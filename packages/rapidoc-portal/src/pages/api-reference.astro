---
import PortalLayout from '../components/PortalLayout.astro';
import PortalMobileNav from '../components/PortalMobileNav.astro';
import PortalSidebarTabs from '../components/PortalSidebarTabs.astro';
import Callout from '../components/Callout.astro';
import { getNavCss, getThemeTokensCss } from '@rapidoc/prerender';
import { renderNavBarHtml } from '@rapidoc/prerender/internal';
import portalConfig from 'virtual:rapidoc-portal/config';
import { OAUTH_RECEIVER_PATH } from '../engine/sync-assets.js';
import { apiReferencePaths, loadVersionSpec } from '../engine/api-routes.js';
import { withBase } from '../components/base-path.js';
import { rapidocThemeAttributes } from '../components/rapidoc-theme.js';

export async function getStaticPaths() {
  // A spec that cannot be loaded stops a build; in `rapidoc dev` only that API's page shows the error.
  const paths = await apiReferencePaths(portalConfig.apis, { deferSpecErrors: import.meta.env.DEV });
  return paths.map((page) => ({ ...page, props: { ...page.props, portalConfig } }));
}

const { api, version, versionTags = [], portalConfig, activeTagSlug = '', currentPath = version.path, redirectTo: redirectPath, specError } = Astro.props;
if (specError) throw new Error(specError);

// Paths below are relative to the portal; links get the base path the portal is served under.
const redirectTo = redirectPath && withBase(redirectPath);
const specUrl = withBase(version.specUrl);
const defaultVersion = api.versions[0];
const versionChoices = api.versions.map((v, i) => ({ ...v, tags: versionTags[i] || [] }));

// A RapiDoc preset under `rapidoc.theme` keeps its own accent and surfaces; otherwise the portal's accent over
// the portal's background and text colors (components/rapidoc-theme.js, and the rapi-doc:not([data-portal-preset])
// rule below).
const { preset: themePreset, usesPreset, attributes: themeAttributes } = rapidocThemeAttributes(portalConfig.rapidoc, portalConfig.theme.primary);

// RapiDoc's own navigation is hidden (show-side-nav=false); the sidebar is @rapidoc/prerender's, so the navigation
// attributes of `rapidoc:` are passed to it.
const navAttributes = {
  'show-method-in-nav-bar': portalConfig.rapidoc['show-method-in-nav-bar'] || 'as-colored-text',
  'use-path-in-nav-bar': portalConfig.rapidoc['use-path-in-nav-bar'] || 'false',
};

// The spec is loaded once per run (engine/api-routes.js) and throws when it cannot be: no page without its sidebar.
const sidebarNavHtml = redirectTo
  ? ''
  : renderNavBarHtml(await loadVersionSpec(api, version), {
      basePath: withBase(version.path),
      activeHref: withBase(currentPath),
      routingMode: 'tag-pages',
      includeSearch: true,
      searchPlaceholder: 'Filter endpoints...',
      itemClassName: 'portal-sidebar-op-item',
      ...navAttributes,
    });

const navCss = getNavCss('.portal-sidebar');
const themeTokensCss = getThemeTokensCss(themePreset);

// <rapi-doc> attributes: portal defaults, then the `rapidoc:` config, then what this layout requires
// (navigation lives in the portal sidebar, the page scrolls, colors follow the portal theme).
const rapidocAttributes = {
  'render-style': 'read',
  'schema-style': 'table',
  scale: 'default',
  'allow-try': 'true',
  'allow-authentication': 'true',
  'allow-server-selection': 'false',
  ...portalConfig.rapidoc,
  ...navAttributes,
  ...themeAttributes,
  'spec-url': specUrl,
  'show-side-nav': 'false',
  'show-header': 'false',
  'update-route': 'false',
  'auto-height': 'true',
  'color-scheme': 'auto',
  'goto-path': activeTagSlug || undefined,
  'oauth-receiver': withBase(OAUTH_RECEIVER_PATH),
};
---

{redirectTo ? (
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{api.title} {version.label} — {portalConfig.site.title}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={redirectTo} />
    {/* Keeps the #operation, which a refresh would drop. */}
    <script is:inline define:vars={{ redirectTo }}>location.replace(redirectTo + location.hash);</script>
    <meta http-equiv="refresh" content={`0;url=${redirectTo}`} />
  </head>
  <body><a href={redirectTo}>{api.title} {version.label}</a></body>
</html>
) : (
<PortalLayout title={`${api.title}${version.isDefault ? '' : ` ${version.label}`}`} sidebarId="portal-api-sidebar">
  <Fragment slot="head">
    <style set:html={themeTokensCss}></style>
    <style set:html={navCss}></style>
    <script type="module" src={withBase('/assets/rapidoc-min.js')}></script>
  </Fragment>

  <aside slot="sidebar" id="portal-api-sidebar" class:list={['portal-layout-sidebar', { 'portal-api-preset': usesPreset }]} popover="auto" data-portal-region="sidebar" aria-label="API navigation">
    <div class="portal-api-header-links">
      <PortalMobileNav />
    </div>
    <PortalSidebarTabs />
    {versionChoices.length > 1 && (
      <div class="portal-api-version">
        <label for="portal-api-version-select">Version</label>
        <select id="portal-api-version-select" data-active-tag={activeTagSlug}>
          {versionChoices.map((v) => (
            <option value={withBase(v.path)} selected={v.version === version.version} data-tags={v.tags.join(' ')}>{v.label}</option>
          ))}
        </select>
      </div>
    )}
    <!-- The nav CSS from @rapidoc/prerender styles its scope element, so it gets an element of its own. -->
    <div class="portal-api-nav portal-sidebar nav-bar">
      <Fragment set:html={sidebarNavHtml} />
    </div>
  </aside>

  <main class="portal-api-main">
    {!version.isDefault && (
      <div class="portal-api-version-note">
        <Callout type="note">
          You're viewing {version.label}. The current version is{' '}
          <a href={withBase(versionChoices[0].tags.includes(activeTagSlug) ? `${defaultVersion.path}/${activeTagSlug}` : defaultVersion.path)}>{defaultVersion.label}</a>.
        </Callout>
      </div>
    )}
    <rapi-doc {...rapidocAttributes}></rapi-doc>
  </main>
</PortalLayout>
)}

<style is:global>
  rapi-doc {
    display: block;
    width: 100%;
    padding: 24px 32px;
    box-sizing: border-box;
    /* Keeps the footer below the fold while the spec loads, so it does not jump down after. */
    min-height: calc(100dvh - var(--sl-nav-height));

    /* Portal fonts. A rule on the element overrides RapiDoc's own :host defaults; `inherit` takes the
       page's :root value (writing var(--font-sans) here would reference itself). */
    --font-sans: inherit;
    --font-mono: inherit;
    /* Same type scale as the guide pages (--sl-text-h* and the heading letter-spacing in
       styles/portal-theme.css), and their body size (--sl-text-body) instead of scale="default"'s 14px. */
    --font-size-regular: 0.9375rem;
    --heading-weight: 600;
    --heading-letter-spacing: -0.02em;
    --heading-line-height: 1.2;
    --line-height: 1.7;
    --h1-font-size: 2rem;
    --h2-font-size: 1.5rem;
    --h3-font-size: 1.25rem;
    --h4-font-size: 1.125rem;
    --h5-font-size: 1rem;
    --h6-font-size: 0.9375rem;
  }
  /* The portal's background and text colors, unless `rapidoc.theme` names a preset with its own */
  rapi-doc:not([data-portal-preset]) {
    --background: var(--portal-bg);
    --foreground: var(--portal-fg);
  }
  @media (min-width: 50em) {
    rapi-doc {
      --h1-font-size: 2.25rem;
      --h2-font-size: 1.75rem;
      --h3-font-size: 1.375rem;
      --h4-font-size: 1.25rem;
    }
  }
  @media (width < 50rem) {
    rapi-doc {
      padding: 16px;
    }
  }
  /* The guides' sidebar colors: links muted and brighter on hover (`.sidebar-pane a` in
     styles/portal-theme.css), tags in a group in Starlight's group-label color. Section labels (and
     the tags, without tag groups) keep RapiDoc's muted upper case. Accent text keeps WCAG AA
     contrast. Method colors are RapiDoc's own. */
  .portal-api-nav {
    --sidebar: var(--portal-bg);
    --sidebar-primary: var(--portal-primary-text);
    --sidebar-foreground: var(--portal-muted);
    --sidebar-label-foreground: var(--portal-muted);
    --sidebar-accent-foreground: var(--portal-fg);
  }
  .portal-api-nav.portal-sidebar .nav-scroll:not(.tags-as-labels) .nav-bar-tag:not(.active) {
    color: var(--sl-color-white);
  }

  /* A preset under `rapidoc.theme` also colors the page around <rapi-doc>: its background (the sidebar's
     too), border, its sidebar color for the header rows, and its accent (as text) in the sidebar, with links
     muted and headings in its heading color, as in the portal's own sidebar. The tokens are on :root
     (getThemeTokensCss above). */
  :root:has(#portal-api-sidebar.portal-api-preset) {
    --portal-bg: var(--background);
    --portal-border: var(--border);
    --portal-header-bg: var(--sidebar);
  }
  .portal-api-preset .portal-api-nav {
    --sidebar-primary: var(--primary-text, var(--primary));
    --sidebar-foreground: color-mix(in srgb, var(--foreground) 72%, var(--sidebar));
    --sidebar-label-foreground: var(--sidebar-foreground);
    --sidebar-accent-foreground: var(--foreground);
  }
  .portal-api-preset .portal-api-nav.portal-sidebar .nav-scroll:not(.tags-as-labels) .nav-bar-tag:not(.active) {
    color: var(--heading-color, var(--foreground));
  }

  /* Fill the sidebar below the (mobile) header links; the nav CSS sizes its root for RapiDoc's own layout. */
  .portal-api-nav.portal-sidebar.nav-bar {
    display: flex;
    flex: 1 1 0%;
    min-height: 0;
    width: auto;
    height: auto;
    border-right: 0;
  }

  .portal-sidebar .nav-scroll {
    flex: 1 1 0%;
    min-height: 0;
    width: 100%;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    padding: 8px 10px 24px;
    box-sizing: border-box;
    scrollbar-width: thin;
  }

  /* Version picker, above the endpoint filter. */
  /* The tabs above the API's pages (PortalSidebarTabs) sit inside the sidebar as in the guides' sidebar,
     whose content has Starlight's padding; this sidebar has none (the RapiDoc navigation brings its own). */
  #portal-api-sidebar > :is(.portal-sidebar-tabs, .portal-sidebar-tabs-select) {
    margin: var(--sl-sidebar-pad-x, 1rem) var(--sl-sidebar-pad-x, 1rem) 1rem;
  }
  .portal-api-version {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem var(--portal-shell-pad-x) 0;
    font-size: 0.875rem;
  }
  .portal-api-version label {
    color: var(--portal-muted, inherit);
  }
  .portal-api-version select {
    flex: 1 1 auto;
    min-width: 0;
    height: 2rem;
    padding: 0 0.5rem;
    border: 1px solid var(--portal-border);
    border-radius: var(--portal-radius);
    background: var(--portal-bg);
    color: var(--portal-fg);
    font: inherit;
  }
  .portal-api-version-note {
    padding: 24px 32px 0;
  }
  .portal-api-version-note .portal-callout {
    margin: 0;
  }
  @media (width < 50rem) {
    .portal-api-version-note {
      padding: 16px 16px 0;
    }
  }

  .portal-api-header-links {
    padding: 1rem var(--portal-shell-pad-x);
    border-bottom: 1px solid var(--portal-border);
  }
  @media (min-width: 50rem) {
    .portal-api-header-links {
      display: none;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const sidebar = document.getElementById('portal-api-sidebar');
    const nav = sidebar?.querySelector('.portal-api-nav');
    const rapiDocEl = document.querySelector('rapi-doc');
    if (!sidebar || !nav || !rapiDocEl) return;

    // Another version: the same tag page (and operation) when that version has the tag, else its overview.
    const versionSelect = document.getElementById('portal-api-version-select');
    versionSelect?.addEventListener('change', () => {
      const option = versionSelect.selectedOptions[0];
      const tag = versionSelect.dataset.activeTag;
      const hasTag = tag && option.dataset.tags.split(' ').includes(tag);
      location.href = hasTag ? `${option.value}/${tag}${location.hash}` : tag ? option.value : option.value + location.hash;
    });

    // On narrow screens the sidebar is a popover menu: close it once a link is chosen.
    sidebar.addEventListener('click', (event) => {
      if (event.target.closest('a') && sidebar.matches(':popover-open')) sidebar.hidePopover();
    });

    // Sidebar links scroll <rapi-doc>, and scrolling <rapi-doc> highlights the current link.
    const bindNav = () => rapiDocEl.bindNavBar(nav);
    if (typeof rapiDocEl.bindNavBar === 'function') {
      bindNav();
    } else {
      customElements.whenDefined('rapi-doc').then(bindNav);
    }
  });
</script>
