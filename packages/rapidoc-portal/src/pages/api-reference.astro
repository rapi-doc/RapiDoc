---
import PortalLayout from '../components/PortalLayout.astro';
import PortalMobileNav from '../components/PortalMobileNav.astro';
import { getNavBarHtml, getNavCss, getSpecNavigation, getThemeTokensCss, toKebabCase } from 'rapidoc/static';
import fs from 'node:fs';
import yaml from 'yaml';
import portalConfig from 'virtual:rapidoc-portal/config';
import { OAUTH_RECEIVER_PATH } from '../engine/sync-assets.js';

export async function getStaticPaths() {
  const paths = [];

  // The route is /apis/[...apiRoute]: every API lives at /apis/<id> (normalizer.js).
  for (const api of portalConfig.apis || []) {
    // 1. Root API route (e.g. apis/shipments)
    paths.push({
      params: { apiRoute: api.id },
      props: { api, portalConfig, activeTagSlug: '', currentPath: api.path },
    });

    // 2. Parse spec tags to generate tag sub-pages (e.g. apis/shipments/shipment-management)
    let specData = null;
    if (!api.isRemote && api.fullPath && fs.existsSync(api.fullPath)) {
      try {
        const raw = fs.readFileSync(api.fullPath, 'utf8');
        try {
          specData = JSON.parse(raw);
        } catch {
          specData = yaml.parse(raw);
        }
      } catch {
        // Fall through
      }
    }

    if (specData) {
      // The same tags the sidebar links to (getNavBarHtml), including tags that operations use
      // without declaring them in the spec's top-level `tags`.
      let navTags = [];
      try {
        navTags = (await getSpecNavigation(specData)).tags;
      } catch {
        // Fall through: the API keeps its root page
      }

      const tagSlugs = new Set(navTags.map((t) => toKebabCase(t.name)));
      for (const tagSlug of tagSlugs) {
        if (!tagSlug || tagSlug === 'general') continue;
        const tagRoute = `${api.id}/${tagSlug}`;
        paths.push({
          params: { apiRoute: tagRoute },
          props: {
            api,
            portalConfig,
            activeTagSlug: tagSlug,
            currentPath: `${api.path}/${tagSlug}`,
          },
        });
      }
    }
  }

  return paths;
}

const { api, portalConfig, activeTagSlug = '', currentPath = api.path } = Astro.props;

let specInput = api.spec;
const specUrl = api.specUrl;

if (!api.isRemote && api.fullPath && fs.existsSync(api.fullPath)) {
  const raw = fs.readFileSync(api.fullPath, 'utf8');
  try {
    specInput = JSON.parse(raw);
  } catch {
    try {
      specInput = yaml.parse(raw);
    } catch {
      specInput = raw;
    }
  }
}

const themePreset = portalConfig.rapidoc.theme || 'ember';

let sidebarNavHtml = '';
try {
  sidebarNavHtml = await getNavBarHtml(specInput, {
    basePath: api.path,
    activeHref: currentPath,
    routingMode: 'tag-pages',
    includeSearch: true,
    searchPlaceholder: 'Filter endpoints...',
    itemClassName: 'portal-sidebar-op-item',
  });
} catch (err) {
  sidebarNavHtml = `<div style="padding: 1.5rem; color: #ef4444;">Failed to render navigation: ${err.message}</div>`;
}

const navCss = getNavCss('.portal-sidebar');
const themeTokensCss = getThemeTokensCss(themePreset);

// <rapi-doc> attributes: portal defaults, then the `rapidoc:` config, then what this layout requires
// (navigation lives in the portal sidebar, the page scrolls, colors follow the portal theme).
const rapidocAttributes = {
  'render-style': 'read',
  'schema-style': 'table',
  scale: 'lg',
  'allow-try': 'true',
  'allow-authentication': 'true',
  'allow-server-selection': 'false',
  'use-path-in-nav-bar': 'true',
  'nav-item-spacing': 'compact',
  theme: themePreset,
  ...portalConfig.rapidoc,
  'primary-color': portalConfig.theme.primary,
  'spec-url': specUrl,
  'show-side-nav': 'false',
  'show-header': 'false',
  'update-route': 'false',
  'auto-height': 'true',
  'color-scheme': 'auto',
  'goto-path': activeTagSlug || undefined,
  'oauth-receiver': OAUTH_RECEIVER_PATH,
};
---

<PortalLayout title={`${api.title} — ${portalConfig.site.title}`} sidebarId="portal-api-sidebar">
  <Fragment slot="head">
    <style set:html={themeTokensCss}></style>
    <style set:html={navCss}></style>
    <script type="module" src="/assets/rapidoc-min.js"></script>
  </Fragment>

  <aside slot="sidebar" id="portal-api-sidebar" class="portal-layout-sidebar" popover="auto" data-portal-region="sidebar" aria-label="API navigation">
    <div class="portal-api-header-links">
      <PortalMobileNav />
    </div>
    <!-- The nav CSS from rapidoc/static styles its scope element, so it gets an element of its own. -->
    <div class="portal-api-nav portal-sidebar nav-bar">
      <Fragment set:html={sidebarNavHtml} />
    </div>
  </aside>

  <main class="portal-api-main">
    <rapi-doc {...rapidocAttributes}></rapi-doc>
  </main>
</PortalLayout>

<style is:global>
  rapi-doc {
    display: block;
    width: 100%;
    padding: 24px 32px;
    box-sizing: border-box;
    /* Keeps the footer below the fold while the spec loads, so it does not jump down after. */
    min-height: calc(100dvh - var(--sl-nav-height));

    /* Portal colours and fonts. A rule on the element overrides RapiDoc's own :host defaults;
       `inherit` takes the page's :root value (writing var(--font-sans) here would reference itself). */
    --background: var(--portal-bg);
    --foreground: var(--portal-fg);
    --font-sans: inherit;
    --font-mono: inherit;
    /* Same type scale as the guide pages (--sl-text-h* and the heading letter-spacing in
       styles/portal-theme.css), and their body size (--sl-text-body) instead of scale="lg"'s 16px. */
    --font-size-regular: 0.9375rem;
    --heading-weight: 600;
    --heading-letter-spacing: -0.02em;
    --heading-line-height: 1.2;
    --line-height: 1.7;
    --h1-font-size: 2rem;
    --h2-font-size: 1.5rem;
    --h3-font-size: 1.25rem;
    --h4-font-size: 1.125rem;
    --h5-font-size: 1rem;
    --h6-font-size: 0.9375rem;
  }
  @media (min-width: 50em) {
    rapi-doc {
      --h1-font-size: 2.25rem;
      --h2-font-size: 1.75rem;
      --h3-font-size: 1.375rem;
      --h4-font-size: 1.25rem;
    }
  }
  @media (width < 50rem) {
    rapi-doc {
      padding: 16px;
    }
  }
  /* Accent text in the sidebar keeps WCAG AA contrast. Method colors are RapiDoc's own. */
  .portal-api-nav {
    --sidebar-primary: var(--portal-primary-text);
  }

  /* One weight for every sidebar level, as in the guides' sidebar (PortalSidebarSublist); RapiDoc's
     nav CSS makes the overview and tag titles bold. */
  .portal-api-nav.portal-sidebar :is(.nav-bar-info, .nav-bar-tag, .nav-bar-tag-group-header, .nav-bar-section) {
    font-weight: 400;
  }

  /* Fill the sidebar below the (mobile) header links; the nav CSS sizes its root for RapiDoc's own layout. */
  .portal-api-nav.portal-sidebar.nav-bar {
    display: flex;
    flex: 1 1 0%;
    min-height: 0;
    width: auto;
    height: auto;
    border-right: 0;
  }

  .portal-sidebar .nav-scroll {
    flex: 1 1 0%;
    min-height: 0;
    width: 100%;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    padding: 8px 0;
    box-sizing: border-box;
    scrollbar-width: thin;
  }

  .portal-api-header-links {
    padding: 1rem var(--portal-shell-pad-x);
    border-bottom: 1px solid var(--portal-border);
  }
  @media (min-width: 50rem) {
    .portal-api-header-links {
      display: none;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const sidebar = document.getElementById('portal-api-sidebar');
    const nav = sidebar?.querySelector('.portal-api-nav');
    const rapiDocEl = document.querySelector('rapi-doc');
    if (!sidebar || !nav || !rapiDocEl) return;

    // On narrow screens the sidebar is a popover menu: close it once a link is chosen.
    sidebar.addEventListener('click', (event) => {
      if (event.target.closest('a') && sidebar.matches(':popover-open')) sidebar.hidePopover();
    });

    // Sidebar links scroll <rapi-doc>, and scrolling <rapi-doc> highlights the current link.
    const bindNav = () => rapiDocEl.bindNavBar(nav);
    if (typeof rapiDocEl.bindNavBar === 'function') {
      bindNav();
    } else {
      customElements.whenDefined('rapi-doc').then(bindNav);
    }
  });
</script>
