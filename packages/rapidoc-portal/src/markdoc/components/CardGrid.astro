---
/**
 * {% card-grid columns=3 %}: a grid of {% card %} items, `columns` across (1 to 4, default 3) from
 * 50rem wide and one column below that. `stagger=true` shifts every second card down, as Starlight's
 * <CardGrid stagger> does (meant for two columns).
 */
interface Props {
  columns?: number;
  stagger?: boolean;
}

const { columns = 3, stagger = false } = Astro.props;
---

<div class:list={['portal-card-grid', { stagger }]} style={`--portal-grid-columns: ${columns}`}><slot /></div>

<style>
  .portal-card-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }
  /* Starlight spaces the children of the content column; in a grid the gap does that. */
  .portal-card-grid > :global(*) {
    margin-top: 0;
  }
  @media (min-width: 50rem) {
    .portal-card-grid {
      grid-template-columns: repeat(var(--portal-grid-columns), minmax(0, 1fr));
      gap: 1.5rem;
    }
    .stagger {
      --stagger-height: 5rem;
      padding-bottom: var(--stagger-height);
    }
    .stagger > :global(*):nth-child(2n) {
      transform: translateY(var(--stagger-height));
    }
  }
</style>
