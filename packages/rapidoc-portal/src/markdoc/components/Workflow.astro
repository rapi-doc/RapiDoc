---
/**
 * {% workflow file="<workflows id>" id="<workflowId>" view="compact" title="..." /%}: one Arazzo
 * workflow of `workflows:`, shown as a <rapi-flow> (the diagram with its run panel). Inside it, the
 * same diagram drawn at build time as a static SVG (@rapidoc/prerender) is the fallback content:
 * it shows until the <rapi-flow> bundle loads, and without JavaScript. Once the element upgrades,
 * its shadow DOM (which has no slot) replaces it. Pages without a workflow do not load the bundle.
 */
import fs from 'node:fs';
import { Aside } from '@astrojs/starlight/components';
import { renderArazzoWorkflow, getFlowCss, getThemeTokensCss } from '@rapidoc/prerender';
import portalConfig from 'virtual:rapidoc-portal/config';
import { readVersionSpec } from '../../engine/api-routes.js';
import { FLOW_BUNDLE_PATH } from '../../engine/sync-assets.js';
import { withBase } from '../../components/base-path.js';

interface Props {
  file: string;
  id?: string;
  view?: 'expanded' | 'compact';
  title?: string;
}

const { file, id, view, title } = Astro.props;
const workflows = portalConfig.workflows || [];
const entry = workflows.find((w: any) => w.id === file);
const apis = portalConfig.apis || [];

let svg = '';
let legendHtml = '';
let workflowId = id || '';
let problem = '';
if (!entry) {
  console.warn(`[rapidoc-portal] workflow on ${Astro.url.pathname}: no workflow file with id "${file}" in workflows:`);
} else if (id && !entry.workflowIds.includes(id)) {
  problem = `The file has no workflow "${id}". Its workflows: ${entry.workflowIds.join(', ')}.`;
  console.warn(`[rapidoc-portal] workflow on ${Astro.url.pathname}: ${problem}`);
} else {
  // Steps resolve against the default version of each source's API
  const sources: Record<string, object> = {};
  for (const [name, apiId] of Object.entries(entry.sources as Record<string, string>)) {
    const api = apis.find((a: any) => a.id === apiId);
    const spec = api && readVersionSpec(api.versions[0]);
    if (spec) sources[name] = spec;
  }
  const drawn = renderArazzoWorkflow(fs.readFileSync(entry.fullPath, 'utf8'), {
    workflowId: id,
    sources,
    view,
    idPrefix: `rf-${file}-${id || 'first'}`,
  });
  svg = drawn.svg;
  legendHtml = drawn.legendHtml;
  workflowId = drawn.graph?.workflowId || id || '';
}

const themePreset = portalConfig.rapidoc?.theme || 'ember';
// As on the API reference pages: the tokens follow <html data-theme>, so the diagram switches with the portal theme
const tokensCss = getThemeTokensCss(themePreset);
const flowCss = getFlowCss();
const firstApi = entry && apis.find((a: any) => a.id === entry.apiIds[0]);
---

{
  entry && !problem ? (
    <figure class="portal-workflow not-content" data-file={file} data-workflow={workflowId}>
      {title && <figcaption>{title}</figcaption>}
      <rapi-flow
        arazzo-url={withBase(entry.url)}
        spec-url={firstApi ? withBase(firstApi.specUrl) : undefined}
        workflow-id={workflowId || undefined}
        view={view}
        theme={themePreset}
        color-scheme="auto"
      >
        <div class="portal-workflow-diagram">
          <Fragment set:html={svg} />
        </div>
        {legendHtml && (
          <div class="portal-workflow-footer">
            <Fragment set:html={legendHtml} />
          </div>
        )}
      </rapi-flow>
      {/* A module script: one load per page however many workflows it has. Inline, so Astro leaves the
          static file's URL alone (Vite's dev server does not serve public/ files to import()). */}
      <script is:inline type="module" src={withBase(FLOW_BUNDLE_PATH)}></script>
    </figure>
  ) : (
    <Aside type="caution" title="Workflow not found">
      {entry ? (
        <>{problem}</>
      ) : (
        <>
          No workflow file with id <code>{file}</code> in <code>workflows:</code> of <code>rapidoc.config.yaml</code>
          {workflows.length > 0 && <>. Available ids: {workflows.map((w: any) => w.id).join(', ')}</>}.
        </>
      )}
    </Aside>
  )
}

<style set:html={tokensCss}></style>
<style set:html={flowCss}></style>
<style>
  .portal-workflow {
    margin: 1.5rem 0;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--portal-radius);
    overflow: hidden;
    --primary: var(--portal-primary);
  }
  figcaption {
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    font-weight: 600;
  }
  .portal-workflow-diagram {
    padding: 1rem;
    overflow-x: auto;
  }
  .portal-workflow-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 0.5rem 1rem;
    border-top: 1px solid var(--sl-color-hairline);
  }
  /* The legend's own styles come with the flow CSS; it sits in the footer, so no top margin */
  .portal-workflow-footer :global(.flow-legend) {
    margin: 0;
  }
  /* The page's fonts, no second border */
  .portal-workflow rapi-flow {
    display: block;
    --font-sans: inherit;
    --font-mono: inherit;
  }
</style>

