---
/**
 * {% card title="..." icon="..." href="..." %}: a card, linked when `href` is set. `icon` is a Phosphor
 * icon name (https://phosphoricons.com), shown in the duotone weight. Styles: `.portal-doc-card` in
 * portal-theme.css, shared with the MDX <Card> and the API catalog.
 */
import Icon from '../../components/Icon.astro';
import { withBase } from '../../components/base-path.js';

interface Props {
  title: string;
  icon?: string;
  href?: string;
}

const { title, icon, href } = Astro.props;
const Element = href ? 'a' : 'article';
---

<Element href={withBase(href)} class="portal-doc-card">
  {icon && <Icon name={icon} duotone class="portal-doc-card-icon" />}
  <p class="portal-doc-card-title">
    <span>{title}</span>
    {href && <Icon name="caret-right" size={16} class="portal-doc-card-arrow" />}
  </p>
  <div class="portal-doc-card-body"><slot /></div>
</Element>
