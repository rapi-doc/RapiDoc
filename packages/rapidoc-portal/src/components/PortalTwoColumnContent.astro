---
/**
 * Starlight TwoColumnContent override: the "On this page" column sticks below the header instead of
 * being fixed to the viewport, so the site footer can scroll in below it at the end of the page. It keeps
 * one width, the left sidebar's (--portal-toc-width to change it), where Starlight's grows with the
 * screen; the page's text stays at its width, centered in the rest.
 */
---

<div class="lg:sl-flex">
  {
    Astro.locals.starlightRoute.toc && (
      <aside class="right-sidebar-container print:hidden">
        <div class="right-sidebar" data-portal-region="toc">
          <slot name="right-sidebar" />
        </div>
      </aside>
    )
  }
  <div class="main-pane"><slot /></div>
</div>

<style>
  .main-pane {
    isolation: isolate;
  }

  @media (min-width: 72rem) {
    .right-sidebar-container {
      order: 2;
      position: relative;
      flex: none;
      width: var(--portal-toc-width, var(--sl-sidebar-width));
    }

    .right-sidebar {
      position: sticky;
      top: var(--sl-nav-height);
      height: calc(100dvh - var(--sl-nav-height));
      overflow-y: auto;
      scrollbar-width: none;
      border-inline-start: 1px solid var(--sl-color-hairline);
    }

    .main-pane {
      width: 100%;
    }

    :global([data-has-sidebar][data-has-toc]) .main-pane {
      order: 1;
      width: calc(100% - var(--portal-toc-width, var(--sl-sidebar-width)));
    }
  }
</style>
