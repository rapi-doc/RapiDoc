---
/**
 * A Phosphor icon (https://phosphoricons.com), inlined at build time. 24px uses the regular (or duotone)
 * weight and 16px the bold one, both a 1.5px line. The navigation (sidebar items, header and mobile tabs)
 * passes `weight="regular"` at 16px, a lighter 1px line. Use duotone at 24px only.
 */
import { iconsDir } from 'virtual:rapidoc-portal/icons';
import { readIconSvg } from './icon-files.js';

interface Props {
  name: string;
  size?: 16 | 24;
  duotone?: boolean;
  /** Overrides the weight the size picks, e.g. `regular` at 16px for a lighter 1px line */
  weight?: 'regular' | 'bold';
  class?: string;
  [key: string]: any;
}

const { name, size = 24, duotone = false, weight: weightProp, ...rest } = Astro.props;
const weight = duotone ? 'duotone' : (weightProp ?? (size === 16 ? 'bold' : 'regular'));
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 256 256"
  width={size}
  height={size}
  fill="currentColor"
  aria-hidden="true"
  {...rest}
  set:html={readIconSvg(iconsDir, name, weight)}
/>
