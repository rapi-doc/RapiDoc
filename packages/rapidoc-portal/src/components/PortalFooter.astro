---
/**
 * Site footer: an optional call-to-action band, then brand (with an optional newsletter sign-up),
 * link columns, copyright and social links. The same full-width footer is used
 * on every page; on documentation pages it is revealed below the sidebar at the end of the page.
 */
import portalConfig from 'virtual:rapidoc-portal/config';

interface Props {
  portalConfig?: any;
}

const config = Astro.props.portalConfig ?? portalConfig;
const { site, footer, tabs } = config;
if (footer === false) {
  return;
}

const logo = site.logo;
// Without configured columns: one column with the header tabs.
const columns = footer.columns || [{ title: site.title, links: tabs.map((tab: any) => ({ label: tab.label, href: tab.href })) }];
const copyright = footer.copyright || `© ${new Date().getFullYear()} ${site.title}. All rights reserved.`;
const social = footer.social || [];
const isExternal = (href?: string) => /^[a-z][a-z0-9+.-]*:/i.test(href || '');
const external = (href?: string) => (isExternal(href) ? { target: '_blank', rel: 'noopener noreferrer' } : {});
const cta = footer.cta;
const newsletter = footer.newsletter;

// 24x24 icon paths for footer.social[].icon
const SOCIAL_ICONS: Record<string, string> = {
  github:
    'M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z',
  x: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
  linkedin:
    'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  youtube:
    'M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z',
  discord:
    'M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.893.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z',
};
---

<footer class="portal-footer-root print:hidden" data-portal-region="footer">
  <div class="portal-footer-container" data-portal-region="footer-inner">
    {
      cta && (
        <section class="portal-footer-cta" aria-labelledby="portal-footer-cta-title">
          <div class="portal-footer-cta-text">
            <h2 class="portal-footer-cta-title" id="portal-footer-cta-title">
              {cta.title}
            </h2>
            {cta.description && <p class="portal-footer-cta-desc">{cta.description}</p>}
          </div>
          {cta.links?.length > 0 && (
            <div class="portal-footer-cta-actions">
              {cta.links.map((link: any, i: number) => (
                <a href={link.href} class:list={['portal-footer-cta-link', `portal-footer-cta-${link.style || (i === 0 ? 'primary' : 'button')}`]} {...external(link.href)}>
                  {link.label}
                </a>
              ))}
            </div>
          )}
        </section>
      )
    }

    <div class="portal-footer-top">
      <div class="portal-footer-brand-col">
        <a href={logo.href} class="portal-footer-brand">
          {logo.light && <img src={logo.light} alt={logo.text ? '' : logo.alt} class:list={['portal-brand-img', { 'portal-brand-img-light': logo.dark !== logo.light }]} />}
          {logo.dark && logo.dark !== logo.light && <img src={logo.dark} alt={logo.text ? '' : logo.alt} class="portal-brand-img portal-brand-img-dark" />}
          {logo.text && <span class="portal-footer-brand-title">{logo.text}</span>}
        </a>
        {site.description && <p class="portal-footer-desc">{site.description}</p>}
        {
          newsletter && (
            <form class="portal-footer-newsletter" action={newsletter.action} method="post" target="_blank" aria-labelledby="portal-newsletter-title">
              <h2 class="portal-footer-col-title" id="portal-newsletter-title">
                {newsletter.title || 'Newsletter'}
              </h2>
              {newsletter.description && <p class="portal-footer-desc">{newsletter.description}</p>}
              <div class="portal-newsletter-row">
                <label for="portal-newsletter-email" class="portal-sr-only">
                  Email address
                </label>
                <input id="portal-newsletter-email" class="portal-newsletter-input" type="email" name={newsletter.field || 'email'} required autocomplete="email" placeholder="you@example.com" />
                <button type="submit" class="portal-newsletter-submit">
                  {newsletter.button || 'Subscribe'}
                </button>
              </div>
            </form>
          )
        }
      </div>

      <div class="portal-footer-columns">
        {
          columns.map((col: any) => (
            <div class="portal-footer-col">
              <h2 class="portal-footer-col-title">{col.title}</h2>
              <ul class="portal-footer-links">
                {col.links.map((link: any) => (
                  <li>
                    <a href={link.href} class="portal-footer-link" {...external(link.href)}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="portal-footer-bottom">
      <div class="portal-footer-copy">
        <span>{copyright}</span>
        {
          footer.branding && (
            <span class="portal-footer-branding">
              · <a href="https://rapidocweb.com" target="_blank" rel="noopener noreferrer">Powered by RapiDoc</a>
            </span>
          )
        }
      </div>

      {
        social.length > 0 && (
          <div class="portal-footer-social">
            {social.map((item: any) => (
              <a href={item.href} class="portal-footer-social-link" aria-label={item.icon} target="_blank" rel="noopener noreferrer">
                {SOCIAL_ICONS[item.icon] ? (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" clip-rule="evenodd" d={SOCIAL_ICONS[item.icon]} />
                  </svg>
                ) : (
                  <span>{item.icon}</span>
                )}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</footer>

<style is:global>
  .portal-footer-root {
    background-color: var(--portal-bg);
    border-top: 1px solid var(--portal-border);
    color: var(--portal-muted);
    font-family: var(--font-sans);
    padding-block: 3.5rem 2.5rem;
    box-sizing: border-box;
    width: 100%;
  }

  /* Same content edges as the header bar (see --portal-shell-pad-x in portal-theme.css). */
  .portal-footer-container {
    padding-inline: var(--portal-shell-pad-x);
  }

  .portal-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .portal-footer-root :is(a, button, input):focus-visible {
    outline: 2px solid var(--portal-primary);
    outline-offset: 2px;
  }

  /* Call-to-action band */
  .portal-footer-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    padding-bottom: 2.5rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--portal-border);
  }

  .portal-footer-cta-title {
    margin: 0;
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.875rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--portal-fg);
  }

  .portal-footer-cta-desc {
    margin: 0.5rem 0 0;
    font-size: 1rem;
    line-height: 1.5;
    max-width: 40rem;
  }

  .portal-footer-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .portal-footer-cta-link,
  .portal-newsletter-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.75rem;
    padding: 0 1.25rem;
    border-radius: 8px;
    border: 1px solid var(--portal-border);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--portal-fg);
    text-decoration: none;
    white-space: nowrap;
    background: transparent;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .portal-footer-cta-button:hover {
    background-color: var(--portal-hover-bg);
  }

  .portal-footer-cta-primary,
  .portal-newsletter-submit {
    border-color: var(--portal-primary);
    background-color: var(--portal-primary);
    color: var(--portal-on-primary);
  }

  .portal-footer-cta-primary:hover,
  .portal-newsletter-submit:hover {
    background-color: color-mix(in srgb, var(--portal-primary) 85%, #ffffff);
  }

  /* Newsletter sign-up */
  .portal-footer-newsletter {
    margin-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .portal-footer-newsletter .portal-footer-col-title {
    margin: 0;
  }

  .portal-newsletter-row {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .portal-newsletter-input {
    flex: 1;
    min-width: 0;
    height: 2.75rem;
    padding: 0 0.75rem;
    border-radius: 8px;
    border: 1px solid var(--portal-border);
    background-color: var(--portal-surface);
    color: var(--portal-fg);
    font: inherit;
    font-size: 0.875rem;
  }

  .portal-newsletter-input::placeholder {
    color: var(--portal-muted);
  }

  .portal-newsletter-submit {
    padding: 0 1rem;
  }

  .portal-footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--portal-border);
  }

  @media (min-width: 768px) {
    .portal-footer-top {
      grid-template-columns: 280px 1fr;
      gap: 4rem;
    }
  }

  .portal-footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .portal-footer-brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--portal-fg);
    text-decoration: none;
    font-size: 1.125rem;
    font-weight: 700;
  }

  .portal-footer-brand-icon {
    font-size: 1.35rem;
  }

  .portal-footer-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    margin: 0;
    max-width: 320px;
  }

  .portal-footer-columns {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 1.5rem;
  }

  @media (min-width: 640px) {
    .portal-footer-columns {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .portal-footer-col-title {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--portal-fg);
    margin: 0 0 1rem;
  }

  .portal-footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .portal-footer-link {
    color: var(--portal-muted);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.15s ease;
  }

  .portal-footer-link:hover {
    color: var(--portal-fg);
  }

  .portal-footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 1.75rem;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8125rem;
  }

  @media (min-width: 640px) {
    .portal-footer-bottom {
      flex-direction: row;
    }
  }

  .portal-footer-branding a {
    color: var(--portal-primary-text);
    text-decoration: underline;
  }

  .portal-footer-branding a:hover {
    text-decoration: underline;
  }

  .portal-footer-social {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .portal-footer-social-link {
    color: var(--portal-muted);
    transition:
      color 0.15s ease,
      transform 0.15s ease;
    display: flex;
    align-items: center;
  }

  .portal-footer-social-link:hover {
    color: var(--portal-fg);
    transform: translateY(-1px);
  }
</style>
