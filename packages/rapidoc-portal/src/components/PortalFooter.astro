---
import portalConfig from 'virtual:rapidoc-portal/config';

interface Props {
  portalConfig?: any;
  mode?: 'auto' | 'columns' | 'compact';
}

const config = Astro.props.portalConfig ?? portalConfig;

const site = config?.site || {};
if (site.footer === false) {
  return;
}

const currentPath = Astro.url?.pathname || '/';
const is3ColumnLayout = currentPath.startsWith('/docs') || currentPath.startsWith('/apis');
const activeMode = Astro.props.mode && Astro.props.mode !== 'auto'
  ? Astro.props.mode
  : (is3ColumnLayout ? 'compact' : 'columns');

const footer = site.footer || {};
const logo = site.logo || {};
const title = logo.text || site.title || 'Developer Portal';
const icon = logo.icon || '🚀';
const columns = footer.columns || [
  {
    title: 'Product',
    links: [
      { label: 'Documentation', href: '/docs/documentation' },
      { label: 'API Catalog', href: '/catalog' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'API Reference', href: '/apis/shipments' },
      { label: 'GitHub', href: 'https://github.com/rapi-doc/RapiDoc' },
    ],
  },
];
const copyright = footer.copyright || `© ${new Date().getFullYear()} ${title}. All rights reserved.`;
const branding = footer.branding || 'Powered by RapiDoc';
const social = footer.social || [];

// Compact links extracted from columns, prioritizing legal, status, and reference links
let compactLinks = (columns || [])
  .flatMap((c: any) => c.links || c.items || [])
  .filter((l: any) =>
    ['privacy', 'terms', 'security', 'status', 'support', 'docs', 'api reference', 'features'].includes(
      (l.label || '').toLowerCase()
    )
  )
  .slice(0, 5);

if (compactLinks.length === 0 && columns) {
  compactLinks = (columns || [])
    .map((c: any) => (c.links || c.items || [])[0])
    .filter(Boolean)
    .slice(0, 4);
}
---

{
  activeMode === 'compact' ? (
    /* Small single-row footer for 3-column layouts (Docs, APIs) */
    <footer class="portal-content-footer" role="contentinfo">
      <div class="portal-content-footer-container">
        <div class="portal-content-footer-copy">{copyright}</div>
        {compactLinks.length > 0 && (
          <div class="portal-content-footer-links">
            {compactLinks.map((link: any, idx: number) => (
              <>
                {idx > 0 && <span class="portal-content-footer-dot">&bull;</span>}
                <a
                  href={link.href || link.path || '#'}
                  class="portal-content-footer-link"
                  target={link.href?.startsWith('http') ? '_blank' : undefined}
                  rel={link.href?.startsWith('http') ? 'noopener noreferrer' : undefined}
                >
                  {link.label || link.title}
                </a>
              </>
            ))}
          </div>
        )}
        {social.length > 0 && (
          <div class="portal-content-footer-social">
            {social.map((item: any) => (
              <a
                href={item.href || '#'}
                class="portal-social-link"
                aria-label={item.icon || 'Social link'}
                target="_blank"
                rel="noopener noreferrer"
              >
                {item.icon === 'github' && (
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                  </svg>
                )}
                {item.icon === 'x' && (
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                  </svg>
                )}
                {item.icon === 'discord' && (
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.893.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z" />
                  </svg>
                )}
              </a>
            ))}
          </div>
        )}
      </div>
    </footer>
  ) : (
    /* Tall multi-column footer for wide layouts (Landing, Catalog) */
    <footer class="portal-footer-root">
      <div class="portal-footer-container">
        <div class="portal-footer-top">
          <div class="portal-footer-brand-col">
            <a href="/" class="portal-footer-brand">
              <span class="portal-footer-brand-icon">{icon}</span>
              <span class="portal-footer-brand-title">{title}</span>
            </a>
            <p class="portal-footer-desc">
              {site.description || 'Enterprise developer platform and interactive OpenAPI documentation console.'}
            </p>
          </div>

          <div class="portal-footer-columns">
            {columns.map((col: any) => (
              <div class="portal-footer-col">
                <h4 class="portal-footer-col-title">{col.title}</h4>
                <ul class="portal-footer-links">
                  {(col.links || col.items || []).map((link: any) => (
                    <li>
                      <a
                        href={link.href || link.path || '#'}
                        class="portal-footer-link"
                        target={link.href?.startsWith('http') ? '_blank' : undefined}
                        rel={link.href?.startsWith('http') ? 'noopener noreferrer' : undefined}
                      >
                        {link.label || link.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>

        <div class="portal-footer-bottom">
          <div class="portal-footer-copy">
            <span>{copyright}</span>
            {branding && (
              <span class="portal-footer-branding">
                · <a href="https://rapidocweb.com" target="_blank" rel="noopener noreferrer">{branding}</a>
              </span>
            )}
          </div>

          {social.length > 0 && (
            <div class="portal-footer-social">
              {social.map((item: any) => (
                <a
                  href={item.href || '#'}
                  class="portal-footer-social-link"
                  aria-label={item.icon || 'Social link'}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {item.icon === 'github' && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                    </svg>
                  )}
                  {item.icon === 'x' && (
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                    </svg>
                  )}
                  {item.icon === 'discord' && (
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.893.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z" />
                    </svg>
                  )}
                </a>
              ))}
            </div>
          )}
        </div>
      </div>
    </footer>
  )
}

<style is:global>
  /* Compact Single-Row Footer for 3-Column Layouts (Docs & APIs) - Matching release_12_0_0 */
  .portal-content-footer {
    margin-top: auto;
    border-top: 1px solid var(--portal-border, #363636);
    height: 52px;
    min-height: 52px;
    max-height: 52px;
    box-sizing: border-box;
    padding: 0;
    width: 100%;
    max-width: none;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    background: var(--portal-bg, oklch(0.2613 0.0134 272.84));
    font-family: var(--font-sans, var(--sl-font-system, system-ui, sans-serif));
  }

  [data-theme='light'] .portal-content-footer {
    background: var(--portal-bg, #ffffff);
    border-color: var(--portal-border, #e4e4e7);
  }

  .portal-content-footer-container {
    width: 100%;
    max-width: var(--sl-content-width, 860px);
    margin-inline: var(--sl-content-margin-inline, auto);
    padding: 0 var(--sl-content-pad-x, 1.5rem);
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.8125rem;
    color: var(--portal-muted, #8b949e);
  }

  .portal-content-footer-copy {
    color: var(--portal-muted, #8b949e);
    white-space: nowrap;
  }

  .portal-content-footer-links {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-wrap: nowrap;
    white-space: nowrap;
  }

  .portal-content-footer-link {
    color: var(--portal-muted, #8b949e);
    text-decoration: none !important;
    transition: color 0.15s ease;
    white-space: nowrap;
  }

  .portal-content-footer-link:hover {
    color: var(--portal-fg, #cccccc);
  }

  .portal-content-footer-dot {
    opacity: 0.4;
    font-size: 0.75rem;
  }

  .portal-content-footer-social {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .portal-content-footer-social .portal-social-link {
    color: var(--portal-muted, #8b949e);
    opacity: 0.75;
    transition: all 0.15s ease;
    display: flex;
    align-items: center;
  }

  .portal-content-footer-social .portal-social-link:hover {
    color: var(--portal-fg, #cccccc);
    opacity: 1;
    transform: translateY(-1px);
  }

  /* Tall Multi-Column Footer for Wide Pages (Landing, Catalog) */
  .portal-footer-root {
    background-color: var(--portal-bg, oklch(0.2613 0.0134 272.84));
    border-top: 1px solid var(--portal-border, #363636);
    color: var(--portal-muted, #8b949e);
    font-family: var(--font-sans, var(--sl-font-system, system-ui, sans-serif));
    padding: 3.5rem 1.5rem 2.5rem;
    box-sizing: border-box;
    width: 100%;
  }

  .portal-footer-container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .portal-footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--portal-border, #363636);
  }

  @media (min-width: 768px) {
    .portal-footer-top {
      grid-template-columns: 280px 1fr;
      gap: 4rem;
    }
  }

  .portal-footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .portal-footer-brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--portal-fg, #cccccc);
    text-decoration: none;
    font-size: 1.125rem;
    font-weight: 700;
  }

  .portal-footer-brand-icon {
    font-size: 1.35rem;
  }

  .portal-footer-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--portal-muted, #8b949e);
    margin: 0;
    max-width: 320px;
  }

  .portal-footer-columns {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 1.5rem;
  }

  @media (min-width: 640px) {
    .portal-footer-columns {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .portal-footer-col-title {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--portal-fg, #cccccc);
    margin: 0 0 1rem;
  }

  .portal-footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .portal-footer-link {
    color: var(--portal-muted, #8b949e);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.15s ease;
  }

  .portal-footer-link:hover {
    color: var(--portal-fg, #cccccc);
  }

  .portal-footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 1.75rem;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8125rem;
  }

  @media (min-width: 640px) {
    .portal-footer-bottom {
      flex-direction: row;
    }
  }

  .portal-footer-copy {
    color: var(--portal-muted, #8b949e);
  }

  .portal-footer-branding a {
    color: var(--portal-primary, #f76b39);
    text-decoration: none;
  }

  .portal-footer-branding a:hover {
    text-decoration: underline;
  }

  .portal-footer-social {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .portal-footer-social-link {
    color: var(--portal-muted, #8b949e);
    transition: color 0.15s ease, transform 0.15s ease;
    display: flex;
    align-items: center;
  }

  .portal-footer-social-link:hover {
    color: var(--portal-fg, #cccccc);
    transform: translateY(-1px);
  }
</style>
