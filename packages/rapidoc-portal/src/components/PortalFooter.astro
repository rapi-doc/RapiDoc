---
/**
 * Site footer: an optional call-to-action band, then brand (with an optional newsletter sign-up),
 * link columns, copyright and social links. The same full-width footer is used
 * on every page; on documentation pages it is revealed below the sidebar at the end of the page.
 */
import portalConfig from 'virtual:rapidoc-portal/config';
import Icon from './Icon.astro';
import { withBase } from './base-path.js';

interface Props {
  portalConfig?: any;
}

const config = Astro.props.portalConfig ?? portalConfig;
const { site, footer, tabs } = config;
if (footer === false) {
  return;
}

const logo = site.logo;
// Without configured columns: one column with the header tabs.
const columns = footer.columns || [{ title: site.title, links: tabs.map((tab: any) => ({ label: tab.label, href: tab.href })) }];
const copyright = footer.copyright || `© ${new Date().getFullYear()} ${site.title}. All rights reserved.`;
const social = footer.social || [];
const isExternal = (href?: string) => /^[a-z][a-z0-9+.-]*:/i.test(href || '');
const external = (href?: string) => (isExternal(href) ? { target: '_blank', rel: 'noopener noreferrer' } : {});
const cta = footer.cta;
const newsletter = footer.newsletter;
---

<!-- Each divided band spans the full width, so its rule runs edge to edge like the header's;
     the content inside lines up with the header content. -->
<footer class="portal-footer-root print:hidden" data-portal-region="footer">
  {
    cta && (
      <section class="portal-footer-band portal-footer-cta-band" aria-labelledby="portal-footer-cta-title">
        <div class="portal-footer-container portal-footer-cta">
          <div class="portal-footer-cta-text">
            <h2 class="portal-footer-cta-title" id="portal-footer-cta-title">
              {cta.title}
            </h2>
            {cta.description && <p class="portal-footer-cta-desc">{cta.description}</p>}
          </div>
          {cta.links?.length > 0 && (
            <div class="portal-footer-cta-actions">
              {cta.links.map((link: any, i: number) => (
                <a href={withBase(link.href)} class:list={['portal-footer-cta-link', `portal-footer-cta-${link.style || (i === 0 ? 'primary' : 'button')}`]} {...external(link.href)}>
                  {link.label}
                </a>
              ))}
            </div>
          )}
        </div>
      </section>
    )
  }

  <div class="portal-footer-band">
    <div class="portal-footer-container portal-footer-top" data-portal-region="footer-inner">
      <div class="portal-footer-brand-col">
        <a href={withBase(logo.href)} class="portal-footer-brand">
          {logo.light && <img src={withBase(logo.light)} alt={logo.text ? '' : logo.alt} class:list={['portal-brand-img', { 'portal-brand-img-light': logo.dark !== logo.light }]} />}
          {logo.dark && logo.dark !== logo.light && <img src={withBase(logo.dark)} alt={logo.text ? '' : logo.alt} class="portal-brand-img portal-brand-img-dark" />}
          {logo.text && <span class="portal-footer-brand-title">{logo.text}</span>}
        </a>
        {site.description && <p class="portal-footer-desc">{site.description}</p>}
        {
          newsletter && (
            <form class="portal-footer-newsletter" action={newsletter.action} method="post" target="_blank" aria-labelledby="portal-newsletter-title">
              <h2 class="portal-footer-col-title" id="portal-newsletter-title">
                {newsletter.title || 'Newsletter'}
              </h2>
              {newsletter.description && <p class="portal-footer-desc">{newsletter.description}</p>}
              <div class="portal-newsletter-row">
                <label for="portal-newsletter-email" class="portal-sr-only">
                  Email address
                </label>
                <input id="portal-newsletter-email" class="portal-newsletter-input" type="email" name={newsletter.field || 'email'} required autocomplete="email" placeholder="you@example.com" />
                <button type="submit" class="portal-newsletter-submit">
                  {newsletter.button || 'Subscribe'}
                </button>
              </div>
            </form>
          )
        }
      </div>

      <div class="portal-footer-columns">
        {
          columns.map((col: any) => (
            <div class="portal-footer-col">
              <h2 class="portal-footer-col-title">{col.title}</h2>
              <ul class="portal-footer-links">
                {col.links.map((link: any) => (
                  <li>
                    <a href={withBase(link.href)} class="portal-footer-link" {...external(link.href)}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="portal-footer-container portal-footer-bottom">
      <div class="portal-footer-copy">
        <span>{copyright}</span>
        {
          footer.branding && (
            <span class="portal-footer-branding">
              · <a href="https://rapidocweb.com" target="_blank" rel="noopener noreferrer">Powered by RapiDoc</a>
            </span>
          )
        }
      </div>

      {
        social.length > 0 && (
          <div class="portal-footer-social">
            {social.map((item: any) => (
              <a href={withBase(item.href)} class="portal-footer-social-link" aria-label={item.icon} target="_blank" rel="noopener noreferrer">
                <Icon name={`${item.icon}-logo`} />
              </a>
            ))}
          </div>
        )
      }
  </div>
</footer>

<style is:global>
  .portal-footer-root {
    background-color: var(--portal-bg);
    border-top: 1px solid var(--portal-border);
    color: var(--portal-muted);
    font-family: var(--font-sans);
    /* No bottom padding: the bottom bar's own padding ends the footer. */
    padding-top: 3.5rem;
    box-sizing: border-box;
    width: 100%;
  }

  /* Same content edges as the header bar (see --portal-shell-pad-x in portal-theme.css). Containers sit
     directly in full-width elements, so the percentage in the padding resolves the same everywhere. */
  .portal-footer-container {
    padding-inline: var(--portal-shell-pad-x);
  }

  /* A full-width band with a rule below it */
  .portal-footer-band {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--portal-border);
  }

  .portal-footer-cta-band {
    margin-bottom: 2.5rem;
  }

  .portal-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .portal-footer-root :is(a, button, input):focus-visible {
    outline: 2px solid var(--portal-primary);
    outline-offset: 2px;
  }

  /* Call-to-action band */
  .portal-footer-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
  }

  .portal-footer-cta-title {
    margin: 0;
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.875rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--portal-fg);
  }

  .portal-footer-cta-desc {
    margin: 0.5rem 0 0;
    font-size: 1rem;
    line-height: 1.5;
    max-width: 40rem;
  }

  .portal-footer-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .portal-footer-cta-link,
  .portal-newsletter-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.75rem;
    padding: 0 1.25rem;
    border-radius: var(--portal-radius);
    border: 1px solid var(--portal-border);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--portal-fg);
    text-decoration: none;
    white-space: nowrap;
    background: transparent;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .portal-footer-cta-button:hover {
    background-color: var(--portal-hover-bg);
  }

  .portal-footer-cta-primary,
  .portal-newsletter-submit {
    border-color: var(--portal-primary);
    background-color: var(--portal-primary);
    color: var(--portal-on-primary);
  }

  .portal-footer-cta-primary:hover,
  .portal-newsletter-submit:hover {
    background-color: color-mix(in srgb, var(--portal-primary) 85%, #ffffff);
  }

  /* Newsletter sign-up */
  .portal-footer-newsletter {
    margin-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .portal-footer-newsletter .portal-footer-col-title {
    margin: 0;
  }

  .portal-newsletter-row {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .portal-newsletter-input {
    flex: 1;
    min-width: 0;
    height: 2.75rem;
    padding: 0 0.75rem;
    border-radius: var(--portal-radius);
    border: 1px solid var(--portal-border);
    background-color: var(--portal-surface);
    color: var(--portal-fg);
    font: inherit;
    font-size: 0.875rem;
  }

  .portal-newsletter-input::placeholder {
    color: var(--portal-muted);
  }

  .portal-newsletter-submit {
    padding: 0 1rem;
  }

  .portal-footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  /* From 768px: brand | link columns | empty track. The two outer tracks share the free space, so the
     columns sit in the middle of the page; when that would cover the brand, the brand track keeps its
     280px and the columns move right (and wrap when even that is too narrow). */
  @media (min-width: 768px) {
    .portal-footer-top {
      grid-template-columns: minmax(280px, 1fr) auto minmax(0, 1fr);
      column-gap: 2.5rem;
    }

    .portal-footer-brand-col {
      max-width: 280px;
    }
  }

  .portal-footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .portal-footer-brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--portal-fg);
    text-decoration: none;
    font-size: 1.125rem;
    font-weight: 700;
  }

  .portal-footer-brand-icon {
    font-size: 1.35rem;
  }

  .portal-footer-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    margin: 0;
    max-width: 320px;
  }

  /* Link columns: a wrapping row, so its widest size (max-content) is all columns on one line, which
     is what the auto grid track above gives it when there is room. */
  .portal-footer-columns {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 1.5rem;
  }

  .portal-footer-col {
    min-width: 7.5rem;
  }

  @media (min-width: 768px) {
    .portal-footer-columns {
      column-gap: 2.5rem;
    }
  }

  .portal-footer-copy {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35em;
  }

  .portal-footer-col-title {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--portal-fg);
    margin: 0 0 1rem;
  }

  .portal-footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .portal-footer-link {
    color: var(--portal-muted);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.15s ease;
  }

  .portal-footer-link:hover {
    color: var(--portal-fg);
  }

  .portal-footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-block: 0.5rem;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8125rem;
  }

  @media (min-width: 640px) {
    .portal-footer-bottom {
      flex-direction: row;
    }
  }

  .portal-footer-branding a {
    color: var(--portal-primary-text);
    text-decoration: underline;
  }

  .portal-footer-branding a:hover {
    text-decoration: underline;
  }

  .portal-footer-social {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .portal-footer-social-link {
    color: var(--portal-muted);
    transition:
      color 0.15s ease,
      transform 0.15s ease;
    display: flex;
    align-items: center;
  }

  .portal-footer-social-link:hover {
    color: var(--portal-fg);
    transform: translateY(-1px);
  }
</style>
