---
/**
 * Starlight TableOfContents override: Starlight's "On this page", with its rail drawn as one SVG path.
 *
 *   │ Overview
 *   ╰╮  Page size        the rail bends with an S-curve where the depth changes;
 *    │  The next page    the stretch of the entries whose sections are on screen is drawn again
 *   ╭╯ Walking …         on top, with one dash that grows, shrinks and glides as the page scrolls
 *
 * The rail runs at x = 0.75rem × depth, the bends take the first 0.75rem of the entry they lead into
 * (the link padding in portal-theme.css leaves room). A section runs from its heading to the next one;
 * with none on screen (in the footer), the dash follows Starlight's aria-current. The mobile dropdown
 * (<mobile-starlight-toc>) has no rail.
 */
import Default from '@astrojs/starlight/components/TableOfContents.astro';
---

<Default />

<script>
  const SVG = 'http://www.w3.org/2000/svg';
  const STEP_REM = 0.75; // matches the link padding in portal-theme.css

  function drawRail(nav: HTMLElement) {
    const list = nav.querySelector(':scope > ul');
    if (!list) return;
    const svg = document.createElementNS(SVG, 'svg');
    svg.setAttribute('aria-hidden', 'true');
    svg.classList.add('portal-toc-rail');
    const track = document.createElementNS(SVG, 'path');
    const marker = document.createElementNS(SVG, 'path');
    track.classList.add('track');
    marker.classList.add('marker');
    svg.append(track, marker);
    nav.append(svg);
    const links = [...list.querySelectorAll('a')];
    const headings = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
    const content = document.querySelector('.sl-markdown-content');
    let spans: { start: number; end: number }[] = [];

    const depthOf = (a: Element) => {
      let depth = 0;
      for (let el = a.parentElement?.parentElement; el && el !== list; el = el.parentElement) if (el.tagName === 'UL') depth++;
      return depth;
    };

    const layout = () => {
      const box = nav.getBoundingClientRect();
      if (!box.height) return;
      const step = STEP_REM * parseFloat(getComputedStyle(document.documentElement).fontSize);
      let d = '';
      let lastX: number | undefined;
      spans = links.map((a) => {
        const r = a.getBoundingClientRect();
        const x = step * depthOf(a) + 0.5;
        const top = r.top - box.top;
        const bottom = r.bottom - box.top;
        if (lastX === undefined) d = `M${x} ${top}`;
        const start = measure(d);
        if (lastX !== undefined && lastX !== x) {
          const mid = top + step / 2;
          d += `L${lastX} ${top}C${lastX} ${mid} ${x} ${mid} ${x} ${top + step}`;
        }
        d += `L${x} ${bottom}`;
        lastX = x;
        return { start, end: measure(d) };
      });
      track.setAttribute('d', d);
      marker.setAttribute('d', d);
      highlight();
    };

    // Path length up to here, measured on the marker path (it is redrawn right after).
    const measure = (d: string) => {
      marker.setAttribute('d', d);
      return marker.getTotalLength();
    };

    // Indexes of the first and last entries whose sections overlap the view below the header.
    const inView = () => {
      const viewTop = document.querySelector('header')?.getBoundingClientRect().bottom ?? 0;
      const tops = headings.map((h) => h?.getBoundingClientRect().top ?? NaN);
      const end = content?.getBoundingClientRect().bottom ?? Infinity;
      const visible = tops.flatMap((top, i) => {
        const next = tops.slice(i + 1).find((t) => !Number.isNaN(t)) ?? end;
        return top < innerHeight && next > viewTop ? [i] : [];
      });
      if (visible.length) return [visible[0], visible.at(-1)!];
      const current = links.findIndex((a) => a.getAttribute('aria-current') === 'true');
      return current < 0 ? [] : [current, current];
    };

    const highlight = () => {
      const [first, last] = inView();
      const total = spans.at(-1)?.end ?? 0;
      const from = spans[first!]?.start;
      const to = spans[last!]?.end;
      marker.style.strokeDasharray = from === undefined || to === undefined ? `0 ${total} 0 ${total}` : `0 ${from} ${to - from} ${total}`;
    };

    layout();
    new ResizeObserver(layout).observe(list);
    new MutationObserver(highlight).observe(list, { subtree: true, attributeFilter: ['aria-current'] });
    let frame = 0;
    addEventListener('scroll', () => (frame ||= requestAnimationFrame(() => ((frame = 0), highlight()))), { passive: true });
    // Glide only after the first paint, so the marker does not grow in on page load.
    requestAnimationFrame(() => requestAnimationFrame(() => svg.classList.add('ready')));
  }

  document.querySelectorAll<HTMLElement>('starlight-toc nav').forEach(drawRail);
</script>
