---
/**
 * Starlight's SidebarSublist, drawn in the three levels of RapiDoc's sidebar (the API pages' sidebar
 * looks the same):
 * 1. A top-level group is a section label: small upper-case text, not a link. It stays open, except a
 *    group with `collapsed: true`, whose label gets an arrow.
 * 2. Its entries are rows with the entry's configured `icon` (set by route-middleware.js); a group here
 *    opens and closes with an arrow.
 * 3. Deeper entries are compact rows under a guide line, without icons; the current page is ticked on it.
 * The current page is a filled block; a group that holds it shows its icon in the accent color. A link to
 * another site opens in a new tab with an arrow after its label, as in the header's menus. Groups that open
 * and close are `<details>` with Starlight's restore points, so SidebarPersister keeps working.
 */
import { Badge, Icon as StarlightIcon } from '@astrojs/starlight/components';
import SidebarRestorePoint from '@astrojs/starlight/components/SidebarRestorePoint.astro';
import Icon from './Icon.astro';
import { externalAttrs, isExternal } from '../config/links.js';

interface Props {
  sublist: any[];
  depth?: number;
}

const { sublist, depth = 0 } = Astro.props;

const hasCurrent = (entries: any[]): boolean =>
  entries.some((entry) => (entry.type === 'link' ? entry.isCurrent : hasCurrent(entry.entries)));
// Icons only on the second level (and on top-level links, which sit on it)
const showIcon = (entry: any) => Boolean(entry.icon) && depth <= 1;
---

<ul class:list={['portal-sidebar-list', `depth-${Math.min(depth, 2)}`, { 'top-level': depth === 0 }]}>
  {
    sublist.map((entry) =>
      entry.type === 'link' ? (
        <li>
          <a
            href={entry.href}
            aria-current={entry.isCurrent ? 'page' : undefined}
            class:list={['portal-sidebar-row', entry.attrs.class]}
            {...externalAttrs(entry.href)}
            {...entry.attrs}
          >
            {showIcon(entry) && <Icon name={entry.icon} size={16} weight="regular" class="portal-sidebar-icon" />}
            <span class="portal-sidebar-text">{entry.label}</span>
            {isExternal(entry.href) && <Icon name="arrow-up-right" size={14} class="portal-sidebar-external" />}
            {entry.badge && <Badge variant={entry.badge.variant} class={entry.badge.class} text={entry.badge.text} />}
          </a>
        </li>
      ) : depth === 0 && !entry.collapsed ? (
        <li class="portal-sidebar-section">
          <p class="portal-sidebar-label">
            <span class="portal-sidebar-text">{entry.label}</span>
            {entry.badge && <Badge variant={entry.badge.variant} class={entry.badge.class} text={entry.badge.text} />}
          </p>
          <Astro.self sublist={entry.entries} depth={1} />
        </li>
      ) : (
        <li class:list={{ 'portal-sidebar-section': depth === 0 }}>
          <details open={hasCurrent(entry.entries) || !entry.collapsed}>
            <summary class:list={[depth === 0 ? 'portal-sidebar-label' : 'portal-sidebar-row', { 'has-current': hasCurrent(entry.entries) }]}>
              {depth > 0 && showIcon(entry) && <Icon name={entry.icon} size={16} weight="regular" class="portal-sidebar-icon" />}
              <span class="portal-sidebar-text">{entry.label}</span>
              {entry.badge && <Badge variant={entry.badge.variant} class={entry.badge.class} text={entry.badge.text} />}
              <StarlightIcon name="right-caret" class="caret" size="1.125rem" />
            </summary>
            <SidebarRestorePoint />
            <Astro.self sublist={entry.entries} depth={depth + 1} />
          </details>
        </li>
      ),
    )
  }
</ul>

<style>
  @layer starlight.core {
    .portal-sidebar-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    li {
      overflow-wrap: anywhere;
    }

    /* Level 1: section labels */
    .portal-sidebar-section + .portal-sidebar-section,
    li + .portal-sidebar-section {
      margin-top: 1.375rem;
    }
    .portal-sidebar-label {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      margin: 0;
      padding: 0 0.625rem 0.375rem;
      font-size: 0.6875rem;
      font-weight: 650;
      line-height: 1.4;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--portal-muted);
    }
    summary.portal-sidebar-label {
      cursor: pointer;
      user-select: none;
    }
    summary.portal-sidebar-label:hover {
      color: var(--portal-fg);
    }
    summary.portal-sidebar-label.has-current:not(:has(+ * + .portal-sidebar-list:hover)) {
      color: var(--portal-primary-text);
    }

    /* Every row: a link, or the summary of a group below the top level */
    .portal-sidebar-row {
      position: relative;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      min-height: 2.25rem;
      padding: 0.25rem 0.625rem;
      box-sizing: border-box;
      font-size: 0.875rem;
      font-weight: 400;
      line-height: 1.4;
      text-decoration: none;
      color: var(--portal-muted);
      border-radius: calc(var(--portal-radius) * 1.5);
      transition:
        color 0.15s ease,
        background-color 0.15s ease;
    }
    summary.portal-sidebar-row {
      cursor: pointer;
      user-select: none;
    }
    .portal-sidebar-row:hover {
      color: var(--portal-fg);
      background-color: var(--portal-hover-bg);
    }
    .portal-sidebar-text {
      flex: 1;
      min-width: 0;
    }

    /* Level 2 icons: faint, in the text color on hover, the accent on the current page and its group */
    .portal-sidebar-icon {
      flex-shrink: 0;
      color: color-mix(in srgb, var(--portal-muted) 75%, transparent);
      transition: color 0.15s ease;
    }
    .portal-sidebar-row:hover > .portal-sidebar-icon {
      color: var(--portal-fg);
    }
    .portal-sidebar-row[aria-current='page'] > .portal-sidebar-icon,
    .portal-sidebar-row.has-current > .portal-sidebar-icon {
      color: var(--portal-primary-text);
    }
    summary.portal-sidebar-row.has-current {
      color: var(--portal-fg);
    }

    /* The current page: a filled block */
    .portal-sidebar-row[aria-current='page'],
    .portal-sidebar-row[aria-current='page']:hover {
      color: var(--portal-fg);
      background-color: var(--portal-primary-tint);
      font-weight: 550;
    }

    /* Level 3 and deeper: under a guide line, tighter rows, the current page ticked on the line */
    .depth-2 {
      position: relative;
      margin-inline-start: 1.1875rem;
      padding-inline-start: 0.6875rem;
    }
    .depth-2 .depth-2 {
      margin-inline-start: 0.625rem;
    }
    .depth-2::before {
      content: '';
      position: absolute;
      inset-inline-start: 0;
      top: 2px;
      bottom: 2px;
      width: 1px;
      background: var(--sl-color-hairline-light);
    }
    .depth-2 .portal-sidebar-row {
      min-height: 1.875rem;
      gap: 0.5rem;
      border-radius: var(--portal-radius);
    }
    .depth-2 > li > .portal-sidebar-row[aria-current='page']::before {
      content: '';
      position: absolute;
      inset-inline-start: -0.6875rem;
      width: 1px;
      height: 1.125rem;
      background: var(--portal-primary);
    }

    /* A link to another site: a small arrow after the label, dimmed like the header menus' */
    .portal-sidebar-external {
      flex-shrink: 0;
      opacity: 0.6;
    }

    /* The arrow of a group that opens and closes */
    summary::marker,
    summary::-webkit-details-marker {
      display: none;
    }
    .caret {
      flex-shrink: 0;
      margin-inline-start: auto;
      opacity: 0.7;
      transition: transform 0.2s ease-in-out;
    }
    :global([dir='rtl']) .caret {
      transform: rotateZ(180deg);
    }
    [open] > summary .caret {
      transform: rotateZ(90deg);
    }

    /* Opening and closing a group slides its list (browsers with ::details-content; others switch). */
    details {
      interpolate-size: allow-keywords;
    }
    details::details-content {
      block-size: 0;
      overflow: hidden;
      transition:
        block-size 0.25s ease,
        content-visibility 0.25s allow-discrete;
    }
    details[open]::details-content {
      block-size: auto;
    }
    @media (prefers-reduced-motion: reduce) {
      details::details-content,
      .caret {
        transition: none;
      }
    }
  }
</style>
