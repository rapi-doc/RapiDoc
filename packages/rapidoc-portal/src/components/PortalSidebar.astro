---
/**
 * Starlight Sidebar override. On narrow screens the sidebar is the only menu, so the header tabs and links
 * are listed above the documentation navigation (hidden from 50rem, where the header shows them).
 * The navigation is Starlight's Sidebar with the portal's sublist (icons, one text size).
 */
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import PortalMobileNav from './PortalMobileNav.astro';
import PortalSidebarSublist from './PortalSidebarSublist.astro';

const { sidebar } = Astro.locals.starlightRoute;
---

<div class="portal-sidebar-header-links md:sl-hidden">
  <PortalMobileNav />
</div>
<SidebarPersister>
  <PortalSidebarSublist sublist={sidebar} />
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<style>
  .portal-sidebar-header-links {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--sl-color-hairline-shade);
  }
</style>
