---
interface Props {
  name?: string;
  size?: number;
  class?: string;
  color?: string;
}

const {
  name = 'zap',
  size = 20,
  class: className = '',
  color,
} = Astro.props;

// Normalizer: handles emojis or names like "satellite", "box", "zap", "rocket"
const normalized = (() => {
  const n = (name || '').toLowerCase().trim();
  if (n === '🛰️' || n.includes('satellit') || n.includes('track')) return 'satellite';
  if (n === '⚡' || n.includes('zap') || n.includes('warp') || n.includes('lightn') || n.includes('speed')) return 'zap';
  if (n === '📦' || n.includes('box') || n.includes('contain') || n.includes('pack')) return 'box';
  if (n === '🚀' || n.includes('rock') || n.includes('fleet') || n.includes('flight')) return 'rocket';
  if (n === '⊞' || n.includes('grid') || n.includes('catalog') || n.includes('api')) return 'grid';
  if (n.includes('browser') || n.includes('web') || n.includes('ui')) return 'browser';
  if (n.includes('eye') || n.includes('visual') || n.includes('inspect')) return 'eye';
  if (n.includes('access') || n.includes('a11y') || n.includes('person') || n.includes('user')) return 'accessibility';
  if (n.includes('ai') || n.includes('spark') || n.includes('star') || n.includes('intel')) return 'ai';
  if (n.includes('chart') || n.includes('analyt') || n.includes('metric')) return 'chart';
  if (n.includes('shield') || n.includes('secur') || n.includes('auth')) return 'shield';
  if (n.includes('server') || n.includes('cloud') || n.includes('infra')) return 'server';
  if (n.includes('term') || n.includes('cli') || n.includes('code')) return 'terminal';
  if (n.includes('doc') || n.includes('book') || n.includes('guide')) return 'book';
  if (n.includes('check') || n.includes('valid') || n.includes('test')) return 'check';
  if (n.includes('radar') || n.includes('tele') || n.includes('scope')) return 'radar';
  if (n.includes('flake') || n.includes('resilien') || n.includes('bug')) return 'flake';
  if (n.includes('work') || n.includes('flow') || n.includes('integ')) return 'workflow';
  return n || 'zap';
})();
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke={color || 'currentColor'}
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['dual-tone-icon', className]}
  aria-hidden="true"
>
  {normalized === 'satellite' && (
    <>
      <path d="M3.707 3.293a1 1 0 0 0-1.414 1.414l5.586 5.586a1 1 0 0 0 1.414-1.414z" />
      <path d="M6 10l-1.5 1.5a3.536 3.536 0 0 0 5 5l1.5-1.5" />
      <path d="M10 6l1.5-1.5a3.536 3.536 0 0 1 5 5l-1.5 1.5" />
      <path d="M12 12l3.5 3.5" />
      <path d="M14.5 17.5l2.5 2.5a2 2 0 0 0 2.828-2.828l-2.5-2.5" />
      <path d="M16 8l3-3" />
      <path d="M19 11l3-3" />
    </>
  )}

  {normalized === 'zap' && (
    <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
  )}

  {normalized === 'box' && (
    <>
      <path d="M12 3l8 4.5v9l-8 4.5-8-4.5v-9l8-4.5z" />
      <path d="M12 12l8-4.5" />
      <path d="M12 12v9" />
      <path d="M12 12l-8-4.5" />
    </>
  )}

  {normalized === 'rocket' && (
    <>
      <path d="M4 13a8 8 0 0 1 7 7 6 6 0 0 0 3-5 15 15 0 0 0 6-8 1 1 0 0 0-1-1 15 15 0 0 0-8 6 6 6 0 0 0-5 3z" />
      <path d="M7 14a6 6 0 0 0-3 6 6 6 0 0 0 6-3" />
      <circle cx="15" cy="9" r="1" />
    </>
  )}

  {normalized === 'grid' && (
    <>
      <rect x="3" y="3" width="7" height="7" rx="1.5" />
      <rect x="14" y="3" width="7" height="7" rx="1.5" />
      <rect x="3" y="14" width="7" height="7" rx="1.5" />
      <rect x="14" y="14" width="7" height="7" rx="1.5" />
    </>
  )}

  {normalized === 'browser' && (
    <>
      <rect x="3" y="4" width="18" height="16" rx="2" />
      <line x1="3" y1="9" x2="21" y2="9" />
      <line x1="7" y1="6.5" x2="7.01" y2="6.5" />
      <line x1="10" y1="6.5" x2="10.01" y2="6.5" />
    </>
  )}

  {normalized === 'eye' && (
    <>
      <circle cx="12" cy="12" r="2.5" />
      <path d="M22 12c-2.4-4-5.4-6-10-6S4.4 8 2 12c2.4 4 5.4 6 10 6s7.6-2 10-6z" />
    </>
  )}

  {normalized === 'accessibility' && (
    <>
      <circle cx="12" cy="5" r="1.75" />
      <path d="M4 10h16M12 10v11M8 21l4-5 4 5" />
    </>
  )}

  {normalized === 'ai' && (
    <>
      <path d="M12 3l1.5 5.5L19 10l-5.5 1.5L12 17l-1.5-5.5L5 10l5.5-1.5z" />
      <path d="M19 15l.75 2.25L22 18l-2.25.75L19 21l-.75-2.25L16 18l2.25-.75z" />
    </>
  )}

  {normalized === 'chart' && (
    <>
      <line x1="3" y1="20" x2="21" y2="20" />
      <polyline points="4 15 9 10 14 14 20 7" />
    </>
  )}

  {normalized === 'shield' && (
    <path d="M12 3a12 12 0 0 0 8.5 3A12 12 0 0 1 12 21 12 12 0 0 1 3.5 6 12 12 0 0 0 12 3z" />
  )}

  {normalized === 'server' && (
    <>
      <rect x="3" y="4" width="18" height="6" rx="2" />
      <rect x="3" y="14" width="18" height="6" rx="2" />
      <line x1="7" y1="7" x2="7.01" y2="7" />
      <line x1="7" y1="17" x2="7.01" y2="17" />
    </>
  )}

  {normalized === 'terminal' && (
    <>
      <polyline points="4 17 10 11 4 5" />
      <line x1="12" y1="19" x2="20" y2="19" />
    </>
  )}

  {normalized === 'book' && (
    <>
      <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
      <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
    </>
  )}

  {normalized === 'check' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <polyline points="9 12 11 14 15 10" />
    </>
  )}

  {normalized === 'radar' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <circle cx="12" cy="12" r="5" />
      <line x1="12" y1="3" x2="12" y2="12" />
      <line x1="12" y1="12" x2="18.36" y2="5.64" />
    </>
  )}

  {normalized === 'flake' && (
    <>
      <path d="M12 3v18M3 12h18M5.636 5.636l12.728 12.728M5.636 18.364L18.364 5.636" />
    </>
  )}

  {normalized === 'workflow' && (
    <>
      <rect x="3" y="3" width="6" height="6" rx="1.5" />
      <rect x="15" y="15" width="6" height="6" rx="1.5" />
      <path d="M6 9v3a3 3 0 0 0 3 3h6" />
    </>
  )}
</svg>
