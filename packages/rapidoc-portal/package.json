{
  "name": "@rapidoc/portal",
  "version": "0.1.3",
  "description": "Docs-as-code developer portal framework for OpenAPI and Markdoc with RapiDoc",
  "homepage": "https://portal.rapidocui.com",
  "bugs": {
    "url": "https://github.com/rapi-doc/RapiDoc/issues"
  },
  "license": "MIT",
  "author": "Mrinmoy Majumdar <mrin9@yahoo.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rapi-doc/RapiDoc.git",
    "directory": "packages/rapidoc-portal"
  },
  "files": [
    "src",
    "schema.json"
  ],
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./config": "./src/config/index.js",
    "./markdoc": "./src/markdoc/index.js",
    "./search": "./src/search/index.js",
    "./components": "./src/components/index.js",
    "./markdoc/astro": "./src/markdoc/astro-config.js",
    "./markdoc/components": "./src/markdoc/components.js",
    "./frontmatter": "./src/engine/frontmatter.js",
    "./schema.json": "./schema.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/**/*.test.js",
    "layout:baseline": "RAPIDOC_LAYOUT_OUT=tests/layout node --test tests/layout.test.js",
    "schema": "node scripts/generate-schema.js",
    "prepublishOnly": "npm run schema"
  },
  "dependencies": {
    "@astrojs/markdoc": "^2.1.2",
    "@astrojs/starlight": "^0.42.9",
    "@astrojs/starlight-markdoc": "^0.7.0",
    "@markdoc/markdoc": "^0.5.11",
    "@phosphor-icons/core": "^2.1.1",
    "@rapidoc/mcp": "^0.1.3",
    "@rapidoc/prerender": "^0.1.3",
    "astro": "^7.4.6",
    "github-slugger": "^2.0.0",
    "pagefind": "^1.6.0",
    "rapidoc": "^12.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "axe-core": "^4.14.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
