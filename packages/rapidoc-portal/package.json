{
  "name": "@rapidoc/portal",
  "version": "0.2.6",
  "description": "RapiDoc Portal: a docs-as-code developer portal from OpenAPI specs and Markdown or Markdoc guides, with search, Arazzo workflows, llms.txt, MCP and optional single sign-on",
  "keywords": [
    "api-catalog",
    "api-documentation",
    "api-portal",
    "api-reference",
    "arazzo",
    "astro",
    "developer-portal",
    "docs-as-code",
    "llms-txt",
    "markdoc",
    "mcp",
    "openapi",
    "rapidoc",
    "sso",
    "swagger"
  ],
  "homepage": "https://portal.rapidocui.com",
  "bugs": {
    "url": "https://github.com/rapi-doc/RapiDoc/issues"
  },
  "license": "MIT",
  "author": "Mrinmoy Majumdar <mrin9@yahoo.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rapi-doc/RapiDoc.git",
    "directory": "packages/rapidoc-portal"
  },
  "files": [
    "src",
    "schema.json"
  ],
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./config": "./src/config/index.js",
    "./search": "./src/search/index.js",
    "./components": "./src/components/index.js",
    "./components/PortalHead.astro": "./src/components/PortalHead.astro",
    "./components/PortalPageHeader.astro": "./src/components/PortalPageHeader.astro",
    "./components/PortalPageFooter.astro": "./src/components/PortalPageFooter.astro",
    "./internal/markdoc-config": "./src/markdoc/astro-config.js",
    "./internal/markdoc-components": "./src/markdoc/components.js",
    "./internal/frontmatter": "./src/engine/frontmatter.js",
    "./schema.json": "./schema.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/**/*.test.js",
    "layout:baseline": "RAPIDOC_LAYOUT_OUT=tests/layout node --test tests/layout.test.js",
    "schema": "node scripts/generate-schema.js",
    "prepublishOnly": "npm run schema"
  },
  "dependencies": {
    "@astrojs/markdoc": "^2.1.2",
    "@astrojs/starlight": "^0.42.10",
    "@astrojs/starlight-markdoc": "^0.7.0",
    "@markdoc/markdoc": "^0.5.11",
    "@phosphor-icons/core": "^2.1.1",
    "@rapidoc/mcp": "^0.2.6",
    "@rapidoc/prerender": "^0.2.6",
    "astro": "^7.4.6",
    "github-slugger": "^2.0.0",
    "pagefind": "^1.6.0",
    "rapidoc": "^14.2.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "axe-core": "^4.14.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
