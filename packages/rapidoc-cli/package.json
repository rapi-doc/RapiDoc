{
  "name": "@rapidoc/cli",
  "version": "1.0.0",
  "description": "RapiDoc CLI: the rapidoc command to build developer portals and to preview, validate, lint, bundle, mock and export OpenAPI specs as PDFs and MCP servers",
  "keywords": [
    "arazzo",
    "cli",
    "developer-portal",
    "mcp",
    "mock-server",
    "openapi",
    "openapi-bundler",
    "openapi-linter",
    "openapi-validator",
    "rapidoc",
    "swagger"
  ],
  "homepage": "https://portal.rapidocui.com",
  "bugs": {
    "url": "https://github.com/rapi-doc/RapiDoc/issues"
  },
  "license": "MIT",
  "author": "Mrinmoy Majumdar <mrin9@yahoo.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rapi-doc/RapiDoc.git",
    "directory": "packages/rapidoc-cli"
  },
  "bin": {
    "rapidoc": "src/index.js"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@rapidoc/mcp": "^1.0.0",
    "@scalar/openapi-validator": "^0.1.18",
    "create-rapidoc": "^1.0.0",
    "rapidoc": "^15.0.0",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@rapidoc/mock": "^1.0.0",
    "@rapidoc/portal": "^1.0.0",
    "@rapidoc/server": "^1.0.0",
    "rapipdf": "^3.0.1"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "@rapidoc/mock": {
      "optional": true
    },
    "@rapidoc/portal": {
      "optional": true
    },
    "@rapidoc/server": {
      "optional": true
    },
    "rapipdf": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
