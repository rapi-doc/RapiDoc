  "scripts": {
    "start": "node src/index.js",
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@rapidoc/mcp": "^0.1.0",
    "@scalar/openapi-validator": "^0.1.18",
