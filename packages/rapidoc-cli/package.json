{
  "name": "@rapidoc/cli",
  "version": "0.1.0",
  "description": "The rapidoc command: developer portal dev/build/serve/init, OpenAPI validation and config migration",
  "type": "module",
  "bin": {
    "rapidoc": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "@scalar/openapi-parser": "^0.29.13",
    "create-rapidoc": "^0.1.0"
  },
  "peerDependencies": {
    "@rapidoc/mock": "^0.1.0",
    "@rapidoc/portal": "^0.1.0",
    "@rapidoc/server": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@rapidoc/mock": {
      "optional": true
    },
    "@rapidoc/portal": {
      "optional": true
    },
    "@rapidoc/server": {
      "optional": true
    }
  }
}
