{
  "name": "@rapidoc/starlight",
  "version": "0.1.0",
  "description": "RapiDoc for Starlight: OpenAPI reference pages inside your Starlight docs, with the operations in the sidebar",
  "keywords": [
    "api documentation",
    "astro",
    "openapi",
    "rapidoc",
    "rapidoc-integration",
    "starlight",
    "starlight-plugin"
  ],
  "homepage": "https://rapidocui.com",
  "bugs": {
    "url": "https://github.com/rapi-doc/RapiDoc/issues"
  },
  "license": "MIT",
  "author": "Mrinmoy Majumdar <mrin9@yahoo.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rapi-doc/RapiDoc.git",
    "directory": "packages/rapidoc-starlight"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "@rapidoc/embed": "^0.1.0",
    "@rapidoc/prerender": "^0.1.5",
    "rapidoc": "^12.2.0",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@astrojs/starlight": ">=0.32.0",
    "astro": ">=5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
