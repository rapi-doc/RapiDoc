{
  "description": "An inline spec whose keys a JSON writer may reorder (JavaScript writes 200 and 404 before default) and with numbers it may write differently (1.0 or 1). The inline spec is compared as parsed JSON; the rest of the page byte for byte.",
  "page": "host",
  "options": {
    "spec": {
      "openapi": "3.1.0",
      "info": {
        "title": "Pets",
        "version": "1.0.0"
      },
