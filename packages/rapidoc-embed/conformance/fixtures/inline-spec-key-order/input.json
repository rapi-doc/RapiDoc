                  "type": "number",
                  "minimum": 1.0,
                  "maximum": 99.5,
                  "multipleOf": 0.5
                }
              }
            ],
            "responses": {
              "default": {
                "description": "Error"
              },
              "404": {
                "description": "Not found"
              },
              "200": {
                "description": "A pet"
              }
            }
          }
        }
      }
    }
  }
}
