{
  "name": "rapidoc",
  "version": "12.2.0",
  "description": "RapiDoc - Open API spec viewer with built in console",
  "keywords": [
    "API",
    "Custom Element",
    "JSON-Schema",
    "Mock Server",
    "OpenAPI",
    "OpenAPI Specification",
    "REST",
    "Web Component",
    "documentation",
    "openapi explorer",
    "openapi parser",
    "openapi preview",
    "openapi renderer",
    "openapi themes",
    "openapi ui",
    "openapi viewer",
    "rapidoc",
    "redoc",
    "scalar",
    "swagger",
    "swagger ui"
  ],
  "homepage": "https://rapidocui.com",
  "bugs": {
    "url": "https://github.com/rapi-doc/RapiDoc/issues"
  },
  "license": "MIT",
  "author": "Mrinmoy Majumdar <mrin9@yahoo.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rapi-doc/RapiDoc.git",
    "directory": "packages/rapidoc"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "dist/rapidoc-min.js",
  "module": "dist/rapidoc-min.js",
  "types": "dist/rapidoc.d.ts",
  "exports": {
    ".": {
      "types": "./dist/rapidoc.d.ts",
      "browser": "./dist/rapidoc-min.js",
      "default": "./dist/rapidoc-min.js"
    },
    "./flow": {
      "types": "./dist/flow.d.ts",
      "browser": "./dist/rapidoc-flow-min.js",
      "default": "./dist/rapidoc-flow-min.js"
    },
    "./react": {
      "types": "./dist/react.d.ts"
    },
    "./vue": {
      "types": "./dist/vue.d.ts"
    },
    "./integration.json": "./dist/integration.json",
    "./options.schema.json": "./dist/rapidoc-options.schema.json",
    "./custom-elements.json": "./dist/custom-elements.json"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.config.flow.mjs && node ../../scripts/capture-build-info.js",
    "build:client": "vite build",
    "build:flow": "vite build --config vite.config.flow.mjs",
    "build:dev": "vite build --mode development",
    "build:size": "ANALYZE=true vite build",
    "lint": "oxlint --deny-warnings src",
    "format": "oxfmt --check src",
    "format-fix": "oxfmt src",
    "test": "node --import ../../scripts/test-loader.mjs --test ../../tests/unit/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@lit-labs/rollup-plugin-minify-html-literals": "^0.2.0",
    "@scalar/openapi-parser": "^0.29.20",
    "esbuild": "^0.28.2",
    "github-slugger": "^2.0.0",
    "lit": "^3.3.3",
    "marked": "^18.1.3",
    "microlighter": "^2.2.0",
    "rollup-plugin-visualizer": "^7.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vite-plugin-banner": "^0.8.1",
    "yaml": "^2.9.1"
  },
  "customElements": "dist/custom-elements.json"
}
