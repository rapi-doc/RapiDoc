{
  "name": "rapidoc",
  "version": "12.0.0",
  "description": "RapiDoc - Open API spec viewer with built in console",
  "author": "Mrinmoy Majumdar <mrin9@yahoo.com>",
  "homepage": "https://rapidocui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rapi-doc/RapiDoc.git"
  },
  "license": "MIT",
  "keywords": [
    "OpenAPI",
    "OpenAPI Specification",
    "JSON-Schema",
    "API",
    "REST",
    "documentation",
    "Custom Element",
    "Web Component",
    "rapidoc",
    "redoc",
    "scalar",
    "swagger",
    "swagger ui",
    "openapi ui",
    "openapi themes",
    "openapi viewer",
    "openapi renderer",
    "openapi explorer",
    "openapi parser",
    "openapi preview",
    "Mock Server"
  ],
  "type": "module",
  "main": "dist/rapidoc-min.js",
  "module": "dist/rapidoc-min.js",
  "exports": {
    ".": {
      "browser": "./dist/rapidoc-min.js",
      "default": "./dist/rapidoc-min.js"
    },
    "./static": {
      "import": "./dist/rapidoc-static-min.js",
      "types": "./src/static/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.config.static.mjs",
    "build:client": "vite build",
    "build:static": "vite build --config vite.config.static.mjs",
    "build:dev": "vite build --mode development",
    "build:size": "ANALYZE=true vite build",
    "lint": "eslint './src/**/*.{js,ts}'",
    "format": "prettier --check './src/**/*.{js,ts,html,css}'",
    "format-fix": "prettier --write './src/**/*.{js,ts,html,css}'",
    "analyze": "lit-analyzer src",
    "test": "node --import ../../scripts/test-loader.mjs --test ../../tests/unit/*.test.js"
  },
  "dependencies": {
    "@scalar/openapi-parser": "^0.29.18",
    "github-slugger": "^2.0.0",
    "lit": "^3.3.3",
    "marked": "^18.1.2",
    "microlighter": "^2.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@lit-labs/rollup-plugin-minify-html-literals": "^0.2.0",
    "esbuild": "^0.28.2",
    "rollup-plugin-visualizer": "^7.1.1",
    "vite": "^8.3.5",
    "vite-plugin-banner": "^0.8.1"
  }
}