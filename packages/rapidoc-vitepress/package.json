{
  "name": "@rapidoc/vitepress",
  "version": "0.1.2",
  "description": "RapiDoc for VitePress: OpenAPI reference pages inside your VitePress site, with the operations in the sidebar",
  "keywords": [
    "api documentation",
    "openapi",
    "rapidoc",
    "rapidoc-integration",
    "vitepress",
    "vitepress-plugin"
  ],
  "homepage": "https://rapidocui.com",
  "bugs": {
    "url": "https://github.com/rapi-doc/RapiDoc/issues"
  },
  "license": "MIT",
  "author": "Mrinmoy Majumdar <mrin9@yahoo.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rapi-doc/RapiDoc.git",
    "directory": "packages/rapidoc-vitepress"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./client": {
      "types": "./src/client.d.ts",
      "default": "./src/client.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "@rapidoc/embed": "^0.3.1",
    "@rapidoc/prerender": "^0.2.0",
    "rapidoc": "^13.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "vitepress": "2.0.0-alpha.21"
  },
  "peerDependencies": {
    "vitepress": ">=1.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
