{
  "name": "@rapidoc/prerender",
  "version": "0.1.6",
  "description": "Renders RapiDoc API documentation to HTML at build time: pre-rendered <rapi-doc> (Declarative Shadow DOM or light DOM), sidebar navigation, Arazzo diagrams",
  "keywords": [
    "api-documentation",
    "declarative-shadow-dom",
    "openapi",
    "rapidoc",
    "ssg",
    "ssr",
    "static-site"
  ],
  "homepage": "https://rapidocui.com",
  "bugs": {
    "url": "https://github.com/rapi-doc/RapiDoc/issues"
  },
  "license": "MIT",
  "author": "Mrinmoy Majumdar <mrin9@yahoo.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rapi-doc/RapiDoc.git",
    "directory": "packages/rapidoc-prerender"
  },
  "files": [
    "dist",
    "src/index.d.ts"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && node ../../scripts/capture-build-info.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@scalar/openapi-parser": "^0.29.20",
    "github-slugger": "^2.0.0",
    "lit": "^3.3.3",
    "marked": "^18.1.3",
    "microlighter": "^2.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "vite": "^8.3.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
