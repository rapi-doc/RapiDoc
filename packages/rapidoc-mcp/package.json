{
  "name": "@rapidoc/mcp",
  "version": "0.2.0",
  "description": "Turns OpenAPI and Arazzo documents into MCP tools: manifest builder, runtime and MCP server project writer for Node",
  "keywords": [
    "arazzo",
    "mcp",
    "model-context-protocol",
    "openapi",
    "rapidoc"
  ],
  "homepage": "https://rapidocui.com",
  "bugs": {
    "url": "https://github.com/rapi-doc/RapiDoc/issues"
  },
  "license": "MIT",
  "author": "Mrinmoy Majumdar <mrin9@yahoo.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rapi-doc/RapiDoc.git",
    "directory": "packages/rapidoc-mcp"
  },
  "files": [
    "dist",
    "src/index.d.ts"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && node ../../scripts/capture-build-info.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "vite": "^8.3.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
