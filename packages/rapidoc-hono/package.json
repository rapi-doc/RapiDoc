{
  "name": "@rapidoc/hono",
  "version": "0.0.0",
  "description": "RapiDoc for Hono: serves an interactive OpenAPI reference (<rapi-doc>) from your Hono app",
  "keywords": [
    "api documentation",
    "hono",
    "middleware",
    "openapi",
    "rapidoc",
    "swagger ui"
  ],
  "homepage": "https://rapidocui.com",
  "bugs": {
    "url": "https://github.com/rapi-doc/RapiDoc/issues"
  },
  "license": "MIT",
  "author": "Mrinmoy Majumdar <mrin9@yahoo.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rapi-doc/RapiDoc.git",
    "directory": "packages/rapidoc-hono"
  },
  "files": [
    "src",
    "examples"
  ],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./edge": {
      "types": "./src/edge.d.ts",
      "default": "./src/edge.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "@rapidoc/embed": "^0.0.0"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16"
  },
  "peerDependencies": {
    "hono": ">=4.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
