{
  "name": "@rapidoc/express",
  "version": "0.1.1",
  "description": "RapiDoc for Express: serves an interactive OpenAPI reference (<rapi-doc>) from your Express app",
  "keywords": [
    "api documentation",
    "express",
    "middleware",
    "openapi",
    "rapidoc",
    "rapidoc-integration",
    "swagger ui"
  ],
  "homepage": "https://rapidocui.com",
  "bugs": {
    "url": "https://github.com/rapi-doc/RapiDoc/issues"
  },
  "license": "MIT",
  "author": "Mrinmoy Majumdar <mrin9@yahoo.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rapi-doc/RapiDoc.git",
    "directory": "packages/rapidoc-express"
  },
  "files": [
    "src",
    "examples"
  ],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "@rapidoc/embed": "^0.3.0"
  },
  "devDependencies": {
    "express": "^5.3.0"
  },
  "peerDependencies": {
    "express": ">=4.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
