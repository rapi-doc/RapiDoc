---
import GoogleAnalytics from '../components/GoogleAnalytics.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'RapiDoc Example',
  description = 'Interactive OpenAPI 3.0 & 3.1 Spec Documentation Example using RapiDoc',
} = Astro.props;

const pageTitle = title.includes('RapiDoc') ? title : `${title} | RapiDoc`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <GoogleAnalytics title={pageTitle} />
    <script is:inline type="module" src="/rapidoc/rapidoc-min.js"></script>
  </head>
  <body>
    <slot />
  </body>
</html>