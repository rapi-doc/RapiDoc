---
import ExampleLayout from './ExampleLayout.astro';
import type { ControllerPreset } from '../components/controller-registry';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  specUrl?: string;
  preset?: ControllerPreset[] | ControllerPreset;
  controls?: string[];
  rapidocProps?: Record<string, any>;
  autoRenderRapiDoc?: boolean;
  tuckedRight?: boolean;
  controllerTitle?: string;
  showController?: boolean;
  controllerSize?: 'small' | 'medium' | 'large' | (string & {}) | number;
  showMethods?: boolean;
  showSlots?: boolean;
  controller?: 'default' | 'pretty' | 'hud' | 'drawer' | ((_props: any) => any);
}

const {
  title,
  description,
  noindex,
  specUrl,
  preset = ['auto'],
  controls,
  rapidocProps = {},
  autoRenderRapiDoc = true,
  tuckedRight,
  controllerTitle,
  showController = true,
  controllerSize,
  showMethods,
  showSlots,
  controller,
} = Astro.props;
---

<ExampleLayout
  title={title}
  description={description}
  noindex={noindex}
  specUrl={specUrl}
  preset={preset}
  controls={controls}
  rapidocProps={rapidocProps}
  autoRenderRapiDoc={autoRenderRapiDoc}
  tuckedRight={tuckedRight}
  controllerTitle={controllerTitle}
  showController={showController}
  controllerSize={controllerSize}
  showMethods={showMethods}
  showSlots={showSlots}
  controller={controller}
>
  <slot name="head" slot="head" />
  <slot name="script" slot="script" />
  <slot name="controller" slot="controller" />
  <slot />
</ExampleLayout>
