---
import { stylingData } from '../page-data/styling-data';

interface Props {
  category?: string;
  showHeader?: boolean;
}

const { category, showHeader = true } = Astro.props;

const categories = category
  ? stylingData.variables.filter(c => c.category.toLowerCase() === category.toLowerCase())
  : stylingData.variables;
---

<div class="rd-catalog-wrapper not-content">
  {categories.map(cat => (
    <div class="rd-catalog-section" id={`var-cat-${cat.category.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
      {showHeader && (
        <div class="rd-cat-header">
          <h3 class="rd-cat-title">{cat.category}</h3>
          <p class="rd-cat-desc">{cat.description}</p>
        </div>
      )}
      <div class="rd-table-container">
        <table class="rd-catalog-table">
          <thead>
            <tr>
              <th class="col-name">CSS Custom Property</th>
              <th class="col-default">Default / Calculated Value</th>
              <th class="col-desc">Description</th>
            </tr>
          </thead>
          <tbody>
            {cat.items.map(item => (
              <tr>
                <td class="col-name">
                  <code class="var-pill">{item.name}</code>
                </td>
                <td class="col-default">
                  <code class="default-pill">{item.default}</code>
                </td>
                <td class="col-desc">
                  <Fragment set:html={item.description} />
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  ))}
</div>

<style>
.rd-catalog-wrapper {
  display: flex;
  flex-direction: column;
  gap: 32px;
  margin: 24px 0;
  width: 100%;
}

.rd-cat-header {
  margin-bottom: 12px;
}

.rd-cat-title {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--rd-text-primary);
  margin: 0 0 6px 0;
  letter-spacing: -0.01em;
}

.rd-cat-desc {
  font-size: 0.9rem;
  color: var(--rd-text-muted);
  margin: 0;
}

.rd-table-container {
  width: 100%;
  overflow-x: auto;
  border: 1px solid var(--rd-border);
  border-radius: var(--rd-radius-md);
  background: var(--rd-surface-card);
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
  backdrop-filter: blur(8px);
}

.rd-catalog-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  font-size: 13.5px;
}

.rd-catalog-table th {
  background: var(--rd-wash);
  padding: 12px 18px;
  color: var(--rd-text-soft);
  font-weight: 600;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  border-bottom: 1px solid var(--rd-border);
  white-space: nowrap;
}

.rd-catalog-table td {
  padding: 14px 18px;
  vertical-align: middle;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  color: var(--rd-text-muted);
  line-height: 1.5;
}

.rd-catalog-table tr:last-child td {
  border-bottom: none;
}

.rd-catalog-table tr:hover td {
  background: rgba(255, 255, 255, 0.02);
}

.col-name {
  width: 32%;
  min-width: 220px;
}

.col-default {
  width: 28%;
  min-width: 180px;
}

.col-desc {
  width: 40%;
  min-width: 240px;
  color: var(--rd-text-soft);
}

.col-desc a {
  color: var(--rd-sky);
  text-decoration: underline;
  text-underline-offset: 2px;
}

.col-desc a:hover {
  color: var(--rd-sky-light);
}

.var-pill {
  font-family: var(--rd-font-mono);
  font-size: 12.5px;
  color: var(--rd-accent-light);
  background: color-mix(in srgb, var(--rd-accent) 10%, transparent);
  border: 1px solid color-mix(in srgb, var(--rd-accent) 25%, transparent);
  border-radius: var(--rd-radius-sm);
  padding: 3px 8px;
  display: inline-block;
  white-space: nowrap;
}

.default-pill {
  font-family: var(--rd-font-mono);
  font-size: 11.5px;
  color: var(--rd-text);
  background: var(--rd-wash);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: var(--rd-radius-sm);
  padding: 2px 7px;
  display: inline-block;
  word-break: break-all;
}

@media (max-width: 640px) {
  .rd-catalog-table th,
  .rd-catalog-table td {
    padding: 10px 12px;
    font-size: 12.5px;
  }
}
</style>
