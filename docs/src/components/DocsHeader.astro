---
import SiteNavbar from './SiteNavbar.astro';
import Search from 'virtual:starlight/components/Search';
import config from 'virtual:starlight/user-config';

const shouldRenderSearch =
  config.pagefind || config.components?.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="rd-docs-header-wrapper">
  <SiteNavbar activePage="docs">
    {shouldRenderSearch && (
      <div slot="search" class="rd-starlight-search-container">
        <Search />
      </div>
    )}
  </SiteNavbar>
</div>

<style>
  .rd-docs-header-wrapper {
    width: 100%;
  }
  .rd-starlight-search-container {
    display: flex;
    align-items: center;
  }
  /* The search button, in the docs theme's colors (styles/starlight-custom.css) */
  .rd-starlight-search-container :global(button[data-open-modal]) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border-radius: var(--rd-radius, 6px);
    font-size: 13px;
    font-weight: 500;
    color: var(--rd-docs-muted, #94a3b8);
    background: var(--rd-docs-hover-bg, rgba(255, 255, 255, 0.04));
    border: 1px solid var(--rd-docs-border, rgba(255, 255, 255, 0.08));
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .rd-starlight-search-container :global(button[data-open-modal]:hover) {
    color: var(--sl-color-white, #fff);
    border-color: color-mix(in oklab, var(--rd-docs-border, #475569) 60%, var(--rd-docs-fg, #ccc));
  }
  .rd-starlight-search-container :global(kbd) {
    font-size: 10px;
    padding: 2px 5px;
    border-radius: 4px;
    background: var(--sl-color-bg-inline-code, rgba(255, 255, 255, 0.08));
    border: 1px solid var(--rd-docs-border, rgba(255, 255, 255, 0.12));
    color: var(--rd-docs-fg, #cbd5e1);
    font-family: var(--sl-font-mono, monospace);
  }
</style>
