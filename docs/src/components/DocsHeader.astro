---
import SiteNavbar from './SiteNavbar.astro';
import Search from 'virtual:starlight/components/Search';
import config from 'virtual:starlight/user-config';

const shouldRenderSearch =
  config.pagefind || config.components?.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="rd-docs-header-wrapper">
  <SiteNavbar activePage="docs">
    {shouldRenderSearch && (
      <div slot="search" class="rd-starlight-search-container">
        <Search />
      </div>
    )}
  </SiteNavbar>
</div>

<style>
  .rd-docs-header-wrapper {
    width: 100%;
  }
  .rd-starlight-search-container {
    display: flex;
    align-items: center;
    width: 100%;
    justify-content: flex-end;
  }
  /* From 1000px the search box fills the navbar's search slot (SiteNavbar); below, an icon only */
  @media (min-width: 1000px) {
    .rd-starlight-search-container :global(button[data-open-modal]) {
      width: 100%;
      justify-content: space-between;
    }
  }
  @media (max-width: 999px) {
    .rd-starlight-search-container :global(button[data-open-modal] > span),
    .rd-starlight-search-container :global(button[data-open-modal] kbd) {
      display: none;
    }
    .rd-starlight-search-container :global(button[data-open-modal]) {
      width: 36px;
      padding: 0;
      justify-content: center;
    }
  }
  /* The search button, in the docs theme's colors (styles/starlight-custom.css) */
  .rd-starlight-search-container :global(button[data-open-modal]) {
    box-sizing: border-box;
    height: 36px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 12px;
    border-radius: var(--rd-radius-sm);
    font-size: 13px;
    font-weight: 500;
    color: var(--rd-docs-muted);
    background: var(--rd-docs-hover-bg);
    border: 1px solid var(--rd-docs-border);
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .rd-starlight-search-container :global(button[data-open-modal]:hover) {
    color: var(--sl-color-white);
    border-color: color-mix(in oklab, var(--rd-docs-border) 60%, var(--rd-docs-fg));
  }
  .rd-starlight-search-container :global(kbd) {
    font-size: 10px;
    padding: 2px 5px;
    border-radius: var(--rd-radius-xs);
    background: var(--sl-color-bg-inline-code);
    border: 1px solid var(--rd-docs-border);
    color: var(--rd-docs-fg);
    font-family: var(--rd-font-mono);
  }
</style>
