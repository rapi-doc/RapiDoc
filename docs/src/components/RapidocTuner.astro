---
import {
  CONTROL_REGISTRY,
  CATEGORY_TITLES,
  PRESETS,
  TUNER_SECTIONS,
  resolveActiveControls,
  resolveActiveSlots,
  normalizePresets,
  groupControlsByCategory,
  type ControlOption,
  type ControlCategory,
  type SegmentedControl,
  type ToggleControl,
  type ControlDef,
  type ControllerPreset,
} from './controller-registry';
import {
  IconAdjustmentsHorizontal,
  IconFileCode,
  IconRotate,
  IconX,
  IconInfoCircle,
} from '@tabler/icons-astro';

export type { ControlOption, ControlCategory, SegmentedControl, ToggleControl, ControlDef, ControllerPreset };

interface Props {
  targetId?: string;
  preset?: ControllerPreset[] | ControllerPreset;
  controls?: string[];
  initialAttrs?: Record<string, string | boolean | number>;
  specUrl?: string;
  title?: string;
  subtitle?: string;
  showMethods?: boolean;
  showSlots?: boolean;
  defaultOpen?: boolean;
  size?: 'small' | 'medium' | 'large' | (string & {}) | number;
  showEdgeTab?: boolean;
}

const {
  targetId = 'thedoc',
  preset = ['minimal'],
  controls: propControls,
  initialAttrs = {},
  specUrl,
  title = 'Options',
  subtitle = 'RapiDoc properties',
  showMethods,
  showSlots,
  defaultOpen = false,
  size = 'medium',
  showEdgeTab = true,
} = Astro.props;

let baseFontSize = '13px';
if (size != null) {
  const s = String(size).trim();
  if (s === 'small') baseFontSize = '12px';
  else if (s === 'large') baseFontSize = '14px';
  else if (s === 'medium') baseFontSize = '13px';
  else if (/^\d+(\.\d+)?$/.test(s)) baseFontSize = `${s}px`;
  else if (s) baseFontSize = s;
}

// Determine active controls and slots
const normalizedPresetList = normalizePresets(preset);
const activeControls = resolveActiveControls(propControls, preset);
const groupedControls = groupControlsByCategory(activeControls);
const activeSlots = resolveActiveSlots(propControls, preset);

const effectiveShowMethods = showMethods !== undefined
  ? showMethods
  : (normalizedPresetList.includes('all') || normalizedPresetList.includes('demo'));

const effectiveShowSlots = showSlots !== undefined
  ? showSlots
  : (activeSlots.length > 0);

const slotsToRender = activeSlots.length > 0 ? activeSlots : ['nav-logo', 'fixed-header', 'default'];

// The sections in the tuner's order: attribute groups, plus the slot and method sections drawn below
type TunerSection =
  | { kind: 'group'; group: (typeof groupedControls)[number] }
  | { kind: 'slots' }
  | { kind: 'methods' };
const tunerSections: TunerSection[] = TUNER_SECTIONS.flatMap((name): TunerSection[] => {
  if (name === 'Slots') return [{ kind: 'slots' }];
  if (name === 'Methods & Actions') return [{ kind: 'methods' }];
  const group = groupedControls.find((g) => g.id === name);
  return group ? [{ kind: 'group', group }] : [];
});

// Black or white text, whichever contrasts more with a colour chip's background (WCAG relative luminance)
function textOn(hex: string): '#000' | '#fff' {
  const [r, g, b] = [1, 3, 5].map((i) => {
    const channel = parseInt(hex.slice(i, i + 2), 16) / 255;
    return channel <= 0.03928 ? channel / 12.92 : ((channel + 0.055) / 1.055) ** 2.4;
  });
  const luminance = 0.2126 * r + 0.7152 * g + 0.0722 * b;
  return 1.05 / (luminance + 0.05) >= (luminance + 0.05) / 0.05 ? '#fff' : '#000';
}

const initialAttrsJson = JSON.stringify(initialAttrs);
const instanceId = `rd-pretty-${targetId}-${Math.random().toString(36).slice(2, 7)}`;
---

<div
  class="rd-pretty-controller-root"
  id={instanceId}
  data-target={targetId}
  data-initial-attrs={initialAttrsJson}
  data-default-open={defaultOpen ? 'true' : 'false'}
  style={`--rd-ctrl-font-size: ${baseFontSize};`}
>
  <!-- Docked Right Edge Tab Button -->
  {
    showEdgeTab && (
      <button
        type="button"
        class="rd-pretty-edge-tab"
        aria-label="Open RapiDoc Options Drawer"
        title={`Open ${title} (Cmd+K)`}
      >
        <IconAdjustmentsHorizontal size={15} stroke={2.2} aria-hidden="true" />
        <span class="rd-tab-label">{title}</span>
      </button>
    )
  }

  <!-- Modern Overlapping Layer Drawer with Frosted Glass -->
  <aside class="rd-pretty-drawer" aria-label={title} aria-hidden="true">
    <div class="rd-pretty-wrapper">
      <!-- Section Header -->
      <div class="rd-pretty-header">
        <div class="rd-pretty-title-wrap">
          <div>
            <div class="rd-title-with-badge">
              <h3 class="rd-pretty-title">{title}</h3>
            </div>
            {subtitle && <p class="rd-pretty-subtitle">{subtitle}</p>}
          </div>
        </div>

        <div class="rd-pretty-header-actions">
          {specUrl && (
            <a
              href={specUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="rd-pretty-action-btn rd-pretty-spec-btn"
              title="Open active OpenAPI spec file"
            >
              <IconFileCode size={12} stroke={2.2} />
              <span>Spec</span>
            </a>
          )}

          <!-- Reset Button -->
          <button
            type="button"
            class="rd-pretty-action-btn rd-pretty-reset-btn"
            title="Reset all options to default"
          >
            <IconRotate size={13} stroke={2.2} />
            <span>Reset</span>
          </button>

          <!-- Close Drawer Button -->
          <button
            type="button"
            class="rd-pretty-action-btn rd-pretty-close-btn"
            aria-label="Close Controls Drawer"
            title="Close Drawer (Esc)"
          >
            <IconX size={15} stroke={2.2} />
          </button>
        </div>
      </div>

      <!-- Scrollable Drawer Body with Fluid Cards -->
      <div class="rd-pretty-body">
        {tunerSections.map(section => {
          if (section.kind === 'methods') {
            return effectiveShowMethods && (
              <div class="rd-pretty-category-section rd-pretty-methods-section" data-category="methods">
                <div class="rd-pretty-category-divider">
                  <span class="rd-pretty-category-tag">Methods & Actions</span>
                </div>

                <div class="rd-pretty-settings-list">
                  <!-- loadSpec -->
                  <div class="rd-option-card rd-option-card--multi" data-method="loadSpec">
                    <div class="rd-option-info">
                      <div class="rd-option-label">loadSpec(spec)</div>
                      <div class="rd-option-tip">Switch the active OpenAPI specification document</div>
                    </div>
                    <div class="rd-control-wrapper rd-chip-group">
                      <button
                        type="button"
                        class="rd-chip rd-method-spec-btn is-active"
                        data-spec-url="/specs/petstore.yaml"
                        title="loadSpec('/specs/petstore.yaml')"
                      >
                        <span class="chip-text">petstore.yaml</span>
                      </button>
                      <button
                        type="button"
                        class="rd-chip rd-method-spec-btn"
                        data-spec-url="/specs/open-api-3-1.yaml"
                        title="loadSpec('/specs/open-api-3-1.yaml')"
                      >
                        <span class="chip-text">open-api-3-1.yaml</span>
                      </button>
                    </div>
                  </div>

                  <!-- scrollTo -->
                  <div class="rd-option-card rd-option-card--multi" data-method="scrollTo">
                    <div class="rd-option-info">
                      <div class="rd-option-label">scrollToPath(path)</div>
                      <div class="rd-option-tip">Smoothly scroll to an endpoint or section ID</div>
                    </div>
                    <div class="rd-method-input-row">
                      <input
                        type="text"
                        class="rd-method-input rd-scroll-path-input"
                        value="get-/user/login"
                        placeholder="e.g. get-/user/login"
                        aria-label="Path to scroll to"
                        spellcheck="false"
                      />
                      <button type="button" class="rd-pretty-action-btn rd-scroll-exec-btn">
                        <span>Call</span>
                      </button>
                    </div>
                  </div>

                  <!-- downloadMcpServer -->
                  <div class="rd-option-card rd-option-card--multi" data-method="downloadMcpServer">
                    <div class="rd-option-info">
                      <div class="rd-option-label">downloadMcpServer()</div>
                      <div class="rd-option-tip">Download the MCP server project (manifest, runtime and stdio server) as a zip</div>
                    </div>
                    <button type="button" class="rd-pretty-action-btn rd-mcp-exec-btn" style="margin-left: auto;">
                      <span>Call</span>
                    </button>
                  </div>
                </div>
              </div>
            );
          }
          if (section.kind === 'slots') {
            return effectiveShowSlots && (
              <div class="rd-pretty-category-section rd-pretty-slots-section" data-category="slots">
                <div class="rd-pretty-category-divider">
                  <span class="rd-pretty-category-tag">Slots</span>
                </div>

                <div class="rd-pretty-settings-list">
                  {/* Nav Logo Slot */}
                  {slotsToRender.includes('nav-logo') && (
                    <div class="rd-option-card rd-option-card--boolean" data-control-slot="nav-logo">
                      <div class="rd-option-info">
                        <div class="rd-option-label-row">
                          <div
                            class="rd-option-label"
                          >
                            slot="nav-logo"
                          </div>
                        </div>
                        <div class="rd-option-tip">Inject custom logo & text HTML into sidebar navigation</div>
                      </div>

                      <div class="rd-control-wrapper">
                        <label class="rd-switch">
                          <input
                            type="checkbox"
                            class="rd-pretty-slot-input"
                            data-slot="nav-logo"
                          />
                          <span class="rd-slider"></span>
                        </label>
                      </div>
                    </div>
                  )}

                  {/* Fixed Header Slot */}
                  {slotsToRender.includes('fixed-header') && (
                    <div class="rd-option-card rd-option-card--boolean" data-control-slot="fixed-header">
                      <div class="rd-option-info">
                        <div class="rd-option-label-row">
                          <div
                            class="rd-option-label"
                          >
                            slot="fixed-header"
                          </div>
                        </div>
                        <div class="rd-option-tip">Inject custom sticky announcement or banner HTML above content</div>
                      </div>

                      <div class="rd-control-wrapper">
                        <label class="rd-switch">
                          <input
                            type="checkbox"
                            class="rd-pretty-slot-input"
                            data-slot="fixed-header"
                          />
                          <span class="rd-slider"></span>
                        </label>
                      </div>
                    </div>
                  )}

                  {/* Default Slot */}
                  {slotsToRender.includes('default') && (
                    <div class="rd-option-card rd-option-card--boolean" data-control-slot="default">
                      <div class="rd-option-info">
                        <div class="rd-option-label-row">
                          <div
                            class="rd-option-label"
                          >
                            slot="(default)"
                          </div>
                        </div>
                        <div class="rd-option-tip">Inject custom top-level announcement HTML into main content body</div>
                      </div>

                      <div class="rd-control-wrapper">
                        <label class="rd-switch">
                          <input
                            type="checkbox"
                            class="rd-pretty-slot-input"
                            data-slot="default"
                          />
                          <span class="rd-slider"></span>
                        </label>
                      </div>
                    </div>
                  )}
                </div>
              </div>
            );
          }
          const group = section.group;
          const segmentedControls = group.controls.filter((c): c is SegmentedControl => c.type === 'segmented');
          const toggleControls = group.controls.filter((c): c is ToggleControl => c.type === 'toggle');

          return (
            <div class="rd-pretty-category-section" data-category={group.id}>
              <div class="rd-pretty-category-divider">
                <span class="rd-pretty-category-tag">{group.title}</span>
              </div>

              <div class="rd-pretty-settings-list">
                {/* Segmented Controls (multi-choice chips; a theme chip is filled with its colour) */}
                {segmentedControls.map(ctrl => {
                  return (
                    <div class="rd-option-card rd-option-card--multi" data-control-attr={ctrl.attr}>
                      <div class="rd-option-info">
                        <div class="rd-option-label-row">
                          <div
                            class="rd-option-label"
                          >
                            {ctrl.label}
                          </div>
                          {(ctrl.description || ctrl.defaultText) && (
                            <span class="rd-option-help" tabindex="0" role="button" aria-label={`About ${ctrl.label}`}>
                              <IconInfoCircle size={13} stroke={2} aria-hidden="true" />
                              <span class="rd-option-help-pop" role="tooltip">
                                {ctrl.description && <span class="rd-option-help-text" set:html={ctrl.description} />}
                                {ctrl.defaultText && (
                                  <span class="rd-option-help-default">
                                    <span class="rd-default-mark" aria-hidden="true" />
                                    Default: <code>{ctrl.defaultText}</code>
                                  </span>
                                )}
                              </span>
                            </span>
                          )}
                          {ctrl.info && (
                            <span class="rd-option-info-badge">
                              <IconInfoCircle size={12} stroke={2.2} aria-hidden="true" />
                              <span class="rd-option-info-text">{ctrl.info}</span>
                            </span>
                          )}
                        </div>
                        {ctrl.tip && <div class="rd-option-tip">{ctrl.tip}</div>}
                      </div>

                      <div
                        class="rd-control-wrapper rd-chip-group"
                        role="radiogroup"
                        aria-label={ctrl.label}
                      >
                        {ctrl.options.map(opt => {
                          return (
                            <label
                              class:list={['rd-chip', opt.dotColor && 'rd-chip--color', opt.isDefault && 'rd-chip--default']}
                              style={opt.dotColor ? `--chip-color: ${opt.dotColor}; --chip-text: ${textOn(opt.dotColor)};` : undefined}
                            >
                              <input
                                type="radio"
                                name={`rd_${instanceId}_${ctrl.attr}`}
                                class="rd-radio-input"
                                data-attr={ctrl.attr}
                                value={opt.rawVal}
                                data-is-default={opt.isDefault ? 'true' : undefined}
                                data-font-css={opt.fontCss}
                              />
                              <span class="chip-text">{opt.label}</span>
                              {opt.isDefault && <span class="rd-sr-only"> (default)</span>}
                            </label>
                          );
                        })}
                      </div>
                    </div>
                  );
                })}

                {/* Boolean / Toggle Controls */}
                {toggleControls.map(ctrl => (
                  <div class="rd-option-card rd-option-card--boolean" data-control-attr={ctrl.attr}>
                    <div class="rd-option-info">
                      <div class="rd-option-label-row">
                        <div
                          class="rd-option-label"
                        >
                          {ctrl.label}
                        </div>
                        {(ctrl.description || ctrl.defaultText) && (
                          <span class="rd-option-help" tabindex="0" role="button" aria-label={`About ${ctrl.label}`}>
                            <IconInfoCircle size={13} stroke={2} aria-hidden="true" />
                            <span class="rd-option-help-pop" role="tooltip">
                              {ctrl.description && <span class="rd-option-help-text" set:html={ctrl.description} />}
                              {ctrl.defaultText && (
                                <span class="rd-option-help-default">
                                  <span class="rd-default-mark" aria-hidden="true" />
                                  Default: <code>{ctrl.defaultText}</code>
                                </span>
                              )}
                            </span>
                          </span>
                        )}
                        {ctrl.info && (
                          <span class="rd-option-info-badge">
                            <IconInfoCircle size={12} stroke={2.2} aria-hidden="true" />
                            <span class="rd-option-info-text">{ctrl.info}</span>
                          </span>
                        )}
                      </div>
                      {ctrl.tip && <div class="rd-option-tip">{ctrl.tip}</div>}
                    </div>

                    <div class="rd-control-wrapper">
                      <label class="rd-switch">
                        <input
                          type="checkbox"
                          class="rd-toggle-input"
                          data-attr={ctrl.attr}
                          data-default-on={ctrl.defaultOn ? 'true' : undefined}
                        />
                        <span class="rd-slider"></span>
                      </label>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          );
        })}

        <!-- Slot for custom, test-specific action buttons or inputs -->
        <div class="rd-pretty-slot-container">
          <slot />
        </div>
      </div>
    </div>
  </aside>
</div>

<script is:inline>
  (function initRapidocTuners() {
    function setupController(root) {
      if (root.__rdPrettyInitialized) return;
      root.__rdPrettyInitialized = true;

      const targetId = root.getAttribute('data-target') || 'thedoc';
      let initialAttrs = {};
      try {
        const rawInitial = root.getAttribute('data-initial-attrs');
        if (rawInitial) {
          initialAttrs = JSON.parse(rawInitial);
        }
      } catch (_) {}

      const edgeTab = root.querySelector('.rd-pretty-edge-tab');
      const drawer = root.querySelector('.rd-pretty-drawer');
      const closeBtn = root.querySelector('.rd-pretty-close-btn');
      const resetBtn = root.querySelector('.rd-pretty-reset-btn');
      const statusDots = root.querySelectorAll('.rd-pretty-status-dot');

      const storageKeyOpen = `rd_pretty_open_${window.location.pathname}`;

      // Font controls set --font-sans / --font-mono. An option with data-font-css also loads its stylesheet,
      // since RapiDoc loads no fonts itself.
      function applyFont(target, attr, val) {
        const cssVar = attr === 'regular-font' ? '--font-sans' : attr === 'mono-font' ? '--font-mono' : '';
        if (!cssVar) return;
        if (!val) {
          target.style.removeProperty(cssVar);
          return;
        }
        const optionEl = Array.from(root.querySelectorAll(`[data-attr="${attr}"][data-font-css]`)).find(
          (el) => (el.getAttribute('value') ?? el.getAttribute('data-val')) === val
        );
        const fontCss = optionEl?.getAttribute('data-font-css');
        const isLoaded = Array.from(document.querySelectorAll('link[rel="stylesheet"]')).some((link) => link.href === fontCss);
        if (fontCss && !isLoaded) {
          const linkEl = document.createElement('link');
          linkEl.rel = 'stylesheet';
          linkEl.href = fontCss;
          document.head.append(linkEl);
        }
        target.style.setProperty(cssVar, val);
      }

      function openDrawer() {
        if (!drawer) return;
        drawer.classList.add('is-open');
        drawer.setAttribute('aria-hidden', 'false');
        root.classList.add('is-drawer-open');
        edgeTab?.setAttribute('aria-expanded', 'true');
        sessionStorage.setItem(storageKeyOpen, 'true');
        window.dispatchEvent(new CustomEvent('rapidoc-tuner:opened'));
      }

      function closeDrawer() {
        if (!drawer) return;
        drawer.classList.remove('is-open');
        drawer.setAttribute('aria-hidden', 'true');
        root.classList.remove('is-drawer-open');
        edgeTab?.setAttribute('aria-expanded', 'false');
        sessionStorage.setItem(storageKeyOpen, 'false');
        window.dispatchEvent(new CustomEvent('rapidoc-tuner:closed'));
      }

      function toggleDrawer() {
        if (drawer?.classList.contains('is-open')) {
          closeDrawer();
        } else {
          openDrawer();
        }
      }

      edgeTab?.addEventListener('click', (e) => {
        e.stopPropagation();
        openDrawer();
      });

      window.addEventListener('rapidoc-tuner:open', openDrawer);
      window.addEventListener('rapidoc-tuner:close', closeDrawer);
      window.addEventListener('rapidoc-tuner:toggle', toggleDrawer);

      window.rapidocTuner = {
        open: openDrawer,
        close: closeDrawer,
        toggle: toggleDrawer,
        isOpen: () => Boolean(drawer?.classList.contains('is-open')),
      };

      closeBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        closeDrawer();
      });

      // Keyboard shortcuts: Cmd+K / Ctrl+K toggles, Escape closes
      window.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          if (drawer?.classList.contains('is-open')) {
            closeDrawer();
          } else {
            openDrawer();
          }
        } else if (e.key === 'Escape' && drawer?.classList.contains('is-open')) {
          closeDrawer();
        }
      });

      function getTarget() {
        return document.getElementById(targetId);
      }

      function executeScrollTo() {
        const target = getTarget();
        if (!target) return;
        const input = root.querySelector('.rd-scroll-path-input');
        if (!input) return;
        let path = input.value.trim();
        if (!path) return;

        // Normalize spaces or colons like "get /user/login" or "get: /user/login" -> "get-/user/login"
        path = path.replace(/^(\w+)[\s:]+(\/.*)$/i, (_, m, p) => `${m.toLowerCase()}-${p}`);

        // Auto-prefix helper if raw path without method or tag prefix is given
        if (target.shadowRoot && !target.shadowRoot.getElementById(path)) {
          const cleanPath = path.startsWith('/') ? path : `/${path}`;
          const candidates = [
            `get-${cleanPath}`,
            `post-${cleanPath}`,
            `put-${cleanPath}`,
            `delete-${cleanPath}`,
            `patch-${cleanPath}`,
            `tag--${path.replace(/^tag--/, '')}`,
          ];
          for (const cand of candidates) {
            if (target.shadowRoot.getElementById(cand)) {
              path = cand;
              break;
            }
          }
        }

        if (typeof target.scrollToPath === 'function') {
          target.scrollToPath(path);
        } else if (typeof target.scrollTo === 'function') {
          target.scrollTo(path);
        }
      }

      const scrollInput = root.querySelector('.rd-scroll-path-input');
      scrollInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          e.stopPropagation();
          executeScrollTo();
        }
      });

      const SLOT_TEMPLATES = {
        'nav-logo': `
          <div slot="nav-logo" data-tuner-slot="nav-logo" style="display:flex; align-items:center; justify-content:center; width:100% !important; box-sizing:border-box !important; padding:12px 16px !important; background:color-mix(in srgb, var(--primary, #3b82f6) 18%, var(--background, #18181b)) !important; color:var(--foreground, currentColor); min-height:48px;">
            <img src="/assets/images/dog.png" style="width:40px; margin-right:20px;" alt="Dog">
            <span style="font-size:13px;">
              <b>nav-logo</b> slot
            </span>
          </div>
        `.trim(),
        'fixed-header': `
          <div slot="fixed-header" data-tuner-slot="fixed-header" style="display:flex; align-items:center; justify-content:center; width:100% !important; box-sizing:border-box !important; padding:10px 16px !important; margin:0; background:color-mix(in srgb, var(--primary, #3b82f6) 18%, var(--background, #18181b)) !important; color:var(--foreground, currentColor); min-height:40px;">
            <span style="font-size:13px;">
              <b>fixed-header</b> slot
            </span>
          </div>
        `.trim(),
        'default': `
          <div data-tuner-slot="default" style="display:flex; align-items:center; justify-content:center; width:100% !important; box-sizing:border-box !important; padding:16px 24px !important; margin:0; background:color-mix(in srgb, var(--primary, #3b82f6) 18%, var(--background, #18181b)) !important; color:var(--foreground, currentColor); min-height:48px;">
            <span style="font-size:13px;">
              <b>(default)</b> slot
            </span>
          </div>
        `.trim(),
      };

      function getSlotElement(target, slotName) {
        if (!target) return null;
        if (slotName === 'nav-logo') {
          return target.querySelector(':scope > [slot="nav-logo"]');
        }
        if (slotName === 'fixed-header') {
          return target.querySelector(':scope > [slot="fixed-header"]');
        }
        if (slotName === 'default') {
          const tunerEl = target.querySelector(':scope > [data-tuner-slot="default"]');
          if (tunerEl) return tunerEl;
          return Array.from(target.children).find(
            (c) => !c.hasAttribute('slot') && c.tagName !== 'SCRIPT' && c.tagName !== 'STYLE'
          );
        }
        return null;
      }

      function setSlotState(target, slotName, enable) {
        if (!target || !SLOT_TEMPLATES[slotName]) return;
        const existing = getSlotElement(target, slotName);
        if (enable) {
          if (!existing) {
            const template = document.createElement('template');
            template.innerHTML = SLOT_TEMPLATES[slotName];
            const newEl = template.content.firstElementChild;
            if (newEl) {
              target.appendChild(newEl);
            }
          }
        } else {
          if (existing) {
            existing.remove();
          }
        }
      }

      // Synchronize controller UI from the target element attributes
      function syncControllerState() {
        const target = getTarget();
        if (!target) return;

        // Sync radio chips & color chips
        root.querySelectorAll('.rd-radio-input').forEach((input) => {
          const attr = input.getAttribute('data-attr');
          const val = input.value ?? '';
          if (!attr) return;

          let currentVal = target.getAttribute(attr);
          if (attr === 'layout' && (currentVal === null || currentVal === '')) {
            const currentRenderStyle = target.getAttribute('render-style') || target.renderStyle || 'focused';
            currentVal = currentRenderStyle === 'read' || currentRenderStyle === 'focused' ? 'column' : 'row';
          }
          let isMatching = false;

          if (currentVal !== null && currentVal !== '') {
            isMatching = String(currentVal).toLowerCase() === String(val).toLowerCase();
          } else {
            isMatching = input.getAttribute('data-is-default') === 'true';
          }

          input.checked = isMatching;
          const parentLabel = input.closest('.rd-chip');
          if (parentLabel) {
            if (isMatching) {
              parentLabel.classList.add('active');
            } else {
              parentLabel.classList.remove('active');
            }
          }
        });

        // Sync boolean toggle inputs
        root.querySelectorAll('.rd-toggle-input').forEach((input) => {
          const attr = input.getAttribute('data-attr');
          if (!attr) return;
          const currentVal = target.getAttribute(attr);
          const defaultOn = input.getAttribute('data-default-on') === 'true';
          const isActive = currentVal === 'true' || (currentVal !== 'false' && (currentVal !== null ? true : defaultOn));

          input.checked = isActive;
        });

        // Sync slot inputs
        root.querySelectorAll('.rd-pretty-slot-input').forEach((input) => {
          const slotName = input.getAttribute('data-slot');
          if (!slotName) return;
          const isPresent = Boolean(getSlotElement(target, slotName));
          input.checked = isPresent;
        });

        // Sync active spec option if present
        const currentSpecUrl = target.getAttribute('spec-url') || '';
        root.querySelectorAll('.rd-method-spec-btn').forEach((btn) => {
          const btnSpec = btn.getAttribute('data-spec-url') || '';
          const isActive = Boolean(
            btnSpec &&
              currentSpecUrl &&
              (currentSpecUrl === btnSpec ||
                currentSpecUrl.endsWith(btnSpec) ||
                btnSpec.endsWith(currentSpecUrl) ||
                (btnSpec.includes('petstore') && currentSpecUrl.includes('petstore')) ||
                (btnSpec.includes('open-api-3-1') && currentSpecUrl.includes('open-api-3-1')))
          );
          if (isActive) {
            btn.classList.add('is-active');
            btn.setAttribute('aria-checked', 'true');
          } else {
            btn.classList.remove('is-active');
            btn.setAttribute('aria-checked', 'false');
          }
        });
      }

      // Handle user interactions inside controller
      root.addEventListener('change', (e) => {
        const target = getTarget();
        if (!target) return;

        // Radio change
        if (e.target.matches('.rd-radio-input')) {
          const attr = e.target.getAttribute('data-attr');
          const val = e.target.value ?? '';
          if (attr) {
            applyFont(target, attr, val);
            if (val === '') {
              target.removeAttribute(attr);
            } else {
              target.setAttribute(attr, val);
            }
            const camelProp = attr.replace(/-([a-z])/g, (_, g) => g.toUpperCase());
            if (camelProp in target) {
              try {
                target[camelProp] = val;
              } catch (_) {}
            }
            if (attr === 'render-style') {
              const syncLayout = val === 'read' || val === 'focused' ? 'column' : 'row';
              target.setAttribute('layout', syncLayout);
              if ('layout' in target) {
                target.layout = syncLayout;
              }
            }
            syncControllerState();
          }
          return;
        }

        // Toggle change
        if (e.target.matches('.rd-toggle-input')) {
          const attr = e.target.getAttribute('data-attr');
          if (attr) {
            const newVal = e.target.checked ? 'true' : 'false';
            target.setAttribute(attr, newVal);
            const camelProp = attr.replace(/-([a-z])/g, (_, g) => g.toUpperCase());
            if (camelProp in target) {
              try {
                target[camelProp] = newVal;
              } catch (_) {}
            }
            syncControllerState();
          }
          return;
        }

        // Slot toggle change
        if (e.target.matches('.rd-pretty-slot-input')) {
          const slotName = e.target.getAttribute('data-slot');
          if (slotName) {
            setSlotState(target, slotName, e.target.checked);
            syncControllerState();
          }
          return;
        }
      });

      root.addEventListener('click', (e) => {
        const methodSpecBtn = e.target.closest('.rd-method-spec-btn');
        if (methodSpecBtn) {
          const specToLoad = methodSpecBtn.getAttribute('data-spec-url');
          const target = getTarget();
          if (target && specToLoad) {
            target.setAttribute('spec-url', specToLoad);
            if (typeof target.loadSpec === 'function') {
              target.loadSpec(specToLoad);
            }
            syncControllerState();
          }
          return;
        }

        const scrollExecBtn = e.target.closest('.rd-scroll-exec-btn');
        if (scrollExecBtn) {
          executeScrollTo();
          return;
        }

        const mcpExecBtn = e.target.closest('.rd-mcp-exec-btn');
        if (mcpExecBtn) {
          const target = getTarget();
          if (target && typeof target.downloadMcpServer === 'function') {
            target.downloadMcpServer();
          }
          return;
        }
      });

      // Reset functionality
      resetBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const target = getTarget();
        if (!target) return;

        // Reset to initialAttrs or clear attributes
        root.querySelectorAll('.rd-radio-input, .rd-toggle-input').forEach((input) => {
          const attr = input.getAttribute('data-attr');
          if (!attr) return;

          if (initialAttrs && Object.prototype.hasOwnProperty.call(initialAttrs, attr)) {
            const initialVal = String(initialAttrs[attr]);
            target.setAttribute(attr, initialVal);
            applyFont(target, attr, initialVal);
          } else {
            target.removeAttribute(attr);
            applyFont(target, attr, '');
          }
        });

        // Reset slot states to initial
        ['nav-logo', 'fixed-header', 'default'].forEach((slotName) => {
          const wasInitial = initialSlots[slotName];
          const current = getSlotElement(target, slotName);
          if (!wasInitial && current) {
            current.remove();
          } else if (wasInitial && !current) {
            setSlotState(target, slotName, true);
          }
        });

        syncControllerState();
      });

      let initialSlots = {};

      function attachToTarget() {
        const target = getTarget();
        if (!target) {
          setTimeout(attachToTarget, 100);
          return;
        }

        initialSlots = {
          'nav-logo': Boolean(getSlotElement(target, 'nav-logo')),
          'fixed-header': Boolean(getSlotElement(target, 'fixed-header')),
          default: Boolean(getSlotElement(target, 'default')),
        };

        try {
          if (initialAttrs) {
            Object.entries(initialAttrs).forEach(([key, val]) => {
              if (!target.hasAttribute(key) && val !== undefined && val !== null) {
                target.setAttribute(key, String(val));
              }
            });
          }
          applyFont(target, 'regular-font', target.getAttribute('regular-font'));
          applyFont(target, 'mono-font', target.getAttribute('mono-font'));
        } catch (_) {}

        target.addEventListener('spec-loaded', () => {
          statusDots.forEach((dot) => dot.classList.add('is-loaded'));
        });

        target.addEventListener('after-render', () => {
          statusDots.forEach((dot) => dot.classList.add('is-ready'));
          syncControllerState();
        });

        const observer = new MutationObserver(() => {
          syncControllerState();
        });
        observer.observe(target, { attributes: true, childList: true });

        syncControllerState();
        if (customElements?.whenDefined) {
          customElements.whenDefined('rapi-doc').then(() => {
            syncControllerState();
          });
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', attachToTarget);
      } else {
        attachToTarget();
      }

      // Check default open preference or session persistence
      const isDefaultOpen = root.getAttribute('data-default-open') === 'true';
      const sessionState = sessionStorage.getItem(storageKeyOpen);
      if (sessionState === 'true' || (sessionState === null && isDefaultOpen)) {
        openDrawer();
      }
    }

    document.querySelectorAll('.rd-pretty-controller-root').forEach(setupController);
  })();
</script>

