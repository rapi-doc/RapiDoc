---
import {
  CONTROL_REGISTRY,
  CATEGORY_TITLES,
  PRESETS,
  resolveActiveControls,
  groupControlsByCategory,
  type ControlOption,
  type ControlCategory,
  type SegmentedControl,
  type ToggleControl,
  type ControlDef,
  type ControllerPreset,
} from './controller-registry';

export type { ControlOption, ControlCategory, SegmentedControl, ToggleControl, ControlDef, ControllerPreset };

interface Props {
  targetId?: string;
  preset?: 'all' | 'minimal' | 'schema' | 'nav' | 'sections' | 'colors' | 'demo' | 'none';
  controls?: string[];
  initialAttrs?: Record<string, string | boolean | number>;
  position?: 'bottom' | 'top';
  tuckedRight?: boolean;
  specUrl?: string;
  title?: string;
  size?: 'small' | 'medium' | 'large' | (string & {}) | number;
  showMethods?: boolean;
}

const {
  targetId = 'thedoc',
  preset = 'minimal',
  controls: propControls,
  initialAttrs = {},
  position = 'bottom',
  tuckedRight = false,
  specUrl,
  title = 'OPTIONS',
  size = 'medium',
  showMethods = (preset === 'all' || preset === 'demo'),
} = Astro.props;

let baseFontSize = '12px';
if (size != null) {
  const s = String(size).trim();
  if (s === 'small') baseFontSize = '11px';
  else if (s === 'large') baseFontSize = '14px';
  else if (s === 'medium') baseFontSize = '12px';
  else if (/^\d+(\.\d+)?$/.test(s)) baseFontSize = `${s}px`;
  else if (s) baseFontSize = s;
}

// Determine active controls
const activeControls = resolveActiveControls(propControls, preset);
const groupedControls = groupControlsByCategory(activeControls);

const initialAttrsJson = JSON.stringify(initialAttrs);
---

<aside
  class={`rd-controller-hud position-${position}${tuckedRight ? ' is-tucked-right' : ''}`}
  id={`rd-hud-${targetId}`}
  data-target={targetId}
  data-initial-attrs={initialAttrsJson}
  style={`--rd-ctrl-font-size: ${baseFontSize};`}
  aria-label="Options Interactive Controller"
>
  <!-- Collapsed badge / Expand trigger -->
  <button type="button" class="rd-hud-trigger" aria-expanded="false" title={`Open ${title}`}>
    <span class="rd-hud-status-dot" aria-hidden="true"></span>
    <span class="rd-hud-trigger-title">{title}</span>
    <span class="rd-hud-toggle-icon">▲</span>
  </button>

  <!-- Expanded controls drawer / panel -->
  <div class="rd-hud-panel">
    <!-- Header with Title, Spec link, API mode toggle, Tuck Right (Icons only), and Minimize -->
    <div class="rd-hud-header">
      <div class="rd-hud-title-group">
        <span class="rd-hud-status-dot" aria-hidden="true"></span>
        <span class="rd-hud-badge">{title}</span>
        {specUrl && (
          <a href={specUrl} target="_blank" rel="noopener noreferrer" class="rd-spec-link" title="Open active OpenAPI spec file">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
            </svg>
            <span>Spec</span>
          </a>
        )}
      </div>

      <div class="rd-hud-actions-group">
        <!-- Raw / Human Labels Switcher (Just "API", dimmed when human mode, highlighted in raw label mode) -->
        <button
          type="button"
          class="rd-hud-action-btn rd-hud-label-mode-btn"
          title="Toggle between Human-Friendly Labels and Raw OpenAPI Attributes"
          aria-label="Toggle Raw OpenAPI Attributes Mode"
        >
          <span class="rd-label-btn-text">API</span>
        </button>

        <!-- Tuck to Right Drawer Button (Icon only, no text words) -->
        <button
          type="button"
          class="rd-hud-action-btn rd-hud-tuck-btn"
          title="Tuck to Right Side Drawer"
          aria-label="Tuck to Right Side Drawer"
        >
          <svg class="icon-tuck-right" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2"></rect>
            <line x1="15" y1="3" x2="15" y2="21"></line>
          </svg>
          <svg class="icon-float-bottom" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2"></rect>
            <line x1="3" y1="16" x2="21" y2="16"></line>
          </svg>
        </button>

        <!-- Minimize Button -->
        <button
          type="button"
          class="rd-hud-action-btn rd-hud-minimize-btn"
          title="Minimize controller (Cmd+K)"
          aria-label="Minimize controller"
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
        </button>
      </div>
    </div>

    <!-- Scrollable Fluid Controls Container with Scrollbar -->
    <div class="rd-hud-body">
      {groupedControls.map(group => {
        const segmentedControls = group.controls.filter(c => c.type === 'segmented');
        const toggleControls = group.controls.filter(c => c.type === 'toggle');
        return (
          <div class="rd-hud-section" data-section={group.id}>
            <div class="rd-hud-category-title">{group.title}</div>
            <div class="rd-hud-section-content">
              {segmentedControls.map(ctrl => (
                <div class="rd-hud-link-row" data-control-attr={ctrl.attr}>
                  <span class="rd-control-label-wrap">
                    <span
                      class="rd-control-label"
                      data-human={`${ctrl.label} :`}
                      data-raw={`${ctrl.attr} :`}
                      data-tooltip={ctrl.tip || `Attribute: ${ctrl.attr}`}
                      tabindex="0"
                    >{ctrl.label} :</span>
                    {ctrl.info && (
                      <button
                        type="button"
                        class="rd-control-info-icon"
                        aria-label={`Info: ${ctrl.info}`}
                        data-tooltip={ctrl.info}
                        data-tooltip-type="info"
                        tabindex="0"
                      >
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="12" cy="12" r="10"></circle>
                          <line x1="12" y1="16" x2="12" y2="12"></line>
                          <line x1="12" y1="8" x2="12.01" y2="8"></line>
                        </svg>
                      </button>
                    )}
                  </span>

                  <span class="rd-link-options" role="radiogroup" aria-label={ctrl.label}>
                    {ctrl.options.map((opt, idx) => (
                      <span class="rd-link-item">
                        {idx > 0 && <span class="rd-link-sep" aria-hidden="true">|</span>}
                        <span
                          role="button"
                          tabindex="0"
                          class="rd-link-btn"
                          data-attr={ctrl.attr}
                          data-val={opt.rawVal}
                          data-is-default={opt.isDefault ? 'true' : undefined}
                          data-tooltip={`${ctrl.attr}="${opt.rawVal}"`}
                        >
                          {opt.dotColor && (
                            <span class="rd-color-dot" style={`background-color: ${opt.dotColor};`} aria-hidden="true" />
                          )}
                          <span
                            class="rd-link-text"
                            data-human={opt.label}
                            data-raw={opt.rawVal || 'default'}
                          >{opt.label}</span>
                        </span>
                      </span>
                    ))}
                  </span>
                </div>
              ))}

              {toggleControls.length > 0 && (
                <div class="rd-toggles-wrap">
                  {toggleControls.map(ctrl => (
                    <span
                      role="button"
                      tabindex="0"
                      class="rd-toggle-chip"
                      data-attr={ctrl.attr}
                      data-default-on={ctrl.defaultOn ? 'true' : undefined}
                      data-tooltip={ctrl.tip || `Toggle ${ctrl.attr}`}
                    >
                      <span class="rd-toggle-check" aria-hidden="true">✓</span>
                      <span
                        class="rd-toggle-text"
                        data-human={ctrl.label}
                        data-raw={ctrl.attr}
                      >{ctrl.label}</span>
                      {ctrl.info && (
                        <button
                          type="button"
                          class="rd-control-info-icon rd-toggle-info-btn"
                          aria-label={`Info: ${ctrl.info}`}
                          data-tooltip={ctrl.info}
                          data-tooltip-type="info"
                          tabindex="0"
                          onclick="event.stopPropagation();"
                        >
                          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="16" x2="12" y2="12"></line>
                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                          </svg>
                        </button>
                      )}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>
        );
      })}

      {showMethods && (
        <div class="rd-hud-section rd-hud-methods-section" data-section="methods">
          <div class="rd-section-header">
            <span class="rd-section-title" data-human="Methods" data-raw="Methods">
              Methods
            </span>
          </div>
          <div class="rd-section-content">
            <!-- loadSpec() -->
            <div class="rd-control-row" data-method="loadSpec">
              <span
                class="rd-control-label"
                data-human="Load Spec"
                data-raw="loadSpec(url)"
              >Load Spec</span>
              <span class="rd-segmented-btn-group" role="group" aria-label="Load Spec">
                <span class="rd-link-item">
                  <span
                    role="button"
                    tabindex="0"
                    class="rd-link-btn rd-method-spec-btn is-active"
                    data-spec-url="/specs/petstore.yaml"
                    title="loadSpec('/specs/petstore.yaml')"
                  >
                    <span class="rd-link-text" data-human="Petstore" data-raw="petstore.yaml">Petstore</span>
                  </span>
                </span>
                <span class="rd-link-item">
                  <span class="rd-link-sep" aria-hidden="true">|</span>
                  <span
                    role="button"
                    tabindex="0"
                    class="rd-link-btn rd-method-spec-btn"
                    data-spec-url="/specs/open-api-3-1.yaml"
                    title="loadSpec('/specs/open-api-3-1.yaml')"
                  >
                    <span class="rd-link-text" data-human="OpenAPI 3.1" data-raw="open-api-3-1.yaml">OpenAPI 3.1</span>
                  </span>
                </span>
              </span>
            </div>

            <!-- scrollTo(path) -->
            <div class="rd-control-row rd-method-scroll-row" data-method="scrollTo">
              <span
                class="rd-control-label"
                data-human="Scroll To"
                data-raw="scrollTo(path)"
              >Scroll To</span>
              <div class="rd-method-input-wrap">
                <input
                  type="text"
                  class="rd-method-input rd-scroll-path-input"
                  value="get-/user/login"
                  placeholder="e.g. get-/user/login"
                  aria-label="Path to scroll to"
                  spellcheck="false"
                />
                <button
                  type="button"
                  class="rd-method-exec-btn rd-scroll-exec-btn"
                  title="Execute scrollTo(path)"
                >
                  <span data-human="Scroll" data-raw="Call">Scroll</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      )}

      <!-- Slot for custom, test-specific action buttons or inputs -->
      <slot />
    </div>
  </div>

  <!-- Single CSS Anchor Positioning Tooltip -->
  <div
    id={`rd-tooltip-${targetId}`}
    class="rd-hud-tooltip"
    role="tooltip"
    aria-hidden="true"
  >
    <div class="rd-tooltip-inner">
      <span class="rd-tooltip-badge" aria-hidden="true"></span>
      <span class="rd-tooltip-text"></span>
    </div>
  </div>
</aside>

<script is:inline>
  (function initRapiDocController() {
    function setupController(hud) {
      if (hud.__rdInitialized) return;
      hud.__rdInitialized = true;

      const targetId = hud.getAttribute('data-target') || 'thedoc';
      let initialAttrs = {};
      try {
        const rawInitial = hud.getAttribute('data-initial-attrs');
        if (rawInitial) {
          initialAttrs = JSON.parse(rawInitial);
        }
      } catch (_) {}

      const triggerBtn = hud.querySelector('.rd-hud-trigger');
      const minimizeBtn = hud.querySelector('.rd-hud-minimize-btn');
      const tuckBtn = hud.querySelector('.rd-hud-tuck-btn');
      const labelModeBtn = hud.querySelector('.rd-hud-label-mode-btn');
      const labelModeText = labelModeBtn?.querySelector('.rd-label-btn-text');
      const labelModeIcon = labelModeBtn?.querySelector('.rd-label-btn-icon');
      const statusDots = hud.querySelectorAll('.rd-hud-status-dot');

      const storageKeyTuck = `rd_ctrl_tucked_${window.location.pathname}`;
      const storageKeyRaw = `rd_ctrl_raw_labels`;

      function setCollapsed(collapsed) {
        if (collapsed) {
          hud.classList.add('is-collapsed');
          triggerBtn?.setAttribute('aria-expanded', 'false');
        } else {
          hud.classList.remove('is-collapsed');
          triggerBtn?.setAttribute('aria-expanded', 'true');
        }
      }

      triggerBtn?.addEventListener('click', e => {
        e.stopPropagation();
        setCollapsed(false);
      });

      minimizeBtn?.addEventListener('click', e => {
        e.stopPropagation();
        setCollapsed(true);
      });

      function syncTuckUi() {
        const isTucked = hud.classList.contains('is-tucked-right');
        tuckBtn?.setAttribute('title', isTucked ? 'Float at Bottom' : 'Tuck to Right Side Drawer');
        tuckBtn?.setAttribute('aria-label', isTucked ? 'Float at Bottom' : 'Tuck to Right Side Drawer');
      }

      tuckBtn?.addEventListener('click', e => {
        e.stopPropagation();
        const isTucked = hud.classList.toggle('is-tucked-right');
        localStorage.setItem(storageKeyTuck, String(isTucked));
        syncTuckUi();
        setCollapsed(false);
      });

      function setLabelMode(isRaw) {
        if (isRaw) {
          hud.classList.add('is-raw-labels');
          labelModeBtn?.setAttribute('aria-pressed', 'true');
        } else {
          hud.classList.remove('is-raw-labels');
          labelModeBtn?.setAttribute('aria-pressed', 'false');
        }

        // Cleanly set single text node to prevent any double-label rendering
        hud.querySelectorAll('[data-human][data-raw]').forEach(el => {
          el.textContent = isRaw ? el.getAttribute('data-raw') : el.getAttribute('data-human');
        });
      }

      labelModeBtn?.addEventListener('click', e => {
        e.stopPropagation();
        const nowRaw = !hud.classList.contains('is-raw-labels');
        localStorage.setItem(storageKeyRaw, String(nowRaw));
        setLabelMode(nowRaw);
      });

      const savedTuck = localStorage.getItem(storageKeyTuck);
      if (savedTuck === 'true') {
        hud.classList.add('is-tucked-right');
      } else if (savedTuck === 'false') {
        hud.classList.remove('is-tucked-right');
      }
      syncTuckUi();

      if (localStorage.getItem(storageKeyRaw) === 'true') {
        setLabelMode(true);
      } else {
        setLabelMode(false);
      }

      // =========================================================================
      // Single Viewport-Safe Tooltip Engine
      // =========================================================================
      const tooltipEl = hud.querySelector('.rd-hud-tooltip');
      const tooltipInner = tooltipEl?.querySelector('.rd-tooltip-inner');
      const tooltipText = tooltipEl?.querySelector('.rd-tooltip-text');
      const tooltipBadge = tooltipEl?.querySelector('.rd-tooltip-badge');

      // Hoist tooltip to document.body so it is never clipped by transforms or overflow
      if (tooltipEl && tooltipEl.parentElement !== document.body) {
        document.body.appendChild(tooltipEl);
      }

      let currentAnchorEl = null;

      function updateTooltipPosition(targetEl) {
        if (!tooltipEl || !targetEl) return;
        const rect = targetEl.getBoundingClientRect();
        const tooltipWidth = tooltipInner?.offsetWidth || 220;
        const tooltipHeight = tooltipInner?.offsetHeight || 30;

        // Center horizontally over target
        let left = rect.left + rect.width / 2 - tooltipWidth / 2;
        // Default position: ABOVE the trigger with an 8px gap (never cuts off at bottom of screen!)
        let top = rect.top - tooltipHeight - 8;

        // If too close to viewport top, flip below the trigger
        if (top < 8) {
          top = rect.bottom + 8;
        }

        // Viewport horizontal boundary constraints
        if (left < 12) left = 12;
        if (left + tooltipWidth > window.innerWidth - 12) {
          left = window.innerWidth - tooltipWidth - 12;
        }

        tooltipEl.style.setProperty('left', `${Math.round(left)}px`, 'important');
        tooltipEl.style.setProperty('top', `${Math.round(top)}px`, 'important');
      }

      function showTooltip(targetEl) {
        if (!tooltipEl || !targetEl) return;
        const text = targetEl.getAttribute('data-tooltip');
        if (!text) return;

        const type = targetEl.getAttribute('data-tooltip-type') || 'default';
        tooltipEl.setAttribute('data-type', type);
        if (tooltipBadge) {
          tooltipBadge.textContent = type === 'info' ? 'Info' : 'Tip';
        }
        if (tooltipText) {
          tooltipText.textContent = text;
        }

        currentAnchorEl = targetEl;
        tooltipEl.classList.add('is-visible');
        tooltipEl.setAttribute('aria-hidden', 'false');

        updateTooltipPosition(targetEl);
      }

      function hideTooltip(targetEl) {
        if (!tooltipEl) return;
        if (targetEl && targetEl === currentAnchorEl) {
          currentAnchorEl = null;
        }
        tooltipEl.classList.remove('is-visible');
        tooltipEl.setAttribute('aria-hidden', 'true');
      }

      hud.addEventListener('pointerover', e => {
        const trigger = e.target.closest('[data-tooltip]');
        if (trigger && hud.contains(trigger)) {
          showTooltip(trigger);
        }
      });

      hud.addEventListener('pointerout', e => {
        const trigger = e.target.closest('[data-tooltip]');
        if (trigger && (!e.relatedTarget || !trigger.contains(e.relatedTarget))) {
          hideTooltip(trigger);
        }
      });

      hud.addEventListener('focusin', e => {
        const trigger = e.target.closest('[data-tooltip]');
        if (trigger && hud.contains(trigger)) {
          showTooltip(trigger);
        }
      });

      hud.addEventListener('focusout', e => {
        const trigger = e.target.closest('[data-tooltip]');
        if (trigger) {
          hideTooltip(trigger);
        }
      });

      // Keep position updated if the controller body or page scrolls
      const hudBody = hud.querySelector('.rd-hud-body');
      hudBody?.addEventListener('scroll', () => {
        if (currentAnchorEl) {
          updateTooltipPosition(currentAnchorEl);
        }
      }, { passive: true });

      window.addEventListener('scroll', () => {
        if (currentAnchorEl) {
          updateTooltipPosition(currentAnchorEl);
        }
      }, { passive: true });

      window.addEventListener('keydown', e => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          setCollapsed(!hud.classList.contains('is-collapsed'));
        }
      });

      hud.addEventListener('keydown', e => {
        if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
        if (e.key === 'Enter' || e.key === ' ') {
          const interactive = e.target.closest('.rd-link-btn, .rd-toggle-chip');
          if (interactive) {
            e.preventDefault();
            interactive.click();
          }
        }
      });

      function getTarget() {
        return document.getElementById(targetId);
      }

      function executeScrollTo() {
        const target = getTarget();
        if (!target) return;
        const input = hud.querySelector('.rd-scroll-path-input');
        if (!input) return;
        let path = input.value.trim();
        if (!path) return;

        // Normalize spaces or colons like "get /user/login" or "get: /user/login" -> "get-/user/login"
        path = path.replace(/^(\w+)[\s:]+(\/.*)$/i, (_, m, p) => `${m.toLowerCase()}-${p}`);

        // Auto-prefix helper if raw path without method or tag prefix is given
        if (target.shadowRoot && !target.shadowRoot.getElementById(path)) {
          const cleanPath = path.startsWith('/') ? path : `/${path}`;
          const candidates = [
            `get-${cleanPath}`,
            `post-${cleanPath}`,
            `put-${cleanPath}`,
            `delete-${cleanPath}`,
            `patch-${cleanPath}`,
            `tag--${path.replace(/^tag--/, '')}`,
          ];
          for (const cand of candidates) {
            if (target.shadowRoot.getElementById(cand)) {
              path = cand;
              break;
            }
          }
        }

        if (typeof target.scrollToPath === 'function') {
          target.scrollToPath(path);
        } else if (typeof target.scrollTo === 'function') {
          target.scrollTo(path);
        }
      }

      const scrollInput = hud.querySelector('.rd-scroll-path-input');
      scrollInput?.addEventListener('keydown', e => {
        if (e.key === 'Enter') {
          e.preventDefault();
          e.stopPropagation();
          executeScrollTo();
        }
      });

      function syncControllerState() {
        const target = getTarget();
        if (!target) return;

        hud.querySelectorAll('.rd-link-btn:not(.rd-method-spec-btn)').forEach(btn => {
          const attr = btn.getAttribute('data-attr');
          const val = btn.getAttribute('data-val') ?? '';
          if (!attr) return;

          const currentVal = target.getAttribute(attr);
          let isMatching = false;

          if (currentVal !== null && currentVal !== '') {
            isMatching = String(currentVal).toLowerCase() === String(val).toLowerCase();
          } else {
            // When attribute is not explicitly set on <rapi-doc>, match the default option
            isMatching = btn.getAttribute('data-is-default') === 'true';
          }

          if (isMatching) {
            btn.classList.add('is-active');
            btn.setAttribute('aria-checked', 'true');
          } else {
            btn.classList.remove('is-active');
            btn.setAttribute('aria-checked', 'false');
          }
        });

        // Sync active spec option if present
        const currentSpecUrl = target.getAttribute('spec-url') || '';
        hud.querySelectorAll('.rd-method-spec-btn').forEach(btn => {
          const btnSpec = btn.getAttribute('data-spec-url') || '';
          const isActive = Boolean(
            btnSpec &&
              currentSpecUrl &&
              (currentSpecUrl === btnSpec ||
                currentSpecUrl.endsWith(btnSpec) ||
                btnSpec.endsWith(currentSpecUrl) ||
                (btnSpec.includes('petstore') && currentSpecUrl.includes('petstore')) ||
                (btnSpec.includes('open-api-3-1') && currentSpecUrl.includes('open-api-3-1')))
          );
          if (isActive) {
            btn.classList.add('is-active');
            btn.setAttribute('aria-checked', 'true');
          } else {
            btn.classList.remove('is-active');
            btn.setAttribute('aria-checked', 'false');
          }
        });

        hud.querySelectorAll('.rd-toggle-chip').forEach(btn => {
          const attr = btn.getAttribute('data-attr');
          if (!attr) return;
          const currentVal = target.getAttribute(attr);
          const defaultOn = btn.getAttribute('data-default-on') === 'true';
          const isActive = currentVal === 'true' || (currentVal !== 'false' && (currentVal !== null ? true : defaultOn));
          if (isActive) {
            btn.classList.add('is-active');
            btn.setAttribute('aria-pressed', 'true');
          } else {
            btn.classList.remove('is-active');
            btn.setAttribute('aria-pressed', 'false');
          }
        });
      }

      hud.addEventListener('click', e => {
        const methodSpecBtn = e.target.closest('.rd-method-spec-btn');
        if (methodSpecBtn) {
          const specToLoad = methodSpecBtn.getAttribute('data-spec-url');
          const target = getTarget();
          if (target && specToLoad) {
            target.setAttribute('spec-url', specToLoad);
            if (typeof target.loadSpec === 'function') {
              target.loadSpec(specToLoad);
            }
            syncControllerState();
          }
          return;
        }

        const scrollExecBtn = e.target.closest('.rd-scroll-exec-btn');
        if (scrollExecBtn) {
          executeScrollTo();
          return;
        }

        const linkBtn = e.target.closest('.rd-link-btn');
        if (linkBtn) {
          const attr = linkBtn.getAttribute('data-attr');
          const val = linkBtn.getAttribute('data-val') ?? '';
          const target = getTarget();
          if (target && attr) {
            if (attr === 'regular-font') {
              if (val === '') {
                target.style.removeProperty('--font-sans');
                target.style.removeProperty('--font-regular');
              } else {
                target.style.setProperty('--font-sans', val);
              }
            } else if (attr === 'mono-font') {
              if (val === '') {
                target.style.removeProperty('--font-mono');
              } else {
                target.style.setProperty('--font-mono', val);
              }
            }
            if (val === '') {
              target.removeAttribute(attr);
            } else {
              target.setAttribute(attr, val);
            }
            syncControllerState();
          }
          return;
        }

        const toggleBtn = e.target.closest('.rd-toggle-chip');
        if (toggleBtn) {
          const attr = toggleBtn.getAttribute('data-attr');
          const target = getTarget();
          if (target && attr) {
            const currentVal = target.getAttribute(attr);
            const defaultOn = toggleBtn.getAttribute('data-default-on') === 'true';
            const isCurrentlyActive = currentVal === 'true' || (currentVal === null && defaultOn);
            const newVal = isCurrentlyActive ? 'false' : 'true';
            target.setAttribute(attr, newVal);
            syncControllerState();
          }
          return;
        }
      });

      function attachToTarget() {
        const target = getTarget();
        if (!target) {
          setTimeout(attachToTarget, 100);
          return;
        }

        try {
          if (initialAttrs) {
            Object.entries(initialAttrs).forEach(([key, val]) => {
              if (!target.hasAttribute(key) && val !== undefined && val !== null) {
                target.setAttribute(key, String(val));
              }
            });
          }
          if (target.hasAttribute('regular-font')) {
            target.style.setProperty('--font-sans', target.getAttribute('regular-font'));
          }
          if (target.hasAttribute('mono-font')) {
            target.style.setProperty('--font-mono', target.getAttribute('mono-font'));
          }
        } catch (_) {}

        target.addEventListener('spec-loaded', () => {
          statusDots.forEach(dot => dot.classList.add('is-loaded'));
        });

        target.addEventListener('after-render', () => {
          statusDots.forEach(dot => dot.classList.add('is-ready'));
          syncControllerState();
        });

        const observer = new MutationObserver(() => {
          syncControllerState();
        });
        observer.observe(target, { attributes: true });

        syncControllerState();
        if (customElements?.whenDefined) {
          customElements.whenDefined('rapi-doc').then(() => {
            syncControllerState();
          });
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', attachToTarget);
      } else {
        attachToTarget();
      }
    }

