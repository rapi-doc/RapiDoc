---
import { rapidocBuildInfo } from '../page-data/rapidoc-build-info';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
---

<footer class="rd-footer">
  <div class="rd-footer-container">
    <div class="rd-footer-col">
      <div class="rd-footer-brand">
        <img src="/assets/images/logo.png" alt="RapiDoc" width="28" height="28" />
        <span class="rd-footer-brand-title">RapiDoc</span>
      </div>
      <p class="rd-footer-tagline">The modern, framework-agnostic OpenAPI Web Component for developers and product leaders.</p>
      <div class="rd-footer-meta">
        {rapidocBuildInfo.versionTag} • MIT License © {new Date().getFullYear()} Mrinmoy Majumdar
      </div>
    </div>

    <div class="rd-footer-links-group">
      <div class="rd-footer-link-col">
        <span class="rd-footer-heading">Getting Started</span>
        <a href="/quickstart">QuickStart</a>
        <a href="/api">API Reference</a>
        <a href="/docs">Documentation</a>
        <a href="/guides">All Guides</a>
      </div>
      <div class="rd-footer-link-col">
        <span class="rd-footer-heading">Guides & Recipes</span>
        <a href="/guides/mock">Mock Server</a>
        <a href="/guides/oauth">OAuth 2.0 Setup</a>
        <a href="/guides/theme">Theme & Colors</a>
        <a href="/guides/css">Custom CSS</a>
        <a href="/guides/slots">Named HTML Slots</a>
        <a href="/guides/mini">RapiDoc Mini</a>
      </div>
      <div class="rd-footer-link-col">
        <span class="rd-footer-heading">Explore & Test</span>
        <a href="/examples">Examples Gallery</a>
        <a href="/examples/rapidoc-demo">Live Configurator</a>
        <a href="/sandbox">Spec Sandbox</a>
        <a href="/tests">Test Matrix</a>
        <a href="/tests/performance">Performance</a>
      </div>
      <div class="rd-footer-link-col">
        <span class="rd-footer-heading">Community</span>
        <a href="https://github.com/rapi-doc/RapiDoc" target="_blank" rel="noopener">GitHub</a>
        <a href="https://www.npmjs.com/package/rapidoc" target="_blank" rel="noopener">NPM Package</a>
        <a href="https://github.com/rapi-doc/RapiDoc/releases" target="_blank" rel="noopener">Releases</a>
        <a href="https://github.com/rapi-doc/RapiDoc/issues" target="_blank" rel="noopener">Issues</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .rd-footer {
    border-top: 1px solid var(--rd-border);
    background: rgba(4, 7, 15, 0.85);
    padding: 56px 24px 40px 24px;
    font-size: 13.5px;
    position: relative;
    z-index: 1;
  }
  .rd-footer-container {
    max-width: var(--rd-max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .rd-footer-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .rd-footer-brand {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .rd-footer-brand-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--rd-text-bright);
  }
  .rd-footer-tagline {
    color: var(--rd-text-muted);
    font-size: 13px;
    line-height: 1.5;
    max-width: 320px;
    margin: 0;
  }
  .rd-footer-meta {
    color: var(--rd-text-dim);
    font-size: 12px;
  }
  .rd-footer-links-group {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 28px;
  }
  .rd-footer-link-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .rd-footer-heading {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--rd-text-bright);
    margin-bottom: 4px;
  }
  .rd-footer-link-col a {
    color: var(--rd-text-muted);
    text-decoration: none;
    font-size: 13px;
    transition: color 0.15s ease;
  }
  .rd-footer-link-col a:hover {
    color: var(--rd-accent);
  }

  @media (min-width: 768px) {
    .rd-footer-container {
      grid-template-columns: 1.3fr 2fr;
    }
  }
</style>
