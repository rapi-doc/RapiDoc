---
/**
 * Starlight's <Card> with a Phosphor icon (components/Icon.astro) instead of a Starlight one, so the docs
 * use the site's one icon set. Same markup and classes as Starlight's, so its styles and the site's
 * card styles (styles/starlight-custom.css) apply; use it in MDX in place of Card.
 */
import Icon from './Icon.astro';

interface Props {
  /** A Phosphor icon name */
  icon?: string;
  title: string;
}

const { icon, title } = Astro.props;
---

<article class="card sl-flex">
  <p class="title sl-flex">
    {icon && <Icon name={icon} class="icon" size={24} weight="duotone" />}
    <span set:html={title} />
  </p>
  <div class="body"><slot /></div>
</article>

<style>
  @layer starlight.components {
    .card {
      --sl-card-border: var(--sl-color-purple);
      --sl-card-bg: var(--sl-color-purple-low);
      border: 1px solid var(--sl-color-gray-5);
      background-color: var(--sl-color-black);
      padding: clamp(1rem, calc(0.125rem + 3vw), 2.5rem);
      flex-direction: column;
      gap: clamp(0.5rem, calc(0.125rem + 1vw), 1rem);
    }
    .title {
      font-weight: 600;
      font-size: var(--sl-text-h4);
      color: var(--sl-color-white);
      line-height: var(--sl-line-height-headings);
      gap: 1rem;
      align-items: center;
    }
    /* The icon on its own, no box: 24px regular, the site's card standard */
    .card .icon {
      flex-shrink: 0;
    }
    .card .body {
      margin: 0;
      font-size: clamp(var(--sl-text-sm), calc(0.5rem + 1vw), var(--sl-text-body));
    }
  }
</style>
