---
import {
  IconBrandGithub,
  IconArrowLeft,
  IconArrowRight,
  IconArrowUpRight,
  IconArrowDown,
  IconCopy,
  IconSearch,
  IconX,
  IconCheck,
  IconExternalLink,
  IconInfoCircle,
} from '@tabler/icons-astro';

interface Props {
  name:
    | 'github'
    | 'arrow-left'
    | 'arrow-right'
    | 'arrow-up-right'
    | 'arrow-down'
    | 'copy'
    | 'search'
    | 'close'
    | 'check'
    | 'external'
    | 'info';
  size?: number;
  class?: string;
  stroke?: number;
}

const { name, size = 18, class: className = '', stroke = 2 } = Astro.props;
---

{name === 'github' && <IconBrandGithub size={size} class={className} stroke={stroke} />}
{name === 'arrow-left' && <IconArrowLeft size={size} class={className} stroke={stroke} />}
{name === 'arrow-right' && <IconArrowRight size={size} class={className} stroke={stroke} />}
{name === 'arrow-up-right' && <IconArrowUpRight size={size} class={className} stroke={stroke} />}
{name === 'arrow-down' && <IconArrowDown size={size} class={className} stroke={stroke} />}
{name === 'copy' && <IconCopy size={size} class={className} stroke={stroke} />}
{name === 'search' && <IconSearch size={size} class={className} stroke={stroke} />}
{name === 'close' && <IconX size={size} class={className} stroke={stroke} />}
{name === 'check' && <IconCheck size={size} class={className} stroke={stroke} />}
{name === 'external' && <IconExternalLink size={size} class={className} stroke={stroke} />}
{name === 'info' && <IconInfoCircle size={size} class={className} stroke={stroke} />}

