---
/**
 * A Phosphor icon (https://phosphoricons.com), inlined at build time: the one icon set of the site, as of
 * the RapiDoc Portal. Every icon keeps a 1.5px line. Phosphor draws its weights on a 256 grid with lines
 * of 8 (thin), 12 (light), 16 (regular) and 24 (bold), so at each size the weight whose line comes
 * closest to 1.5px is used: bold up to 18px, regular at 20-26px, light at 28px and above. Navigation icons
 * (the Products menu, the docs product switcher) are 20px: the regular weight, a lighter 1.25px line, as
 * in the RapiDoc Portal's navigation.
 */
import fs from 'node:fs';
import { iconsDir } from 'virtual:docs-icons';

interface Props {
  /** A Phosphor icon name, e.g. `arrow-right`, `file-code`, `github-logo` */
  name: string;
  size?: number;
  class?: string;
  [key: string]: any;
}

const { name, size = 18, class: className, stroke: _stroke, ...rest } = Astro.props;

const WEIGHTS = [
  { weight: 'thin', line: 8 },
  { weight: 'light', line: 12 },
  { weight: 'regular', line: 16 },
  { weight: 'bold', line: 24 },
] as const;
const target = (1.5 * 256) / size;
const { weight } = WEIGHTS.reduce((best, w) => (Math.abs(w.line - target) < Math.abs(best.line - target) ? w : best));

const file = (icon: string) => `${iconsDir}${weight}/${icon}${weight === 'regular' ? '' : `-${weight}`}.svg`;
let svg: string;
try {
  svg = fs.readFileSync(file(name), 'utf8');
} catch {
  console.warn(`[docs] Unknown icon "${name}": use a name from https://phosphoricons.com`);
  svg = fs.readFileSync(file('question'), 'utf8');
}
const inner = svg.slice(svg.indexOf('>') + 1, svg.lastIndexOf('</svg>'));
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 256 256"
  width={size}
  height={size}
  fill="currentColor"
  aria-hidden="true"
  class={className}
  {...rest}
  set:html={inner}
/>
