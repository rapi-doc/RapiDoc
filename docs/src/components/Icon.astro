---
import {
  IconBrandGithub,
  IconArrowLeft,
  IconArrowRight,
  IconArrowUpRight,
  IconArrowDown,
  IconCopy,
  IconSearch,
  IconX,
  IconCheck,
  IconExternalLink,
  IconInfoCircle,
  IconMenu2,
  IconLayoutGrid,
  IconChevronDown,
  IconFileCode,
  IconPuzzle,
  IconRoute,
  IconFileTypePdf,
  IconLayoutDashboard,
  IconTerminal2,
  IconServer,
  IconRobot,
  IconBolt,
  IconPlug,
} from '@tabler/icons-astro';

interface Props {
  name:
    | 'github'
    | 'arrow-left'
    | 'arrow-right'
    | 'arrow-up-right'
    | 'arrow-down'
    | 'copy'
    | 'search'
    | 'close'
    | 'check'
    | 'external'
    | 'info'
    | 'menu'
    | 'grid'
    | 'chevron-down'
    | 'file-code'
    | 'puzzle'
    | 'route'
    | 'file-pdf'
    | 'dashboard'
    | 'terminal'
    | 'server'
    | 'robot'
    | 'bolt'
    | 'plug';
  size?: number;
  class?: string;
  stroke?: number;
}

const { name, size = 18, class: className = '', stroke = 2 } = Astro.props;
---

{name === 'github' && <IconBrandGithub size={size} class={className} stroke={stroke} />}
{name === 'arrow-left' && <IconArrowLeft size={size} class={className} stroke={stroke} />}
{name === 'arrow-right' && <IconArrowRight size={size} class={className} stroke={stroke} />}
{name === 'arrow-up-right' && <IconArrowUpRight size={size} class={className} stroke={stroke} />}
{name === 'arrow-down' && <IconArrowDown size={size} class={className} stroke={stroke} />}
{name === 'copy' && <IconCopy size={size} class={className} stroke={stroke} />}
{name === 'search' && <IconSearch size={size} class={className} stroke={stroke} />}
{name === 'close' && <IconX size={size} class={className} stroke={stroke} />}
{name === 'check' && <IconCheck size={size} class={className} stroke={stroke} />}
{name === 'external' && <IconExternalLink size={size} class={className} stroke={stroke} />}
{name === 'info' && <IconInfoCircle size={size} class={className} stroke={stroke} />}
{name === 'menu' && <IconMenu2 size={size} class={className} stroke={stroke} />}
{name === 'grid' && <IconLayoutGrid size={size} class={className} stroke={stroke} />}
{name === 'chevron-down' && <IconChevronDown size={size} class={className} stroke={stroke} />}
{name === 'file-code' && <IconFileCode size={size} class={className} stroke={stroke} />}
{name === 'puzzle' && <IconPuzzle size={size} class={className} stroke={stroke} />}
{name === 'route' && <IconRoute size={size} class={className} stroke={stroke} />}
{name === 'file-pdf' && <IconFileTypePdf size={size} class={className} stroke={stroke} />}
{name === 'dashboard' && <IconLayoutDashboard size={size} class={className} stroke={stroke} />}
{name === 'terminal' && <IconTerminal2 size={size} class={className} stroke={stroke} />}
{name === 'server' && <IconServer size={size} class={className} stroke={stroke} />}
{name === 'robot' && <IconRobot size={size} class={className} stroke={stroke} />}
{name === 'bolt' && <IconBolt size={size} class={className} stroke={stroke} />}
{name === 'plug' && <IconPlug size={size} class={className} stroke={stroke} />}
