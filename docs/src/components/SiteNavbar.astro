---
import { rapidocBuildInfo } from '../page-data/rapidoc-build-info';
import { NAV_LINKS, resolveActiveNavKey, isNavActive, type NavPageKey } from '../page-data/nav';
import Icon from './Icon.astro';
import { PRODUCT_GROUPS, ALL_PACKAGES } from '../page-data/products';

interface Props {
  activePage?: NavPageKey;
}

const { activePage = 'other' } = Astro.props;
const pathname = Astro.url.pathname;
const current = resolveActiveNavKey(pathname, activePage);
---

<header class:list={['rd-navbar', { 'rd-navbar--docs': activePage === 'docs' }]}>
  <div class="rd-nav-container">
    <a href="/" class="rd-brand">
      <img src="/assets/images/rapidoc-lockup-dark.svg" alt="RapiDoc" class="rd-logo" width="167" height="28" />
      <span class="rd-version-badge" title={`RapiDoc ${rapidocBuildInfo.versionTag} (${rapidocBuildInfo.bundle.minified.formatted})`}>
        {rapidocBuildInfo.versionShort}
      </span>
    </a>

    <nav class="rd-nav-links">
      <!-- The Products menu: a disclosure (button + panel), opened by a click, or by hovering with a
           mouse. The panel spans the navbar's width, under it. -->
      <div class="rd-products">
        <button
          type="button"
          class="rd-nav-link rd-products-btn"
          aria-expanded="false"
          aria-controls="rd-products-panel"
        >
          <span>Products</span>
          <Icon name="chevron-down" size={14} class="rd-products-chevron" />
        </button>
        <div id="rd-products-panel" class="rd-products-panel" hidden>
          <div class="rd-products-inner">
            {
              PRODUCT_GROUPS.map((group) => (
                <section class:list={['rd-products-col', `rd-products-col--${group.key}`]} aria-labelledby={`rd-products-h-${group.key}`}>
                  <h2 class="rd-products-heading" id={`rd-products-h-${group.key}`}>{group.label}</h2>
                  <ul class="rd-products-list">
                    {group.items.map((item) => (
                      <li>
                        <a
                          href={item.href}
                          class:list={['rd-product', { 'rd-product--compact': !item.description }]}
                          target={item.external ? '_blank' : undefined}
                          rel={item.external ? 'noopener' : undefined}
                        >
                          {item.icon && (
                            <span class="rd-product-icon">
                              <Icon name={item.icon} size={18} />
                            </span>
                          )}
                          <span class="rd-product-text">
                            <span class="rd-product-name">
                              {item.label}
                              {item.tag && <code class="rd-product-tag">{item.tag}</code>}
                              {item.external && <Icon name="arrow-up-right" size={12} class="rd-product-ext" />}
                            </span>
                            {item.description && <span class="rd-product-desc">{item.description}</span>}
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </section>
              ))
            }
          </div>
          <div class="rd-products-footer">
            <a href={ALL_PACKAGES.href} class="rd-products-all">
              {ALL_PACKAGES.label}
              <Icon name="arrow-right" size={14} />
            </a>
          </div>
        </div>
      </div>
      {
        NAV_LINKS.map((item) => {
          const active = isNavActive(item, current, pathname);
          return (
            <a href={item.href} class={`rd-nav-link ${item.pill ? 'rd-nav-link-dryrun' : ''} ${active ? 'active' : ''}`} title={item.title}>
              <span>{item.label}</span>
              {item.pill && <span class="rd-dev-pill">{item.pill}</span>}
            </a>
          );
        })
      }
    </nav>

    <div class="rd-nav-actions">
      <!-- Same width on every page, empty except on the Starlight /docs/ pages (DocsHeader), so the
           links don't move when the search box appears -->
      <div class="rd-nav-search">
        <slot name="search" />
      </div>
      <a href="https://github.com/rapi-doc/RapiDoc" target="_blank" rel="noopener" class="rd-btn rd-btn-ghost rd-github-btn">
        <Icon name="github" size={18} />
        <span class="rd-github-label">GitHub</span>
      </a>
      <!-- Below 860px the links move into this menu (a disclosure: the script toggles aria-expanded and hidden) -->
      <button
        type="button"
        class="rd-btn rd-btn-ghost rd-menu-btn"
        aria-expanded="false"
        aria-controls="rd-site-menu"
        aria-label="Site menu"
      >
        <!-- On /docs/ a grid, so it isn't confused with Starlight's sidebar menu (a hamburger) beside it -->
        <span class="rd-menu-icon rd-menu-icon--open"><Icon name={activePage === 'docs' ? 'grid' : 'menu'} size={18} /></span>
        <span class="rd-menu-icon rd-menu-icon--close"><Icon name="close" size={18} /></span>
      </button>
    </div>
  </div>

  <nav id="rd-site-menu" class="rd-site-menu" aria-label="Site" hidden>
    <details class="rd-site-menu-products">
      <summary class="rd-site-menu-link">
        <span>Products</span>
        <Icon name="chevron-down" size={16} class="rd-products-chevron" />
      </summary>
      {
        PRODUCT_GROUPS.map((group) => (
          <div class="rd-site-menu-group">
            <span class="rd-site-menu-heading">{group.label}</span>
            {group.items.map((item) => (
              <a
                href={item.href}
                class="rd-site-menu-sublink"
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener' : undefined}
              >
                {item.label}
                {item.external && <Icon name="arrow-up-right" size={12} />}
              </a>
            ))}
          </div>
        ))
      }
    </details>
    {
      NAV_LINKS.map((item) => {
        const active = isNavActive(item, current, pathname);
        return (
          <a href={item.href} class:list={['rd-site-menu-link', { active }]} aria-current={active ? 'page' : undefined}>
            <span>{item.label}</span>
            {item.pill && <span class="rd-dev-pill">{item.pill}</span>}
          </a>
        );
      })
    }
  </nav>
</header>

<script>
  // The Products menu. A click toggles it; with a mouse, hovering opens it and leaving closes it
  // after a short delay, unless it was clicked open. Escape closes it and returns focus to the
  // button; so do a click outside, focus moving out of it, and shrinking the window below 860px.
  for (const products of document.querySelectorAll<HTMLElement>('.rd-products')) {
    const button = products.querySelector<HTMLButtonElement>('.rd-products-btn');
    const panel = products.querySelector<HTMLElement>('.rd-products-panel');
    if (!button || !panel) continue;
    let byHover = false;
    let timer: ReturnType<typeof setTimeout> | undefined;
    const setOpen = (open: boolean, hover = false) => {
      clearTimeout(timer);
      byHover = open && hover;
      button.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    };
    button.addEventListener('click', () => {
      // Hovered open, then clicked: keep it open, as if clicked open
      if (!panel.hidden && byHover) byHover = false;
      else setOpen(panel.hidden);
    });
    products.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      clearTimeout(timer);
      if (panel.hidden) timer = setTimeout(() => setOpen(true, true), 120);
    });
    products.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse') return;
      clearTimeout(timer);
      if (panel.hidden) return;
      if (byHover) timer = setTimeout(() => setOpen(false), 200);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        button.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (!panel.hidden && !products.contains(e.target as Node)) setOpen(false);
    });
    products.addEventListener('focusout', (e) => {
      if (!panel.hidden && !products.contains(e.relatedTarget as Node | null) && e.relatedTarget) setOpen(false);
    });
    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    window.matchMedia('(min-width: 860px)').addEventListener('change', (e) => {
      if (!e.matches) setOpen(false);
    });
  }

  // The site menu below 860px. Escape closes it and returns focus to the button; so do a click
  // outside, picking a link, and growing the window past the breakpoint.
  for (const navbar of document.querySelectorAll<HTMLElement>('.rd-navbar')) {
    const button = navbar.querySelector<HTMLButtonElement>('.rd-menu-btn');
    const menu = navbar.querySelector<HTMLElement>('.rd-site-menu');
    if (!button || !menu) continue;
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
    };
    button.addEventListener('click', () => setOpen(menu.hidden));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        button.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (!menu.hidden && !navbar.contains(e.target as Node)) setOpen(false);
    });
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    window.matchMedia('(min-width: 860px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>

<style>
  .rd-navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(16px);
    background: var(--rd-bg-glass);
    border-bottom: 1px solid var(--rd-border);
  }
  .rd-nav-container {
    max-width: var(--rd-max-width);
    margin: 0 auto;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .rd-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .rd-logo {
    display: block;
    width: auto;
    height: 28px;
  }
  .rd-version-badge {
    font-size: 11px;
    padding: 2px 7px;
    border-radius: var(--rd-radius-md);
    background: var(--rd-accent-dim);
    color: var(--rd-accent);
    border: 1px solid var(--rd-accent-border);
    font-family: var(--rd-font-mono);
    font-weight: 600;
  }
  .rd-nav-links {
    display: none;
    align-items: center;
    gap: 24px;
  }
  /* Heights are fixed here, so the bar is the same on the site pages and under Starlight's base styles */
  .rd-nav-link {
    color: var(--rd-text-muted);
    font-size: 14px;
    line-height: 22px;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease;
  }
  .rd-nav-link:hover,
  .rd-nav-link.active {
    color: var(--rd-text-bright);
  }
  .rd-nav-link.active {
    color: var(--rd-accent);
  }
  .rd-nav-link-dryrun {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .rd-dev-pill {
    font-size: 9px;
    padding: 1px 5px;
    border-radius: var(--rd-radius-xs);
    background: color-mix(in srgb, var(--rd-amber) 15%, transparent);
    color: var(--rd-amber);
    border: 1px solid color-mix(in srgb, var(--rd-amber) 30%, transparent);
    font-weight: 700;
    letter-spacing: 0.05em;
    font-family: var(--rd-font-mono);
    line-height: 1.2;
    transition: var(--rd-transition);
  }
  .rd-nav-link-dryrun:hover .rd-dev-pill,
  .rd-nav-link-dryrun.active .rd-dev-pill {
    background: color-mix(in srgb, var(--rd-amber) 25%, transparent);
    border-color: color-mix(in srgb, var(--rd-amber) 60%, transparent);
    color: var(--rd-amber-light);
    box-shadow: 0 0 8px color-mix(in srgb, var(--rd-amber) 25%, transparent);
  }
  /* The Products menu. The panel is positioned against .rd-navbar (sticky), so nothing between them
     may be positioned. */
  .rd-products-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 0;
    background: none;
    border: none;
    font-family: inherit;
    cursor: pointer;
  }
  .rd-products-btn[aria-expanded='true'] {
    color: var(--rd-text-bright);
  }
  .rd-products-btn :global(.rd-products-chevron) {
    transition: transform 0.15s ease;
  }
  .rd-products-btn[aria-expanded='true'] :global(.rd-products-chevron),
  .rd-site-menu-products[open] :global(.rd-products-chevron) {
    transform: rotate(180deg);
  }
  .rd-products-panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--rd-menu-bg, var(--rd-bg));
    border-bottom: 1px solid var(--rd-border);
    box-shadow: var(--rd-shadow-panel);
  }
  .rd-products-panel[hidden] {
    display: none;
  }
  .rd-products-inner {
    max-width: var(--rd-max-width);
    margin: 0 auto;
    padding: 24px 24px 16px;
    display: grid;
    grid-template-columns: 1.15fr 1.15fr 0.85fr;
    gap: 32px;
  }
  .rd-products-heading {
    margin: 0 0 10px;
    padding: 0 10px;
    font-size: 11px;
    line-height: 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--rd-text-dim);
  }
  .rd-products-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .rd-product {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 8px 10px;
    border-radius: var(--rd-radius-lg);
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .rd-product:hover,
  .rd-product:focus-visible {
    background: var(--rd-wash);
  }
  .rd-product--compact {
    padding-block: 6px;
  }
  .rd-product-icon {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--rd-radius-lg);
    background: var(--rd-wash);
    border: 1px solid var(--rd-border);
    color: var(--rd-accent);
    transition: border-color 0.15s ease;
  }
  .rd-product:hover .rd-product-icon {
    border-color: var(--rd-accent-border);
  }
  .rd-product-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .rd-product-name {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 14px;
    line-height: 20px;
    font-weight: 600;
    color: var(--rd-text-bright);
  }
  .rd-product--compact .rd-product-name {
    font-weight: 500;
    color: var(--rd-text-muted);
  }
  .rd-product--compact:hover .rd-product-name {
    color: var(--rd-text-bright);
  }
  .rd-product-tag {
    font-family: var(--rd-font-mono);
    font-size: 11px;
    font-weight: 500;
    line-height: 16px;
    color: var(--rd-text-dim);
    background: none;
    padding: 0;
  }
  .rd-product-name :global(.rd-product-ext) {
    color: var(--rd-text-dim);
  }
  .rd-product-desc {
    font-size: 12.5px;
    line-height: 18px;
    color: var(--rd-text-muted);
  }
  .rd-products-footer {
    max-width: var(--rd-max-width);
    margin: 0 auto;
    padding: 0 24px 18px;
  }
  .rd-products-all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    font-size: 13px;
    line-height: 20px;
    font-weight: 600;
    color: var(--rd-accent);
    text-decoration: none;
  }
  .rd-products-all:hover {
    color: var(--rd-accent-light);
  }
  @media (max-width: 1100px) {
    .rd-products-inner {
      grid-template-columns: 1fr 1fr;
    }
    .rd-products-col--integrations {
      grid-column: 1 / -1;
    }
    .rd-products-col--integrations .rd-products-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    }
  }

  /* Products in the small-screen menu: a native disclosure */
  .rd-site-menu-products > summary {
    list-style: none;
    cursor: pointer;
    justify-content: space-between;
  }
  .rd-site-menu-products > summary::-webkit-details-marker {
    display: none;
  }
  .rd-site-menu-group {
    display: flex;
    flex-direction: column;
    padding: 4px 0 8px 12px;
  }
  .rd-site-menu-heading {
    padding: 6px 12px;
    font-size: 11px;
    line-height: 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--rd-text-dim);
  }
  .rd-site-menu-sublink {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border-radius: var(--rd-radius-sm);
    font-size: 14px;
    line-height: 20px;
    color: var(--rd-text-muted);
    text-decoration: none;
  }
  .rd-site-menu-sublink:hover {
    color: var(--rd-text-bright);
    background: var(--rd-wash);
  }
  .rd-nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .rd-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    box-sizing: border-box;
    height: 36px;
    line-height: 20px;
    padding: 0 16px;
    border-radius: var(--rd-radius-md);
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: var(--rd-transition);
    border: none;
  }
  .rd-btn-primary {
    background: var(--rd-accent-dim);
    border: 1px solid var(--rd-accent-border);
    color: var(--rd-accent-light);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  }
  .rd-btn-primary:hover {
    background: color-mix(in srgb, var(--rd-accent) 22%, transparent);
    border-color: var(--rd-accent);
    color: var(--rd-text-bright);
    box-shadow: 0 4px 16px var(--rd-accent-glow);
    transform: translateY(-1px);
  }
  .rd-btn-ghost {
    background: transparent;
    color: var(--rd-text-muted);
    border: 1px solid var(--rd-border);
  }
  .rd-btn-ghost:hover {
    background: var(--rd-wash);
    color: var(--rd-text-bright);
  }
  .rd-nav-search {
    display: flex;
    justify-content: flex-end;
  }
  /* The menu button and its panel: below 860px, where the links are hidden */
  .rd-menu-btn {
    width: 36px;
    padding: 0;
    justify-content: center;
  }
  .rd-menu-icon {
    display: inline-flex;
  }
  .rd-menu-btn[aria-expanded='true'] .rd-menu-icon--open,
  .rd-menu-btn[aria-expanded='false'] .rd-menu-icon--close {
    display: none;
  }
  .rd-site-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    padding: 8px 16px 16px;
    /* With Products open it can be taller than a phone's screen */
    max-height: calc(100dvh - 64px);
    overflow-y: auto;
    /* Opaque, so the page doesn't show through (the /docs/ pages set --rd-menu-bg) */
    background: var(--rd-menu-bg, var(--rd-bg));
    border-bottom: 1px solid var(--rd-border);
    box-shadow: var(--rd-shadow-panel);
  }
  .rd-site-menu[hidden] {
    display: none;
  }
  .rd-site-menu-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    border-radius: var(--rd-radius-sm);
    font-size: 15px;
    line-height: 22px;
    font-weight: 500;
    color: var(--rd-text-muted);
    text-decoration: none;
  }
  .rd-site-menu-link:hover {
    color: var(--rd-text-bright);
    background: var(--rd-wash);
  }
  .rd-site-menu-link.active {
    color: var(--rd-accent);
    background: var(--rd-accent-dim);
  }

  /* On the Starlight /docs/ pages below 50rem, Starlight's own menu button sits fixed in the top-right
     corner: leave room for it */
  @media (max-width: 49.99rem) {
    .rd-navbar--docs .rd-nav-container {
      padding-right: 64px;
    }
    /* Starlight's menu shows the GitHub link there */
    .rd-navbar--docs .rd-github-btn {
      display: none;
    }
  }

  /* The links show from 860px; the search slot is the full box from 1000px and an icon below */
  @media (min-width: 860px) {
    .rd-nav-links {
      display: flex;
    }
    .rd-nav-search {
      width: 36px;
    }
    .rd-menu-btn,
    .rd-site-menu {
      display: none;
    }
  }
  @media (min-width: 1000px) {
    .rd-nav-search {
      width: 150px;
    }
  }
  /* Less room up to 1100px: tighter links, GitHub as an icon; up to 900px, no version badge */
  @media (max-width: 1100px) {
    .rd-nav-links {
      gap: 16px;
    }
    .rd-github-label {
      display: none;
    }
  }
  @media (max-width: 900px) {
    .rd-nav-links {
      gap: 12px;
    }
    .rd-version-badge {
      display: none;
    }
  }
</style>
