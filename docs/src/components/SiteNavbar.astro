---
import { rapidocBuildInfo } from '../page-data/rapidoc-build-info';
import { NAV_LINKS, resolveActiveNavKey, isNavActive, type NavPageKey } from '../page-data/nav';
import Icon from './Icon.astro';

interface Props {
  activePage?: NavPageKey;
}

const { activePage = 'other' } = Astro.props;
const pathname = Astro.url.pathname;
const current = resolveActiveNavKey(pathname, activePage);
---

<header class:list={['rd-navbar', { 'rd-navbar--docs': activePage === 'docs' }]}>
  <div class="rd-nav-container">
    <a href="/" class="rd-brand">
      <img src="/assets/images/rapidoc-lockup-dark.svg" alt="RapiDoc" class="rd-logo" width="167" height="28" />
      <span class="rd-version-badge" title={`RapiDoc ${rapidocBuildInfo.versionTag} (${rapidocBuildInfo.bundle.minified.formatted})`}>
        {rapidocBuildInfo.versionShort}
      </span>
    </a>

    <nav class="rd-nav-links">
      {
        NAV_LINKS.map((item) => {
          const active = isNavActive(item, current, pathname);
          return (
            <a href={item.href} class={`rd-nav-link ${item.pill ? 'rd-nav-link-dryrun' : ''} ${active ? 'active' : ''}`} title={item.title}>
              <span>{item.label}</span>
              {item.pill && <span class="rd-dev-pill">{item.pill}</span>}
            </a>
          );
        })
      }
    </nav>

    <div class="rd-nav-actions">
      <!-- Same width on every page, empty except on the Starlight /docs/ pages (DocsHeader), so the
           links don't move when the search box appears -->
      <div class="rd-nav-search">
        <slot name="search" />
      </div>
      <a href="https://github.com/rapi-doc/RapiDoc" target="_blank" rel="noopener" class="rd-btn rd-btn-ghost rd-github-btn">
        <Icon name="github" size={18} />
        <span class="rd-github-label">GitHub</span>
      </a>
      <!-- Below 860px the links move into this menu (a disclosure: the script toggles aria-expanded and hidden) -->
      <button
        type="button"
        class="rd-btn rd-btn-ghost rd-menu-btn"
        aria-expanded="false"
        aria-controls="rd-site-menu"
        aria-label="Site menu"
      >
        <!-- On /docs/ a grid, so it isn't confused with Starlight's sidebar menu (a hamburger) beside it -->
        <span class="rd-menu-icon rd-menu-icon--open"><Icon name={activePage === 'docs' ? 'grid' : 'menu'} size={18} /></span>
        <span class="rd-menu-icon rd-menu-icon--close"><Icon name="close" size={18} /></span>
      </button>
    </div>
  </div>

  <nav id="rd-site-menu" class="rd-site-menu" aria-label="Site" hidden>
    {
      NAV_LINKS.map((item) => {
        const active = isNavActive(item, current, pathname);
        return (
          <a href={item.href} class:list={['rd-site-menu-link', { active }]} aria-current={active ? 'page' : undefined}>
            <span>{item.label}</span>
            {item.pill && <span class="rd-dev-pill">{item.pill}</span>}
          </a>
        );
      })
    }
  </nav>
</header>

<script>
  // The site menu below 860px. Escape closes it and returns focus to the button; so do a click
  // outside, picking a link, and growing the window past the breakpoint.
  for (const navbar of document.querySelectorAll<HTMLElement>('.rd-navbar')) {
    const button = navbar.querySelector<HTMLButtonElement>('.rd-menu-btn');
    const menu = navbar.querySelector<HTMLElement>('.rd-site-menu');
    if (!button || !menu) continue;
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
    };
    button.addEventListener('click', () => setOpen(menu.hidden));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        button.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (!menu.hidden && !navbar.contains(e.target as Node)) setOpen(false);
    });
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    window.matchMedia('(min-width: 860px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>

<style>
  .rd-navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(16px);
    background: var(--rd-bg-glass);
    border-bottom: 1px solid var(--rd-border);
  }
  .rd-nav-container {
    max-width: var(--rd-max-width);
    margin: 0 auto;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .rd-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .rd-logo {
    display: block;
    width: auto;
    height: 28px;
  }
  .rd-version-badge {
    font-size: 11px;
    padding: 2px 7px;
    border-radius: var(--rd-radius-md);
    background: var(--rd-accent-dim);
    color: var(--rd-accent);
    border: 1px solid var(--rd-accent-border);
    font-family: var(--rd-font-mono);
    font-weight: 600;
  }
  .rd-nav-links {
    display: none;
    align-items: center;
    gap: 24px;
  }
  /* Heights are fixed here, so the bar is the same on the site pages and under Starlight's base styles */
  .rd-nav-link {
    color: var(--rd-text-muted);
    font-size: 14px;
    line-height: 22px;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease;
  }
  .rd-nav-link:hover,
  .rd-nav-link.active {
    color: var(--rd-text-bright);
  }
  .rd-nav-link.active {
    color: var(--rd-accent);
  }
  .rd-nav-link-dryrun {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .rd-dev-pill {
    font-size: 9px;
    padding: 1px 5px;
    border-radius: var(--rd-radius-xs);
    background: color-mix(in srgb, var(--rd-amber) 15%, transparent);
    color: var(--rd-amber);
    border: 1px solid color-mix(in srgb, var(--rd-amber) 30%, transparent);
    font-weight: 700;
    letter-spacing: 0.05em;
    font-family: var(--rd-font-mono);
    line-height: 1.2;
    transition: var(--rd-transition);
  }
  .rd-nav-link-dryrun:hover .rd-dev-pill,
  .rd-nav-link-dryrun.active .rd-dev-pill {
    background: color-mix(in srgb, var(--rd-amber) 25%, transparent);
    border-color: color-mix(in srgb, var(--rd-amber) 60%, transparent);
    color: var(--rd-amber-light);
    box-shadow: 0 0 8px color-mix(in srgb, var(--rd-amber) 25%, transparent);
  }
  .rd-nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .rd-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    box-sizing: border-box;
    height: 36px;
    line-height: 20px;
    padding: 0 16px;
    border-radius: var(--rd-radius-md);
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: var(--rd-transition);
    border: none;
  }
  .rd-btn-primary {
    background: var(--rd-accent-dim);
    border: 1px solid var(--rd-accent-border);
    color: var(--rd-accent-light);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  }
  .rd-btn-primary:hover {
    background: color-mix(in srgb, var(--rd-accent) 22%, transparent);
    border-color: var(--rd-accent);
    color: var(--rd-text-bright);
    box-shadow: 0 4px 16px var(--rd-accent-glow);
    transform: translateY(-1px);
  }
  .rd-btn-ghost {
    background: transparent;
    color: var(--rd-text-muted);
    border: 1px solid var(--rd-border);
  }
  .rd-btn-ghost:hover {
    background: var(--rd-wash);
    color: var(--rd-text-bright);
  }
  .rd-nav-search {
    display: flex;
    justify-content: flex-end;
  }
  /* The menu button and its panel: below 860px, where the links are hidden */
  .rd-menu-btn {
    width: 36px;
    padding: 0;
    justify-content: center;
  }
  .rd-menu-icon {
    display: inline-flex;
  }
  .rd-menu-btn[aria-expanded='true'] .rd-menu-icon--open,
  .rd-menu-btn[aria-expanded='false'] .rd-menu-icon--close {
    display: none;
  }
  .rd-site-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    padding: 8px 16px 16px;
    /* Opaque, so the page doesn't show through (the /docs/ pages set --rd-menu-bg) */
    background: var(--rd-menu-bg, var(--rd-bg));
    border-bottom: 1px solid var(--rd-border);
    box-shadow: var(--rd-shadow-panel);
  }
  .rd-site-menu[hidden] {
    display: none;
  }
  .rd-site-menu-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    border-radius: var(--rd-radius-sm);
    font-size: 15px;
    line-height: 22px;
    font-weight: 500;
    color: var(--rd-text-muted);
    text-decoration: none;
  }
  .rd-site-menu-link:hover {
    color: var(--rd-text-bright);
    background: var(--rd-wash);
  }
  .rd-site-menu-link.active {
    color: var(--rd-accent);
    background: var(--rd-accent-dim);
  }

  /* On the Starlight /docs/ pages below 50rem, Starlight's own menu button sits fixed in the top-right
     corner: leave room for it */
  @media (max-width: 49.99rem) {
    .rd-navbar--docs .rd-nav-container {
      padding-right: 64px;
    }
    /* Starlight's menu shows the GitHub link there */
    .rd-navbar--docs .rd-github-btn {
      display: none;
    }
  }

  /* The links show from 860px; the search slot is the full box from 1000px and an icon below */
  @media (min-width: 860px) {
    .rd-nav-links {
      display: flex;
    }
    .rd-nav-search {
      width: 36px;
    }
    .rd-menu-btn,
    .rd-site-menu {
      display: none;
    }
  }
  @media (min-width: 1000px) {
    .rd-nav-search {
      width: 150px;
    }
  }
  /* Less room up to 1100px: tighter links, GitHub as an icon; up to 900px, no version badge */
  @media (max-width: 1100px) {
    .rd-nav-links {
      gap: 16px;
    }
    .rd-github-label {
      display: none;
    }
  }
  @media (max-width: 900px) {
    .rd-nav-links {
      gap: 12px;
    }
    .rd-version-badge {
      display: none;
    }
  }
</style>
