---
/**
 * The theming attributes, tried out on a sketch of <rapi-doc>: controls for theme, color-scheme, radius,
 * scale and nav-item-spacing, a wireframe that shows only what they change, and the matching HTML. A
 * schematic on purpose, so the reader looks at the parts that change; the real element with every setting
 * is on /examples/themes.
 *
 * Nothing here is typed in by hand. Read at build time from RapiDoc's source:
 * - colors: the presets' accent, foreground-on-accent and surfaces (THEMES of styles/theme-tokens.js), the
 *   color-scheme defaults and the card, muted and border formulas (its CSS), used as the same custom
 *   properties (--background, --card, ...) so color-mix() gives what the element shows;
 * - sizes: the --radius, --font-size-regular, --sidebar-width and --sidebar-item-padding values;
 * - allowed values and defaults: the API manifest of rapidoc.ts (page-data/rapidoc-api.ts).
 */
import themeCss, { THEMES, THEME_PRESETS } from '~/styles/theme-tokens.js';
import { API_ELEMENTS, readElementApi, type RapidocAttribute } from '../page-data/rapidoc-api';

const cssText: string = (themeCss as { cssText: string }).cssText;
const prop = (decls: string, name: string) =>
  decls.match(new RegExp(`${name}:\\s*([^;]+);`))?.[1].trim();
// Every rule of the form :host([attr='value']) ... { ... }, merged per value (a value can have several)
const rules = (attr: string) => {
  const out: Record<string, string> = {};
  for (const m of cssText.matchAll(new RegExp(`:host\\(\\[${attr}='([\\w-]+)'\\]\\)[^{]*\\{([^}]*)\\}`, 'g'))) {
    out[m[1]] = (out[m[1]] ?? '') + m[2];
  }
  return out;
};

// The surfaces a color scheme sets when the theme doesn't, and the formulas of the derived tokens
const schemes = rules('color-scheme');
const SURFACE_TOKENS = ['--background', '--foreground', '--card', '--muted', '--muted-foreground', '--border'];
const surfaces = (scheme: 'dark' | 'light', themeDecls = '') =>
  Object.fromEntries(
    [...SURFACE_TOKENS, '--primary', '--primary-foreground'].map((t) => [
      t,
      prop(themeDecls, t) ?? prop(schemes[scheme] ?? '', t) ?? '',
    ]),
  );
const palette = Object.fromEntries(
  (THEME_PRESETS as string[]).map((name) => [
    name,
    {
      dark: surfaces('dark', (THEMES as Record<string, { dark: string; light: string }>)[name].dark),
      light: surfaces('light', (THEMES as Record<string, { dark: string; light: string }>)[name].light),
    },
  ]),
);
// A custom color only sets the accent (applyCustomTheme): the rest is the scheme's
const customBase = { dark: surfaces('dark'), light: surfaces('light') };

const radius = Object.fromEntries(Object.entries(rules('radius')).map(([k, d]) => [k, prop(d, '--radius')]));
const scale = Object.fromEntries(
  Object.entries(rules('scale')).map(([k, d]) => [
    k,
    { font: prop(d, '--font-size-regular'), sidebar: prop(d, '--sidebar-width') },
  ]),
);
const navSpacing = Object.fromEntries(
  Object.entries(rules('nav-item-spacing')).map(([k, d]) => [k, prop(d, '--sidebar-item-padding')?.split(/\s+/)[0]]),
);

// Allowed values and defaults, from the element's declarations
const manifest = readElementApi(API_ELEMENTS[0]);
const attrs = new Map<string, RapidocAttribute>();
for (const group of manifest.Attributes) {
  for (const a of Object.values(group)[0] as RapidocAttribute[]) attrs.set(a.name, a);
}
const valuesOf = (name: string) => (attrs.get(name)?.allowed ?? []).filter((v) => !/[\s(]/.test(v));
const defaultOf = (name: string) => String(attrs.get(name)?.default ?? '');

const controls = [
  // color-scheme: system and auto follow the reader's setup, so the sketch offers the two it can draw
  { name: 'color-scheme', label: 'Color scheme', values: valuesOf('color-scheme').filter((v) => v === 'dark' || v === 'light') },
  { name: 'radius', label: 'Radius', values: valuesOf('radius') },
  { name: 'scale', label: 'Scale', values: valuesOf('scale') },
  { name: 'nav-item-spacing', label: 'Sidebar spacing', values: valuesOf('nav-item-spacing') },
];
const initial = {
  theme: defaultOf('theme') || 'amber',
  'color-scheme': defaultOf('color-scheme') || 'dark',
  radius: defaultOf('radius'),
  scale: defaultOf('scale'),
  'nav-item-spacing': defaultOf('nav-item-spacing'),
};
const config = { palette, customBase, radius, scale, navSpacing, initial, order: ['theme', ...controls.map((c) => c.name)] };
const uid = `td-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="td not-content" data-config={JSON.stringify(config)}>
  <div class="td-controls">
    <fieldset class="td-field">
      <legend>Theme</legend>
      <div class="td-options">
        {
          (THEME_PRESETS as string[]).map((name) => (
            <label class="td-option">
              <input type="radio" name={`${uid}-theme`} value={name} checked={name === initial.theme} data-attr="theme" />
              <span class="td-chip">
                <span class="td-swatch" style={`background:${palette[name][initial['color-scheme'] as 'dark' | 'light']['--primary']}`} data-swatch={name} />
                {name}
              </span>
            </label>
          ))
        }
        <label class="td-option td-custom" title="Any #hex color">
          <input type="radio" name={`${uid}-theme`} value="custom" data-attr="theme" />
          <span class="td-chip">
            <input type="color" class="td-color" value="#2563eb" aria-label="Custom brand color" />
            custom
          </span>
        </label>
      </div>
    </fieldset>
    {
      controls.map((c) => (
        <fieldset class="td-field">
          <legend>{c.label}</legend>
          <div class="td-options">
            {c.values.map((v) => (
              <label class="td-option">
                <input type="radio" name={`${uid}-${c.name}`} value={v} checked={v === initial[c.name as keyof typeof initial]} data-attr={c.name} />
                <span class="td-chip">{v}</span>
              </label>
            ))}
          </div>
        </fieldset>
      ))
    }
  </div>

  <div class="td-frame" role="img" aria-label="A sketch of RapiDoc with the chosen theme, color scheme, radius, scale and sidebar spacing">
    <div class="td-header">
      <span class="td-logo"></span>
      <span class="td-search"></span>
      <span class="td-btn td-btn-primary"></span>
    </div>
    <div class="td-body">
      <div class="td-nav">
        <span class="td-nav-filter"></span>
        <span class="td-nav-group"></span>
        <span class="td-nav-item" style="--w: 62%"></span>
        <span class="td-nav-item td-active" style="--w: 74%"></span>
        <span class="td-nav-item" style="--w: 55%"></span>
        <span class="td-nav-group"></span>
        <span class="td-nav-item" style="--w: 68%"></span>
        <span class="td-nav-item" style="--w: 50%"></span>
        <span class="td-nav-item" style="--w: 60%"></span>
      </div>
      <div class="td-main">
        <span class="td-title"></span>
        <span class="td-text" style="--w: 92%"></span>
        <span class="td-text" style="--w: 70%"></span>
        <div class="td-op">
          <span class="td-method">GET</span>
          <span class="td-path"></span>
        </div>
        <div class="td-cards">
          <div class="td-card">
            <span class="td-label"></span>
            <span class="td-input"></span>
            <span class="td-input" style="--w: 60%"></span>
            <span class="td-btn td-btn-primary td-try">TRY</span>
          </div>
          <div class="td-card">
            <div class="td-tabs"><span class="td-tab td-tab-active"></span><span class="td-tab"></span></div>
            <span class="td-code" style="--w: 80%"></span>
            <span class="td-code td-code-accent" style="--w: 55%"></span>
            <span class="td-code" style="--w: 70%"></span>
            <span class="td-code" style="--w: 45%"></span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="td-code-block">
    <div class="td-code-head">
      <span>index.html</span>
      <button type="button" class="td-copy">Copy</button>
    </div>
    <pre><code class="td-html"></code></pre>
  </div>
  <p class="td-note">
    A sketch: it shows only what these attributes change. The real element, with every setting, is on the
    <a href="/examples/themes">Themes example</a>.
  </p>
</div>

<script>
  type Palette = Record<string, string>;
  interface Config {
    palette: Record<string, { dark: Palette; light: Palette }>;
    customBase: { dark: Palette; light: Palette };
    radius: Record<string, string>;
    scale: Record<string, { font: string; sidebar: string }>;
    navSpacing: Record<string, string>;
    initial: Record<string, string>;
    order: string[];
  }

  // isLightColor of packages/rapidoc/src/styles/theme-tokens.js: dark text on a light accent
  const isLight = (hex: string) => {
    const h = hex.replace('#', '');
    const [r, g, b] = [0, 2, 4].map((i) => parseInt(h.slice(i, i + 2), 16));
    return (r * 299 + g * 587 + b * 114) / 1000 >= 128;
  };
  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');

  for (const root of document.querySelectorAll<HTMLElement>('.td')) {
    const cfg: Config = JSON.parse(root.dataset.config || '{}');
    const frame = root.querySelector<HTMLElement>('.td-frame')!;
    const out = root.querySelector<HTMLElement>('.td-html')!;
    const colorInput = root.querySelector<HTMLInputElement>('.td-color')!;
    const customRadio = root.querySelector<HTMLInputElement>('input[value="custom"]')!;
    const state: Record<string, string> = { ...cfg.initial };

    const render = () => {
      const scheme = state['color-scheme'] === 'light' ? 'light' : 'dark';
      const custom = state.theme.startsWith('#');
      const tokens: Palette = custom
        ? {
            ...cfg.customBase[scheme],
            '--primary': state.theme,
            '--primary-foreground': isLight(state.theme) ? '#000000' : '#ffffff',
          }
        : cfg.palette[state.theme][scheme];
      for (const [k, v] of Object.entries(tokens)) frame.style.setProperty(k, v);
      frame.style.setProperty('--radius', cfg.radius[state.radius] ?? '0.25rem');
      const s = cfg.scale[state.scale];
      frame.style.setProperty('--scale', String(parseFloat(s?.font ?? '14px') / 14));
      frame.style.setProperty('--sidebar-width', s?.sidebar ?? '18.75rem');
      frame.style.setProperty('--nav-pad', cfg.navSpacing[state['nav-item-spacing']] ?? '0.4375rem');
      frame.dataset.scheme = scheme;
      for (const sw of root.querySelectorAll<HTMLElement>('[data-swatch]')) {
        sw.style.background = cfg.palette[sw.dataset.swatch!][scheme]['--primary'];
      }
      const lines = cfg.order.map(
        (a) => `  <span class="td-a">${a}</span>=<span class="td-v">"${esc(state[a])}"</span>`,
      );
      out.innerHTML =
        `&lt;<span class="td-t">rapi-doc</span>\n  <span class="td-a">spec-url</span>=<span class="td-v">"openapi.yaml"</span>\n` +
        lines.join('\n') +
        `\n&gt;&lt;/<span class="td-t">rapi-doc</span>&gt;`;
    };

    root.addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      if (input === colorInput) {
        customRadio.checked = true;
        state.theme = colorInput.value;
      } else if (input.dataset.attr) {
        state[input.dataset.attr] = input.value === 'custom' ? colorInput.value : input.value;
      }
      render();
    });
    colorInput.addEventListener('input', () => {
      customRadio.checked = true;
      state.theme = colorInput.value;
      render();
    });
    root.querySelector('.td-copy')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      try {
        await navigator.clipboard.writeText(out.textContent || '');
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Copy failed';
      }
      setTimeout(() => (btn.textContent = 'Copy'), 1500);
    });
    render();
  }
</script>

<style>
  .td {
    margin: 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Controls: one row per attribute, its values as a segmented group of radio buttons */
  .td-controls {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1rem;
    border: 1px solid var(--rd-docs-border);
    border-radius: var(--rd-radius);
    background: var(--rd-docs-card-bg, transparent);
  }
  .td-field {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    border: none;
    min-width: 0;
  }
  .td-field legend {
    float: left;
    padding: 0;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--rd-docs-muted);
  }
  .td-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .td-option input[type='radio'] {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .td-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--rd-docs-border);
    border-radius: var(--rd-radius);
    font-size: 0.8125rem;
    color: var(--rd-docs-fg);
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }
  .td-option:hover .td-chip {
    border-color: color-mix(in oklab, var(--rd-docs-border) 50%, var(--rd-docs-fg));
  }
  .td-option input:checked + .td-chip {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
  }
  .td-option input:focus-visible + .td-chip {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .td-swatch {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
  }
  .td-color {
    width: 1rem;
    height: 1rem;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
  }

  /* The sketch: RapiDoc's tokens as custom properties on the frame, the same formulas for the derived ones */
  .td-frame {
    --s: var(--scale, 1);
    display: flex;
    flex-direction: column;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--rd-docs-border);
    border-radius: var(--rd-radius);
    background: var(--background);
    color: var(--foreground);
    font-family: var(--rd-font-mono);
    transition: background 0.2s ease;
  }
  .td-header {
    display: flex;
    align-items: center;
    gap: 3%;
    padding: 2% 3%;
    border-bottom: 1px solid var(--border);
    background: var(--card);
  }
  .td-logo {
    width: calc(18px * var(--s));
    height: calc(18px * var(--s));
    border-radius: var(--radius);
    background: var(--primary);
  }
  .td-search {
    flex: 1;
    max-width: 40%;
    height: calc(18px * var(--s));
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--background);
  }
  .td-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: calc(44px * var(--s));
    height: calc(18px * var(--s));
    padding: 0 calc(8px * var(--s));
    border-radius: var(--radius);
    font-size: calc(9px * var(--s));
    font-weight: 700;
  }
  .td-btn-primary {
    margin-left: auto;
    background: var(--primary);
    color: var(--primary-foreground);
  }
  .td-body {
    flex: 1;
    display: flex;
    min-height: 0;
  }
  .td-nav {
    /* The real sidebar width, at the sketch's size */
    width: calc(var(--sidebar-width) * 0.42);
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: calc(var(--nav-pad) * 0.9);
    padding: 3% 2.5%;
    border-right: 1px solid var(--border);
    background: var(--card);
    transition: width 0.2s ease;
  }
  .td-nav-filter {
    height: calc(14px * var(--s));
    margin-bottom: 4%;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  .td-nav-group {
    width: 40%;
    height: calc(5px * var(--s));
    margin-top: 6%;
    border-radius: 2px;
    background: var(--muted-foreground);
    opacity: 0.6;
  }
  .td-nav-item {
    width: var(--w);
    height: calc(6px * var(--s));
    border-radius: 2px;
    background: var(--muted-foreground);
    opacity: 0.45;
    box-shadow: 0 0 0 calc(var(--nav-pad) * 0.6) transparent;
  }
  .td-nav-item.td-active {
    width: 100%;
    opacity: 1;
    background: color-mix(in srgb, var(--primary) 22%, transparent);
    box-shadow: inset 3px 0 0 var(--primary);
    height: calc(6px * var(--s) + var(--nav-pad));
    border-radius: var(--radius);
  }
  .td-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: calc(7px * var(--s));
    padding: 3% 4%;
  }
  .td-title {
    width: 45%;
    height: calc(11px * var(--s));
    border-radius: 2px;
    background: var(--foreground);
    opacity: 0.85;
  }
  .td-text,
  .td-path,
  .td-label,
  .td-code {
    width: var(--w, 50%);
    height: calc(6px * var(--s));
    border-radius: 2px;
    background: var(--muted-foreground);
    opacity: 0.5;
  }
  .td-op {
    display: flex;
    align-items: center;
    gap: 3%;
    margin-top: 2%;
  }
  .td-method {
    padding: calc(2px * var(--s)) calc(6px * var(--s));
    border-radius: var(--radius);
    font-size: calc(9px * var(--s));
    font-weight: 700;
    color: var(--primary);
    border: 1px solid color-mix(in srgb, var(--primary) 45%, transparent);
  }
  .td-path {
    --w: 40%;
  }
  .td-cards {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4%;
    min-height: 0;
  }
  .td-card {
    display: flex;
    flex-direction: column;
    gap: calc(7px * var(--s));
    padding: 5%;
    border: 1px solid var(--border);
    /* A full radius rounds the controls; panels keep a moderate corner */
    border-radius: min(var(--radius), 12px);
    background: var(--card);
  }
  .td-label {
    --w: 35%;
  }
  .td-input {
    width: var(--w, 100%);
    height: calc(14px * var(--s));
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--background);
  }
  .td-try {
    margin-top: auto;
    align-self: flex-end;
    margin-left: 0;
  }
  .td-tabs {
    display: flex;
    gap: 8%;
    padding-bottom: 4%;
    border-bottom: 1px solid var(--border);
  }
  .td-tab {
    width: 28%;
    height: calc(6px * var(--s));
    border-radius: 2px;
    background: var(--muted-foreground);
    opacity: 0.45;
  }
  .td-tab-active {
    background: var(--primary);
    opacity: 1;
  }
  .td-code-accent {
    background: var(--primary);
    opacity: 0.8;
  }

  /* The HTML for the chosen settings */
  .td-code-block {
    border: 1px solid var(--rd-docs-border);
    border-radius: var(--rd-radius);
    overflow: hidden;
  }
  .td-code-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.375rem 0.75rem;
    font-family: var(--rd-font-mono);
    font-size: 0.75rem;
    color: var(--rd-docs-muted);
    background: color-mix(in oklab, var(--rd-docs-fg) 5%, var(--rd-docs-bg));
    border-bottom: 1px solid var(--rd-docs-border);
  }
  .td-copy {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--rd-docs-border);
    border-radius: var(--rd-radius);
    background: none;
    color: var(--rd-docs-fg);
    font: inherit;
    cursor: pointer;
  }
  .td-copy:hover {
    border-color: var(--sl-color-accent);
  }
  .td-code-block pre {
    margin: 0;
    padding: 0.875rem 1rem;
    overflow-x: auto;
    font-family: var(--rd-font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--rd-docs-fg);
    background: var(--rd-docs-bg);
  }
  .td-code-block :global(.td-t) {
    color: var(--sl-color-text-accent);
  }
  .td-code-block :global(.td-a) {
    color: var(--rd-docs-fg);
  }
  .td-code-block :global(.td-v) {
    color: var(--rd-docs-muted);
  }
  .td-note {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--rd-docs-muted);
  }
  .td-note a {
    color: var(--sl-color-text-accent);
  }

  @media (max-width: 40rem) {
    .td-field {
      grid-template-columns: 1fr;
      gap: 0.375rem;
    }
    .td-frame {
      aspect-ratio: 4 / 3;
    }
  }
</style>
