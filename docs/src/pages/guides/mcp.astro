---
import GlobalLayout from '../../layouts/GlobalLayout.astro';
import SiteNavbar from '../../components/SiteNavbar.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import {
  IconCheck,
  IconCopy,
  IconArrowRight,
  IconArrowUpRight,
  IconBolt,
  IconTarget,
  IconFileCode,
  IconPlayerPlay,
  IconShieldCheck,
  IconLock,
} from '@tabler/icons-astro';

const manifestToolSnippet = `{
  "name": "place_order",
  "description": "Place a new order",
  "inputSchema": {
    "type": "object",
    "properties": {
      "body": {
        "type": "object",
        "required": ["customerId", "items"],
        "properties": {
          "customerId": { "type": "string" },
          "items": { "type": "array", "items": { "type": "string" } },
          "shippingMethod": { "type": "string", "enum": ["standard", "express", "overnight"] }
        }
      }
    },
    "required": ["body"]
  },
  "annotations": { "readOnlyHint": false, "destructiveHint": false, "idempotentHint": false },
  "operation": {
    "source": "api",
    "method": "POST",
    "path": "/orders",
    "params": [{ "name": "body", "in": "body", "contentType": "application/json" }],
    "security": [{ "api_key": [] }]
  }
}`;

const runProjectSnippet = `# The zip: manifest.json, runtime.js, server.ts, package.json, README.md, claude_desktop_config.json
# (and workflow-runtime.js when the page has a <rapi-flow> with workflows)
unzip my-api-mcp.zip -d my-api-mcp
cd my-api-mcp
npm install

# One environment variable per security scheme (upper snake case); API_KEY is the fallback
API_KEY="your-key" npm start        # runs: tsx server.ts

# Point the server at another environment
API_BASE_URL="https://staging.example.com/v2" API_KEY="your-key" npm start`;

const openApiToMcpSnippet = `# Plain OpenAPI: no extra annotations needed
security:
  - api_key: []                      # Applied by the runtime from API_KEY

paths:
  /orders:
    post:
      operationId: placeOrder        # Tool "place_order"
      summary: Place a new order     # Tool description
      parameters:
        - name: Authorization        # Stripped: never a tool argument
          in: header
          schema: { type: string }
      requestBody:                   # Tool argument "body", full JSON Schema
        required: true
        content:
          application/json:
            schema: { $ref: "#/components/schemas/NewOrder" }
      # POST: readOnlyHint false, so hosts can ask before running it

  /orders/{orderId}:
    get:
      operationId: getOrder          # Read-only tool "get_order"
      summary: Get an order

  /currencies:
    get:
      operationId: getCurrencies     # Resource "reference://currencies"
      summary: List supported currencies

  /admin/database/vacuum:
    post:
      summary: Trigger internal database maintenance
      x-internal: true               # Excluded

  /orders/legacy:
    get:
      summary: Legacy order list
      deprecated: true               # Excluded

components:
  securitySchemes:
    api_key:                         # Copied into the manifest's sources
      type: apiKey
      in: header
      name: X-API-Key`;

const rapiDocTagSnippet = `<!-- 1. Enable the Export MCP Server button in the API overview -->
<script type="module" src="https://unpkg.com/rapidoc/dist/rapidoc-min.js"></script>

<rapi-doc
  spec-url="/specs/my-api.yaml"
  mcp="true"
  mcp-server-name="my-api-mcp"
  theme="slate"
> </rapi-doc>`;

const programmaticApiSnippet = `// Access the RapiDoc custom element in JavaScript
const doc = document.querySelector('rapi-doc');

// 1. Build the manifest, the project files and the host configuration in memory
const result = doc.generateMcpServer({ serverName: 'my_api_mcp' });
console.log(result.manifest.tools);       // [{ name, description, inputSchema, annotations, operation }]
console.log(result.files['server.ts']);   // also manifest.json, runtime.js, package.json, README.md, ...
console.log(result.hostConfig);           // Claude Desktop / Cursor JSON config
console.log(result.budget);               // { totalTools: 5, estimatedTokens: 850, ... }

// 2. Download the project as <server-name>-mcp.zip
doc.downloadMcpServer();

// 3. Inspect token budget overhead before exporting
const budget = doc.getMcpBudget();
console.log(\`Overhead: ~\${budget.estimatedTokens} tokens/turn across \${budget.totalTools} tools\`);`;
---

<GlobalLayout
  title="Curated MCP Server Guide | RapiDoc"
  description="Learn how to shape token-efficient, agent-first Model Context Protocol (MCP) servers from plain OpenAPI specs using smart heuristics."
  keywords="Model Context Protocol, MCP, OpenAPI to MCP, MCP manifest, Claude Desktop, Cursor, AI agents, RapiDoc MCP"
>
  <!-- Ambient background glow elements -->
  <div class="ambient-glow glow-emerald"></div>
  <div class="ambient-glow glow-indigo"></div>
  <div class="ambient-glow glow-cyan"></div>

  <!-- Reusable Frosted Glass Navigation -->
  <SiteNavbar activePage="guides" />

  <main class="mcp-guide-main">
    <!-- Hero Header -->
    <header class="mcp-guide-header">
      <div class="mcp-badge-pill">
        <span class="mcp-badge-pulse"></span>
        <span class="mcp-badge-text">Model Context Protocol • AI Agent Engineering</span>
      </div>

      <h1 class="mcp-page-title">
        Shaping Curated <span class="text-gradient">MCP Servers</span>
      </h1>

      <p class="mcp-page-subtitle">
        How RapiDoc applies smart heuristics to a plain OpenAPI spec to cut prompt token tax, keep internal endpoints
        away from agents, and build an MCP manifest with a runnable TypeScript server directly in the browser.
      </p>

      <div class="mcp-cta-row">
        <a href="/examples/mcp-server" class="mcp-btn primary">
          <IconPlayerPlay size={18} stroke={2} />
          <span>Interactive Showcase Demo</span>
        </a>
        <a href="/docs/ai/mcp-server/" class="mcp-btn secondary">
          <IconFileCode size={18} stroke={2} />
          <span>Technical Reference Docs</span>
          <IconArrowUpRight size={16} stroke={2} />
        </a>
      </div>

      <div class="mcp-quick-stats">
        <div class="mcp-stat-chip">
          <span class="mcp-stat-num">Zero Config</span>
          <span class="mcp-stat-txt">Works on Plain OpenAPI</span>
        </div>
        <div class="mcp-stat-chip">
          <span class="mcp-stat-num">One Manifest</span>
          <span class="mcp-stat-txt">JSON Schema Tools & Annotations</span>
        </div>
        <div class="mcp-stat-chip">
          <span class="mcp-stat-num">Zero Backend</span>
          <span class="mcp-stat-txt">Runs 100% in Browser</span>
        </div>
        <div class="mcp-stat-chip">
          <span class="mcp-stat-num">npm start</span>
          <span class="mcp-stat-txt">Runnable TypeScript Project</span>
        </div>
      </div>
    </header>

    <!-- Content Sections -->
    <div class="mcp-guide-content">
      <!-- Section 1: The Core Philosophy -->
      <section class="mcp-section">
        <div class="section-tag">Philosophy</div>
        <h2 class="section-heading">Why Naive 1:1 REST-to-MCP Fails</h2>
        <p class="section-lead">
          When teams first connect OpenAPI to AI agents, their initial instinct is to convert every REST endpoint into an individual MCP tool.
          As Jeremiah Lowin explains in <em>"Stop Converting Your REST APIs to MCP"</em>, this naive approach severely degrades LLM performance:
        </p>

        <div class="comparison-grid">
          <div class="comparison-card naive">
            <div class="card-status-badge badge-danger">Naive 1:1 Conversion</div>
            <h3 class="card-title">Endpoint-as-a-Tool Trap</h3>
            <ul class="comparison-list">
              <li><strong>Token Window Bloat:</strong> 30–50 raw JSON schemas consume 4,000–8,000 tokens on <em>every conversation turn</em>.</li>
              <li><strong>Internal Leaks:</strong> Infrastructure endpoints (<code>/healthz</code>, <code>/metrics</code>, <code>/admin/debug</code>) confuse the model.</li>
              <li><strong>Transport Pollution:</strong> Headers like <code>Authorization</code>, <code>Cookie</code>, and <code>X-Api-Key</code> pollute tool parameters.</li>
            </ul>
          </div>

          <div class="comparison-card curated">
            <div class="card-status-badge badge-success">RapiDoc Curated MCP</div>
            <h3 class="card-title">Agent-First Tool Design</h3>
            <ul class="comparison-list">
              <li><strong>Lean Token Footprint:</strong> Reference lookups become MCP Resources, and a live token budget warns before the tool catalog saturates the context.</li>
              <li><strong>Safety Annotations:</strong> every tool carries MCP <code>readOnlyHint</code>, <code>destructiveHint</code> and <code>idempotentHint</code>, so hosts can ask before a <code>POST</code>, <code>PUT</code>, <code>PATCH</code> or <code>DELETE</code>.</li>
              <li><strong>Zero Admin Leaks:</strong> Automatic filtering via <code>x-internal</code>, <code>x-hidden</code>, and <code>deprecated: true</code>.</li>
              <li><strong>Clean Auth Separation:</strong> Transport headers are stripped; the runtime applies the spec's <code>securitySchemes</code> from environment variables.</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Section 2: Key Performance Indicators (KPIs) & Production Benchmarks -->
      <section class="mcp-section">
        <div class="section-tag">Performance & ROI</div>
        <h2 class="section-heading">Key Performance Indicators (KPIs)</h2>
        <p class="section-lead">
          Unlike generic converters that blindly dump hundreds of endpoints into an agent's context, RapiDoc is engineered to meet strict, quantifiable enterprise production benchmarks:
        </p>

        <div class="kpi-grid">
          <div class="kpi-card">
            <div class="kpi-badge">Token Budget KPI</div>
            <div class="kpi-metric-row">
              <span class="kpi-value">5,000</span>
              <span class="kpi-unit">token guardrail</span>
            </div>
            <h4>Context Overhead Control</h4>
            <p>Skips internal, hidden, deprecated and webhook operations, strips transport headers and moves reference lookups into resources. <code>getMcpBudget()</code> estimates the per-turn overhead and warns above <strong>5,000 tokens</strong> or <strong>30 tools</strong>.</p>
            <div class="kpi-bar-track">
              <div class="kpi-bar-fill" style="width: 80%;"></div>
            </div>
            <div class="kpi-meta">Estimated live from your spec</div>
          </div>

          <div class="kpi-card">
            <div class="kpi-badge">Security Scorecard</div>
            <div class="kpi-metric-row">
              <span class="kpi-value">0</span>
              <span class="kpi-unit">credentials in tool arguments</span>
            </div>
            <h4>Auth Stays Out of the Model's Hands</h4>
            <p>Auth headers and API-key parameters are never tool arguments. The runtime applies the spec's <code>securitySchemes</code> from environment variables and percent-encodes every path parameter it substitutes.</p>
            <div class="kpi-bar-track">
              <div class="kpi-bar-fill" style="width: 100%; background: #10b981;"></div>
            </div>
            <div class="kpi-meta">API key, HTTP Basic, Bearer, OAuth 2, OpenID Connect</div>
          </div>

          <div class="kpi-card">
            <div class="kpi-badge">Data, Not Code</div>
            <div class="kpi-metric-row">
              <span class="kpi-value">1</span>
              <span class="kpi-unit">manifest, one runtime</span>
            </div>
            <h4>One Manifest Drives Everything</h4>
            <p><code>manifest.json</code> holds every tool with real JSON Schema arguments and MCP annotations. <code>runtime.js</code> executes it with <code>fetch</code> in Node, browsers and edge workers, and <code>server.ts</code> is the same file for every API.</p>
            <div class="kpi-bar-track">
              <div class="kpi-bar-fill" style="width: 100%; background: #f59e0b;"></div>
            </div>
            <div class="kpi-meta">Servers in other languages can read the same manifest</div>
          </div>
        </div>

        <!-- Comparative KPI Matrix Table -->
        <div class="sub-topic">
          <h3>Competitive KPI Matrix: RapiDoc vs. Generic MCP Generators</h3>
          <p>
            How RapiDoc stacks up against raw 1:1 endpoint wrappers and generic cloud CLI tools:
          </p>
          <div class="table-container">
            <table class="mcp-spec-table">
              <thead>
                <tr>
                  <th>Performance Dimension / KPI</th>
                  <th>Generic 1:1 Converters</th>
                  <th>Generic Cloud CLI Generators</th>
                  <th>RapiDoc Curated Generator</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Internal & Deprecated Endpoints</strong></td>
                  <td>Exposed as tools</td>
                  <td>Partially filtered</td>
                  <td><strong style="color: #34d399;">Skips <code>x-internal</code>, <code>x-hidden</code>, <code>deprecated</code> and webhooks</strong></td>
                </tr>
                <tr>
                  <td><strong>Output</strong></td>
                  <td>Generated code per API</td>
                  <td>Hosted proxy or heavy CLI</td>
                  <td><strong style="color: #34d399;">One JSON manifest, one fixed runtime, a runnable TypeScript project</strong></td>
                </tr>
                <tr>
                  <td><strong>Tool Arguments</strong></td>
                  <td>Flat string bags</td>
                  <td>Partial schemas</td>
                  <td><strong style="color: #34d399;">Real JSON Schema: nested bodies, arrays, enums, <code>required</code></strong></td>
                </tr>
                <tr>
                  <td><strong>Safety Annotations</strong></td>
                  <td>None</td>
                  <td>None</td>
                  <td><strong style="color: #34d399;">MCP <code>readOnlyHint</code>, <code>destructiveHint</code>, <code>idempotentHint</code></strong></td>
                </tr>
                <tr>
                  <td><strong>Authentication</strong></td>
                  <td>Keys as tool arguments</td>
                  <td>Hardcoded static credentials</td>
                  <td><strong style="color: #34d399;">From <code>securitySchemes</code>, via environment variables</strong></td>
                </tr>
                <tr>
                  <td><strong>Backend / Cloud Dependency</strong></td>
                  <td>External Node server required</td>
                  <td>Paid cloud SaaS or heavy CLI</td>
                  <td><strong style="color: #34d399;">Zero Backend (100% In-Browser & Air-Gapped)</strong></td>
                </tr>
                <tr>
                  <td><strong>Real-Time Token Budget Warnings</strong></td>
                  <td>None (Blind to token saturation)</td>
                  <td>None</td>
                  <td><strong style="color: #34d399;">Built-in turn budget & token saturation guards</strong></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- Section 3: Zero-Config Smart Heuristics -->
      <section class="mcp-section">
        <div class="section-tag">Zero Configuration</div>
        <h2 class="section-heading">Smart Heuristics (Out of the Box)</h2>
        <p class="section-lead">
          RapiDoc needs no extra annotations. It derives every tool and resource from standard OpenAPI fields during export:
        </p>

        <div class="heuristics-cards">
          <div class="heuristic-card">
            <div class="heuristic-icon"><IconCheck size={20} /></div>
            <div>
              <h4>Tool Names & Descriptions</h4>
              <p>Tool names are the snake_case form of each <code>operationId</code>, or derived from method and path when it is missing. Descriptions come from the <code>summary</code>, else the <code>description</code>, else <code>METHOD /path</code>.</p>
            </div>
          </div>
          <div class="heuristic-card">
            <div class="heuristic-icon"><IconCheck size={20} /></div>
            <div>
              <h4>Header & Transport Sanitization</h4>
              <p>Headers like <code>Authorization</code>, <code>Cookie</code>, <code>X-Api-Key</code>, <code>User-Agent</code>, and <code>Accept</code> are stripped from LLM parameter schemas, as is any parameter that carries an API key named in <code>securitySchemes</code>. The runtime applies the scheme itself, from an environment variable named after it, against the base URL from <code>servers[0]</code> (or <code>API_BASE_URL</code>).</p>
            </div>
          </div>
          <div class="heuristic-card">
            <div class="heuristic-icon"><IconCheck size={20} /></div>
            <div>
              <h4>Internal & Deprecated Route Exclusion</h4>
              <p>Operations marked <code>x-internal: true</code>, <code>x-hidden: true</code> or <code>deprecated: true</code>, and webhooks, are omitted from generated agent tools so models never see admin or stale APIs.</p>
            </div>
          </div>
          <div class="heuristic-card">
            <div class="heuristic-icon"><IconCheck size={20} /></div>
            <div>
              <h4>Static Resource Classification</h4>
              <p>A <code>GET</code> with no required parameters on a reference-data path (<code>/reference</code>, <code>/currencies</code>, <code>/countries</code>, <code>/tiers</code>, <code>/categories</code>, <code>/status</code>, <code>/schema</code>) becomes an <strong>MCP Resource</strong> (<code>reference://&lt;name&gt;</code>), preserving tool calling budgets.</p>
            </div>
          </div>
          <div class="heuristic-card">
            <div class="heuristic-icon"><IconCheck size={20} /></div>
            <div>
              <h4>Safety Annotations</h4>
              <p>Every tool carries MCP annotations: <code>readOnlyHint</code> for <code>GET</code>, <code>destructiveHint</code> for <code>PUT</code>, <code>PATCH</code> and <code>DELETE</code>, <code>idempotentHint</code> for <code>GET</code>, <code>PUT</code> and <code>DELETE</code>, so agent hosts can ask the user before running a consequential tool.</p>
            </div>
          </div>
          <div class="heuristic-card">
            <div class="heuristic-icon"><IconCheck size={20} /></div>
            <div>
              <h4>Token Budget Diagnostics</h4>
              <p>RapiDoc dynamically estimates prompt context tokens per conversation turn and generates warnings if tool count exceeds 30 or context exceeds 5,000 tokens.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 4: From OpenAPI to MCP -->
      <section class="mcp-section">
        <div class="section-tag">Mapping</div>
        <h2 class="section-heading">From OpenAPI to MCP</h2>
        <p class="section-lead">
          In the Model Context Protocol, <strong>Tools</strong> represent executable actions, while <strong>Resources</strong>
          represent contextual reference data the model can inspect without function calling. Here is how each operation in a plain spec is treated:
        </p>

        <div class="sub-topic">
          <CodeBlock code={openApiToMcpSnippet} lang="yaml" filename="openapi.yaml" />
        </div>

        <div class="sub-topic">
          <h3>OpenAPI Field Reference</h3>
          <div class="table-container">
            <table class="mcp-spec-table">
              <thead>
                <tr>
                  <th>OpenAPI Field</th>
                  <th>Applies To</th>
                  <th>Effect on the Manifest</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><code>operationId</code></td>
                  <td>Operation</td>
                  <td>Tool name in snake_case (<code>placeOrder</code> &rarr; <code>place_order</code>); derived from method and path when missing.</td>
                </tr>
                <tr>
                  <td><code>summary</code> / <code>description</code></td>
                  <td>Operation</td>
                  <td>Tool description (<code>summary</code> first), stripped of HTML and Markdown and truncated to 300 characters.</td>
                </tr>
                <tr>
                  <td><code>x-internal</code> / <code>x-hidden</code></td>
                  <td>Operation</td>
                  <td>When <code>true</code>, the operation is left out.</td>
                </tr>
                <tr>
                  <td><code>deprecated</code></td>
                  <td>Operation</td>
                  <td>When <code>true</code>, the operation is left out.</td>
                </tr>
                <tr>
                  <td>HTTP method</td>
                  <td>Operation</td>
                  <td>Sets the tool's <code>annotations</code>: <code>readOnlyHint</code> for <code>GET</code>, <code>destructiveHint</code> for <code>PUT</code>, <code>PATCH</code> and <code>DELETE</code>, <code>idempotentHint</code> for <code>GET</code>, <code>PUT</code> and <code>DELETE</code>.</td>
                </tr>
                <tr>
                  <td>Parameters and <code>requestBody</code></td>
                  <td>Operation</td>
                  <td>The tool's <code>inputSchema</code>: path, query, header and cookie parameters by name, plus a <code>body</code> property with the request body's full schema (<code>$ref</code>s inlined, read-only properties dropped).</td>
                </tr>
                <tr>
                  <td>Path</td>
                  <td>Operation</td>
                  <td>A parameterless <code>GET</code> on a reference-data path becomes a <code>reference://</code> resource.</td>
                </tr>
                <tr>
                  <td>Header parameters</td>
                  <td>Parameter</td>
                  <td>Auth and transport headers (<code>Authorization</code>, <code>Cookie</code>, <code>X-API-Key</code>, <code>User-Agent</code>, ...) are not exposed as tool arguments.</td>
                </tr>
                <tr>
                  <td><code>servers</code></td>
                  <td>Root Spec</td>
                  <td>Default base URL, overridable with the <code>API_BASE_URL</code> environment variable.</td>
                </tr>
                <tr>
                  <td><code>securitySchemes</code> / <code>security</code></td>
                  <td>Root Spec / Operation</td>
                  <td>Copied into the manifest; the runtime reads each scheme's credential from an environment variable named after it (<code>petstore_auth</code> &rarr; <code>PETSTORE_AUTH</code>).</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- Section 5: The Manifest -->
      <section class="mcp-section">
        <div class="section-tag">Data, Not Code</div>
        <h2 class="section-heading">The Manifest</h2>
        <p class="section-lead">
          The export is a plain JSON <code>manifest.json</code>, not generated code. It holds the <code>server</code> (name, version, description),
          one entry in <code>sources</code> (the base URL from <code>servers[0]</code> and the spec's <code>securitySchemes</code>),
          the <code>tools</code>, the <code>resources</code> and the <code>workflows</code> of a tied <a href="/guides/workflows"><code>&lt;rapi-flow&gt;</code></a>, each one a tool of its own. Each operation tool has a real JSON Schema
          <code>inputSchema</code>, MCP <code>annotations</code> and an <code>operation</code> block that tells the runtime where every argument goes:
        </p>

        <div class="sub-topic">
          <CodeBlock code={manifestToolSnippet} lang="json" filename="manifest.json (one tool)" />
        </div>

        <div class="targets-grid">
          <div class="target-card">
            <div class="target-badge">inputSchema</div>
            <h4>Real JSON Schema arguments</h4>
            <p>Path, query, header and cookie parameters by name, plus a <code>body</code> property with the request body's full schema: nested objects, arrays, enums and <code>required</code>. <code>$ref</code>s are inlined, cycles cut, read-only properties dropped.</p>
          </div>

          <div class="target-card">
            <div class="target-badge">annotations</div>
            <h4>MCP safety hints</h4>
            <p><code>readOnlyHint</code> for <code>GET</code>, <code>destructiveHint</code> for <code>PUT</code>, <code>PATCH</code> and <code>DELETE</code>, <code>idempotentHint</code> for <code>GET</code>, <code>PUT</code> and <code>DELETE</code>.</p>
          </div>

          <div class="target-card">
            <div class="target-badge">operation</div>
            <h4>How to make the call</h4>
            <p><code>source</code>, <code>method</code>, <code>path</code>, <code>params</code> with each argument's location, and the operation's <code>security</code> requirement (else the spec's).</p>
          </div>
        </div>
      </section>

      <!-- Section 6: The Runtime and the Project -->
      <section class="mcp-section">
        <div class="section-tag">Run It</div>
        <h2 class="section-heading">One Runtime, One TypeScript Project</h2>
        <p class="section-lead">
          <strong>Export MCP Server</strong> downloads <code>&lt;server-name&gt;-mcp.zip</code>: the manifest plus files that are identical for every API.
          Run it with <code>npm install</code> and <code>npm start</code>, or copy the <code>mcpServers</code> entry from <code>claude_desktop_config.json</code> into Claude Desktop or Cursor:
        </p>

        <div class="sub-topic">
          <CodeBlock code={runProjectSnippet} lang="bash" filename="terminal" />
        </div>

        <div class="standards-grid">
          <div class="standard-card">
            <div class="standard-badge">runtime.js</div>
            <h4>1. Executes any tool with <code>fetch</code></h4>
            <p>
              <code>createMcpRuntime(manifest, &#123; fetch, credentials, baseUrls &#125;)</code> puts each argument where <code>operation.params</code> says, percent-encodes path parameters, applies the security scheme (API key in header, query or cookie; HTTP Basic; Bearer tokens for HTTP bearer, OAuth 2 and OpenID Connect) and returns the MCP result: pretty-printed <code>content</code>, <code>structuredContent</code> for JSON objects, <code>isError</code> with the HTTP status and body on 4xx and 5xx. The same file runs in Node, browsers and edge workers.
            </p>
          </div>

          <div class="standard-card">
