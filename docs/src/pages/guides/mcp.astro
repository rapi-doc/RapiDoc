---
import GlobalLayout from '../../layouts/GlobalLayout.astro';
import SiteNavbar from '../../components/SiteNavbar.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import {
  IconCheck,
  IconCopy,
  IconArrowRight,
  IconArrowUpRight,
  IconBolt,
  IconTarget,
  IconFileCode,
  IconPlayerPlay,
  IconShieldCheck,
  IconLock,
} from '@tabler/icons-astro';

const pathEscapingSnippet = `// Enterprise Security: Dynamic RFC 3986 Escaping across all targets
// Go (mark3labs/mcp-go)
url := fmt.Sprintf("%s/v1/users/%s", baseURL, url.PathEscape(userId))

// C# (ModelContextProtocol.NET)
var path = $"/v1/users/{Uri.EscapeDataString(userId)}";

// Rust (tokio / reqwest)
let path = format!("/v1/users/{}", urlencoding::encode(&user_id));

// Python (FastMCP standard library)
clean_id = urllib.parse.quote(str(user_id), safe="")
url = f"{base_url}/v1/users/{clean_id}"

// Java (Spring AI RestClient)
String cleanId = URLEncoder.encode(String.valueOf(userId), StandardCharsets.UTF_8);
String url = baseUrl + "/v1/users/" + cleanId;`;

const dualModeAuthSnippet = `// Dual-Mode Multi-Tenancy: Local Stdio vs. Gateway Per-Turn Override
// TypeScript:
const apiKey = (args?.apiKey as string) || (args?.api_key as string) || process.env.API_KEY || '';
if (apiKey) {
  headers['Authorization'] = \`Bearer \${apiKey}\`;
}

// Go:
apiKey := ""
if key, ok := args["apiKey"].(string); ok && key != "" {
    apiKey = key
} else {
    apiKey = os.Getenv("API_KEY")
}
if apiKey != "" {
    req.Header.Set("Authorization", "Bearer " + apiKey)
}`;

const naiveVsCuratedSnippet = `# Naive 1:1 conversion (raw endpoint)
# Problem: 14 tools, 4,200 tokens overhead, leaks internal trace tokens
/orders:
  post:
    summary: Create order
    # No curation: LLM sees 15 fields including internalDebugTrace, clientTelemetry

# Curated with RapiDoc x-mcp extensions:
# Result: 1 tool, clean prompt, 3 parameters, confirmation guardrail
/orders:
  post:
    summary: Create order
    x-mcp:
      name: place_customer_order
      description: "Places a verified order for the customer. Requires confirmation before billing."
      requireConfirmation: true
      parameters:
        include:
          - customerId
          - items
          - shippingMethod
        defaults:
          shippingMethod: "standard"
        descriptions:
          customerId: "Unique customer UUID"`;

const compositeWorkflowSnippet = `# Root-level composite task workflow
# Collapses 3 distinct HTTP roundtrips into 1 single tool call for the agent
x-mcp-workflows:
  - name: get_customer_order_summary
    description: "Fetches customer profile, subscription status, and latest 3 orders in a single tool call."
    parameters:
      customerId:
        type: string
        description: "Unique customer UUID (e.g. 'cust_98234')"
    steps:
      - call: getCustomer
        args: { id: "$params.customerId" }
      - call: listOrders
        args: { customerId: "$params.customerId", limit: 3 }`;

const staticResourceSnippet = `# Distinguishing Actionable Tools from Static Data
# Parameterless lookups are compiled into MCP Resources (reference://...)
/shipping-tiers:
  get:
    summary: Supported carrier shipping tiers
    description: Static lookup table of carrier delivery speeds and pricing.
    x-mcp:
      type: resource
      uri: "reference://shipping-tiers"`;

const rapiDocTagSnippet = `<!-- 1. Enable MCP Export button in API overview -->
<script type="module" src="https://unpkg.com/rapidoc/dist/rapidoc-min.js"></script>

<rapi-doc
  spec-url="/specs/curated-mcp-demo.yaml"
  mcp="typescript, python, go"
  mcp-server-name="my-api-mcp"
  theme="slate"
> </rapi-doc>`;

const programmaticApiSnippet = `// Access the RapiDoc custom element in JavaScript
const doc = document.querySelector('rapi-doc');

// 1. Generate in-memory code & Claude Desktop / Cursor configuration
const result = doc.generateMcpServer('python');
console.log(result.serverCode);   // FastMCP Python source code
console.log(result.hostConfig);   // Claude Desktop JSON config
console.log(result.budget);       // { totalTools: 5, estimatedTokens: 850 }

// 2. Trigger browser download of server file (server.ts, server.py, main.go, Program.cs)
doc.downloadMcpServer('go');

// 3. Inspect token budget overhead before exporting
const budget = doc.getMcpBudget();
console.log(\`Overhead: ~\${budget.estimatedTokens} tokens/turn across \${budget.totalTools} tools\`);`;
---

<GlobalLayout
  title="Curated MCP Server Guide & Vendor Extensions | RapiDoc"
  description="Learn how to shape token-efficient, agent-first Model Context Protocol (MCP) servers from OpenAPI specs using x-mcp vendor extensions and smart heuristics."
  keywords="Model Context Protocol, MCP, OpenAPI to MCP, x-mcp, FastMCP, Claude Desktop, Cursor, AI agents, RapiDoc MCP"
>
  <!-- Ambient background glow elements -->
  <div class="ambient-glow glow-emerald"></div>
  <div class="ambient-glow glow-indigo"></div>
  <div class="ambient-glow glow-cyan"></div>

  <!-- Reusable Frosted Glass Navigation -->
  <SiteNavbar activePage="guides" />

  <main class="mcp-guide-main">
    <!-- Hero Header -->
    <header class="mcp-guide-header">
      <div class="mcp-badge-pill">
        <span class="mcp-badge-pulse"></span>
        <span class="mcp-badge-text">Model Context Protocol • AI Agent Engineering</span>
      </div>

      <h1 class="mcp-page-title">
        Shaping Curated <span class="text-gradient">MCP Servers</span>
      </h1>

      <p class="mcp-page-subtitle">
        How to use OpenAPI vendor extensions (<code>x-mcp-*</code>) and smart heuristics to eliminate prompt token tax,
        collapse multi-hop REST roundtrips, and compile production-ready AI agent servers directly in the browser.
      </p>

      <div class="mcp-cta-row">
        <a href="/examples/mcp-server" class="mcp-btn primary">
          <IconPlayerPlay size={18} stroke={2} />
          <span>Interactive Showcase Demo</span>
        </a>
        <a href="/docs/advanced/mcp-server" class="mcp-btn secondary">
          <IconFileCode size={18} stroke={2} />
          <span>Technical Reference Docs</span>
          <IconArrowUpRight size={16} stroke={2} />
        </a>
      </div>

      <div class="mcp-quick-stats">
        <div class="mcp-stat-chip">
          <span class="mcp-stat-num">~80%</span>
          <span class="mcp-stat-txt">Token Overhead Reduction</span>
        </div>
        <div class="mcp-stat-chip">
          <span class="mcp-stat-num">6 Targets</span>
          <span class="mcp-stat-txt">TS, Python, Go, C#, Rust, Java</span>
        </div>
        <div class="mcp-stat-chip">
          <span class="mcp-stat-num">Zero Backend</span>
          <span class="mcp-stat-txt">Runs 100% in Browser</span>
        </div>
        <div class="mcp-stat-chip">
          <span class="mcp-stat-num">100%</span>
          <span class="mcp-stat-txt">RFC 3986 Hardened</span>
        </div>
      </div>
    </header>

    <!-- Content Sections -->
    <div class="mcp-guide-content">
      <!-- Section 1: The Core Philosophy -->
      <section class="mcp-section">
        <div class="section-tag">Philosophy</div>
        <h2 class="section-heading">Why Naive 1:1 REST-to-MCP Fails</h2>
        <p class="section-lead">
          When teams first connect OpenAPI to AI agents, their initial instinct is to convert every REST endpoint into an individual MCP tool.
          As Jeremiah Lowin explains in <em>"Stop Converting Your REST APIs to MCP"</em>, this naive approach severely degrades LLM performance:
        </p>

        <div class="comparison-grid">
          <div class="comparison-card naive">
            <div class="card-status-badge badge-danger">Naive 1:1 Conversion</div>
            <h3 class="card-title">Endpoint-as-a-Tool Trap</h3>
            <ul class="comparison-list">
              <li><strong>Token Window Bloat:</strong> 30–50 raw JSON schemas consume 4,000–8,000 tokens on <em>every conversation turn</em>.</li>
              <li><strong>Chained Atomic Hops:</strong> Agents must guess and execute 3–4 sequential calls (get customer &rarr; get orders &rarr; get items) just to fulfill one user intent.</li>
              <li><strong>Internal Leaks:</strong> Infrastructure endpoints (<code>/healthz</code>, <code>/metrics</code>, <code>/admin/debug</code>) confuse the model.</li>
              <li><strong>Transport Pollution:</strong> Headers like <code>Authorization</code>, <code>Cookie</code>, and <code>X-Api-Key</code> pollute tool parameters.</li>
            </ul>
          </div>

          <div class="comparison-card curated">
            <div class="card-status-badge badge-success">RapiDoc Curated MCP</div>
            <h3 class="card-title">Agent-First Tool Design</h3>
            <ul class="comparison-list">
              <li><strong>Lean Token Footprint:</strong> Parameter pruning and curated tool sets drop prompt cost by <strong>~80%</strong> (~850 tokens).</li>
              <li><strong>Composite Workflows:</strong> Multi-step REST hops collapse into single task tools via <code>x-mcp-workflows</code>.</li>
              <li><strong>Zero Admin Leaks:</strong> Automatic filtering via <code>x-internal</code>, <code>x-hidden</code>, and <code>deprecated: true</code>.</li>
              <li><strong>Clean Auth Separation:</strong> Transport headers are automatically stripped into environment variables (<code>process.env.API_KEY</code>).</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Section 2: Key Performance Indicators (KPIs) & Production Benchmarks -->
      <section class="mcp-section">
        <div class="section-tag">Performance & ROI</div>
        <h2 class="section-heading">Key Performance Indicators (KPIs)</h2>
        <p class="section-lead">
          Unlike generic converters that blindly dump hundreds of endpoints into an agent's context, RapiDoc is engineered to meet strict, quantifiable enterprise production benchmarks:
        </p>

        <div class="kpi-grid">
          <div class="kpi-card">
            <div class="kpi-badge">Token Budget KPI</div>
            <div class="kpi-metric-row">
              <span class="kpi-value">~80%</span>
              <span class="kpi-unit">prompt savings</span>
            </div>
            <h4>Context Overhead Elimination</h4>
            <p>Reduces prompt overhead from <strong>4,000–8,000 tokens</strong> down to <strong>~850 tokens/turn</strong>. Prevents LLM context saturation, eliminates model paralysis, and cuts recurring LLM inference bills.</p>
            <div class="kpi-bar-track">
              <div class="kpi-bar-fill" style="width: 80%;"></div>
            </div>
            <div class="kpi-meta">Benchmarked across Bookstore, Stripe & GitHub specs</div>
          </div>

          <div class="kpi-card">
            <div class="kpi-badge">Agent Latency KPI</div>
            <div class="kpi-metric-row">
              <span class="kpi-value">1 Turn</span>
              <span class="kpi-unit">vs 3–5 hops</span>
            </div>
            <h4>Composite Workflow Hop Reduction</h4>
            <p>Aggregates sequential REST requests (<code>getCustomer</code> &rarr; <code>listOrders</code> &rarr; <code>getDetails</code>) into atomic tools via <code>x-mcp-workflows</code>, reducing execution latency by <strong>~75%</strong>.</p>
            <div class="kpi-bar-track">
              <div class="kpi-bar-fill" style="width: 75%; background: #38bdf8;"></div>
            </div>
            <div class="kpi-meta">Zero compounding intermediate hallucination errors</div>
          </div>

          <div class="kpi-card">
            <div class="kpi-badge">Security Scorecard</div>
            <div class="kpi-metric-row">
              <span class="kpi-value">100%</span>
              <span class="kpi-unit">RFC 3986 escaped</span>
            </div>
            <h4>Path Traversal & Injection Immunity</h4>
            <p>Enforces dynamic percent-encoding across all path parameters in all 6 targets, stripping transport headers (<code>Authorization</code>, <code>Cookie</code>) and preventing path injection attacks.</p>
            <div class="kpi-bar-track">
              <div class="kpi-bar-fill" style="width: 100%; background: #10b981;"></div>
            </div>
            <div class="kpi-meta">Audited across Go, C#, Rust, Python, TS & Java</div>
          </div>

          <div class="kpi-card">
            <div class="kpi-badge">Polyglot Parity</div>
            <div class="kpi-metric-row">
              <span class="kpi-value">6 Targets</span>
              <span class="kpi-unit">100% parity</span>
            </div>
            <h4>Enterprise Polyglot Parity</h4>
            <p>First-class native implementations across TypeScript, Python (FastMCP with 0 external network dependencies), Go (static binary), C# (.NET 8/9), Rust (&lt;10 MB RAM), and Java (Spring AI).</p>
            <div class="kpi-bar-track">
              <div class="kpi-bar-fill" style="width: 100%; background: #f59e0b;"></div>
            </div>
            <div class="kpi-meta">Single-file zero-headache deployment</div>
          </div>
        </div>

        <!-- Comparative KPI Matrix Table -->
        <div class="sub-topic">
          <h3>Competitive KPI Matrix: RapiDoc vs. Generic MCP Generators</h3>
          <p>
            How RapiDoc stacks up against raw 1:1 endpoint wrappers and generic cloud CLI tools:
          </p>
          <div class="table-container">
            <table class="mcp-spec-table">
              <thead>
                <tr>
                  <th>Performance Dimension / KPI</th>
                  <th>Generic 1:1 Converters</th>
                  <th>Generic Cloud CLI Generators</th>
                  <th>RapiDoc Curated Generator</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Prompt Token Overhead</strong></td>
                  <td>4,000–8,000+ tokens / turn</td>
                  <td>2,500–5,000 tokens / turn</td>
                  <td><strong style="color: #34d399;">~850 tokens / turn (~80% reduction)</strong></td>
                </tr>
                <tr>
                  <td><strong>Target Languages Supported</strong></td>
                  <td>1 (TypeScript only)</td>
                  <td>1–2 languages</td>
                  <td><strong style="color: #34d399;">6 Targets (TS, Python, Go, C#, Rust, Java)</strong></td>
                </tr>
                <tr>
                  <td><strong>Multi-Hop REST Aggregation</strong></td>
                  <td>None (Agent must chain calls)</td>
                  <td>None (Raw 1:1 mapping)</td>
                  <td><strong style="color: #34d399;">Native <code>x-mcp-workflows</code> composite tools</strong></td>
                </tr>
                <tr>
                  <td><strong>Path Traversal & Injection Safety</strong></td>
                  <td>Vulnerable (raw string templates)</td>
                  <td>Unescaped parameter substitution</td>
                  <td><strong style="color: #34d399;">100% Target-Native RFC 3986 Escaping</strong></td>
                </tr>
                <tr>
                  <td><strong>Multi-Tenant Gateway Auth</strong></td>
                  <td>Stdio environment only</td>
                  <td>Hardcoded static credentials</td>
                  <td><strong style="color: #34d399;">Dual-Mode: Env fallback + Per-turn dynamic keys</strong></td>
                </tr>
                <tr>
                  <td><strong>Resource Dynamic Query Forwarding</strong></td>
                  <td>Statically broken or ignored</td>
                  <td>Unparsed query strings</td>
                  <td><strong style="color: #34d399;">RFC 6570 Dynamic Query Forwarding & Scrubbing</strong></td>
                </tr>
                <tr>
                  <td><strong>Backend / Cloud Dependency</strong></td>
                  <td>External Node server required</td>
                  <td>Paid cloud SaaS or heavy CLI</td>
                  <td><strong style="color: #34d399;">Zero Backend (100% In-Browser & Air-Gapped)</strong></td>
                </tr>
                <tr>
                  <td><strong>Real-Time Token Budget Warnings</strong></td>
                  <td>None (Blind to token saturation)</td>
                  <td>None</td>
                  <td><strong style="color: #34d399;">Built-in turn budget & token saturation guards</strong></td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- Section 3: Zero-Config Smart Heuristics -->
      <section class="mcp-section">
        <div class="section-tag">Zero Configuration</div>
        <h2 class="section-heading">Smart Heuristics (Out of the Box)</h2>
        <p class="section-lead">
          Even if your OpenAPI spec does not contain custom vendor extensions, RapiDoc applies smart heuristics during export:
        </p>

        <div class="heuristics-cards">
          <div class="heuristic-card">
            <div class="heuristic-icon"><IconCheck size={20} /></div>
            <div>
              <h4>Header & Transport Sanitization</h4>
              <p>Headers like <code>Authorization</code>, <code>Cookie</code>, <code>X-Api-Key</code>, <code>User-Agent</code>, and <code>Accept</code> are stripped from LLM parameter schemas and mapped to host environment variables.</p>
            </div>
          </div>
          <div class="heuristic-card">
            <div class="heuristic-icon"><IconCheck size={20} /></div>
            <div>
              <h4>Deprecated Route Exclusion</h4>
              <p>Operations marked with <code>deprecated: true</code> are automatically omitted from generated agent tools to prevent models from utilizing stale APIs.</p>
            </div>
          </div>
          <div class="heuristic-card">
            <div class="heuristic-icon"><IconCheck size={20} /></div>
            <div>
              <h4>Static Resource Classification</h4>
              <p>Zero-parameter <code>GET</code> endpoints (such as <code>/currencies</code> or <code>/shipping-tiers</code>) are converted into <strong>MCP Resources</strong> (<code>reference://...</code>), preserving tool calling budgets.</p>
            </div>
          </div>
          <div class="heuristic-card">
            <div class="heuristic-icon"><IconCheck size={20} /></div>
            <div>
              <h4>Token Budget Diagnostics</h4>
              <p>RapiDoc dynamically estimates prompt context tokens per conversation turn and generates warnings if tool count exceeds 30 or context exceeds 5,000 tokens.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 3: Vendor Extensions Specification -->
      <section class="mcp-section">
        <div class="section-tag">Specification</div>
        <h2 class="section-heading">The <code>x-mcp</code> Extension Family</h2>
        <p class="section-lead">
          Use the following vendor extensions to shape how agents interact with your operations:
        </p>

        <!-- 3.1: Tool Curation & Parameter Pruning -->
        <div class="sub-topic">
          <h3>1. Parameter Pruning & Agent Descriptions</h3>
          <p>
            REST APIs often contain telemetry, internal tracking tokens, and debug fields that confuse agents.
            Use <code>x-mcp.parameters.include</code> to expose only essential business parameters:
          </p>
          <CodeBlock code={naiveVsCuratedSnippet} lang="yaml" filename="openapi.yaml (Tool Curation)" />
        </div>

        <!-- 3.2: Tools vs Resources -->
        <div class="sub-topic">
          <h3>2. Declaring MCP Resources (Read-Only Lookups)</h3>
          <p>
            In the Model Context Protocol, <strong>Tools</strong> represent executable actions with side-effects, while <strong>Resources</strong>
            represent contextual reference data (like database catalogs, tax rates, or pricing tiers) that the model can inspect without function calling:
          </p>
          <CodeBlock code={staticResourceSnippet} lang="yaml" filename="openapi.yaml (MCP Resource)" />
        </div>

        <!-- 3.3: Composite Task Workflows -->
        <div class="sub-topic">
          <h3>3. Composite Task Workflows (<code>x-mcp-workflows</code>)</h3>
          <p>
            Instead of having the agent call <code>getCustomer</code>, then <code>listOrders</code>, and then <code>getOrderItems</code>,
            define a root-level composite workflow. The generated server executes the individual HTTP hops internally and returns consolidated JSON to the agent in <strong>1 single tool call</strong>:
          </p>
          <CodeBlock code={compositeWorkflowSnippet} lang="yaml" filename="openapi.yaml (Composite Workflows)" />
        </div>

        <!-- 3.4: Vendor Compatibility Matrix Table -->
        <div class="sub-topic">
          <h3>4. Vendor Extension Reference & Compatibility Matrix</h3>
          <div class="table-container">
            <table class="mcp-spec-table">
              <thead>
                <tr>
                  <th>Extension Key</th>
                  <th>Applies To</th>
                  <th>Type</th>
                  <th>Purpose & Compatibility</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><code>x-mcp.name</code></td>
                  <td>Operation</td>
                  <td>string</td>
                  <td>Agent-friendly snake_case tool name (e.g., <code>place_customer_order</code>).</td>
                </tr>
                <tr>
                  <td><code>x-mcp.description</code></td>
                  <td>Operation</td>
                  <td>string</td>
                  <td>Prompt engineering instructions tailored specifically for LLMs.</td>
                </tr>
                <tr>
                  <td><code>x-mcp.type</code></td>
                  <td>Operation</td>
                  <td><code>tool | resource</code></td>
                  <td>Explicitly assigns the endpoint as an actionable Tool or a reference Resource.</td>
                </tr>
                <tr>
                  <td><code>x-mcp.uri</code></td>
                  <td>Operation</td>
                  <td>string</td>
                  <td>Resource URI identifier (e.g., <code>reference://shipping-tiers</code>).</td>
                </tr>
                <tr>
                  <td><code>x-mcp.parameters.include</code></td>
                  <td>Operation</td>
                  <td>array&lt;string&gt;</td>
                  <td>Whitelist of parameters exposed to the LLM (prunes all other fields).</td>
                </tr>
                <tr>
                  <td><code>x-mcp.parameters.exclude</code></td>
                  <td>Operation</td>
                  <td>array&lt;string&gt;</td>
                  <td>Blacklist of parameters hidden from the agent.</td>
                </tr>
                <tr>
                  <td><code>x-mcp.parameters.defaults</code></td>
                  <td>Operation</td>
                  <td>object</td>
                  <td>Default argument values pre-filled for the agent.</td>
                </tr>
                <tr>
                  <td><code>x-mcp.requireConfirmation</code></td>
                  <td>Operation</td>
                  <td>boolean</td>
                  <td>Flags mutating/financial actions as requiring user confirmation.</td>
                </tr>
                <tr>
                  <td><code>x-mcp-workflows</code></td>
                  <td>Root Spec</td>
                  <td>array</td>
                  <td>Multi-step composite workflows collapsing REST hops into single tools.</td>
                </tr>
                <tr>
                  <td><code>x-internal</code> / <code>x-hidden</code></td>
                  <td>Operation</td>
                  <td>boolean</td>
                  <td><strong>Compatibility alias:</strong> Redocly & Scalar internal endpoint exclusion.</td>
                </tr>
                <tr>
                  <td><code>x-openai-isConsequential</code></td>
                  <td>Operation</td>
                  <td>boolean</td>
                  <td><strong>Compatibility alias:</strong> OpenAI ChatGPT Actions safety flag.</td>
                </tr>
                <tr>
                  <td><code>x-speakeasy-name-override</code></td>
                  <td>Operation</td>
                  <td>string</td>
                  <td><strong>Compatibility alias:</strong> Speakeasy SDK tool naming override.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- Section 5: Multi-Target Code Generation -->
      <section class="mcp-section">
        <div class="section-tag">Polyglot Runtimes</div>
        <h2 class="section-heading">Supported Target Languages</h2>
        <p class="section-lead">
          RapiDoc generates self-contained, production-ready server implementations across 6 popular languages:
        </p>

        <div class="targets-grid">
          <div class="target-card">
            <div class="target-badge">TypeScript</div>
            <h4>@modelcontextprotocol/sdk</h4>
            <p>Single-file TypeScript server with full <code>zod</code> parameter validation, async fetch handlers, and StdioServerTransport.</p>
            <div class="target-command">API_KEY="key" npx tsx server.ts</div>
          </div>

          <div class="target-card">
            <div class="target-badge">Python</div>
            <h4>FastMCP (The "Sweet Spot")</h4>
            <p>Uses Jeremiah Lowin's <code>fastmcp</code> with Python's built-in <code>urllib.request</code>. Zero 3rd party networking dependencies.</p>
            <div class="target-command">fastmcp run server.py</div>
          </div>

          <div class="target-card">
            <div class="target-badge">Go</div>
            <h4>mark3labs/mcp-go</h4>
            <p>Compiles to a single standalone static binary with zero host dependencies. Standard library <code>net/http</code>.</p>
            <div class="target-command">go build -o server && ./server</div>
          </div>

          <div class="target-card">
            <div class="target-badge">C# (.NET)</div>
            <h4>ModelContextProtocol.NET</h4>
            <p>Built for .NET 8 / 9 enterprise environments, Microsoft Semantic Kernel integration, and native <code>HttpClient</code>.</p>
            <div class="target-command">dotnet run</div>
          </div>

          <div class="target-card">
            <div class="target-badge">Rust</div>
            <h4>mcp-sdk + tokio</h4>
            <p>Ultra-low memory footprint (&lt;10 MB RAM), zero-cost abstractions, and instant cold starts.</p>
            <div class="target-command">cargo build --release</div>
          </div>

