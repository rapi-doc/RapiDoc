---
import GlobalLayout from '../../layouts/GlobalLayout.astro';
import SiteNavbar from '../../components/SiteNavbar.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { IconArrowRight, IconArrowUpRight, IconFileCode, IconPlayerPlay } from '@tabler/icons-astro';

const enableSnippet = `<script type="module" src="https://unpkg.com/rapidoc/dist/rapidoc-min.js"></script>

<rapi-doc
  spec-url="/specs/my-api.yaml"
  mcp="true"
  mcp-server-name="my-api"
></rapi-doc>`;

const trySnippet = `unzip my-api-mcp.zip -d my-api-mcp
cd my-api-mcp
npm install

# Optional: start it once to check it. It prints "[MCP] my_api: 2 tools on stdio" and waits.
PARTNER_KEY="your-key" npm start`;

const hostConfigSnippet = `{
  "mcpServers": {
    "my_api": {
      "command": "npx",
      "args": ["-y", "tsx", "/Users/you/my-api-mcp/server.ts"],
      "env": {
        "PARTNER_KEY": "your-key"
      }
    }
  }
}`;

const cliSnippet = `npm install -D @rapidoc/cli
npx rapidoc mcp export my-api.yaml --out-dir my-api-mcp --server-name my-api`;

const openApiToMcpSnippet = `security:
  - partner_key: []                  # Sent by the server, from the PARTNER_KEY variable

paths:
  /orders:
    post:
      operationId: placeOrder        # Tool "place_order"
      summary: Place a new order     # Tool description
      parameters:
        - name: Authorization        # Left out: never a tool argument
          in: header
          schema: { type: string }
      requestBody:                   # Tool argument "body", with its full JSON Schema
        required: true
        content:
          application/json:
            schema: { $ref: "#/components/schemas/NewOrder" }

  /orders/{orderId}:
    get:
      operationId: getOrder          # Tool "get_order", marked read-only
      summary: Get an order
      parameters:
        - name: orderId              # Tool argument "orderId"
          in: path
          required: true
          schema: { type: string }

  /currencies:
    get:
      operationId: getCurrencies     # Resource "reference://currencies", not a tool
      summary: List supported currencies

  /admin/database/vacuum:
    post:
      summary: Trigger internal database maintenance
      x-internal: true               # Left out

  /orders/legacy:
    get:
      summary: Legacy order list
      deprecated: true               # Left out

components:
  securitySchemes:
    partner_key:                     # The scheme's name decides the variable's name
      type: apiKey
      in: header
      name: X-API-Key`;

const optionsSnippet = `const doc = document.querySelector('rapi-doc');

// The same export as the button, with options
doc.downloadMcpServer({
  includeInternal: true,     // keep x-internal and x-hidden operations
  includeDeprecated: true,   // keep deprecated operations
});

// Or build it in memory and look before you download
const result = doc.generateMcpServer();
console.log(result.manifest.tools);   // each: name, description, inputSchema, annotations (the safety hints), operation (the request)
console.log(result.budget);           // { totalTools, totalResources, estimatedTokens, warnings, ... }`;
---

<GlobalLayout
  title="MCP Server Guide | RapiDoc"
  description="Export an MCP server from an OpenAPI spec with RapiDoc: turn on the export, run the server, connect Claude Desktop, Cursor or another AI app, and know what the agent can call."
  keywords="Model Context Protocol, MCP, OpenAPI to MCP, MCP manifest, Claude Desktop, Cursor, AI agents, RapiDoc MCP"
>
  <div class="ambient-glow glow-emerald"></div>
  <div class="ambient-glow glow-indigo"></div>
  <div class="ambient-glow glow-cyan"></div>

  <SiteNavbar activePage="guides" />

  <main class="mcp-guide-main">
    <header class="rd-hero-header">
      <div class="rd-badge-pill">
        <span class="rd-badge-pulse"></span>
        <span class="rd-badge-text">Guide • Model Context Protocol</span>
      </div>

      <h1 class="rd-page-title">
        Export an <span class="text-gradient">MCP Server</span> from Your OpenAPI Spec
      </h1>

      <p class="rd-page-subtitle">
        The Model Context Protocol (MCP) is how AI apps such as Claude Desktop, Cursor, Claude Code and Codex call outside tools. RapiDoc
        turns the API it documents into an MCP server project, so an AI assistant can call that API.
      </p>

      <div class="mcp-cta-row">
        <a href="/examples/mcp-server" class="rd-btn rd-btn-primary">
          <IconPlayerPlay size={18} stroke={2} />
          <span>Try the demo</span>
        </a>
        <a href="/docs/ai/mcp-server/" class="rd-btn rd-btn-secondary">
          <IconFileCode size={18} stroke={2} />
          <span>Reference docs</span>
          <IconArrowUpRight size={16} stroke={2} />
        </a>
      </div>
    </header>

    <div class="mcp-guide-content">
      <!-- 1. How it works -->
      <section class="rd-section">
        <div class="rd-section-badge">Overview</div>
        <h2 class="rd-section-title">How It Works</h2>
        <p class="rd-section-desc">
          Three things happen, in three places. The documentation page only builds a download: the server never runs there, and there is no service to host.
        </p>

        <ol class="where-grid">
          <li class="where-card">
            <span class="where-place">In the browser</span>
            <h3>RapiDoc builds a zip</h3>
            <p>
              With <code>mcp="true"</code>, the API overview shows an <strong>Export MCP Server</strong> button. A click
              builds a small Node.js project from the loaded spec and downloads it. No request leaves the page.
            </p>
          </li>
          <li class="where-card">
            <span class="where-place">On your machine</span>
            <h3>You unzip and install it</h3>
            <p>
              The project is a list of the API's tools (<code>manifest.json</code>) plus a server that is the same for
              every API. <code>npm install</code> gets its two dependencies.
            </p>
          </li>
          <li class="where-card">
            <span class="where-place">In the AI app</span>
            <h3>The app starts the server</h3>
            <p>
              The app (Claude Desktop, Cursor, or any other that can start a local MCP server) starts the server as a child process and talks to it over stdin and stdout. It
              listens on no port. When the assistant calls a tool, the server calls your API.
            </p>
          </li>
        </ol>

        <p class="note">
          Who does what: the person who publishes the documentation adds <code>mcp="true"</code>. Anyone reading the
          documentation can then export the server and run it with their own API credentials.
        </p>
      </section>

      <!-- 2. Quick start -->
      <section class="rd-section">
        <div class="rd-section-badge">Quick start</div>
        <h2 class="rd-section-title">From Spec to a Tool in Claude or Cursor</h2>
        <p class="rd-section-desc">You need Node.js 18 or later for steps 3 and 4.</p>

        <ol class="steps">
          <li>
            <h3>Turn on the export</h3>
            <p>Add <code>mcp="true"</code> to <code>&lt;rapi-doc&gt;</code>. The spec needs no changes.</p>
            <CodeBlock code={enableSnippet} lang="html" filename="index.html" />
            <p>
              <code>mcp-server-name</code> is only a name. It is not a server that is running somewhere. It becomes
              the name of the download (<code>my-api-mcp.zip</code>), the package name (<code>my-api</code>), and the name the AI app lists
              the server under (<code>my_api</code>). Without it, the name comes from the spec's title.
            </p>
          </li>
          <li>
            <h3>Export</h3>
            <p>
              Open the page and click <strong>Export MCP Server</strong> in the API overview. The browser downloads <code>my-api-mcp.zip</code>.
            </p>
          </li>
          <li>
            <h3>Unzip and install</h3>
            <CodeBlock code={trySnippet} lang="bash" filename="terminal" />
            <p>
              <code>npm install</code> is needed even though the AI app starts the server: it gets the MCP library that <code>server.ts</code> imports. <code>npm start</code> is only a check. The server waits on stdin for an AI app, so it prints one line and then nothing; stop it with Ctrl+C. It starts without credentials too, and a tool call then returns the API's own error. Credentials are environment variables named after the spec's security schemes. This guide's example API has one scheme, <code>partner_key</code>, so its variable is <code>PARTNER_KEY</code>; the <code>README.md</code> in your zip lists the names for your API (see <a href="#credentials">Credentials</a>).
            </p>
          </li>
          <li>
            <h3>Connect the AI app</h3>
            <p>
              Any AI app that can start a local MCP server works: Claude Desktop, Cursor, Claude Code, Codex and others. The zip has a file named <code>mcp.json</code> with one ready <code>mcpServers</code> entry. It is a template: nothing is installed into your AI app yet. Add that entry to the <code>mcpServers</code> object of your app's own configuration file (keep the entries already there), replace the placeholder path <code>/absolute/path/to/my-api/server.ts</code> with the real absolute path of your <code>server.ts</code>, and fill in the credentials:
            </p>
            <CodeBlock code={hostConfigSnippet} lang="json" filename="your AI app's configuration file" />
            <div class="rd-table-container">
              <table class="mcp-spec-table">
                <thead>
                  <tr>
                    <th>App</th>
                    <th>Configuration file</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Claude Desktop, macOS</td>
                    <td><code>~/Library/Application Support/Claude/claude_desktop_config.json</code></td>
                  </tr>
                  <tr>
                    <td>Claude Desktop, Windows</td>
                    <td><code>%APPDATA%\Claude\claude_desktop_config.json</code></td>
                  </tr>
                  <tr>
                    <td>Cursor</td>
                    <td><code>~/.cursor/mcp.json</code>, or <code>.cursor/mcp.json</code> in a project</td>
                  </tr>
                  <tr>
                    <td>Claude Code</td>
                    <td><code>.mcp.json</code> in a project</td>
                  </tr>
                  <tr>
                    <td>Codex</td>
                    <td><code>~/.codex/config.toml</code>: a <code>[mcp_servers.my_api]</code> section with the same <code>command</code>, <code>args</code> and <code>env</code>, written as TOML</td>
                  </tr>
                  <tr>
                    <td>Another app</td>
                    <td>Its MCP settings. Most read the same <code>mcpServers</code> JSON; the rest take the same command, arguments and variables in their own format.</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <p>
              Restart the app. It starts the server itself, and the API's tools appear in its tool list. The path must be absolute because the app starts the server from its own folder, not from yours. If the tools do not appear, check that the path is right and that <code>npm install</code> ran in that folder, then look at the app's MCP log.
            </p>
          </li>
        </ol>

        <div class="sub-topic">
          <h3>From the command line</h3>
          <p>
            The <code>rapidoc</code> command writes the same project from a spec file, without a browser, and puts the real path of <code>server.ts</code> in the configuration entry. It comes with the <code>@rapidoc/cli</code> package (see <a href="/docs/tools/command-line/">Command line</a>):
          </p>
          <CodeBlock code={cliSnippet} lang="bash" filename="terminal" />
        </div>
      </section>

      <!-- 3. What gets exported -->
      <section class="rd-section">
        <div class="rd-section-badge">Mapping</div>
        <h2 class="rd-section-title">What Gets Exported</h2>
        <p class="rd-section-desc">
          MCP has two kinds of things a server offers. A <strong>tool</strong> is an action the assistant can call. A <strong>resource</strong> is data the AI app can attach to a conversation. Each operation in the spec becomes
          one tool, with these exceptions: operations marked internal, hidden or deprecated are left out, and lookups
          of reference data become resources.
        </p>

        <div class="sub-topic">
          <CodeBlock code={openApiToMcpSnippet} lang="yaml" filename="my-api.yaml" />
        </div>

        <div class="sub-topic">
          <h3>The rules</h3>
          <div class="rd-table-container">
            <table class="mcp-spec-table">
              <thead>
                <tr>
                  <th>In the spec</th>
                  <th>In the export</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><code>operationId</code></td>
                  <td>
                    The tool's name, in snake_case (<code>placeOrder</code> &rarr; <code>place_order</code>). Without
                    one, the name comes from the method and path.
                  </td>
                </tr>
                <tr>
                  <td><code>summary</code>, <code>description</code></td>
                  <td>The tool's description (<code>summary</code> first), as plain text of up to 300 characters.</td>
                </tr>
                <tr>
                  <td>Parameters, <code>requestBody</code></td>
                  <td>
                    The tool's arguments: each path, query, header and cookie parameter by name, and a <code>body</code> argument with the request body's full JSON Schema.
                  </td>
                </tr>
                <tr>
                  <td>Auth and transport headers</td>
                  <td>
                    Never tool arguments: <code>Authorization</code>, <code>Cookie</code>, <code>X-API-Key</code>, <code>User-Agent</code>, <code>Accept</code>, and any parameter that carries an API key declared
                    in <code>securitySchemes</code>. A secret passed in a parameter the spec does not declare as a
                    security scheme stays an argument.
                  </td>
                </tr>
                <tr>
                  <td><code>x-internal</code>, <code>x-hidden</code>, <code>deprecated</code></td>
                  <td>When <code>true</code>, the operation is left out. So are webhooks.</td>
                </tr>
                <tr>
                  <td>HTTP method</td>
                  <td>
                    The tool's safety hints. <code>GET</code> is marked read-only. <code>PUT</code>, <code>PATCH</code> and <code>DELETE</code> are marked destructive. <code>POST</code> gets neither mark, because a <code>POST</code> can create something or cancel something. AI apps treat a tool without the mark as possibly destructive.
                  </td>
                </tr>
                <tr>
                  <td>Reference-data paths</td>
                  <td>
                    A <code>GET</code> with no required parameters whose path contains <code>/reference</code>, <code>/currencies</code>, <code>/countries</code>, <code>/tiers</code>, <code>/categories</code> or <code>/schema</code> becomes a resource (<code>reference://currencies</code>), not a tool.
                  </td>
                </tr>
                <tr>
                  <td><code>x-mcp-resource</code></td>
                  <td>
                    On an operation, overrides the row above: <code>false</code> keeps it a tool, <code>true</code> makes any <code>GET</code> with no required parameters a resource.
                  </td>
                </tr>
                <tr>
                  <td><code>servers</code></td>
                  <td>
                    The first server's URL is the base URL the tools call, with each server variable at its default. The exported server runs outside the documentation page, so it needs a full URL: when the spec has no <code>servers</code>, or a relative one such as <code>/api/v1</code>, set the <code>API_BASE_URL</code> variable. It also overrides a full URL, for example to point at staging.
                  </td>
                </tr>
                <tr>
                  <td><code>securitySchemes</code>, <code>security</code></td>
                  <td>
                    Copied into the manifest. The server sends each scheme's credential itself, from an environment
                    variable (see <a href="#credentials">Credentials</a>).
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="sub-topic">
          <h3>Changing what is exported</h3>
          <p>
            Most control is in the spec: mark an operation <code>x-internal: true</code> to leave it out, or set <code>x-mcp-resource</code>. From JavaScript, <code>downloadMcpServer()</code> and <code>generateMcpServer()</code> take the same options, to keep internal or deprecated operations. Both work whether or not the button is shown. The path list for resources and the names of tools are not configurable.
          </p>
          <CodeBlock code={optionsSnippet} lang="javascript" filename="app.js" />
          <p>
            The list of tools is sent to the model on every turn, so a long list costs tokens. <code>result.budget</code> (also <code>doc.getMcpBudget()</code>) estimates that cost and carries a warning
            above 30 tools or about 5,000 tokens. It only warns: nothing is cut. If the page also shows workflows (sequences of API calls, drawn by the <code>&lt;rapi-flow&gt;</code> element), each workflow is exported as one more tool that runs its calls in order. The <a href="/docs/rapi-flow/">Workflows</a> page explains them; this guide does not need them.
          </p>
        </div>
      </section>

      <!-- 4. Credentials -->
      <section class="rd-section" id="credentials">
        <div class="rd-section-badge">Running it</div>
        <h2 class="rd-section-title">Credentials</h2>
        <p class="rd-section-desc">
          The assistant never sees or supplies a credential. The server reads each one from an environment variable and
          adds it to the request, the way the spec's security scheme says. Set the variables in the <code>env</code> block of the app's configuration entry.
        </p>

        <div class="rd-table-container">
          <table class="mcp-spec-table">
            <thead>
              <tr>
                <th>Security scheme</th>
                <th>What to set</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Any scheme</td>
                <td>
                  A variable named after the scheme, in upper snake case: <code>partner_key</code> &rarr; <code>PARTNER_KEY</code>, <code>petstoreAuth</code> &rarr; <code>PETSTORE_AUTH</code>. The exported
                  README and configuration entry list the names for your API.
                </td>
              </tr>
              <tr>
                <td>API key</td>
                <td>The key. It is sent in the header, query parameter or cookie the scheme names.</td>
              </tr>
              <tr>
                <td>HTTP Basic</td>
                <td>
                  <code>user:password</code> in the scheme's variable, or <code>&lt;NAME&gt;_USERNAME</code> and <code>&lt;NAME&gt;_PASSWORD</code>.
                </td>
              </tr>
              <tr>
                <td>HTTP bearer, OAuth 2, OpenID Connect</td>
                <td>
                  An access token you already have. It is sent as a <code>Bearer</code> token. The server does not
                  sign in, and does not refresh a token that expires.
                </td>
              </tr>
              <tr>
                <td>An API with one scheme</td>
                <td>
                  <code>API_KEY</code> also works as the variable. With several schemes, each needs its own.
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- 5. Safety and limits -->
      <section class="rd-section">
        <div class="rd-section-badge">Before you rely on it</div>
        <h2 class="rd-section-title">Safety and Limits</h2>
        <ul class="limits">
          <li>
            <strong>The assistant calls your real API.</strong> Every tool call is a real request, made with the
            credentials you set. Use a key with only the permissions the assistant should have, or point <code>API_BASE_URL</code> at a staging server.
          </li>
          <li>
            <strong>Safety hints are hints.</strong> An AI app may use them to ask before a tool that changes data,
            but the server runs whatever it is asked to run. It has no confirmation step of its own.
          </li>
          <li>
            <strong>Leaving an operation out is not access control.</strong> It keeps the operation off the tool
            list. Only the API's own permissions stop a key from reaching it.
          </li>
          <li>
            <strong>The spec's text and the API's responses reach the model as they are.</strong> Export only from
            specs you trust, and keep in mind that a response can be large.
          </li>
          <li>
            <strong>Local AI apps only.</strong> The exported server talks over stdin and stdout, and it is a
            TypeScript project for Node.js. It is not an HTTP server, so a hosted or remote AI app cannot reach it.
          </li>
        </ul>
      </section>

      <!-- 6. The files -->
      <section class="rd-section">
        <div class="rd-section-badge">Reference</div>
        <h2 class="rd-section-title">What Is in the Zip</h2>
        <p class="rd-section-desc">
          Only <code>manifest.json</code> is specific to your API. It is data, not generated code, so it is the one
          file to review. The rest is the same in every export.
        </p>
        <div class="rd-table-container">
          <table class="mcp-spec-table">
            <thead>
              <tr>
                <th>File</th>
                <th>What it is</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><code>manifest.json</code></td>
                <td>
                  The server's name, the API's base URL and security schemes, and every tool and resource: its name,
                  description, arguments, safety hints, and the request to make.
                </td>
              </tr>
              <tr>
                <td><code>server.ts</code></td>
                <td>The MCP server. It reads the manifest and offers its tools and resources over stdin and stdout.</td>
              </tr>
              <tr>
                <td><code>runtime.js</code></td>
                <td>Turns a tool call into an HTTP request to the API and the response into the tool's result.</td>
              </tr>
              <tr>
                <td><code>package.json</code></td>
                <td>
                  Two dependencies: <code>@modelcontextprotocol/sdk</code> and <code>tsx</code>, which runs <code>server.ts</code> without a build step.
                </td>
              </tr>
              <tr>
                <td><code>mcp.json</code></td>
                <td>The <code>mcpServers</code> entry to copy into an AI app's configuration, with one variable per security scheme.</td>
              </tr>
              <tr>
                <td><code>README.md</code></td>
                <td>How to run this export, with the variable names for this API.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="mcp-cta-box">
        <div class="mcp-cta-content">
          <h2>Next</h2>
          <p>
            The demo shows the export for a sample API: its tools, the token estimate and every file in the zip. The
            reference docs cover the manifest format, the runtime and the JavaScript API.
          </p>
          <div class="cta-actions">
            <a href="/examples/mcp-server" class="rd-btn rd-btn-primary">
              <span>Try the demo</span>
              <IconArrowRight size={18} stroke={2} />
            </a>
            <a href="/docs/ai/mcp-server/" class="rd-btn rd-btn-secondary">
              <span>Reference docs</span>
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>

  <SiteFooter />
</GlobalLayout>

<style>
  .mcp-guide-main {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--rd-page-top) 24px 96px;
  }
  .mcp-cta-row {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  /* The lead paragraph sits directly above the section's content, without a header wrapper */
  .rd-section > .rd-section-desc {
    margin-bottom: 28px;
  }
  .rd-section a:not(.rd-btn) {
    color: var(--rd-accent-light);
  }
  .rd-section code {
    background: var(--rd-wash-strong);
    padding: 2px 6px;
    border-radius: var(--rd-radius-xs);
    font-size: 0.92em;
    color: var(--rd-sky);
    font-family: var(--rd-font-mono);
  }
  .sub-topic {
    margin-top: 36px;
  }
  .sub-topic h3 {
    font-size: 19px;
    font-weight: 600;
    color: var(--rd-text-primary);
    margin: 0 0 10px;
  }
  .sub-topic p,
  .note {
    font-size: 14px;
    line-height: 1.6;
    color: var(--rd-text-muted);
    margin: 14px 0;
  }

  /* Where each part runs: three cards in order */
  .where-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .where-card {
    padding: 22px;
    background: var(--rd-surface);
    border: 1px solid var(--rd-border);
    border-radius: var(--rd-radius-lg);
  }
  .where-place {
    display: inline-block;
    margin-bottom: 12px;
    padding: 3px 10px;
    border: 1px solid var(--rd-accent-border);
    border-radius: var(--rd-radius-pill);
    background: var(--rd-accent-dim);
    color: var(--rd-accent-light);
    font-size: 12px;
    font-weight: 600;
  }
  .where-card h3 {
    font-size: 16px;
    font-weight: 700;
    color: var(--rd-text-bright);
    margin: 0 0 8px;
  }
  .where-card p {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--rd-text-muted);
    margin: 0;
  }

