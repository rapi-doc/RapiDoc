---
import GlobalLayout from '../../layouts/GlobalLayout.astro';
import SiteNavbar from '../../components/SiteNavbar.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { stylingData } from '../../page-data/styling-data';
import '../../styles/styling.css';
import {
  IconSearch,
  IconSearchOff,
  IconX,
  IconCopy,
  IconArrowRight,
} from '@tabler/icons-astro';

const totalParts = stylingData.parts.reduce((acc, cat) => acc + cat.items.length, 0);
const totalVariables = stylingData.variables.reduce((acc, cat) => acc + cat.items.length, 0);
const totalCategories = stylingData.parts.length;
---

<GlobalLayout
  title="Custom CSS, Design Tokens & Shadow Parts (::part) | RapiDoc"
  description="Deeply customize RapiDoc OpenAPI UI via CSS custom properties (variables) and W3C standard CSS Shadow Parts (::part) without breaking encapsulation."
  keywords="RapiDoc CSS parts, Shadow DOM styling, OpenAPI custom CSS, CSS variables catalog, Swagger ::part, design tokens"
>
  <div class="ambient-glow glow-emerald"></div>
  <div class="ambient-glow glow-indigo"></div>
  <div class="ambient-glow glow-cyan"></div>

  <SiteNavbar activePage="guides" />

  <main class="rd-styling-main">
    <header class="rd-styling-hero">
      <div class="rd-badge-pill">
        <span class="rd-badge-pulse"></span>
        <span class="rd-badge-text">Shadow DOM Encapsulation & Styling</span>
      </div>

      <h1 class="rd-page-title">
        Custom CSS, Design Tokens & <span class="text-gradient">Shadow Parts (::part)</span>
      </h1>

      <p class="rd-page-subtitle">
        Because RapiDoc is built as a standard W3C Web Component, its markup resides inside an isolated Shadow DOM.
        Safely customize internal styles using CSS Custom Properties (Design Tokens) and standard CSS Shadow Parts (<code>::part()</code>) without breaking encapsulation.
      </p>

      <div class="rd-stats-bar">
        <div class="rd-stat-card">
          <span class="rd-stat-value">{totalVariables}</span>
          <span class="rd-stat-label">CSS Custom Properties</span>
        </div>
        <div class="rd-stat-card">
          <span class="rd-stat-value">{totalParts}</span>
          <span class="rd-stat-label">CSS Shadow Parts</span>
        </div>
        <div class="rd-stat-card">
          <span class="rd-stat-value">{totalCategories}</span>
          <span class="rd-stat-label">Functional UI Zones</span>
        </div>
      </div>

      <!-- Quick Jump Navigation -->
      <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 28px;">
        <a href="#variables-catalog" style="font-size: 13px; font-weight: 600; color: #34d399; background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.25); padding: 6px 14px; border-radius: 9999px; text-decoration: none;">
          🎨 CSS Custom Properties ({totalVariables})
        </a>
        <a href="#parts-catalog" style="font-size: 13px; font-weight: 600; color: #38bdf8; background: rgba(56,189,248,0.1); border: 1px solid rgba(56,189,248,0.25); padding: 6px 14px; border-radius: 9999px; text-decoration: none;">
          🧩 CSS Shadow Parts ({totalParts})
        </a>
      </div>
    </header>

    <!-- Unified Real-time Search & Filter Controls -->
    <section class="rd-catalog-section" id="catalogs">
      <div class="rd-section-header">
        <div class="rd-section-badge">Complete Reference</div>
        <h2 class="rd-section-title">Design Tokens & Shadow Parts Catalog</h2>
        <p class="rd-section-desc">
          Both CSS Custom Properties and CSS Shadow Parts are displayed below. Use the search bar or category filters to quickly locate specific tokens or elements across both catalogs.
        </p>
      </div>

      <!-- Live Search & Interactive Filter Controls -->
      <div class="rd-filter-controls">
        <div class="rd-search-wrapper">
          <IconSearch size={18} class="rd-search-icon" stroke={2} />
          <input
            id="styling-search-input"
            type="text"
            placeholder="Search custom properties, shadow parts, HTML targets, or keywords (e.g. --radius, section-navbar, btn, primary)..."
            autocomplete="off"
            class="rd-search-input"
          />
          <button id="clear-search-btn" class="rd-clear-btn" aria-label="Clear search" style="display: none;">
            <IconX size={14} stroke={2} />
          </button>
        </div>

        <!-- Category Filter Pills -->
        <div class="rd-nav-pills" id="category-pills">
          <button class="rd-pill active" data-category="all">All Categories</button>
          {
            stylingData.parts.map((cat) => (
              <button class="rd-pill" data-category={cat.category}>{cat.category}</button>
            ))
          }
        </div>
      </div>

      <!-- Empty State -->
      <div id="catalog-empty-state" class="rd-empty-state" style="display: none;">
        <div class="rd-empty-icon">
          <IconSearchOff size={32} stroke={1.8} />
        </div>
        <h3 class="rd-empty-title">No matching styling items found <span id="empty-query-text" class="text-gradient"></span></h3>
        <p class="rd-empty-desc">Try searching for a different keyword or reset your active category filter.</p>
        <button id="reset-search-btn" class="rd-btn rd-btn-primary">Reset Filter</button>
      </div>

      <!-- CATALOG 1: CSS CUSTOM PROPERTIES (DESIGN TOKENS) -->
      <div id="variables-catalog" class="rd-catalog-wrapper" style="margin-top: 36px; margin-bottom: 64px;">
        <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid rgba(16,185,129,0.3); padding-bottom: 12px; margin-bottom: 24px;">
          <div>
            <div style="display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #34d399; background: rgba(16,185,129,0.1); padding: 3px 8px; border-radius: 4px; margin-bottom: 6px;">
              Design System Tokens
            </div>
            <h3 style="font-size: 24px; font-weight: 800; color: #fff; margin: 0; letter-spacing: -0.02em;">
              1. CSS Custom Properties ({totalVariables})
            </h3>
          </div>
          <span style="font-size: 12.5px; color: #94a3b8; font-family: monospace;">:host variables</span>
        </div>

        <div id="variables-catalog-container" class="rd-catalog-grid">
          {
            stylingData.variables.map((cat) => (
              <div class="rd-catalog-group" data-category={cat.category}>
                <div class="rd-group-header">
                  <h4 class="rd-group-title">{cat.category}</h4>
                  <p class="rd-group-desc">{cat.description}</p>
                </div>
                <div class="rd-table-wrapper">
                  <table class="rd-catalog-table">
                    <thead>
                      <tr>
                        <th class="col-name">Custom Property</th>
                        <th class="col-default">Default / Calculated Value</th>
                        <th class="col-desc">Description & Purpose</th>
                      </tr>
                    </thead>
                    <tbody>
                      {cat.items.map((item) => (
                        <tr class="rd-catalog-row" data-name={item.name} data-default={item.default} data-desc={item.description} data-category={cat.category}>
                          <td class="col-name">
                            <button class="rd-copy-pill var-pill" data-copy={`${item.name}`} title="Click to copy variable">
                              <code>{item.name}</code>
                              <IconCopy size={12} class="copy-svg" stroke={2} />
                            </button>
                          </td>
                          <td class="col-default">
                            <span class="rd-default-badge">{item.default}</span>
                          </td>
                          <td class="col-desc">{item.description}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- CATALOG 2: CSS SHADOW PARTS (::part()) DIRECTLY BELOW -->
      <div id="parts-catalog" class="rd-catalog-wrapper" style="margin-top: 48px;">
        <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid rgba(56,189,248,0.3); padding-bottom: 12px; margin-bottom: 24px;">
          <div>
            <div style="display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #38bdf8; background: rgba(56,189,248,0.1); padding: 3px 8px; border-radius: 4px; margin-bottom: 6px;">
              Shadow Boundary Piercing
            </div>
            <h3 style="font-size: 24px; font-weight: 800; color: #fff; margin: 0; letter-spacing: -0.02em;">
              2. CSS Shadow Parts ({totalParts})
            </h3>
          </div>
          <span style="font-size: 12.5px; color: #94a3b8; font-family: monospace;">::part() selectors</span>
        </div>

        <div id="parts-catalog-container" class="rd-catalog-grid">
          {
            stylingData.parts.map((cat) => (
              <div class="rd-catalog-group" data-category={cat.category}>
                <div class="rd-group-header">
                  <h4 class="rd-group-title">{cat.category}</h4>
                  <p class="rd-group-desc">{cat.description}</p>
                </div>
                <div class="rd-table-wrapper">
                  <table class="rd-catalog-table">
                    <thead>
                      <tr>
                        <th class="col-name">Part Name (<code>::part</code>)</th>
                        <th class="col-target">HTML Element</th>
                        <th class="col-desc">Description & Purpose</th>
                      </tr>
                    </thead>
                    <tbody>
                      {cat.items.map((item) => (
                        <tr class="rd-catalog-row" data-name={item.name} data-target={item.target} data-desc={item.description} data-category={cat.category}>
                          <td class="col-name">
                            <button class="rd-copy-pill" data-copy={`rapi-doc::part(${item.name})`} title="Click to copy ::part selector">
                              <code>::{item.name}</code>
                              <IconCopy size={12} class="copy-svg" stroke={2} />
                            </button>
                          </td>
                          <td class="col-target">
                            <span class="rd-target-badge">{item.target}</span>
                          </td>
                          <td class="col-desc">{item.description}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Cross Navigation Banner -->
    <section class="rd-section-block" style="text-align: center; background: rgba(15,23,42,0.6); border: 1px solid rgba(16,185,129,0.3); border-radius: 16px; padding: 40px 24px; margin-top: 64px;">
      <h3 style="font-size: 22px; font-weight: 700; color: #fff; margin-bottom: 10px;">Looking for Named HTML Slots or Theme Presets?</h3>
      <p style="color: #94a3b8; max-width: 620px; margin: 0 auto 24px; font-size: 14px; line-height: 1.6;">
        Inject corporate logos, banners, headers, and footers with standard Web Component slots, or configure declarative color presets in our Themes guide.
      </p>
      <div style="display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;">
        <a href="/guides/slots" class="rd-action-primary" style="display: inline-flex; align-items: center; gap: 8px; background: #10b981; color: #fff; padding: 10px 22px; border-radius: 8px; font-weight: 600; text-decoration: none;">
          <span>Named HTML Slots Guide</span>
          <IconArrowRight size={16} stroke={2.5} />
        </a>
        <a href="/guides/theme" style="display: inline-flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); color: #f8fafc; padding: 10px 22px; border-radius: 8px; font-weight: 600; text-decoration: none;">
          <span>Themes & Brand Colors Guide</span>
          <IconArrowRight size={16} stroke={2.5} />
        </a>
      </div>
    </section>
  </main>

  <script>
    function setupStylingSearch() {
      let activeCategory = 'all';

      const searchInput = document.getElementById('styling-search-input') as HTMLInputElement | null;
      const clearSearchBtn = document.getElementById('clear-search-btn');
      const resetSearchBtn = document.getElementById('reset-search-btn');
      const emptyState = document.getElementById('catalog-empty-state');
      const emptyQueryText = document.getElementById('empty-query-text');

      const categoryPills = document.getElementById('category-pills');
      const variablesContainer = document.getElementById('variables-catalog-container');
      const partsContainer = document.getElementById('parts-catalog-container');
      const variablesCatalog = document.getElementById('variables-catalog');
      const partsCatalog = document.getElementById('parts-catalog');

      function filterCatalog() {
        const query = searchInput ? searchInput.value.trim().toLowerCase() : '';

        let totalVisibleOverall = 0;

        [variablesContainer, partsContainer].forEach((container) => {
          if (!container) return;
          let containerVisible = 0;
          const groups = container.querySelectorAll('.rd-catalog-group');

          groups.forEach((groupEl) => {
            const group = groupEl as HTMLElement;
            const groupCategory = group.getAttribute('data-category') || '';
            const matchesCategory = activeCategory === 'all' || activeCategory.toLowerCase() === groupCategory.toLowerCase();

            if (!matchesCategory) {
              group.style.display = 'none';
              return;
            }

            let visibleRowsInGroup = 0;
            const rows = group.querySelectorAll('.rd-catalog-row');

            rows.forEach((rowEl) => {
              const row = rowEl as HTMLElement;
              const name = (row.getAttribute('data-name') || '').toLowerCase();
              const target = (row.getAttribute('data-target') || '').toLowerCase();
              const defaultVal = (row.getAttribute('data-default') || '').toLowerCase();
              const desc = (row.getAttribute('data-desc') || '').toLowerCase();

              const matchesQuery =
                !query ||
                name.includes(query) ||
                target.includes(query) ||
                defaultVal.includes(query) ||
                desc.includes(query) ||
                groupCategory.toLowerCase().includes(query);

              if (matchesQuery) {
                row.style.display = '';
                visibleRowsInGroup++;
              } else {
                row.style.display = 'none';
              }
            });

            if (visibleRowsInGroup > 0) {
              group.style.display = '';
              containerVisible += visibleRowsInGroup;
            } else {
              group.style.display = 'none';
            }
          });

          // Show/hide entire catalog wrapper if empty
          const wrapper = container === variablesContainer ? variablesCatalog : partsCatalog;
          if (wrapper) {
            wrapper.style.display = containerVisible > 0 ? '' : 'none';
          }
          totalVisibleOverall += containerVisible;
        });

        if (totalVisibleOverall === 0) {
          if (emptyState) emptyState.style.display = 'flex';
          if (emptyQueryText) emptyQueryText.textContent = query ? `for "${query}"` : '';
        } else {
          if (emptyState) emptyState.style.display = 'none';
        }

        if (clearSearchBtn) {
          clearSearchBtn.style.display = query ? 'flex' : 'none';
        }
      }

      function handlePillClick(e: Event) {
        const target = (e.target as HTMLElement).closest('.rd-pill');
        if (!target) return;
        categoryPills?.querySelectorAll('.rd-pill').forEach((p) => p.classList.remove('active'));
        target.classList.add('active');
        activeCategory = target.getAttribute('data-category') || 'all';
        filterCatalog();
      }

      categoryPills?.addEventListener('click', handlePillClick);

      searchInput?.addEventListener('input', filterCatalog);
      clearSearchBtn?.addEventListener('click', () => {
        if (searchInput) {
          searchInput.value = '';
          searchInput.focus();
        }
        filterCatalog();
      });

      resetSearchBtn?.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        activeCategory = 'all';
        categoryPills?.querySelectorAll('.rd-pill').forEach((p) => {
          if (p.getAttribute('data-category') === 'all') {
            p.classList.add('active');
          } else {
            p.classList.remove('active');
          }
        });
        filterCatalog();
      });

      // Copy Pill Click Handler
      document.addEventListener('click', (e) => {
        const copyBtn = (e.target as HTMLElement).closest('.rd-copy-pill') as HTMLElement | null;
        if (!copyBtn) return;
        const textToCopy = copyBtn.getAttribute('data-copy');
        if (!textToCopy) return;

        navigator.clipboard.writeText(textToCopy).then(() => {
          const originalText = copyBtn.innerHTML;
          copyBtn.classList.add('copied');
          setTimeout(() => {
            copyBtn.classList.remove('copied');
          }, 1800);
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupStylingSearch);
    } else {
      setupStylingSearch();
    }
  </script>

  <SiteFooter />
</GlobalLayout>
