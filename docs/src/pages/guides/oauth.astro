---
import GlobalLayout from '../../layouts/GlobalLayout.astro';
import SiteNavbar from '../../components/SiteNavbar.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import OAuthFlowDiagram from '../../components/OAuthFlowDiagram.astro';

// Code Snippets for the Tutorial
const indexHtmlCode = `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>API Documentation</title>
    <!-- 1. Load RapiDoc Web Component from CDN -->
    <script type="module" src="https://unpkg.com/rapidoc/dist/rapidoc-min.js"></script>
  </head>
  <body>
    <!-- 2. Embed <rapi-doc> pointing to your OpenAPI spec -->
    <rapi-doc 
      spec-url="https://mrin9.github.io/RapiDoc/specs/oauth.yaml"
      render-style="focused"
      allow-try="true"
    > </rapi-doc>
  </body>
</html>`;

const customReceiverPathCode = `<!-- If oauth-receiver.html is hosted in a different path or subdirectory: -->
<rapi-doc 
  spec-url="/specs/api.yaml"
  oauth-receiver="/auth/oauth-receiver.html"
> </rapi-doc>`;

const receiverHtmlCode = `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>OAuth Receiver</title>
    <!-- Load the same RapiDoc script -->
    <script type="module" src="https://unpkg.com/rapidoc/dist/rapidoc-min.js"></script>
  </head>
  <body>
    <!-- The companion custom element that relays auth codes and closes the popup -->
    <oauth-receiver> </oauth-receiver>
  </body>
</html>`;

const openApiSpecCode = `openapi: 3.0.3
info:
  title: Protected API Service
  version: "1.0.0"
servers:
  - url: https://demo.duendesoftware.com

paths:
  /api/test:
    get:
      summary: Test Authenticated Endpoint
      security:
        - demo-oauth:
            - openid
            - email
            - profile
      responses:
        '200':
          description: Successful operation

components:
  securitySchemes:
    demo-oauth:
      type: oauth2
      description: Enterprise OAuth 2.0 Authorization Code flow
      flows:
        authorizationCode:
          authorizationUrl: https://demo.duendesoftware.com/connect/authorize
          tokenUrl: https://demo.identityserver.io/connect/token
          scopes:
            openid: OpenID Connect identity
            email: User email address
            profile: User profile information`;

const vendorExtensionsCode = `components:
  securitySchemes:
    # Scheme 1: Public Client (PKCE Enforced - Recommended for Documentation)
    public-oauth:
      type: oauth2
      description: Public client authorization flow with PKCE
      flows:
        authorizationCode:
          authorizationUrl: https://demo.duendesoftware.com/connect/authorize
          tokenUrl: https://demo.identityserver.io/connect/token
          scopes:
            openid: OpenID Connect identity
            profile: User profile information
            email: User email address

          # Pre-fill Client ID in the authorization dialog
          x-client-id: interactive.public

          # Pre-select default scopes in the checkbox list
          x-default-scopes:
            - openid
            - profile

          # Enforces PKCE: Hides client secret field entirely from the UI
          x-pkce-only: true

          # Custom query parameters sent to authorizationUrl (e.g. proxy launch parameters)
          x-authorize-params:
            launch: xyz123
            prompt: consent

          # Custom parameters sent in POST body to tokenUrl
          x-token-params:
            audience: https://api.example.com

    # Scheme 2: Sandbox / Confidential Client (With Pre-filled Test Secret)
    sandbox-oauth:
      type: oauth2
      description: Sandbox test scheme with credentials pre-populated
      
      # Scheme-level vendor extensions apply to all flows within this scheme
      x-client-id: interactive.confidential.short
      x-client-secret: secret
      x-default-scopes: openid email
      x-receive-token-in: request-body
      
      flows:
        authorizationCode:
          authorizationUrl: https://demo.duendesoftware.com/connect/authorize
          tokenUrl: https://demo.identityserver.io/connect/token
          scopes:
            openid: OpenID Connect
            email: Email address`;

const customParamsCode = `<!-- Option 1: Static / Semi-Static via HTML Attributes -->
<rapi-doc 
  spec-url="/specs/api.yaml"
  additional-authorize-params='{"launch": "xyz123", "prompt": "consent"}'
  additional-token-params='{"audience": "https://api.example.com"}'
></rapi-doc>

<!-- Option 2: Dynamic Programmatic Interception via Events -->
<script>
  const rapidocEl = document.querySelector('rapi-doc');

  // Intercept & inject dynamic query parameters before opening the authorization window
  rapidocEl.addEventListener('before-authorize', (e) => {
    const { securitySchemeId, flowType, authUrl, authParams } = e.detail;
    // authParams is a live URLSearchParams instance
    authParams.set('launch', sessionStorage.getItem('launch_context') || 'default-launch');
    authParams.set('tenant', window.currentTenantId);
    console.log('Opening authorization URL with customized params:', authParams.toString());
  });

  // Intercept & inject dynamic body parameters or headers before calling the token endpoint
  rapidocEl.addEventListener('before-token-request', (e) => {
    const { securitySchemeId, grantType, tokenUrl, params, headers } = e.detail;
    // params is a live URLSearchParams instance for the POST request body
    params.set('resource', 'https://api.mycompany.com');
    // headers is a live Headers instance
    headers.set('X-Device-Fingerprint', getDeviceFingerprint());
  });
</script>`;

const vendorExtensionsList = [
  {
    name: 'x-client-id',
    type: 'string',
    level: 'Scheme or Flow',
    description: 'Pre-populates the Client ID input in the authorization modal, saving developers from manually entering it.'
  },
  {
    name: 'x-client-secret',
    type: 'string',
    level: 'Scheme or Flow',
    description: 'Pre-populates the Client Secret input. Intended strictly for test/sandbox credentials, never for production secrets.'
  },
  {
    name: 'x-default-scopes',
    type: 'array | string',
    level: 'Scheme or Flow',
    description: 'Pre-selects specified scopes in the authorization dialog checkbox list (array of strings or space-separated list).'
  },
  {
    name: 'x-pkce-only',
    type: 'boolean',
    level: 'Flow',
    description: 'When true, enforces PKCE (RFC 7636) and hides the Client Secret field completely from the authorization UI.'
  },
  {
    name: 'x-receive-token-in',
    type: 'request-body | header',
    level: 'Scheme or Flow',
    description: 'Specifies whether client credentials should be passed in request body (client_secret_post) or Authorization header (client_secret_basic) when calling the tokenUrl. Default is request-body.'
  },
  {
    name: 'x-receive-token-in-options',
    type: 'array',
    level: 'Scheme or Flow',
    description: 'Limits the client authentication options available in the UI dropdown (e.g. ["request-body", "header"]).'
  },
  {
    name: 'x-authorize-params',
    type: 'object | string',
    level: 'Scheme or Flow',
    description: 'Custom query parameters appended to authorizationUrl (e.g. proxy launch parameters, audience, prompt).'
  },
  {
    name: 'x-token-params',
    type: 'object | string',
    level: 'Scheme or Flow',
    description: 'Custom parameters included in the POST request body to tokenUrl (e.g. custom IdP proxy fields, audience, resource).'
  }
];

const flowSteps = [
  {
    num: '1',
    title: 'User Clicks "Authorize"',
    desc: 'The developer clicks "Authorize" on an endpoint or the top security modal. <rapi-doc> opens a lightweight browser popup pointing to oauth-receiver.html.'
  },
  {
    num: '2',
    title: 'Redirect to Identity Provider',
    desc: '<oauth-receiver> immediately constructs the authorization URL with client_id, redirect_uri, requested scopes, state, and PKCE code challenge, then redirects the popup to your IdP.'
  },
  {
    num: '3',
    title: 'User Consent & Login',
    desc: 'The developer authenticates directly on the Identity Provider login page and grants consent to requested scopes.'
  },
  {
    num: '4',
    title: 'Callback to Receiver Popup',
    desc: 'Upon success, the IdP redirects the popup back to your registered redirect URI: oauth-receiver.html?code=AUTH_CODE&state=STATE.'
  },
  {
    num: '5',
    title: 'Local Relay & Popup Closure',
    desc: 'The <oauth-receiver> custom element extracts the code, securely transmits it to <rapi-doc> in the parent window via window.postMessage(), and automatically closes itself.'
  },
  {
    num: '6',
    title: 'Token Exchange & Automatic Header Injection',
    desc: '<rapi-doc> calls your IdP tokenUrl to exchange the authorization code for an Access Token, stores it in memory, and attaches Authorization: Bearer <token> to all interactive TRY calls.'
  }
];
---

<GlobalLayout 
  title="OAuth 2.0 & OpenID Connect Authentication Guide | RapiDoc"
  description="Step-by-step tutorial on configuring OAuth 2.0 Authorization Code Flow, PKCE, Implicit Flow, Client Credentials, and popup receivers in RapiDoc."
  keywords="OAuth 2.0 OpenAPI, RapiDoc authentication, OpenID Connect Swagger, oauth-receiver, PKCE API console"
>
  <!-- Ambient background glow elements -->
  <div class="ambient-glow glow-emerald"></div>
  <div class="ambient-glow glow-indigo"></div>
  <div class="ambient-glow glow-cyan"></div>
  <div class="ambient-glow glow-purple"></div>

  <!-- Reusable Frosted Glass Navigation -->
  <SiteNavbar activePage="guides" />

  <main class="rd-oauth-page">
    <!-- Hero Section -->
    <header class="rd-hero">
      <div class="rd-badge-pill">
        <span class="rd-badge-pulse"></span>
        <span class="rd-badge-text">Interactive Authentication Tutorial</span>
      </div>

      <h1 class="rd-hero-title">
        Setting up OAuth 2.0 <br/>
        <span class="text-gradient">in RapiDoc</span>
      </h1>

      <p class="rd-hero-subtitle">
        A clear, step-by-step tutorial to configure OAuth 2.0 and OpenID Connect in your API documentation. 
        Connect to any Identity Provider (Auth0, Okta, Azure AD, Keycloak, Duende), authenticate via secure popups, 
        and execute live API calls with zero backend relay code.
      </p>

      <!-- Hero Action Buttons -->
      <div class="rd-hero-actions">
        <a href="/examples/oauth-demo" target="_blank" class="rd-btn rd-btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          <span>Try Live Demo</span>
        </a>
        <a href="#tutorial-steps" class="rd-btn rd-btn-secondary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 5v14M19 12l-7 7-7-7"/>
          </svg>
          <span>Start Tutorial</span>
        </a>
        <a href="https://github.com/rapi-doc/RapiDoc/blob/master/docs/specs/oauth.yaml" target="_blank" rel="noopener" class="rd-btn rd-btn-ghost">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
          <span>View Sample Spec</span>
        </a>
      </div>

      <!-- Quick Metrics / Highlights Bar -->
      <div class="rd-kpi-grid">
        <div class="rd-kpi-card">
          <div class="rd-kpi-val">2 <span class="rd-kpi-unit">Files</span></div>
          <div class="rd-kpi-label">Zero-Config Setup</div>
          <div class="rd-kpi-desc">Just <code>index.html</code> and <code>oauth-receiver.html</code>. No custom JavaScript or backend proxy needed.</div>
        </div>

        <div class="rd-kpi-card">
          <div class="rd-kpi-val">PKCE <span class="rd-kpi-unit">RFC 7636</span></div>
          <div class="rd-kpi-label">Bulletproof Security</div>
          <div class="rd-kpi-desc">Native PKCE support removes the need to expose client secrets in browser documentation.</div>
        </div>

        <div class="rd-kpi-card">
          <div class="rd-kpi-val">100% <span class="rd-kpi-unit">Automatic</span></div>
          <div class="rd-kpi-label">Bearer Token Injection</div>
          <div class="rd-kpi-desc">Acquired tokens are stored in memory and automatically attached to interactive TRY calls.</div>
        </div>

        <div class="rd-kpi-card">
          <div class="rd-kpi-val">Any <span class="rd-kpi-unit">IdP</span></div>
          <div class="rd-kpi-label">Universal Compatibility</div>
          <div class="rd-kpi-desc">Works with Auth0, Okta, Azure AD / Entra ID, Keycloak, Duende IdentityServer, AWS Cognito, etc.</div>
        </div>
      </div>
    </header>

    <!-- Quick Summary (TL;DR) -->
    <section class="rd-section" id="quick-summary">
      <div class="rd-section-header">
        <div class="rd-section-badge">Fast Track</div>
        <h2 class="rd-section-title">The 30-Second Summary</h2>
        <p class="rd-section-desc">
          Setting up OAuth 2.0 in RapiDoc requires only 3 simple steps:
        </p>
      </div>

      <div class="rd-summary-cards">
        <div class="rd-summary-card">
          <div class="rd-summary-num">1</div>
          <div class="rd-summary-content">
            <h3 class="rd-summary-heading">Register Client with Identity Provider</h3>
            <p class="rd-summary-text">
              In your IdP console (Auth0, Okta, Azure AD, etc.), create a public client and register your redirect URI:
              <br/>
              <code class="mono-code">https://your-domain.com/oauth-receiver.html</code>
            </p>
          </div>
        </div>

        <div class="rd-summary-card">
          <div class="rd-summary-num">2</div>
          <div class="rd-summary-content">
            <h3 class="rd-summary-heading">Create index.html</h3>
            <p class="rd-summary-text">
              Add the <code class="mono-code">&lt;rapi-doc&gt;</code> element pointing to your OpenAPI spec. RapiDoc automatically manages the popup lifecycle.
            </p>
          </div>
        </div>

        <div class="rd-summary-card">
          <div class="rd-summary-num">3</div>
          <div class="rd-summary-content">
            <h3 class="rd-summary-heading">Create oauth-receiver.html</h3>
            <p class="rd-summary-text">
              Create a file named <code class="mono-code">oauth-receiver.html</code> containing <code class="mono-code">&lt;oauth-receiver&gt;</code> in the same folder.
            </p>
          </div>
        </div>
      </div>

      <div class="rd-callout-card success">
        <div class="rd-callout-icon">✨</div>
        <div class="rd-callout-body">
          <div class="rd-callout-title">You're All Set!</div>
          <div class="rd-callout-desc">
            Developers can click <strong>"Authorize"</strong> in your docs, sign in via a popup window, and immediately execute authenticated API calls!
          </div>
        </div>
      </div>
    </section>

    <!-- Architecture & Complete Flow -->
    <section class="rd-section" id="architecture-flow">
      <div class="rd-section-header">
        <div class="rd-section-badge">How It Works</div>
        <h2 class="rd-section-title">Architecture & Authorization Code Flow</h2>
        <p class="rd-section-desc">
          When a user initiates authentication, RapiDoc coordinates between the documentation window, a secure popup window, and your authorization server.
        </p>
      </div>

      <!-- High-Resolution Flow Diagram Component -->
      <OAuthFlowDiagram />

      <!-- Step-by-Step Flow Explanation -->
      <div class="rd-flow-timeline">
        {flowSteps.map(step => (
          <div class="rd-flow-item">
            <div class="rd-flow-badge">{step.num}</div>
            <div class="rd-flow-detail">
              <h4 class="rd-flow-heading">{step.title}</h4>
              <p class="rd-flow-desc">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Detailed Tutorial Steps -->
    <section class="rd-section" id="tutorial-steps">
      <div class="rd-section-header">
        <div class="rd-section-badge">Step-by-Step Tutorial</div>
        <h2 class="rd-section-title">Complete Implementation Guide</h2>
        <p class="rd-section-desc">
          Follow these detailed steps to set up OAuth 2.0 authentication from scratch.
        </p>
      </div>

      <!-- Step 1: Identity Provider Setup -->
      <div class="rd-step-card" id="step-1">
        <div class="rd-step-header">
          <span class="rd-step-pill">Step 1</span>
          <h3 class="rd-step-title">Register Your Application with your Identity Provider</h3>
        </div>
        <div class="rd-step-body">
          <p>
            Before configuring RapiDoc, register your documentation portal as a client application in your Identity Provider (IdP). 
            Examples include <strong>Auth0</strong>, <strong>Okta</strong>, <strong>Microsoft Entra ID (Azure AD)</strong>, <strong>Keycloak</strong>, or <strong>Duende IdentityServer</strong>.
          </p>
          
          <div class="rd-sub-box">
            <h4>Key Registration Requirements:</h4>
            <ul>
              <li>
                <strong>Application Type:</strong> Single Page Application (SPA) or Public Native Client.
              </li>
              <li>
                <strong>Allowed Grant Types:</strong> <code class="mono-code">Authorization Code</code> with <code class="mono-code">PKCE</code>.
              </li>
              <li>
                <strong>Redirect URI:</strong> The exact URL where your receiver page is served. For example:
                <br/>
                <code>http://localhost:8080/oauth-receiver.html</code> (for local testing)
                <br/>
                <code>https://api.yourcompany.com/docs/oauth-receiver.html</code> (for production)
              </li>
              <li>
                <strong>Allowed Origins / CORS:</strong> Ensure your documentation origin is permitted on the token and authorize endpoints.
              </li>
            </ul>
          </div>

          <div class="rd-callout-card info">
            <div class="rd-callout-icon">💡</div>
            <div class="rd-callout-body">
              <div class="rd-callout-title">Testing with our Pre-Configured Demo Server</div>
              <div class="rd-callout-desc">
                For this tutorial and instant testing, you can use Duende IdentityServer's public demo instance:
                <br/>
                <strong>Auth URL:</strong> <code class="mono-code">https://demo.duendesoftware.com/connect/authorize</code>
                <br/>
                <strong>Token URL:</strong> <code class="mono-code">https://demo.identityserver.io/connect/token</code>
                <br/>
                <strong>Public Client ID:</strong> <code class="mono-code">interactive.public</code> (PKCE enabled, no secret required)
                <br/>
                <strong>Confidential Client ID:</strong> <code class="mono-code">interactive.confidential.short</code> (Secret: <code class="mono-code">secret</code>)
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 2: index.html Setup -->
      <div class="rd-step-card" id="step-2">
        <div class="rd-step-header">
          <span class="rd-step-pill">Step 2</span>
          <h3 class="rd-step-title">Create your Main Documentation Page (index.html)</h3>
        </div>
        <div class="rd-step-body">
          <p>
            Create your primary documentation HTML file. Import RapiDoc from a CDN or local bundle and add the <code class="mono-code">&lt;rapi-doc&gt;</code> element pointing to your OpenAPI specification.
          </p>

          <CodeBlock code={indexHtmlCode} lang="html" filename="index.html" />

          <div class="rd-callout-card note">
            <div class="rd-callout-icon">📂</div>
            <div class="rd-callout-body">
              <div class="rd-callout-title">Custom Receiver Path (Optional)</div>
              <div class="rd-callout-desc">
                By default, RapiDoc looks for <code class="mono-code">oauth-receiver.html</code> in the current folder. 
                If your receiver file is in a custom subfolder, supply the <code class="mono-code">oauth-receiver</code> attribute:
                <div style="margin-top: 8px;">
                  <CodeBlock code={customReceiverPathCode} lang="html" filename="custom-path.html" />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 3: oauth-receiver.html Setup -->
      <div class="rd-step-card" id="step-3">
        <div class="rd-step-header">
          <span class="rd-step-pill">Step 3</span>
          <h3 class="rd-step-title">Create the OAuth Receiver Callback Page (oauth-receiver.html)</h3>
        </div>
        <div class="rd-step-body">
          <p>
            Create a second HTML file named <strong><code>oauth-receiver.html</code></strong> in the same directory. 
            This file contains RapiDoc's companion <code class="mono-code">&lt;oauth-receiver&gt;</code> element.
          </p>

          <CodeBlock code={receiverHtmlCode} lang="html" filename="oauth-receiver.html" />

          <div class="rd-sub-box">
            <h4>What does <code>&lt;oauth-receiver&gt;</code> do automatically?</h4>
            <ul>
              <li><strong>Zero Custom JavaScript:</strong> You do NOT need to write query string parsers, state verifiers, or window messaging code.</li>
              <li><strong>Extracts Auth Code:</strong> Reads the authorization code (<code class="mono-code">?code=...</code>) or implicit token (<code class="mono-code">#access_token=...</code>) from the URL.</li>
              <li><strong>Relays to Main Window:</strong> Sends the credentials to <code class="mono-code">&lt;rapi-doc&gt;</code> in the parent window via <code class="mono-code">window.postMessage()</code> (with an automatic fallback to <code class="mono-code">sessionStorage</code>).</li>
              <li><strong>Auto-Closes Popup:</strong> Closes the popup window immediately after successful transmission.</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Step 4: OpenAPI Spec Configuration -->
      <div class="rd-step-card" id="step-4">
        <div class="rd-step-header">
          <span class="rd-step-pill">Step 4</span>
          <h3 class="rd-step-title">Configure OAuth 2.0 in your OpenAPI Specification</h3>
        </div>
        <div class="rd-step-body">
          <p>
            In your OpenAPI 3.0 or 3.1 specification, declare your OAuth 2.0 security scheme under <code class="mono-code">components.securitySchemes</code>, 
            and protect relevant endpoints by referencing it under <code class="mono-code">security</code>:
          </p>

          <CodeBlock code={openApiSpecCode} lang="yaml" filename="openapi.yaml" />
        </div>
      </div>

      <!-- Step 5: Vendor Extensions -->
      <div class="rd-step-card" id="step-5">
        <div class="rd-step-header">
          <span class="rd-step-pill">Step 5</span>
          <h3 class="rd-step-title">Supercharge Developer UX with RapiDoc Vendor Extensions</h3>
        </div>
        <div class="rd-step-body">
          <p>
            To make authentication frictionless for developers testing your API, RapiDoc provides custom OpenAPI vendor extensions 
            (<code class="mono-code">x-*</code>) to pre-populate credentials and enforce modern security protocols like PKCE:
          </p>

          <!-- Vendor Extensions Table -->
          <div class="rd-table-wrapper">
            <table class="rd-table">
              <thead>
                <tr>
                  <th>Extension</th>
                  <th>Type</th>
                  <th>Applicable Level</th>
                  <th>Purpose</th>
                </tr>
              </thead>
              <tbody>
                {vendorExtensionsList.map(ext => (
                  <tr>
                    <td><code class="mono-code highlight">{ext.name}</code></td>
                    <td><span class="rd-type-tag">{ext.type}</span></td>
                    <td><span class="rd-level-tag">{ext.level}</span></td>
                    <td>{ext.description}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div style="margin-top: 1.5rem;">
            <h4>Specification Example with Vendor Extensions:</h4>
            <CodeBlock code={vendorExtensionsCode} lang="yaml" filename="openapi-with-extensions.yaml" />
          </div>

          <div style="margin-top: 2rem;">
            <h4>Customizing Parameters via Attributes & Dynamic Events:</h4>
            <p>
              When working with Identity Provider proxies (such as Keycloak proxies requiring a <code class="mono-code">launch</code> context token), multi-tenant auth gateways, or token endpoints requiring custom parameters (<code class="mono-code">audience</code>, <code class="mono-code">resource</code>), you can customize parameters statically using attributes or dynamically via DOM lifecycle events:
            </p>
            <CodeBlock code={customParamsCode} lang="html" filename="custom-oauth-params.html" />
          </div>
        </div>
      </div>

      <!-- Step 6: Testing & Verification -->
      <div class="rd-step-card" id="step-6">
        <div class="rd-step-header">
          <span class="rd-step-pill">Step 6</span>
          <h3 class="rd-step-title">Test Authenticated Requests in the Interactive Console</h3>
        </div>
