                    --bg: #ffffff;
                    --nav-bg: #f4f4f5;
                    --header-bg: #f4f4f5;
                    --card-bg: #ffffff;
                    --border: #e4e4e7;
                    --primary: #d97706;
                    --primary-border: #b45309;

                    /* Typography: Heading is dark, Secondary/Body text is one shade lighter */
                    --text-heading: #09090b;
                    --text-body: #71717a;
                    --text-muted: #a1a1aa;
                    --tag-fill: #71717a;
                    --search-fill: #ffffff;
                    --search-stroke: #e4e4e7;
