    function setupInstantThemingDemo() {
      const svg = document.getElementById('instant-demo-svg');
      const codePre = document.getElementById('demo-code-pre');
      const copyBtn = document.getElementById('demo-copy-code-btn');
      const copyText = document.getElementById('demo-copy-text');
      if (!svg || !codePre) return;

      const renderBtns = document.querySelectorAll('#demo-render-control .rd-seg-btn');
      const toggleHeader = document.getElementById('demo-toggle-header') as HTMLInputElement | null;
      const toggleNavLogo = document.getElementById('demo-toggle-nav-logo') as HTMLInputElement | null;
      const toggleNavMethods = document.getElementById('demo-toggle-nav-methods') as HTMLInputElement | null;
      const logoItem = document.getElementById('demo-toggle-logo-item');
      const methodsItem = document.getElementById('demo-toggle-methods-item');
      const presetBtns = document.querySelectorAll('#demo-preset-control .rd-seg-btn');
      const schemeBtns = document.querySelectorAll('#demo-scheme-control .rd-seg-btn');

      let currentRender = 'focused';
      let currentPreset = 'amber';
      let currentScheme = 'dark';
      let currentShowHeader = true;
      let currentShowNavLogo = true;
      let currentShowNavMethods = true;

      const palettes = {
        amber: {
          dark: {
            bg: '#22242b',
            navBg: '#1a1c23',
            headerBg: '#14161c',
            cardBg: '#2a2d36',
            border: '#363636',
            primary: '#f59e0b',
            textHeading: '#ffffff',
            textBody: '#94a3b8'
          },
          light: {
            bg: '#ffffff',
            navBg: '#f4f4f5',
            headerBg: '#f4f4f5',
            cardBg: '#ffffff',
            border: '#e4e4e7',
            primary: '#d97706',
            textHeading: '#09090b',
            textBody: '#71717a'
          }
        },
        emerald: {
          dark: {
            bg: '#060913',
            navBg: '#03060c',
            headerBg: '#020408',
            cardBg: '#0f172a',
            border: '#1e293b',
            primary: '#10b981',
            textHeading: '#f8fafc',
            textBody: '#94a3b8'
          },
          light: {
            bg: '#ffffff',
            navBg: '#f4f4f5',
            headerBg: '#f4f4f5',
            cardBg: '#ffffff',
            border: '#e4e4e7',
            primary: '#059669',
            textHeading: '#09090b',
            textBody: '#71717a'
          }
        }
      };

      function updateSvgAndCode() {
        // 1. Update SVG styles
        const p = palettes[currentPreset as 'amber' | 'emerald'][currentScheme as 'dark' | 'light'];
        svg.style.setProperty('--bg', p.bg);
        svg.style.setProperty('--nav-bg', p.navBg);
        svg.style.setProperty('--header-bg', p.headerBg);
        svg.style.setProperty('--card-bg', p.cardBg);
        svg.style.setProperty('--border', p.border);
        svg.style.setProperty('--primary', p.primary);
        svg.style.setProperty('--primary-border', p.primary);
        svg.style.setProperty('--text-heading', p.textHeading);
        svg.style.setProperty('--text-body', p.textBody);

        // Render style class
        if (currentRender === 'view') {
          svg.classList.add('render-view');
          if (logoItem) logoItem.style.opacity = '0.4';
          if (methodsItem) methodsItem.style.opacity = '0.4';
        } else {
          svg.classList.remove('render-view');
          if (logoItem) logoItem.style.opacity = '1';
          if (methodsItem) methodsItem.style.opacity = '1';
        }

        // Visibility classes
        if (currentShowHeader) {
          svg.classList.remove('hide-header');
        } else {
          svg.classList.add('hide-header');
        }

        if (currentShowNavLogo) {
          svg.classList.remove('hide-nav-logo');
        } else {
          svg.classList.add('hide-nav-logo');
        }

        if (currentShowNavMethods) {
          svg.classList.remove('hide-nav-methods');
        } else {
          svg.classList.add('hide-nav-methods');
        }

        // Preset & Scheme classes
        if (currentPreset === 'emerald') {
          svg.classList.add('preset-emerald');
        } else {
          svg.classList.remove('preset-emerald');
        }

        if (currentScheme === 'light') {
          svg.classList.add('theme-light');
        } else {
          svg.classList.remove('theme-light');
        }

        // 2. Generate and update code snippet
        const rawLines: string[] = [
          '<rapi-doc',
          '  spec-url="https://petstore.swagger.io/v2/swagger.json"',
          `  theme="${currentPreset}"`,
          `  color-scheme="${currentScheme}"`,
          `  render-style="${currentRender}"`
        ];

        if (!currentShowHeader) {
          rawLines.push('  show-header="false"');
        } else {
          rawLines.push('  show-header="true"');
        }

        if (!currentShowNavMethods) {
          rawLines.push('  show-method-in-nav-bar="false"');
        } else {
          rawLines.push('  show-method-in-nav-bar="true"');
        }

        if (currentShowNavLogo && currentRender !== 'view') {
          rawLines.push('>');
          rawLines.push('  <img slot="nav-logo" src="logo.png" width="36" />');
          rawLines.push('</rapi-doc>');
        } else {
          rawLines.push('>');
          rawLines.push('</rapi-doc>');
        }

        const rawCode = rawLines.join('\n');
        copyBtn?.setAttribute('data-code', rawCode);

        // Safe syntax highlighting with Prism or structured tokenizer
        const prism = (window as any).Prism;
        if (prism && prism.highlight && prism.languages && (prism.languages.markup || prism.languages.html)) {
          const grammar = prism.languages.markup || prism.languages.html;
          codePre.innerHTML = prism.highlight(rawCode, grammar, 'markup');
        } else {
          const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
          const lines = rawLines.map((line) => {
            const trimmed = line.trim();
            if (trimmed.startsWith('<rapi-doc') || trimmed.startsWith('</rapi-doc>') || trimmed.startsWith('<img') || trimmed === '>') {
              return esc(line)
                .replace(/(&lt;\/?)(rapi-doc|img)/g, '<span class="tok-punct">$1</span><span class="tok-tag">$2</span>')
                .replace(/(\/?&gt;)/g, '<span class="tok-punct">$1</span>');
            } else if (trimmed.includes('=')) {
              const match = line.match(/^(\s*)([a-zA-Z0-9-]+)=(".*?"|'.*?')$/);
              if (match) {
                const [, indent, attr, val] = match;
                return `${indent}<span class="tok-attr">${esc(attr)}</span><span class="tok-punct">=</span><span class="tok-val">${esc(val)}</span>`;
              }
              return esc(line);
            }
            return esc(line);
          });
          codePre.innerHTML = lines.join('\n');
        }
      }

      // Event handlers
      renderBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const r = btn.getAttribute('data-render') || 'focused';
          renderBtns.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          currentRender = r;
          updateSvgAndCode();
        });
      });

      if (toggleHeader) {
        toggleHeader.addEventListener('change', () => {
          currentShowHeader = toggleHeader.checked;
          updateSvgAndCode();
        });
      }

      if (toggleNavLogo) {
        toggleNavLogo.addEventListener('change', () => {
          currentShowNavLogo = toggleNavLogo.checked;
          updateSvgAndCode();
        });
      }

      if (toggleNavMethods) {
        toggleNavMethods.addEventListener('change', () => {
          currentShowNavMethods = toggleNavMethods.checked;
          updateSvgAndCode();
        });
      }

      presetBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const p = btn.getAttribute('data-preset') || 'amber';
          presetBtns.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          currentPreset = p;
          updateSvgAndCode();
        });
      });

      schemeBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const s = btn.getAttribute('data-scheme') || 'dark';
          schemeBtns.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          currentScheme = s;
          updateSvgAndCode();
        });
      });

      if (copyBtn) {
        copyBtn.addEventListener('click', async () => {
          const code = copyBtn.getAttribute('data-code') || '';
          try {
            await navigator.clipboard.writeText(code);
            if (copyText) copyText.textContent = 'Copied!';
            copyBtn.classList.add('copied');
            setTimeout(() => {
              if (copyText) copyText.textContent = 'Copy';
              copyBtn.classList.remove('copied');
            }, 2000);
          } catch (err) {
            console.error('Failed to copy', err);
          }
        });
      }

      // Initial render
      updateSvgAndCode();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupInstantThemingDemo);
    } else {
      setupInstantThemingDemo();
    }
    document.addEventListener('astro:page-load', setupInstantThemingDemo);
