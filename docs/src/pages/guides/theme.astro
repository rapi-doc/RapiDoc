---
import GlobalLayout from '../../layouts/GlobalLayout.astro';
import SiteNavbar from '../../components/SiteNavbar.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import '../../styles/styling.css';

const coreThemingAttributes = [
  {
    name: 'theme',
    type: 'preset | #hex',
    default: 'amber',
    allowed: 'amber, blue, graphite, modern, emerald, violet, rose, slate, default, or #hex',
    desc: 'Sets the primary brand color palette. Accepts any built-in shadcn/ui-inspired preset or a custom brand color hex code (e.g. #2563eb).',
  },
  {
    name: 'color-scheme',
    type: 'string',
    default: 'dark',
    allowed: 'dark | light | system',
    desc: 'Controls dark or light surface mode. When set to "system", RapiDoc automatically switches based on the user OS prefers-color-scheme setting.',
  },
  {
    name: 'radius',
    type: 'string',
    default: 'sm',
    allowed: 'none | sm | md | lg | full',
    desc: 'Corner radius scale applied to cards, buttons, badges, parameter inputs, and dialogs (--radius and --card-radius).',
  },
  {
    name: 'scale',
    type: 'string',
    default: 'default',
    allowed: 'sm | default | lg',
    desc: 'Proportionally scales UI base dimensions, body fonts, monospace code blocks, and sidebar width across the documentation.',
  },
  {
    name: 'nav-item-spacing',
    type: 'string',
    default: 'default',
    allowed: 'compact | default | relaxed',
    desc: 'Controls vertical density and padding of sidebar navigation links independently of typography scale.',
  },
  {
    name: 'load-fonts',
    type: 'boolean',
    default: 'true',
    allowed: 'true | false',
    desc: 'Automatically loads default Open Sans from Google Fonts CDN. Set to "false" in air-gapped, offline, or enterprise intranet environments.',
  },
  {
    name: 'render-style',
    type: 'string',
    default: 'focused',
    allowed: 'focused | read | view',
    desc: 'Document presentation layout mode: single-operation focused console, continuous reading doc, or multi-column interactive view.',
  },
  {
    name: 'schema-style',
    type: 'string',
    default: 'tree',
    allowed: 'tree | table',
    desc: 'Visual formatting of request and response payload schemas (interactive collapsible tree or structured property table).',
  },
];

const themePresets = [
  {
    id: 'amber',
    name: 'Amber',
    color: '#f59e0b',
    surface: '#09090b (dark) / #ffffff (light)',
    badge: 'DEFAULT',
    desc: 'Warm amber accents over dark charcoal surfaces. High visibility and modern developer aesthetic.',
  },
  {
    id: 'blue',
    name: 'Blue',
    color: '#3b82f6',
    surface: '#262626 (dark) / #ffffff (light)',
    badge: '',
    desc: 'Classic vivid blue brand accent with balanced neutral dark backgrounds. Highly readable for technical portals.',
  },
  {
    id: 'emerald',
    name: 'Emerald',
    color: '#10b981',
    surface: '#060913 (dark) / #ffffff (light)',
    badge: '',
    desc: 'Vibrant emerald green accents over deep navy slate surfaces. Ideal for payments, banking, and crypto APIs.',
  },
  {
    id: 'violet',
    name: 'Violet',
    color: '#8b5cf6',
    surface: '#130e20 (dark) / #ffffff (light)',
    badge: '',
    desc: 'Electric purple highlights paired with subtle deep violet surface tints for modern SaaS and developer ecosystems.',
  },
  {
    id: 'graphite',
    name: 'Graphite',
    color: '#fafafa',
    surface: '#09090b (dark) / #ffffff (light)',
    badge: 'Monochrome',
    desc: 'Ultra-clean monochrome palette inspired by high-contrast developer tools and modern terminal UI designs.',
  },
  {
    id: 'rose',
    name: 'Rose',
    color: '#f7667e',
    surface: '#2a2b2c (dark) / #ffffff (light)',
    badge: '',
    desc: 'Vibrant rose pink highlights over neutral slate surfaces. High contrast and contemporary visual polish.',
  },
  {
    id: 'slate',
    name: 'Slate',
    color: '#64748b',
    surface: '#09090b (dark) / #ffffff (light)',
    badge: '',
    desc: 'Sophisticated cool grey slate accents for understated enterprise corporate documentation portals.',
  },
];

const quickstartSnippet = `<rapi-doc
  spec-url="https://petstore.swagger.io/v2/swagger.json"
  theme="emerald"
  color-scheme="dark"
  radius="md"
  scale="default"
  nav-item-spacing="default"
  render-style="focused"
></rapi-doc>`;

const customHexSnippet = `<!-- Use your corporate brand hex color directly -->
<rapi-doc
  spec-url="https://api.acme.corp/openapi.json"
  theme="#2563eb"
  color-scheme="dark"
  radius="lg"
  scale="default"
></rapi-doc>

<!--
  RapiDoc automatically analyzes #2563eb luminance:
  - Generates --primary: #2563eb
  - Generates --ring: #2563eb
  - Generates high-contrast --primary-foreground: #ffffff
-->`;

const typographySnippet = `<!-- Load custom Google Fonts in document head -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

<style>
  /* Override typography tokens directly on <rapi-doc> */
  rapi-doc {
    --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    --font-mono: 'JetBrains Mono', 'Fira Code', monospace;
  }
</style>

<rapi-doc
  spec-url="https://petstore.swagger.io/v2/swagger.json"
  theme="violet"
  color-scheme="dark"
  radius="md"
  load-fonts="false"
></rapi-doc>`;

const dynamicJsSnippet = `// Select the RapiDoc custom element in the DOM
const doc = document.querySelector('rapi-doc');

// Switch theme preset or brand color
function setBrandTheme(presetOrHex) {
  doc.setAttribute('theme', presetOrHex); // e.g. 'emerald', 'violet', or '#ff5722'
}

// Toggle between dark and light modes
function toggleColorScheme() {
  const current = doc.getAttribute('color-scheme') || 'dark';
  doc.setAttribute('color-scheme', current === 'dark' ? 'light' : 'dark');
}

// Adjust corner roundness dynamically
function setRadius(size) {
  doc.setAttribute('radius', size); // 'none', 'sm', 'md', 'lg', 'full'
}

// Switch UI scaling dynamically
function setScale(size) {
  doc.setAttribute('scale', size); // 'sm', 'default', 'lg'
}`;
---

<GlobalLayout
  title="Overhauled Theming & Brand Identity Guide | RapiDoc"
  description="Explore RapiDoc's overhauled theming architecture: 9 shadcn/ui-inspired presets, custom brand hex colors with automatic contrast calculation, dark/light modes, and typography tokens."
  keywords="RapiDoc themes, OpenAPI styling, Swagger dark mode, API documentation fonts, custom brand hex colors, shadcn color tokens"
>
  <div class="ambient-glow glow-emerald"></div>
  <div class="ambient-glow glow-indigo"></div>
  <div class="ambient-glow glow-cyan"></div>

  <SiteNavbar activePage="guides" />

  <main class="rd-styling-main">
    <header class="rd-styling-hero">
      <div class="rd-badge-pill">
        <span class="rd-badge-pulse"></span>
        <span class="rd-badge-text">Overhauled Theming Architecture</span>
      </div>

      <h1 class="rd-page-title">
        Themes, Brand Colors & <span class="text-gradient">Typography</span>
      </h1>

      <p class="rd-page-subtitle">
        RapiDoc features a streamlined, token-driven styling architecture inspired by modern design systems. Configure rich color presets,
        custom brand hex colors, contrast modes, typography, and corner radius using clean declarative attributes.
      </p>

      <div class="rd-stats-bar">
        <div class="rd-stat-card">
          <span class="rd-stat-value">9</span>
          <span class="rd-stat-label">Built-in Presets</span>
        </div>
        <div class="rd-stat-card">
          <span class="rd-stat-value">#HEX</span>
          <span class="rd-stat-label">Any Brand Color</span>
        </div>
        <div class="rd-stat-card">
          <span class="rd-stat-value">3</span>
          <span class="rd-stat-label">Color Modes (Dark / Light / System)</span>
        </div>
        <div class="rd-stat-card">
          <span class="rd-stat-value">5</span>
          <span class="rd-stat-label">Radius Scales</span>
        </div>
      </div>
    </header>

    <!-- Section 1: The New Declarative Interface -->
    <section class="rd-section-block" id="attributes">
      <div class="rd-section-header">
        <div class="rd-section-badge">Streamlined Interface</div>
        <h2 class="rd-section-title">The Four Primary Styling Attributes</h2>
        <p class="rd-section-desc">
          Instead of dozens of disparate color properties, RapiDoc consolidates visual styling into four high-leverage attributes:
          <code class="mono-code">theme</code>, <code class="mono-code">color-scheme</code>, <code class="mono-code">radius</code>, and <code
            class="mono-code">scale</code
          >.
        </p>
      </div>

      <div class="rd-recipe-card rd-mb-40">
        <div class="rd-recipe-top">
          <div class="rd-recipe-header-text">
            <div class="rd-recipe-tag">Quickstart Blueprint</div>
            <h3 class="rd-recipe-heading">Instant Declarative Theming</h3>
            <p class="rd-recipe-text">
              Configure complete visual styling directly in your HTML tag with zero CSS boilerplate or build steps required.
            </p>
          </div>
          <div class="rd-recipe-action">
            <a href="/examples/themes" target="_blank" class="rd-btn rd-btn-primary">
              <span>View Live Theme Switcher Demo</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M5 12h14m-7-7 7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </div>
        <div class="rd-recipe-split">
          <div class="rd-neon-frame">
            <img src="/assets/images/theme/rapidoc-theme-emerald.png" alt="RapiDoc Emerald Dark Theme Live Preview" />
            <div class="rd-preview-callouts">
              <div class="rd-callout-pill pill-emerald" data-highlight="theme">
                <span class="rd-callout-dot"></span>
                <span class="rd-callout-code">theme="emerald"</span>
                <span class="rd-callout-label">#10b981</span>
              </div>
              <div class="rd-callout-pill pill-dark" data-highlight="color-scheme">
                <span class="rd-callout-dot"></span>
                <span class="rd-callout-code">color-scheme="dark"</span>
                <span class="rd-callout-label">#060913</span>
              </div>
              <div class="rd-callout-pill pill-focused" data-highlight="render-style">
                <span class="rd-callout-dot"></span>
                <span class="rd-callout-code">render-style="focused"</span>
                <span class="rd-callout-label">Console</span>
              </div>
              <div class="rd-callout-pill pill-radius" data-highlight="radius">
                <span class="rd-callout-dot"></span>
                <span class="rd-callout-code">radius="md"</span>
                <span class="rd-callout-label">6px</span>
              </div>
            </div>
          </div>
          <div class="rd-recipe-code">
            <CodeBlock code={quickstartSnippet} lang="html" filename="index.html" />
          </div>
        </div>

        <!-- Interactive Attribute Highlights Breakdown -->
        <div class="rd-recipe-highlights">
          <div class="rd-highlight-item" data-target="theme">
            <div class="rd-highlight-head">
              <code class="mono-code">theme="emerald"</code>
              <span class="rd-highlight-tag tag-emerald">Brand Color</span>
            </div>
            <p class="rd-highlight-desc">
              Applies vibrant emerald green (<code class="text-emerald">#10b981</code>) to action buttons (Search, Try), active
              navigation links, and focus rings.
            </p>
          </div>

          <div class="rd-highlight-item" data-target="color-scheme">
            <div class="rd-highlight-head">
              <code class="mono-code">color-scheme="dark"</code>
              <span class="rd-highlight-tag tag-surface">Surface</span>
            </div>
            <p class="rd-highlight-desc">
              Renders deep navy slate background surfaces (<code class="text-surface">#060913</code>) with high-contrast text and crisp
              card borders.
            </p>
          </div>

          <div class="rd-highlight-item" data-target="radius">
            <div class="rd-highlight-head">
              <code class="mono-code">radius="md"</code>
              <span class="rd-highlight-tag tag-geometry">Geometry</span>
            </div>
            <p class="rd-highlight-desc">
              Smooths cards, inputs, and button corners to <code class="text-cyan">6px</code> (0.375rem) balanced roundness.
            </p>
          </div>

          <div class="rd-highlight-item" data-target="render-style">
            <div class="rd-highlight-head">
              <code class="mono-code">render-style="focused"</code>
              <span class="rd-highlight-tag tag-layout">Layout</span>
            </div>
            <p class="rd-highlight-desc">
              Structures docs as an interactive two-pane layout: searchable navigation on the left with a dedicated single-operation test
              console.
            </p>
          </div>
        </div>
      </div>

      <!-- Core Styling Attributes Reference Table -->
      <div class="rd-table-wrapper">
        <table class="rd-catalog-table">
          <thead>
            <tr>
              <th class="col-attr-name">Attribute</th>
              <th class="col-attr-type">Type / Allowed</th>
              <th class="col-attr-default">Default</th>
              <th class="col-attr-desc">Description & Behavior</th>
            </tr>
          </thead>
          <tbody>
            {
              coreThemingAttributes.map((attr) => (
                <tr class="rd-catalog-row">
                  <td class="col-attr-name">
                    <div class="rd-item-pill">
                      <span class="rd-pill-name">{attr.name}</span>
                    </div>
                  </td>
                  <td class="col-attr-type">
                    <span class="rd-type-tag">{attr.type}</span>
                    <div class="rd-allowed-text">{attr.allowed}</div>
                  </td>
                  <td class="col-attr-default">
                    <code class="rd-default-badge">{attr.default}</code>
                  </td>
                  <td class="col-attr-desc">{attr.desc}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <!-- Section 2: Built-in Presets & Brand Hex Colors -->
    <section class="rd-section-block" id="presets">
      <div class="rd-section-header">
        <div class="rd-section-badge">Color Palettes</div>
        <h2 class="rd-section-title">Built-in Presets & Custom Hex Brand Colors</h2>
        <p class="rd-section-desc">
          Choose from curated presets matched to modern design systems, or pass any corporate brand hex color directly into <code
            class="mono-code">theme</code
          >.
        </p>
      </div>

      <div class="rd-presets-grid">
        {
          themePresets.map((preset) => (
            <div class="rd-preset-card">
              <div class="rd-preset-card-header">
                <div class="rd-preset-title-group">
                  <span
                    class="rd-preset-dot"
                    style={`background: ${preset.color}; box-shadow: 0 0 10px ${preset.color}88;`}
                  />
                  <span class="rd-preset-name">{preset.name}</span>
                </div>
                <span class="rd-preset-badge">{preset.badge}</span>
              </div>
              <p class="rd-preset-desc">{preset.desc}</p>
              <div class="rd-preset-footer">
                <code class="rd-preset-code">
                  theme="{preset.id}"
                </code>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Custom Brand Color Callout -->
      <div class="rd-recipe-card">
        <div class="rd-recipe-top">
          <div class="rd-recipe-header-text">
            <div class="rd-recipe-tag">Custom Brand Color</div>
            <h3 class="rd-recipe-heading">Hex Color Dynamic Contrast Engine</h3>
            <p class="rd-recipe-text">
              Pass your corporate brand color (such as <code class="mono-code">#2563eb</code> or <code class="mono-code">#ff5722</code>)
              directly to <code class="mono-code">theme</code>. RapiDoc automatically calculates perceived YIQ luminance, assigns the focus
              ring and primary token, and guarantees accessible contrast on button text by dynamically selecting pure black or crisp white.
            </p>
          </div>
        </div>
        <div class="rd-recipe-code">
          <CodeBlock code={customHexSnippet} lang="html" filename="custom-brand.html" />
        </div>
      </div>
    </section>

    <!-- Section 3: Radius & Scale Geometry -->
    <section class="rd-section-block" id="geometry">
      <div class="rd-section-header">
        <div class="rd-section-badge">Layout & Geometry</div>
        <h2 class="rd-section-title">Corner Radius & Sizing Scale</h2>
        <p class="rd-section-desc">Calibrate corner roundness and base density to match your product's UI design language.</p>
      </div>

      <div class="rd-geometry-grid">
        <!-- Radius Card -->
        <div class="rd-geometry-card">
          <h3 class="rd-geometry-title">
            <span>Corner Radius (<code class="text-cyan">radius</code>)</span>
          </h3>
          <p class="rd-geometry-desc">
            Controls roundness across cards, buttons, badges, parameter inputs, and dialogs:
          </p>
          <ul class="rd-geometry-list">
            <li class="rd-geometry-item">
              <code class="text-cyan">radius="none"</code>
              <span class="rd-geometry-text">0px sharp geometric corners</span>
            </li>
            <li class="rd-geometry-item">
              <code class="text-cyan">radius="sm"</code>
              <span class="rd-geometry-text">4px (0.25rem) — Default sleek modern</span>
            </li>
            <li class="rd-geometry-item">
              <code class="text-cyan">radius="md"</code>
              <span class="rd-geometry-text">6px (0.375rem) balanced roundness</span>
            </li>
            <li class="rd-geometry-item">
              <code class="text-cyan">radius="lg"</code>
              <span class="rd-geometry-text">8px (0.5rem) pronounced roundness</span>
            </li>
            <li class="rd-geometry-item">
              <code class="text-cyan">radius="full"</code>
              <span class="rd-geometry-text">Pill buttons/inputs (9999px), 8px cards</span>
            </li>
          </ul>
        </div>

        <!-- Scale Card -->
        <div class="rd-geometry-card">
          <h3 class="rd-geometry-title">
            <span>UI Scale (<code class="text-cyan">scale</code>)</span>
          </h3>
          <p class="rd-geometry-desc">
            Harmoniously scales base sizing, font dimensions, and sidebar width:
          </p>
          <ul class="rd-geometry-list">
            <li class="rd-scale-item">
              <div class="rd-scale-item-head">
                <code class="text-cyan">scale="sm"</code>
                <span class="rd-geometry-text">Compact (13px base, 17rem nav)</span>
              </div>
              <span class="rd-scale-item-sub">Ideal for embedded widgets and compact consoles</span>
            </li>
            <li class="rd-scale-item">
              <div class="rd-scale-item-head">
                <code class="text-cyan">scale="default"</code>
                <span class="rd-geometry-text">Standard (14px base, 18.75rem nav)</span>
              </div>
              <span class="rd-scale-item-sub">Standard desktop layout for public developer hubs</span>
            </li>
            <li class="rd-scale-item">
              <div class="rd-scale-item-head">
                <code class="text-cyan">scale="lg"</code>
                <span class="rd-geometry-text">Generous (16px base, 21rem nav)</span>
              </div>
              <span class="rd-scale-item-sub">Enhanced readability, high-DPI displays, and presentations</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Section 4: Typography & Google Fonts -->
    <section class="rd-section-block" id="typography">
      <div class="rd-section-header">
        <div class="rd-section-badge">Typography Tokens</div>
        <h2 class="rd-section-title">Custom Typography & Google Fonts Pairing</h2>
        <p class="rd-section-desc">
          RapiDoc natively supports shadcn/ui design tokens. Set <code class="mono-code">--font-sans</code> (or <code class="mono-code"
            >--font-regular</code
          >) and <code class="mono-code">--font-mono</code> on <code class="mono-code">&lt;rapi-doc&gt;</code> to seamlessly apply any custom
          font family.
        </p>
      </div>

      <div class="rd-recipe-card">
        <div class="rd-recipe-top">
          <div class="rd-recipe-header-text">
            <div class="rd-recipe-tag">Typography Recipe</div>
            <h3 class="rd-recipe-heading">Pairing Inter & JetBrains Mono</h3>
            <p class="rd-recipe-text">
              Load your Google Fonts stylesheet in the document head and bind the tokens directly in CSS. Set <code class="mono-code"
                >load-fonts="false"</code
              > to prevent RapiDoc from fetching the default Open Sans font.
            </p>
          </div>
        </div>
        <div class="rd-recipe-code">
          <CodeBlock code={typographySnippet} lang="html" filename="typography.html" />
        </div>
      </div>
    </section>

    <!-- Section 5: Dynamic Runtime Switching -->
    <section class="rd-section-block" id="runtime">
      <div class="rd-section-header">
        <div class="rd-section-badge">Programmatic Control</div>
        <h2 class="rd-section-title">Dynamic Runtime Theming via JavaScript</h2>
        <p class="rd-section-desc">
          Because RapiDoc is a standard custom HTML element, its styling attributes reflect instantly when modified through vanilla DOM
          methods.
        </p>
      </div>

      <div class="rd-recipe-card">
        <div class="rd-recipe-code">
          <CodeBlock code={dynamicJsSnippet} lang="javascript" filename="theme-controller.js" />
        </div>
      </div>
    </section>

    <!-- Next Steps Banner -->
    <section class="rd-section-block rd-next-banner">
      <h3 class="rd-next-title">Need Granular CSS Customization?</h3>
      <p class="rd-next-desc">
        For custom frosted glass navigation, gradient badges, Shadow DOM piercing, and complete parts catalogs, explore our Custom CSS &
        Shadow Parts Guide.
      </p>
      <a href="/guides/css" class="rd-action-primary rd-next-link">
        <span>Explore Custom CSS & Shadow Parts Guide</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
          ><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg
        >
      </a>
    </section>
  </main>

  <SiteFooter />

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const items = document.querySelectorAll('.rd-highlight-item');
      items.forEach((item) => {
        const target = item.getAttribute('data-target');
        const pill = document.querySelector(`.rd-callout-pill[data-highlight="${target}"]`);

        item.addEventListener('mouseenter', () => {
          if (pill) pill.classList.add('active');
        });
        item.addEventListener('mouseleave', () => {
          if (pill) pill.classList.remove('active');
        });

        if (pill) {
          pill.addEventListener('mouseenter', () => {
            item.classList.add('active');
          });
          pill.addEventListener('mouseleave', () => {
            item.classList.remove('active');
          });
        }
      });
    });
  </script>
  <style>
    /* Section 1: Callout Pills */
    .pill-emerald {
      top: 14px;
      left: 16px;
    }
    .pill-dark {
      top: 14px;
      right: 16px;
    }
    .pill-focused {
      bottom: 16px;
      left: 16px;
    }
    .pill-radius {
      bottom: 16px;
      right: 16px;
    }

    /* Section 1: Highlight Tags & Accents */
    .tag-emerald {
      color: #34d399;
      background: rgba(16, 185, 129, 0.12);
    }
    .tag-surface {
      color: #cbd5e1;
      background: rgba(255, 255, 255, 0.08);
    }
    .tag-geometry {
      color: #38bdf8;
      background: rgba(56, 189, 248, 0.12);
    }
    .tag-layout {
      color: #c084fc;
      background: rgba(168, 85, 247, 0.12);
    }

    .text-emerald {
      color: #34d399;
    }
    .text-surface {
      color: #cbd5e1;
    }
    .text-cyan {
      color: #38bdf8;
    }

    /* Section 2: Presets Grid & Cards */
    .rd-presets-grid {
