                    --nav-bg: #f4f4f5;
                    --header-bg: #f4f4f5;
                    --card-bg: #ffffff;
                    --border: #e4e4e7;
                    --primary: #059669;
                    --primary-border: #047857;

                    /* Typography: Heading is dark, Secondary/Body text is one shade lighter */
                    --text-heading: #09090b;
                    --text-body: #71717a;
                    --text-muted: #a1a1aa;
                    --tag-fill: #71717a;
                    --search-fill: #ffffff;
                    --search-stroke: #e4e4e7;
                  }

                  .rapidoc-illustration {
                    transition: background-color 0.35s ease;
                  }
                  .rapidoc-illustration * {
                    transition: fill 0.35s ease, stroke 0.35s ease, opacity 0.35s ease, transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.35s ease;
                  }

                  .rapidoc-illustration .header-group {
                    transform-origin: top center;
                    transition: opacity 0.35s ease, transform 0.35s ease, visibility 0.35s ease;
                  }
                  .rapidoc-illustration.hide-header .header-group {
                    opacity: 0;
                    visibility: hidden;
                    pointer-events: none;
                    transform: translateY(-10px);
                  }

                  .rapidoc-illustration .nav-logo {
                    transform-origin: 51px 47px;
                    transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s ease;
                  }
                  .rapidoc-illustration.hide-nav-logo .nav-logo {
                    opacity: 0;
                    visibility: hidden;
                    pointer-events: none;
                    transform: scale(0.4);
                  }

                  .rapidoc-illustration .nav-methods {
                    transform-origin: center right;
                    transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s ease;
                  }
                  .rapidoc-illustration.hide-nav-methods .nav-methods {
                    opacity: 0;
                    visibility: hidden;
                    pointer-events: none;
                    transform: translateX(12px);
                  }

                  .rapidoc-illustration .nav-group {
                    transform-origin: left center;
                    transition: opacity 0.35s ease, transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.35s ease;
                  }
                  .rapidoc-illustration.render-view .nav-group {
                    opacity: 0;
                    visibility: hidden;
                    pointer-events: none;
                    transform: translateX(-150px);
                  }

                  .rapidoc-illustration .main-headings,
                  .rapidoc-illustration .post-endpoint {
                    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
                  }
                  .rapidoc-illustration.render-view .main-headings,
                  .rapidoc-illustration.render-view .post-endpoint {
                    transform: translateX(-142px);
                  }

                  .rapidoc-illustration .request-section {
                    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
                  }
                  .rapidoc-illustration.render-view .request-section {
                    transform: translateX(-143px);
                  }

                  .rapidoc-illustration .response-section {
                    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
                  }
                  .rapidoc-illustration.render-view .response-section {
                    transform: translate(73px, -64.22px);
                  }

                  .main-bg { fill: var(--bg); }
                  .nav-bg { fill: var(--nav-bg); }
                  .nav-border { stroke: var(--border); }
                  .header-bg { fill: var(--header-bg); }
                  .header-border { stroke: var(--border); }
                  .header-search { fill: var(--card-bg); stroke: var(--border); }
                  .card-bg, .card-bg rect, #aa, #svg_15 { fill: var(--card-bg); stroke: var(--border); }
                  .primary-accent { fill: var(--primary) !important; }
                  .primary-btn { fill: var(--primary) !important; }
                  .text-heading { fill: var(--text-heading); }
                  .text-body { fill: var(--text-body); }
                  .text-main { fill: var(--text-heading); }
                  .text-dim { fill: var(--text-body); }
                  .text-muted { fill: var(--text-muted); }
                  .tag-fill { fill: var(--tag-fill); }
                  .search-fill { fill: var(--search-fill); stroke: var(--search-stroke); }
                </style>

