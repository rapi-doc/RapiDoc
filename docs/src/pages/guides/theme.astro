---
import GlobalLayout from '../../layouts/GlobalLayout.astro';
import SiteNavbar from '../../components/SiteNavbar.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import '../../styles/styling.css';

const coreThemingAttributes = [
  {
    name: 'theme',
    type: 'preset | #hex',
    default: 'amber',
    allowed: 'amber, blue, graphite, modern, emerald, violet, rose, slate, default, or #hex',
    desc: 'Sets the primary brand color palette. Accepts any built-in shadcn/ui-inspired preset or a custom brand color hex code (e.g. #2563eb).',
  },
  {
    name: 'color-scheme',
    type: 'string',
    default: 'dark',
    allowed: 'dark | light | system',
    desc: 'Controls dark or light surface mode. When set to "system", RapiDoc automatically switches based on the user OS prefers-color-scheme setting.',
  },
  {
    name: 'radius',
    type: 'string',
    default: 'sm',
    allowed: 'none | sm | md | lg | full',
    desc: 'Corner radius scale applied to cards, buttons, badges, parameter inputs, and dialogs (--radius and --card-radius).',
  },
  {
    name: 'scale',
    type: 'string',
    default: 'default',
    allowed: 'sm | default | lg',
    desc: 'Proportionally scales UI base dimensions, body fonts, monospace code blocks, and sidebar width across the documentation.',
  },
  {
    name: 'nav-item-spacing',
    type: 'string',
    default: 'default',
    allowed: 'compact | default | relaxed',
    desc: 'Controls vertical density and padding of sidebar navigation links independently of typography scale.',
  },
  {
    name: 'load-fonts',
    type: 'boolean',
    default: 'true',
    allowed: 'true | false',
    desc: 'Automatically loads default Open Sans from Google Fonts CDN. Set to "false" in air-gapped, offline, or enterprise intranet environments.',
  },
  {
    name: 'render-style',
    type: 'string',
    default: 'focused',
    allowed: 'focused | read | view',
    desc: 'Document presentation layout mode: single-operation focused console, continuous reading doc, or multi-column interactive view.',
  },
  {
    name: 'schema-style',
    type: 'string',
    default: 'tree',
    allowed: 'tree | table',
    desc: 'Visual formatting of request and response payload schemas (interactive collapsible tree or structured property table).',
  },
];

