---
import GlobalLayout from '../../layouts/GlobalLayout.astro';
import SiteNavbar from '../../components/SiteNavbar.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import RapidocMiniComparisonTable from '../../components/RapidocMiniComparisonTable.astro';

const basicMiniCode = `<script type="module" src="https://unpkg.com/rapidoc/dist/rapidoc-min.js"></script>

<rapi-doc-mini
  spec-url="/specs/mock.yaml"
  color-scheme="dark"
  paths-expanded="false"
> </rapi-doc-mini>`;

const matchPathsCode = `<rapi-doc-mini
  spec-url="/specs/mock.yaml"
  color-scheme="dark"
  paths-expanded="false"
  match-paths="post /users"
> </rapi-doc-mini>`;

const regexMatchCode = `<rapi-doc-mini
  spec-url="/specs/mock.yaml"
  color-scheme="dark"
  schema-style="table"
  paths-expanded="false"
  match-paths="^get /users/{userId}$|^post /users$"
  match-type="regex"
> </rapi-doc-mini>`;

const expandedCode = `<rapi-doc-mini
  spec-url="/specs/mock.yaml"
  color-scheme="dark"
  schema-style="table"
  layout="column"
  paths-expanded="true"
  match-paths="post /users"
> </rapi-doc-mini>`;

const microservicesCode = `<!-- Service A: Code Highlighting Service -->
<rapi-doc-mini
  spec-url="/specs/code-highlight.yaml"
  color-scheme="dark"
  match-paths="get /code"
  paths-expanded="false"
> </rapi-doc-mini>

<!-- Service B: Store & Inventory Service -->
<rapi-doc-mini
  spec-url="/specs/petstore.json"
  color-scheme="dark"
  match-paths="/store"
  paths-expanded="false"
> </rapi-doc-mini>`;

const specNotFoundCode = `<!-- Graceful error rendering when a spec is unavailable or returns 404 -->
<rapi-doc-mini
  spec-url="/specs/fake-non-existing.json"
  color-scheme="dark"
> </rapi-doc-mini>`;

const customStylingCode = `<!-- Custom width, golden border, table schema, and padding -->
<rapi-doc-mini
  style="max-width: 650px; width: 100%; border: 2px solid #eab308; border-radius: 8px; padding: 12px; margin: 16px 0;"
  spec-url="/specs/mock.yaml"
  color-scheme="dark"
  schema-style="table"
  layout="column"
  paths-expanded="false"
> </rapi-doc-mini>

<!-- Compact single-endpoint card with salmon accent border -->
<rapi-doc-mini
  style="max-width: 650px; width: 100%; border: 1px solid #f87171; border-radius: 6px; padding: 8px; margin: 16px 0;"
  spec-url="/specs/mock.yaml"
  color-scheme="dark"
  match-paths="post /users"
  paths-expanded="false"
> </rapi-doc-mini>`;

const attributes = [
  {
    name: 'spec-url',
    type: 'String',
    default: '(empty)',
    desc: 'URL of the OpenAPI specification file (JSON or YAML) to load and render.'
  },
  {
    name: 'match-paths',
    type: 'String',
    default: '(empty)',
    desc: 'Target path and HTTP method filter to selectively render specific endpoints (e.g. "post /users" or "/store").'
  },
  {
    name: 'match-type',
    type: 'includes | regex',
    default: 'includes',
    desc: 'Matching strategy for match-paths. Set to "regex" for regular expression matching.'
  },
  {
    name: 'paths-expanded',
    type: 'true | false',
    default: 'false',
    desc: 'Controls whether matching endpoints are expanded by default or rendered as collapsible items.'
  },
  {
    name: 'layout',
    type: 'row | column',
    default: 'row',
    desc: 'Internal layout of endpoint details (side-by-side parameters and console, or stacked in a column).'
  },
  {
    name: 'schema-style',
    type: 'tree | table',
    default: 'tree',
    desc: 'Visual representation of request and response JSON schemas: interactive tree or structured table.'
  },
  {
    name: 'schema-expand-level',
    type: 'Number',
    default: '999',
    desc: 'Initial expansion depth for nested schema models and properties.'
  },
  {
    name: 'theme',
    type: 'dark | light',
    default: 'dark',
    desc: 'Base color theme preset for the component.'
  },
  {
    name: 'bg-color',
    type: 'Hex / CSS color',
    default: '#1a1a1a',
    desc: 'Custom background color for the component container, allowing seamless blending with your page.'
  },
  {
    name: 'text-color',
    type: 'Hex / CSS color',
    default: '(theme default)',
    desc: 'Base text color for endpoint descriptions, labels, and parameters.'
  },
  {
    name: 'primary-color',
    type: 'Hex / CSS color',
    default: '#f3705a',
    desc: 'Accent highlight color used for primary buttons, active tabs, and HTTP method badges.'
  },
  {
    name: 'allow-try',
    type: 'true | false',
    default: 'true',
    desc: 'Enables or disables the interactive "TRY" execution console.'
  },
  {
    name: 'show-curl-before-try',
    type: 'true | false',
    default: 'false',
    desc: 'Generates and displays copyable cURL commands directly in the card before execution.'
  },
  {
    name: 'api-key-name',
    type: 'String',
    default: '(empty)',
    desc: 'Name of the API key header or query parameter to include in interactive requests.'
  },
  {
    name: 'api-key-location',
    type: 'header | query',
    default: 'header',
    desc: 'Target location where the API key value will be injected.'
  },
  {
    name: 'api-key-value',
    type: 'String',
    default: '(empty)',
    desc: 'Value of the API key or bearer authorization token.'
  },
  {
    name: 'server-url',
    type: 'String',
    default: '(from spec)',
    desc: 'Overrides the base API server URL for all requests made from the widget.'
  },
  {
    name: 'regular-font',
    type: 'String',
    default: '(system font)',
    desc: 'Custom font family for body text and labels (e.g. "Outfit, sans-serif").'
  },
  {
    name: 'mono-font',
    type: 'String',
    default: '(monospace)',
    desc: 'Custom font family for code blocks, payloads, and parameter definitions.'
  }
];
---

<GlobalLayout 
  title="RapiDoc Mini (<rapi-doc-mini>) - Lightweight OpenAPI Micro-Widget | RapiDoc"
  description="Embed lightweight, contextual OpenAPI documentation snippets and single endpoints directly inside blogs, tutorials, dashboards, and developer portals."
  keywords="RapiDoc Mini, rapi-doc-mini, OpenAPI widget, embed API docs, micro API documentation"
>
  <!-- RapiDoc Component Registration -->
  <script slot="script" is:inline type="module" src="/rapidoc/rapidoc-min.js"></script>

  <!-- Ambient background glow elements -->
  <div class="ambient-glow glow-emerald"></div>
  <div class="ambient-glow glow-indigo"></div>
  <div class="ambient-glow glow-cyan"></div>

  <!-- Reusable Frosted Glass Navigation -->
  <SiteNavbar activePage="guides" />

  <main class="rd-mini-main">
    <!-- Hero Header -->
    <header class="rd-mini-header">
      <div class="rd-badge-pill">
        <span class="rd-badge-pulse"></span>
        <span class="rd-badge-text">Standalone Endpoint Web Component</span>
      </div>

      <h1 class="rd-page-title">
        RapiDoc <span class="text-gradient">Mini</span>
      </h1>

      <p class="rd-page-subtitle">
        <code>&lt;rapi-doc-mini&gt;</code> is a lightweight, zero-iframe Web Component designed to embed live, interactive OpenAPI endpoints directly into technical blog posts, markdown tutorials, changelogs, and microservice workflows without visual clutter.
      </p>

      <!-- Key Metrics / Feature Badges -->
      <div class="rd-stats-bar">
        <div class="rd-stat-card">
          <span class="rd-stat-value">100%</span>
          <span class="rd-stat-label">No &lt;iframe&gt; Friction</span>
        </div>
        <div class="rd-stat-card">
          <span class="rd-stat-value">Granular</span>
          <span class="rd-stat-label">Path & RegEx Filtering</span>
        </div>
        <div class="rd-stat-card">
          <span class="rd-stat-value">Live TRY</span>
          <span class="rd-stat-label">Interactive Console</span>
        </div>
        <div class="rd-stat-card">
          <span class="rd-stat-value">Multi-Spec</span>
          <span class="rd-stat-label">Microservice Mashup</span>
        </div>
      </div>
    </header>

    <!-- Why RapiDoc Mini Grid -->
    <section class="rd-section">
      <div class="rd-section-header">
        <div class="rd-section-badge">Why RapiDoc Mini</div>
        <h2 class="rd-section-title">The Problem with Traditional API Documentation</h2>
      </div>

      <div class="rd-usecase-grid">
        <div class="rd-usecase-card">
          <div class="rd-card-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="16" y1="13" x2="8" y2="13"/>
              <line x1="16" y1="17" x2="8" y2="17"/>
              <polyline points="10 9 9 9 8 9"/>
            </svg>
          </div>
          <h3>Blog & Tutorial Writing</h3>
          <p>
            Static markdown code snippets and screenshots go stale the moment an API schema changes. <code>&lt;rapi-doc-mini&gt;</code> reads directly from your source OpenAPI spec, guaranteeing your code examples and live consoles are always 100% up to date.
          </p>
        </div>

        <div class="rd-usecase-card">
          <div class="rd-card-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 2 7 12 12 22 7 12 2"/>
              <polyline points="2 17 12 22 22 17"/>
              <polyline points="2 12 12 17 22 12"/>
            </svg>
          </div>
          <h3>Step-by-Step Onboarding</h3>
          <p>
            When guiding a developer through a multistep journey (e.g. Register &rarr; Verify &rarr; Transact), you don't want to overwhelm them with 100 irrelevant endpoints. Pluck and display only the relevant endpoint at each step.
          </p>
        </div>

        <div class="rd-usecase-card">
          <div class="rd-card-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="18" cy="18" r="3"/>
              <circle cx="6" cy="6" r="3"/>
              <circle cx="18" cy="6" r="3"/>
              <path d="M6 9v12"/>
              <path d="M18 9a9 9 0 0 1-9 9H6"/>
            </svg>
          </div>
          <h3>Microservice Storytelling</h3>
          <p>
            Modern architectures divide APIs across dozens of microservices. <code>&lt;rapi-doc-mini&gt;</code> allows you to pluck 1 endpoint from Billing, 1 from Identity, and 1 from Catalog into a unified narrative without merging backend specs.
          </p>
        </div>

        <div class="rd-usecase-card">
          <div class="rd-card-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
              <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
            </svg>
          </div>
          <h3>Release Notes & Changelogs</h3>
          <p>
            Announce a new or deprecated endpoint in your product changelog by embedding the live interactive card directly into the release announcement with a working "TRY" console.
          </p>
        </div>
      </div>
    </section>

    <!-- ================= DEMO 1: ESSENTIAL EMBED ================= -->
    <section class="rd-section" id="blog-style">
      <div class="rd-section-header">
        <div class="rd-section-badge">Interactive Demo 1</div>
        <h2 class="rd-section-title">Seamless Blog & Guide Embedding</h2>
      </div>

      <p class="rd-section-desc">
        Just like an <code>&lt;img&gt;</code> tag, <code>&lt;rapi-doc-mini&gt;</code> drops directly into any HTML flow. Notice how it blends seamlessly with the page background, allowing you to trigger live API requests without being trapped inside an iframe or nested card:
      </p>

      <div class="rd-single-col-demo">
        <CodeBlock code={basicMiniCode} lang="html" filename="blog-embed.html" />

        <div class="rd-live-wrapper">
          <div class="rd-live-indicator">
            <span class="rd-live-dot"></span>
            <span>Live Component Output (Blended with Page)</span>
          </div>

          <!-- RapiDoc Mini rendered directly on page surface -->
          <rapi-doc-mini
            class="rd-mini-element"
            spec-url="/specs/mock.yaml"
            color-scheme="dark"
            paths-expanded="false"
          > </rapi-doc-mini>
        </div>
      </div>
    </section>

    <!-- ================= DEMO 2: CUSTOM STYLING & SIZING ================= -->
    <section class="rd-section" id="styling-sizing">
      <div class="rd-section-header">
        <div class="rd-section-badge">Interactive Demo 2</div>
        <h2 class="rd-section-title">Placement, Sizing &amp; Custom CSS Styling</h2>
      </div>

      <p class="rd-section-desc">
        Just like an <code>&lt;img&gt;</code> or <code>&lt;div&gt;</code> tag, <code>&lt;rapi-doc-mini&gt;</code> can be styled with standard CSS. You can easily constrain its <code>width</code>, apply custom <code>border</code> and <code>border-radius</code>, adjust <code>padding</code>, or attach box shadows to fit your exact layout requirements:
      </p>

      <div class="rd-single-col-demo">
        <CodeBlock code={customStylingCode} lang="html" filename="custom-styling.html" />

        <div class="rd-live-wrapper">
          <div class="rd-live-indicator">
            <span class="rd-live-dot" style="background: #eab308; box-shadow: 0 0 8px #eab308;"></span>
            <span>Custom Width (650px), Golden Border &amp; Padding</span>
          </div>

          <rapi-doc-mini
            style="max-width: 650px; width: 100%; border: 2px solid #eab308; border-radius: 8px; padding: 12px; margin: 0 0 24px 0;"
            spec-url="/specs/mock.yaml"
            color-scheme="dark"
            schema-style="table"
            layout="column"
            paths-expanded="false"
          > </rapi-doc-mini>

          <div class="rd-live-indicator" style="margin-top: 16px;">
            <span class="rd-live-dot" style="background: #f87171; box-shadow: 0 0 8px #f87171;"></span>
            <span>Single-Endpoint Card with Salmon Accent Border</span>
          </div>

          <rapi-doc-mini
            style="max-width: 650px; width: 100%; border: 1px solid #f87171; border-radius: 6px; padding: 8px; margin: 0 0 24px 0;"
            spec-url="/specs/mock.yaml"
            color-scheme="dark"
            match-paths="post /users"
            paths-expanded="false"
          > </rapi-doc-mini>
        </div>
      </div>
    </section>

    <!-- ================= DEMO 3: PATH FILTERING ================= -->
    <section class="rd-section" id="path-filtering">
      <div class="rd-section-header">
        <div class="rd-section-badge">Interactive Demo 3</div>
        <h2 class="rd-section-title">Selective Endpoint Filtering with <code>match-paths</code></h2>
      </div>

      <p class="rd-section-desc">
        Instead of rendering an entire specification, use <code>match-paths</code> to extract and display only the exact endpoint needed for your narrative (e.g. <code>match-paths="post /users"</code>):
      </p>

      <div class="rd-single-col-demo">
        <CodeBlock code={matchPathsCode} lang="html" filename="filter-endpoint.html" />

        <div class="rd-live-wrapper">
          <div class="rd-live-indicator">
            <span class="rd-live-dot"></span>
            <span>Filtered Output: Only POST /users</span>
          </div>

          <rapi-doc-mini
            class="rd-mini-element"
            spec-url="/specs/mock.yaml"
            color-scheme="dark"
            paths-expanded="false"
            match-paths="post /users"
          > </rapi-doc-mini>
        </div>
      </div>
    </section>

    <!-- ================= DEMO 4: REGEX FILTERING ================= -->
    <section class="rd-section" id="regex-filtering">
      <div class="rd-section-header">
        <div class="rd-section-badge">Interactive Demo 4</div>
        <h2 class="rd-section-title">Multi-Endpoint Selection with RegEx</h2>
      </div>

      <p class="rd-section-desc">
        Set <code>match-type="regex"</code> to craft powerful regular expression filters. Below, we match both <code>GET /users/{'{userId}'}</code> and <code>POST /users</code> simultaneously while rendering schemas as clean data tables:
      </p>

      <div class="rd-single-col-demo">
        <CodeBlock code={regexMatchCode} lang="html" filename="regex-filter.html" />

        <div class="rd-live-wrapper">
          <div class="rd-live-indicator">
            <span class="rd-live-dot"></span>
            <span>RegEx Match: GET /users/{'{userId}'} &amp; POST /users</span>
          </div>

          <rapi-doc-mini
            class="rd-mini-element"
            spec-url="/specs/mock.yaml"
            color-scheme="dark"
            schema-style="table"
            paths-expanded="false"
            match-paths={`^get /users/{userId}$|^post /users$`}
            match-type="regex"
          > </rapi-doc-mini>
        </div>
      </div>
    </section>

    <!-- ================= DEMO 5: ALWAYS EXPANDED ================= -->
    <section class="rd-section" id="always-expanded">
      <div class="rd-section-header">
        <div class="rd-section-badge">Interactive Demo 5</div>
        <h2 class="rd-section-title">Always-Expanded Inline Mode (<code>paths-expanded="true"</code>)</h2>
      </div>

      <p class="rd-section-desc">
        If click-to-expand accordion controls do not fit your article flow, set <code>paths-expanded="true"</code> to render parameters, request body schemas, and the live test console fully expanded:
      </p>

      <div class="rd-single-col-demo">
        <CodeBlock code={expandedCode} lang="html" filename="expanded-mode.html" />

        <div class="rd-live-wrapper">
          <div class="rd-live-indicator">
            <span class="rd-live-dot"></span>
            <span>Fully Expanded Inline View</span>
          </div>

          <rapi-doc-mini
            class="rd-mini-element"
            spec-url="/specs/mock.yaml"
            color-scheme="dark"
            schema-style="table"
            sort-endpoints-by="method"
            layout="column"
            paths-expanded="true"
            match-paths="post /users"
          > </rapi-doc-mini>
        </div>
      </div>
    </section>

    <!-- ================= DEMO 6: MICROSERVICES MASHUP ================= -->
    <section class="rd-section" id="microservices">
      <div class="rd-section-header">
        <div class="rd-section-badge">Interactive Demo 6</div>
        <h2 class="rd-section-title">Multi-Spec Microservice Integration</h2>
      </div>

      <p class="rd-section-desc">
        Seamlessly weave endpoints from multiple independent OpenAPI specs into a cohesive story. Below, we embed an endpoint from a Syntax Highlighting service alongside an endpoint from a Petstore service in the same article:
      </p>

      <div class="rd-single-col-demo">
        <CodeBlock code={microservicesCode} lang="html" filename="microservices-flow.html" />

        <div class="rd-live-wrapper">
          <div class="rd-live-indicator">
            <span class="rd-live-dot"></span>
            <span>Microservice A: Code Highlighting Spec (/specs/code-highlight.yaml)</span>
          </div>

          <rapi-doc-mini
            class="rd-mini-element"
            spec-url="/specs/code-highlight.yaml"
            color-scheme="dark"
            schema-style="table"
            layout="column"
            match-paths="get /code"
            paths-expanded="false"
          > </rapi-doc-mini>

          <div class="rd-live-indicator" style="margin-top: 24px;">
            <span class="rd-live-dot" style="background: #a855f7; box-shadow: 0 0 8px #a855f7;"></span>
            <span>Microservice B: Petstore Inventory Spec (/specs/petstore.json)</span>
          </div>

          <rapi-doc-mini
            class="rd-mini-element"
            spec-url="/specs/petstore.json"
            color-scheme="dark"
            schema-style="table"
            layout="column"
            match-paths="/store"
            paths-expanded="false"
          > </rapi-doc-mini>
        </div>
      </div>
    </section>

    <!-- ================= DEMO 7: SPEC NOT FOUND ERROR ================= -->
    <section class="rd-section" id="error-handling">
      <div class="rd-section-header">
        <div class="rd-section-badge">Interactive Demo 7</div>
        <h2 class="rd-section-title">Handling Unavailable Specs (404 / Network Errors)</h2>
      </div>

      <p class="rd-section-desc">
        If an OpenAPI spec URL is missing, invalid, or returns a 404 HTTP status, <code>&lt;rapi-doc-mini&gt;</code> renders a clean built-in error message without throwing unhandled exceptions or breaking your page layout:
      </p>

      <div class="rd-single-col-demo">
        <CodeBlock code={specNotFoundCode} lang="html" filename="spec-not-found.html" />

        <div class="rd-live-wrapper">
          <div class="rd-live-indicator">
            <span class="rd-live-dot" style="background: #ef4444; box-shadow: 0 0 8px #ef4444;"></span>
            <span>Graceful Error State (Non-Existent Spec URL)</span>
          </div>

          <rapi-doc-mini
            class="rd-mini-element"
            spec-url="/specs/fake-non-existing.json"
            color-scheme="dark"
          > </rapi-doc-mini>
        </div>
      </div>
    </section>

    <!-- ================= ATTRIBUTES REFERENCE TABLE ================= -->
    <section class="rd-section" id="attributes-reference">
      <div class="rd-section-header">
        <div class="rd-section-badge">API Reference</div>
        <h2 class="rd-section-title">Supported <code>&lt;rapi-doc-mini&gt;</code> Attributes</h2>
      </div>

      <p class="rd-section-desc">
        Configure any of the following HTML attributes directly on the custom element tag to control filtering, theming, layout, and authorization:
      </p>

      <div class="rd-table-container">
        <table class="rd-api-table">
          <thead>
            <tr>
              <th class="col-name">Attribute</th>
              <th class="col-type">Type / Allowed</th>
              <th class="col-default">Default</th>
              <th class="col-desc">Description</th>
            </tr>
          </thead>
          <tbody>
            {attributes.map(attr => (
              <tr class="rd-api-row">
                <td class="col-name">
                  <code class="rd-attr-name">{attr.name}</code>
                </td>
                <td class="col-type">
                  <span class="rd-type-tag">{attr.type}</span>
                </td>
                <td class="col-default">
                  <span class="rd-default-tag">{attr.default}</span>
                </td>
                <td class="col-desc">
                  <div class="rd-attr-desc">{attr.desc}</div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- ================= COMPONENT COMPARISON ================= -->
    <section class="rd-section" id="comparison">
      <div class="rd-section-header">
        <div class="rd-section-badge">Architecture</div>
        <h2 class="rd-section-title">Component Comparison: <code>&lt;rapi-doc&gt;</code> vs. <code>&lt;rapi-doc-mini&gt;</code></h2>
      </div>

      <p class="rd-section-desc">
        Understanding when to use the comprehensive full-portal <code>&lt;rapi-doc&gt;</code> component versus the lightweight, embeddable <code>&lt;rapi-doc-mini&gt;</code> widget:
      </p>

      <RapidocMiniComparisonTable />
    </section>

    <!-- Bottom Navigation / Callout -->
    <section class="rd-bottom-callout">
      <div class="rd-callout-glow"></div>
      <div class="rd-callout-content">
        <div class="rd-callout-badge">Next Steps</div>
        <h2 class="rd-callout-title">Ready to Integrate RapiDoc?</h2>
        <p class="rd-callout-desc">
          Check out our Quick Start for copy-paste integration recipes, or explore the complete API reference for full-portal documentation options.
        </p>
        <div class="rd-callout-actions">
          <a href="/quickstart" class="rd-btn rd-btn-primary rd-btn-lg">
            <span>Quick Start Guide</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14m-7-7 7 7-7 7" />
            </svg>
