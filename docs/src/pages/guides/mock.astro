<script>
  // Interactive testbed script for fetch testing
  window.addEventListener('DOMContentLoaded', () => {
    const endpointSelect = document.getElementById('endpoint-select') as HTMLSelectElement | null;
    const statusSelect = document.getElementById('status-select') as HTMLSelectElement | null;
    const delaySelect = document.getElementById('delay-select') as HTMLSelectElement | null;
    const sendBtn = document.getElementById('send-fetch-btn');
    const resStatus = document.getElementById('res-status');
    const resTime = document.getElementById('res-time');
    const resBody = document.getElementById('res-body');
    const rapidocEl = document.getElementById('live-mock-rapidoc');

    // Setup custom styled dropdown logic
    function setupCustomSelect(containerId: string, selectEl: HTMLSelectElement | null) {
      const container = document.getElementById(containerId);
      if (!container || !selectEl) return;

      const trigger = container.querySelector('.rd-select-trigger') as HTMLButtonElement | null;
      const valDisplay = container.querySelector('.rd-select-value');
      const options = container.querySelectorAll('.rd-select-option');

      trigger?.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = container.classList.contains('is-open');
        document.querySelectorAll('.rd-custom-select.is-open').forEach((el) => {
          if (el !== container) el.classList.remove('is-open');
        });
        container.classList.toggle('is-open', !isOpen);
        trigger.setAttribute('aria-expanded', (!isOpen).toString());
      });

      options.forEach((opt, idx) => {
        opt.addEventListener('click', (e) => {
          e.stopPropagation();
          const text = opt.querySelector('span')?.textContent ?? '';
          if (valDisplay) valDisplay.textContent = text;

          options.forEach((o) => {
            o.classList.remove('selected');
            o.setAttribute('aria-selected', 'false');
          });
          opt.classList.add('selected');
          opt.setAttribute('aria-selected', 'true');
          container.classList.remove('is-open');
          trigger?.setAttribute('aria-expanded', 'false');

          // Sync underlying native select option by exact index
          if (selectEl.options[idx]) {
            selectEl.selectedIndex = idx;
            selectEl.dispatchEvent(new Event('change', { bubbles: true }));
          }
        });
      });
    }

    setupCustomSelect('endpoint-custom-select', endpointSelect);
    setupCustomSelect('status-custom-select', statusSelect);
    setupCustomSelect('delay-custom-select', delaySelect);

    // Global click-away and Escape dismiss for custom dropdowns
    document.addEventListener('click', () => {
      document.querySelectorAll('.rd-custom-select.is-open').forEach((el) => {
        el.classList.remove('is-open');
        el.querySelector('.rd-select-trigger')?.setAttribute('aria-expanded', 'false');
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelectorAll('.rd-custom-select.is-open').forEach((el) => {
          el.classList.remove('is-open');
          el.querySelector('.rd-select-trigger')?.setAttribute('aria-expanded', 'false');
        });
      }
    });

    function syncRapidocAttributes() {
      if (!rapidocEl) return;
      const statusVal = statusSelect.value;
      const delayVal = delaySelect.value;
      const selectedOption = statusSelect.options[statusSelect.selectedIndex];
      const strategy = selectedOption.getAttribute('data-strategy') || 'first';

      if (statusVal) {
        rapidocEl.setAttribute('mock-server-status-code', statusVal);
      } else {
        rapidocEl.removeAttribute('mock-server-status-code');
      }
      rapidocEl.setAttribute('mock-server-status-strategy', strategy);
      rapidocEl.setAttribute('mock-server-delay', delayVal);
    }

    statusSelect?.addEventListener('change', syncRapidocAttributes);
    delaySelect?.addEventListener('change', syncRapidocAttributes);

    sendBtn?.addEventListener('click', async () => {
      syncRapidocAttributes();

      const url = endpointSelect.value;
      const selectedOpt = endpointSelect.options[endpointSelect.selectedIndex];
      const method = selectedOpt.getAttribute('data-method') || 'GET';

      resStatus.className = 'rd-status-badge badge-pending';
      resStatus.textContent = 'Fetching...';
      resTime.textContent = '...';
      resBody.textContent = `Sending ${method} request to ${url} ...`;

      const startTime = performance.now();
      try {
        const fetchOptions = { method };
        if (method === 'POST') {
          fetchOptions.headers = { 'Content-Type': 'application/json' };
          fetchOptions.body = JSON.stringify({ name: 'morpheus', job: 'leader' });
        }

        const response = await fetch(url, fetchOptions);
        const elapsed = Math.round(performance.now() - startTime);

        const statusClass = response.ok ? 'badge-2xx' : response.status >= 500 ? 'badge-5xx' : 'badge-4xx';
        resStatus.className = `rd-status-badge ${statusClass}`;
        resStatus.textContent = `${response.status} ${response.statusText || 'OK'}`;
        resTime.textContent = `${elapsed}ms`;

        const contentType = response.headers.get('content-type') || '';
        if (contentType.includes('json')) {
          const data = await response.json();
          resBody.textContent = JSON.stringify(data, null, 2);
        } else {
          const text = await response.text();
          resBody.textContent = text;
        }
      } catch (err) {
        const elapsed = Math.round(performance.now() - startTime);
        resStatus.className = 'rd-status-badge badge-5xx';
        resStatus.textContent = 'Failed';
        resTime.textContent = `${elapsed}ms`;
        resBody.textContent = `Error executing fetch: ${err.message}`;
      }
    });
  });
</script>

