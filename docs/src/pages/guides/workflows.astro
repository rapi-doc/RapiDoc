---
import GlobalLayout from '../../layouts/GlobalLayout.astro';
import SiteNavbar from '../../components/SiteNavbar.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import {
  IconArrowRight,
  IconArrowUpRight,
  IconFileCode,
  IconPlayerPlay,
  IconRoute,
  IconArrowsSplit,
  IconRepeat,
  IconLayoutList,
  IconTable,
  IconBrowser,
  IconRobot,
  IconBook,
} from '@tabler/icons-astro';

const pageSnippet = `<script type="module" src="https://unpkg.com/rapidoc/dist/rapidoc-min.js"></script>
<!-- A separate bundle: pages without workflows don't load it -->
<script type="module" src="https://unpkg.com/rapidoc/dist/rapidoc-flow-min.js"></script>

<rapi-flow
  arazzo-url="/specs/petstore.arazzo.yaml"
  workflow-id="adoptPet"
  for="thedoc"
></rapi-flow>

<!-- The workflow borrows this element's spec, server, credentials and mock -->
<rapi-doc id="thedoc" spec-url="/specs/petstore.yaml" mock-server="true"></rapi-doc>`;

const arazzoSnippet = `arazzo: 1.0.1
info: { title: Petstore workflows, version: 1.0.0 }
sourceDescriptions:
  - name: petstore
    url: ./petstore.yaml
    type: openapi
workflows:
  - workflowId: adoptPet
    summary: Adopt an available pet
    inputs:
      type: object
      properties:
        quantity: { type: integer, default: 1 }
    steps:
      - stepId: findAvailable
        operationId: findPetsByStatus          # a box linked to this operation
        parameters:
          - { name: status, in: query, value: available }
        successCriteria:
          - condition: $statusCode == 200
        onFailure:
          - { name: noPets, type: end }        # the failure branch
        outputs:
          petId: $response.body#/0/id          # passed on: a dashed line
      - stepId: placeOrder
        operationId: placeOrder
        requestBody:
          contentType: application/json
          payload:
            petId: $steps.findAvailable.outputs.petId
            quantity: $inputs.quantity
        onFailure:
          - name: storeBusy
            type: retry                        # drawn as a loop back
            retryAfter: 2
            retryLimit: 3
            criteria:
              - condition: $statusCode == 503
        outputs:
          orderId: $response.body#/id
    outputs:
      orderId: $steps.placeOrder.outputs.orderId`;

const mockServerSnippet = `# A mock that validates requests, generates data and checks OAuth scopes
npx rapidoc mock            # serves every spec under http://localhost:4010/<api id>`;

const mockServerHtmlSnippet = `<rapi-flow
  arazzo-url="/specs/petstore.arazzo.yaml"
  spec-url="/specs/petstore.yaml"
  server-url="http://localhost:4010/petstore"
></rapi-flow>`;
---

<GlobalLayout
  title="Arazzo Workflows Guide | RapiDoc"
  description="Draw the multi-step journeys through your API from an Arazzo document, run them in the browser against a mock or the real API, and reuse them as MCP tools."
  keywords="Arazzo, API workflows, rapi-flow, OpenAPI workflows, workflow diagram, API mock, MCP tools, RapiDoc"
>
  <script slot="script" is:inline type="module" src="/rapidoc/rapidoc-min.js"></script>

  <div class="ambient-glow glow-emerald"></div>
  <div class="ambient-glow glow-indigo"></div>
  <div class="ambient-glow glow-cyan"></div>

  <SiteNavbar activePage="guides" />

  <main class="wf-guide-main">
    <header class="rd-hero-header">
      <div class="rd-badge-pill">
        <span class="rd-badge-pulse"></span>
        <span class="rd-badge-text">Arazzo • Workflows</span>
      </div>

      <h1 class="rd-page-title">
        Show the <span class="text-gradient">sequence</span>, not just the endpoints
      </h1>

      <p class="rd-page-subtitle">
        <code>&lt;rapi-flow&gt;</code> draws the journeys an Arazzo document describes (find a pet, order it, read the order
        back) right next to your API reference, and lets readers run them against a mock or the real API, one lit-up step
        at a time.
      </p>

      <div class="wf-cta-row">
        <a href="#live-demo" class="rd-btn rd-btn-primary">
          <IconPlayerPlay size={18} stroke={2} />
          <span>Run the Live Demo</span>
        </a>
        <a href="/docs/components/workflows/" class="rd-btn rd-btn-secondary">
          <IconFileCode size={18} stroke={2} />
          <span>Technical Reference Docs</span>
          <IconArrowUpRight size={16} stroke={2} />
        </a>
      </div>

      <div class="rd-stats-bar">
        <div class="rd-stat-card">
          <span class="rd-stat-value">Arazzo 1.x</span>
          <span class="rd-stat-label">The OpenAPI Initiative's Standard</span>
        </div>
        <div class="rd-stat-card">
          <span class="rd-stat-value">0 KB</span>
          <span class="rd-stat-label">Added to rapidoc-min.js</span>
        </div>
        <div class="rd-stat-card">
          <span class="rd-stat-value">One Runtime</span>
          <span class="rd-stat-label">Browser, MCP & Portal</span>
        </div>
        <div class="rd-stat-card">
          <span class="rd-stat-value">Zero Backend</span>
          <span class="rd-stat-label">Runs Against the Mock</span>
        </div>
      </div>
    </header>

    <div class="wf-guide-content">
      <section class="rd-section">
        <div class="rd-section-badge">Why</div>
        <h2 class="rd-section-title">Integrators Need the Order, Not Just the Operations</h2>
        <p class="rd-section-desc">
          An API reference answers "what does this endpoint take?". The first question a new integrator asks is different:
          "which calls do I make, in which order, and what do I pass from one to the next?". That knowledge usually lives in
          a tutorial that drifts from the API. Arazzo puts it in a file next to the spec, and <code>&lt;rapi-flow&gt;</code>
          draws it from that file, so the diagram changes when the workflow does.
        </p>

        <div class="comparison-grid">
          <div class="comparison-card before">
            <div class="card-status-badge badge-muted">Reference Alone</div>
            <h3 class="card-title">Forty operations, no path through them</h3>
            <ul class="comparison-list">
              <li>The order of calls is buried in prose, or in a sample app.</li>
              <li>Which response field feeds which request is left to the reader.</li>
              <li>Error handling ("retry when the store is busy") is a footnote, if it's there at all.</li>
              <li>Trying a journey means copying IDs between Try panels by hand.</li>
            </ul>
          </div>

          <div class="comparison-card after">
            <div class="card-status-badge badge-success">With a Workflow</div>
            <h3 class="card-title">The journey, drawn from the Arazzo file</h3>
            <ul class="comparison-list">
              <li>One box per step, in order, each linked to its operation in the reference.</li>
              <li>Dashed lines show each value a step passes on, labelled with its name.</li>
              <li><code>goto</code>, <code>retry</code> and <code>end</code> branches are part of the diagram.</li>
              <li><strong>Run workflow</strong> makes every call, passes the values along and shows the outputs.</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="rd-section" id="live-demo">
        <div class="rd-section-badge">Live Demo</div>
        <h2 class="rd-section-title">Run a Workflow Against the In-Browser Mock</h2>
        <p class="rd-section-desc">
          The diagram below is tied to the Petstore reference beside it, which has <code>mock-server="true"</code>: no
          backend answers, the page does. Pick what the mock should answer, then press <strong>Run workflow</strong> under
          the diagram and watch each step light up. Click a step to open its operation in the reference.
        </p>

        <div class="wf-scenarios" role="group" aria-label="What the mock answers">
          <button type="button" class="wf-scenario is-active" data-codes="{}" data-note="The mock answers every step with its success response.">
            <span class="wf-scenario-code ok">200</span>
            <span>
              <strong>Everything succeeds</strong>
              <small>Every step answers from the spec's examples; the outputs table fills in.</small>
            </span>
          </button>
          <button type="button" class="wf-scenario" data-codes='{"*":"404"}' data-note="The mock answers every step with 404.">
            <span class="wf-scenario-code fail">404</span>
            <span>
              <strong>No pets available</strong>
              <small>The first step fails; its <code>noPets</code> action ends the run, which reports the failure.</small>
            </span>
          </button>
          <button type="button" class="wf-scenario" data-codes='{"placeOrder":"503, 200"}' data-note="The order step answers 503 first, then 200; the other steps succeed.">
            <span class="wf-scenario-code warn">503 → 200</span>
            <span>
              <strong>Store busy, then free</strong>
              <small>Only <code>placeOrder</code> fails, once; its <code>retry</code> action waits 2 s and the second attempt succeeds.</small>
            </span>
          </button>
        </div>
        <p class="wf-scenario-note" aria-live="polite">The mock answers every step with its success response. Press Run workflow.</p>

        <div class="wf-demo">
          <div class="wf-demo-flow">
            <rapi-flow
              arazzo-url="/specs/petstore.arazzo.yaml"
              workflow-id="adoptPet"
              for="workflow-guide-doc"
              theme="ember"
              color-scheme="dark"></rapi-flow>
          </div>
          <div class="wf-demo-doc">
            <rapi-doc
              id="workflow-guide-doc"
              spec-url="/specs/petstore.yaml"
              mock-server="true"
              mock-server-status-code="200"
              mock-server-delay="250"
              color-scheme="dark"
              theme="ember"
              render-style="focused"
              show-header="false"
              show-info="false"
              allow-authentication="false"
              style="height: 100%; width: 100%;"></rapi-doc>
          </div>
        </div>
        <p class="wf-demo-caveat">
          The buttons fill the <strong>Mock Response Status</strong> table under the diagram: one row per step, plus a default.
          Edit it yourself to try other paths.
        </p>
      </section>

      <section class="rd-section">
        <div class="rd-section-badge">The Diagram</div>
        <h2 class="rd-section-title">What It Draws</h2>
        <p class="rd-section-desc">
          The layout is RapiDoc's own SVG code with no graph library, so the same diagram renders in the browser and, in a
          portal, as static SVG at build time.
        </p>
        <div class="feature-grid">
          <div class="feature-card">
            <div class="feature-icon"><IconRoute size={20} stroke={2} /></div>
            <div>
              <h4>Steps linked to operations</h4>
              <p>Each box names its step, method and path. Clicking it scrolls a tied <code>&lt;rapi-doc&gt;</code> to the operation.</p>
            </div>
          </div>
          <div class="feature-card">
            <div class="feature-icon"><IconArrowsSplit size={20} stroke={2} /></div>
            <div>
              <h4>Values passed between steps</h4>
              <p>A dashed line from <code>findAvailable</code> to <code>placeOrder</code>, labelled <code>petId</code>. Hover a value to see where it goes.</p>
            </div>
          </div>
          <div class="feature-card">
            <div class="feature-icon"><IconRepeat size={20} stroke={2} /></div>
            <div>
              <h4>Success and failure branches</h4>
              <p><code>goto</code> and <code>retry</code> draw as arrows back or forward; <code>end</code> closes the run. Each action shows its criteria.</p>
            </div>
          </div>
          <div class="feature-card">
            <div class="feature-icon"><IconLayoutList size={20} stroke={2} /></div>
            <div>
              <h4>Compact and expanded</h4>
              <p>Expanded shows each step's inputs and actions in its box; compact keeps only the operation, for long workflows.</p>
            </div>
          </div>
          <div class="feature-card">
            <div class="feature-icon"><IconTable size={20} stroke={2} /></div>
            <div>
              <h4>Outputs at a glance</h4>
              <p>The workflow's outputs sit in a table under the steps, each with the step it comes from.</p>
            </div>
          </div>
        </div>

        <div class="sub-topic">
          <h3>The Arazzo behind it</h3>
          <p>
            Steps name their operation by <code>operationId</code> (or <code>operationPath</code>); runtime expressions such as
            <code>$response.body#/0/id</code> and <code>$steps.findAvailable.outputs.petId</code> carry values from one step to the next.
          </p>
          <CodeBlock code={arazzoSnippet} lang="yaml" filename="petstore.arazzo.yaml" />
        </div>
      </section>

      <section class="rd-section">
        <div class="rd-section-badge">One Runtime</div>
        <h2 class="rd-section-title">One Workflow, Three Places It Runs</h2>
        <p class="rd-section-desc">
          The run button, AI agents and the developer portal all use the same workflow runtime, built on RapiDoc's MCP
          manifest. A workflow that runs on this page runs the same way for an agent.
        </p>
        <div class="standards-grid">
          <div class="standard-card">
            <div class="standard-badge"><IconBrowser size={14} stroke={2} /> Browser</div>
            <h4>The run panel</h4>
            <p>
              Inputs with their defaults, credentials from the tied <code>&lt;rapi-doc&gt;</code> (or a small form of its own),
              a log with each step's request and response, and the outputs. Requests go from the reader's browser, like
              <strong>Try</strong>.
            </p>
          </div>
          <div class="standard-card">
            <div class="standard-badge"><IconRobot size={14} stroke={2} /> AI agents</div>
            <h4>One MCP tool per workflow</h4>
            <p>
              With a <code>&lt;rapi-flow for="…"&gt;</code> on the page, <strong>Export MCP Server</strong> adds a tool per
              workflow: its inputs become the arguments, its outputs the result. See the <a href="/guides/mcp">MCP guide</a>.
            </p>
          </div>
          <div class="standard-card">
            <div class="standard-badge"><IconBook size={14} stroke={2} /> Developer portal</div>
            <h4>Drawn at build time</h4>
            <p>
              <code>@rapidoc/portal</code>'s <code>&#123;% workflow %&#125;</code> tag renders the diagram as static SVG, so
              it shows without JavaScript; the element loads only when a reader clicks <strong>Run workflow</strong>. The
              portal's hosted <code>/mcp</code> serves the same workflows to agents.
            </p>
          </div>
        </div>
      </section>

      <section class="rd-section">
        <div class="rd-section-badge">Integration</div>
        <h2 class="rd-section-title">Add It to Your Docs</h2>
        <p class="rd-section-desc">
          Load the flow bundle next to RapiDoc, point the element at your Arazzo file and tie it to the reference. Its
          attributes, events and CSS parts are in the <a href="/docs/components/workflows/">reference docs</a>.
        </p>
        <div class="sub-topic">
          <CodeBlock code={pageSnippet} lang="html" filename="index.html" />
        </div>

        <div class="sub-topic">
          <h3>Against a mock server, or the real API</h3>
          <p>
            For a mock that validates requests, generates data and checks OAuth scopes, run <code>rapidoc mock</code> and send
            the run there with <code>server-url</code> (or list it as a server in the spec and pick it in
            <code>&lt;rapi-doc&gt;</code>). Against the real API, the browser makes the calls, so the API must allow
            cross-origin requests from your docs site.
          </p>
          <CodeBlock code={mockServerSnippet} lang="bash" filename="terminal" />
          <CodeBlock code={mockServerHtmlSnippet} lang="html" filename="index.html" />
        </div>
      </section>

      <section class="wf-cta-box">
        <div class="wf-cta-content">
          <h3>See it next to a full API reference</h3>
          <p>The example page ties two Arazzo files to the Petstore reference, with branches, retries and the MCP export.</p>
          <div class="cta-actions">
            <a href="/examples/arazzo-flow" class="rd-btn rd-btn-primary">
              <span>Open the rapi-flow Example</span>
              <IconArrowRight size={18} stroke={2} />
            </a>
            <a href="/docs/components/workflows/" class="rd-btn rd-btn-secondary">
              <span>View Technical Docs</span>
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>

  <SiteFooter />
</GlobalLayout>

<script>
  import 'rapidoc/flow';

  // Scenario buttons fill the flow's status-code table (`*` = every step, else by step id); the
  // flow hands them to the tied <rapi-doc>'s in-browser mock, per operation, for the run.
  const flow = document.querySelector('rapi-flow') as any;
  const note = document.querySelector('.wf-scenario-note');
  document.querySelectorAll<HTMLButtonElement>('.wf-scenario').forEach((button) => {
    button.addEventListener('click', () => {
      if (flow) flow.statusCodes = JSON.parse(button.dataset.codes || '{}');
      document.querySelectorAll('.wf-scenario').forEach((b) => b.classList.toggle('is-active', b === button));
      if (note) note.textContent = `${button.dataset.note} Press Run workflow.`;
    });
  });
</script>

<style>
  .wf-guide-main {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
    padding: 48px 24px 96px;
  }

  /* The hero's call-to-action buttons */
  .wf-cta-row {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  /* Sections */
  .rd-section {
    scroll-margin-top: 80px;
  }
  /* The lead paragraph sits directly above the section's content, without a header wrapper */
  .rd-section > .rd-section-desc {
    margin-bottom: 28px;
  }
  .sub-topic {
    margin-top: 36px;
    display: grid;
    gap: 14px;
  }
  .sub-topic h3 {
    font-size: 19px;
    font-weight: 600;
    color: var(--rd-text-primary);
    margin: 0;
  }
  .sub-topic p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--rd-text-muted);
    margin: 0;
  }
  code {
    font-size: 0.9em;
  }

  /* Before / after */
  .comparison-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }
  .comparison-card {
    padding: 24px;
    border-radius: var(--rd-radius-md);
    background: var(--rd-surface);
    border: 1px solid var(--rd-border);
    backdrop-filter: blur(8px);
  }
  .comparison-card.after {
    border-color: var(--rd-accent-border);
    background: color-mix(in srgb, var(--rd-accent) 3%, transparent);
  }
  .card-status-badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: var(--rd-radius-pill);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .badge-muted {
    background: color-mix(in srgb, var(--rd-text-muted) 15%, transparent);
    color: var(--rd-text-muted);
  }
  .badge-success {
    background: color-mix(in srgb, var(--rd-accent) 15%, transparent);
    color: var(--rd-accent-light);
  }
  .card-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--rd-text-bright);
    margin: 0 0 16px;
  }
  .comparison-list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 13px;
    line-height: 1.7;
    color: var(--rd-text-soft);
  }
  .comparison-list li {
    margin-bottom: 10px;
    padding-left: 20px;
    position: relative;
  }
  .comparison-card.before .comparison-list li::before {
    content: "–";
    position: absolute;
    left: 0;
    color: var(--rd-text-dim);
    font-weight: 700;
  }
  .comparison-card.after .comparison-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--rd-accent-light);
    font-weight: 700;
  }

  /* Live demo */
  .wf-scenarios {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 14px;
  }
  .wf-scenario {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 14px 16px;
    text-align: left;
    font: inherit;
    color: var(--rd-text-soft);
    background: var(--rd-surface);
    border: 1px solid var(--rd-border);
    border-radius: var(--rd-radius-md);
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .wf-scenario:hover {
    border-color: var(--rd-border-hover);
  }
  .wf-scenario.is-active {
    border-color: var(--rd-accent);
    background: color-mix(in srgb, var(--rd-accent) 6%, transparent);
  }
  .wf-scenario:focus-visible {
    outline: 2px solid var(--rd-accent);
    outline-offset: 2px;
  }
  .wf-scenario strong {
    display: block;
    color: var(--rd-text-bright);
    font-size: 14px;
  }
  .wf-scenario small {
    display: block;
    margin-top: 2px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--rd-text-muted);
  }
  .wf-scenario-code {
    flex-shrink: 0;
    padding: 2px 8px;
    border-radius: var(--rd-radius-sm);
    font-family: var(--rd-font-mono);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.6;
  }
  .wf-scenario-code.ok {
    background: color-mix(in srgb, var(--rd-green) 15%, transparent);
    color: var(--rd-green-light);
  }
  .wf-scenario-code.fail {
    background: color-mix(in srgb, var(--rd-red) 15%, transparent);
    color: var(--rd-red-light);
  }
  .wf-scenario-code.warn {
    background: color-mix(in srgb, var(--rd-amber) 15%, transparent);
    color: var(--rd-amber-light);
    white-space: nowrap;
  }
  .wf-scenario-note {
    margin: 14px 0 18px;
    font-size: 13px;
    color: var(--rd-text-muted);
  }
  .wf-scenario-note strong {
    color: var(--rd-accent-light);
  }
  .wf-demo {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    /* One row exactly the box's height: an auto row would grow to the content, and each pane's own
       scroll area with it, leaving the run panel below the clipped edge */
    grid-template-rows: minmax(0, 1fr);
    height: 760px;
    border: 1px solid var(--rd-border);
    border-radius: var(--rd-radius-lg);
    overflow: hidden;
    background: var(--rd-surface);
  }
  .wf-demo-flow {
    min-height: 0;
    padding: 0;
    overflow: auto;
    border-right: 1px solid var(--rd-border);
  }
  .wf-demo-doc {
    min-width: 0;
    height: 100%;
  }
  .wf-demo-caveat {
    margin: 12px 0 0;
    font-size: 12px;
    line-height: 1.6;
    color: var(--rd-text-dim);
  }
  @media (max-width: 860px) {
    .wf-demo {
      grid-template-columns: 1fr;
      grid-template-rows: auto 560px;
      height: auto;
    }
    .wf-demo-flow {
      border-right: 0;
      border-bottom: 1px solid var(--rd-border);
    }
  }

  /* What it draws */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 18px;
  }
  .feature-card {
    display: flex;
    gap: 14px;
    padding: 18px;
    background: var(--rd-surface);
    border: 1px solid var(--rd-border);
    border-radius: var(--rd-radius-md);
  }
  .feature-icon {
    width: 34px;
    height: 34px;
    border-radius: var(--rd-radius-md);
    background: color-mix(in srgb, var(--rd-accent) 15%, transparent);
    color: var(--rd-accent-light);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .feature-card h4 {
