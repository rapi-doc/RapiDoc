---
import GlobalLayout from '../layouts/GlobalLayout.astro';
import SiteNavbar from '../components/SiteNavbar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CodeBlock from '../components/CodeBlock.astro';
import { rapidocApiData, RapidocAttribute } from '../page-data/rapidoc-api';
import GithubSlugger from 'github-slugger';

const slugger = new GithubSlugger();

// Pre-calculate counts for stats banner
let totalAttributes = 0;
rapidocApiData.Attributes.forEach(group => {
  const [, items] = Object.entries(group)[0] as [string, RapidocAttribute[]];
  totalAttributes += items.filter(a => !a.hidden).length;
});
const totalMethods = rapidocApiData.Methods.items.length;
const totalEvents = rapidocApiData.Events.items.length;
const totalSlots = rapidocApiData.Slots.items.length;
const totalExtensions = rapidocApiData.Extensions.items.length;

const eventCodeExample = `// Intercept requests and add authentication or telemetry
const rapidocEl = document.getElementById('the-doc');

// Fires before the HTTP request is dispatched
rapidocEl.addEventListener('before-try', (e) => {
  if (e.detail.request.method === 'POST') {
    e.detail.request.headers.append('X-Tenant-ID', 'corp-acme-123');
  }
});

// Fires when API server selection changes
rapidocEl.addEventListener('api-server-change', (e) => {
  console.log('Selected target server:', e.detail.selectedServer);
});`;

const slotCodeExample = `<rapi-doc spec-url="https://petstore.swagger.io/v2/swagger.json">
  <!-- Default slot: Renders custom banner directly below top navigation -->
  <div class="custom-hero">
    <h1>Enterprise API Portal</h1>
  </div>

  <!-- Named slot: Custom logo inside the sidebar -->
  <img slot="nav-logo" src="/brand/logo.svg" alt="Company Logo" width="36" height="36" />

  <!-- Named slot: Custom notice above authentication panel -->
  <div slot="auth" class="auth-notice">
    <p>Please obtain API tokens from the Internal Developer Console.</p>
  </div>
</rapi-doc>`;

const methodCodeExample = `// Programmatically control RapiDoc from your web app
const rapidoc = document.getElementById('the-doc');

// Switch API server on runtime event
rapidoc.setApiServer('https://staging-api.example.com/v1');

// Programmatically scroll to and open a specific endpoint
rapidoc.scrollToPath('get-/users/{id}');

// Set credentials dynamically
rapidoc.setApiKey('api_key_header', 'sk_live_9482910481029');`;
---

<GlobalLayout>
  <!-- Ambient background glow elements inspired by Nuxt.com -->
  <div class="ambient-glow glow-emerald"></div>
  <div class="ambient-glow glow-indigo"></div>
  <div class="ambient-glow glow-cyan"></div>

  <!-- Reusable Frosted Glass Navigation -->
  <SiteNavbar activePage="api" />

  <main class="rd-api-main">
    <!-- Hero Header -->
    <header class="rd-api-header">
      <div class="rd-badge-pill">
        <span class="rd-badge-pulse"></span>
        <span class="rd-badge-text">Web Component API Reference</span>
      </div>

      <h1 class="rd-page-title">
        RapiDoc <span class="text-gradient">API Specification</span>
      </h1>

      <p class="rd-page-subtitle">
        Comprehensive reference for every HTML attribute, JavaScript DOM method, custom lifecycle event, slot placeholder, and vendor extension supported by <code>&lt;rapi-doc&gt;</code>.
      </p>

      <!-- Key Metrics Counter Bar -->
      <div class="rd-stats-bar">
        <a href="#attributes" class="rd-stat-card">
          <span class="rd-stat-value">{totalAttributes}</span>
          <span class="rd-stat-label">Attributes</span>
        </a>
        <a href="#methods" class="rd-stat-card">
          <span class="rd-stat-value">{totalMethods}</span>
          <span class="rd-stat-label">DOM Methods</span>
        </a>
        <a href="#events" class="rd-stat-card">
          <span class="rd-stat-value">{totalEvents}</span>
          <span class="rd-stat-label">Lifecycle Events</span>
        </a>
        <a href="#slots" class="rd-stat-card">
          <span class="rd-stat-value">{totalSlots}</span>
          <span class="rd-stat-label">HTML Slots</span>
        </a>
        <a href="#extensions" class="rd-stat-card">
          <span class="rd-stat-value">{totalExtensions}</span>
          <span class="rd-stat-label">Vendor Extensions</span>
        </a>
      </div>

      <!-- Live Search & Interactive Filter Bar -->
      <div class="rd-search-section">
        <div class="rd-search-wrapper">
          <svg class="rd-search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            id="api-search"
            type="text"
            placeholder="Search attributes, methods, events, or keywords (e.g. render-style, before-try, theme, oauth)..."
            autocomplete="off"
            class="rd-search-input"
          />
          <button id="clear-api-search" class="rd-clear-btn" aria-label="Clear search" style="display: none;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <!-- Section Navigation Pills -->
        <div class="rd-nav-pills">
          <a href="#attributes" class="rd-pill active" data-section="all">All Specs</a>
          <a href="#attributes" class="rd-pill" data-section="attributes">Attributes ({totalAttributes})</a>
          <a href="#methods" class="rd-pill" data-section="methods">Methods ({totalMethods})</a>
          <a href="#events" class="rd-pill" data-section="events">Events ({totalEvents})</a>
          <a href="#slots" class="rd-pill" data-section="slots">Slots ({totalSlots})</a>
          <a href="#extensions" class="rd-pill" data-section="extensions">Vendor Extensions ({totalExtensions})</a>
        </div>
      </div>
    </header>

    <!-- Empty Search State -->
    <div id="api-empty-state" class="rd-empty-state" style="display: none;">
      <div class="rd-empty-icon">🔍</div>
      <h3 class="rd-empty-title">No matching API items found <span id="empty-query-text" class="text-gradient"></span></h3>
      <p class="rd-empty-desc">Try searching for a different attribute, method, or keyword, or reset the filter.</p>
      <button id="reset-api-search-btn" class="rd-btn rd-btn-primary">Reset Search</button>
    </div>

    <!-- Main Content Container -->
    <div class="rd-api-content" id="api-content">
      
      <!-- ================= ATTRIBUTES SECTION ================= -->
      <section id="attributes" class="rd-api-section" data-section-type="attributes">
        <div class="rd-section-header">
          <div class="rd-section-badge">Config Options</div>
          <h2 class="rd-section-title">
            <a href="#attributes" class="rd-anchor-link">
              HTML Attributes
              <span class="rd-hash">#</span>
            </a>
          </h2>
          <p class="rd-section-desc">
            Declared directly on the <code>&lt;rapi-doc&gt;</code> web component element to customize styling, layout modes, feature visibility, routing, and authentication.
          </p>
        </div>

        {
          rapidocApiData.Attributes.map(attGroup => {
            const [attrGroupTitle, attrGroupItems] = Object.entries(attGroup)[0] as [string, RapidocAttribute[]];
            const attrGroupHref = slugger.slug(attrGroupTitle);
            const visibleItems = attrGroupItems.filter(attr => attr.hidden !== true);

            return (
              <div class="rd-group-container" id={attrGroupHref} data-group-name={attrGroupTitle.toLowerCase()}>
                <h3 class="rd-group-title">
                  <a href={`#${attrGroupHref}`} class="rd-anchor-link">
                    {attrGroupTitle}
                    <span class="rd-hash">#</span>
                  </a>
                  <span class="rd-group-count">{visibleItems.length}</span>
                </h3>

                <div class="rd-table-container">
                  <table class="rd-api-table">
                    <thead>
                      <tr>
                        <th class="col-name">Attribute Name</th>
                        <th class="col-desc">Description & Allowed Values</th>
                        <th class="col-default">Default</th>
                      </tr>
                    </thead>
                    <tbody>
                      {visibleItems.map(attr => (
                        <tr class="rd-api-row" id={attr.name} data-section="attributes" data-name={attr.name.toLowerCase()}>
                          <td class="col-name">
                            <div class="rd-name-cell">
                              <a href={`#${attr.name}`} class="rd-item-name-link" title="Copy direct link to this attribute">
                                <span class="rd-item-name">{attr.name}</span>
                                <span class="rd-item-hash">#</span>
                              </a>

                              {attr.example && (
                                <a href={attr.example} class="rd-example-badge" target="_blank" rel="noopener">
                                  <span>Live Demo</span>
                                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <path d="M7 17l9.2-9.2M17 17V8H8"/>
                                  </svg>
                                </a>
                              )}
                            </div>
                          </td>

                          <td class="col-desc">
                            {attr.allowed && (
                              <div class="rd-allowed-row">
                                <span class="rd-allowed-label">Allowed:</span>
                                <div class="rd-tags-list">
                                  {attr.allowed.map(val => (
                                    <code class="rd-val-tag">{val}</code>
                                  ))}
                                </div>
                              </div>
                            )}

                            <div class="rd-item-desc">
                              <Fragment set:html={attr.description} />
                            </div>

                            {attr.code && (
                              <div class="rd-card-code">
                                <pre><code class="language-html">{attr.code}</code></pre>
                              </div>
                            )}
                          </td>

                          <td class="col-default">
                            {attr.default ? (
                              <div class="rd-default-badge">
                                <Fragment set:html={attr.default} />
                              </div>
                            ) : (
                              <span class="rd-empty-val">—</span>
                            )}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            );
          })
        }
      </section>

      <!-- ================= METHODS SECTION ================= -->
      <section id="methods" class="rd-api-section" data-section-type="methods">
        <div class="rd-section-header">
          <div class="rd-section-badge">JavaScript API</div>
          <h2 class="rd-section-title">
            <a href="#methods" class="rd-anchor-link">
              DOM Methods
              <span class="rd-hash">#</span>
            </a>
          </h2>
          <p class="rd-section-desc">
            Methods accessible directly on the <code>&lt;rapi-doc&gt;</code> DOM element instance (e.g. <code>document.getElementById('doc').loadSpec(...)</code>) for seamless programmatic interaction.
          </p>
        </div>

        <div class="rd-feature-code-block">
          <CodeBlock code={methodCodeExample} lang="javascript" filename="Programmatic Control Example" />
        </div>

        <div class="rd-table-container">
          <table class="rd-api-table">
            <thead>
              <tr>
                <th class="col-name">Method Name</th>
                <th class="col-desc">Description & Usage</th>
              </tr>
            </thead>
            <tbody>
              {rapidocApiData.Methods.items.map(method => (
                <tr class="rd-api-row" id={method.name.replace(/[^a-zA-Z0-9_-]/g, '-')} data-section="methods" data-name={method.name.toLowerCase()}>
                  <td class="col-name">
                    <div class="rd-name-cell">
                      <a href={`#${method.name.replace(/[^a-zA-Z0-9_-]/g, '-')}`} class="rd-item-name-link">
                        <span class="rd-item-name rd-method-name">{method.name}</span>
                        <span class="rd-item-hash">#</span>
                      </a>

                      {method.example && (
                        <a href={method.example} class="rd-example-badge" target="_blank" rel="noopener">
                          <span>Example Code</span>
                          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path d="M7 17l9.2-9.2M17 17V8H8"/>
                          </svg>
                        </a>
                      )}
                    </div>
                  </td>

                  <td class="col-desc">
                    <div class="rd-item-desc">
                      <Fragment set:html={method.description} />
                    </div>

                    {method.code && (
                      <div class="rd-card-code">
                        <pre><code class="language-html">{method.code}</code></pre>
                      </div>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- ================= EVENTS SECTION ================= -->
      <section id="events" class="rd-api-section" data-section-type="events">
        <div class="rd-section-header">
          <div class="rd-section-badge">Runtime Hooks</div>
          <h2 class="rd-section-title">
            <a href="#events" class="rd-anchor-link">
              Lifecycle & Console Events
              <span class="rd-hash">#</span>
            </a>
          </h2>
          <p class="rd-section-desc">
            Standard CustomEvents dispatched by <code>&lt;rapi-doc&gt;</code> that allow you to intercept request pipelines, inject authorization headers, capture metrics, and respond to UI state changes.
          </p>
        </div>

        <div class="rd-feature-code-block">
          <CodeBlock code={eventCodeExample} lang="javascript" filename="Event Interceptor Example" />
        </div>

        <div class="rd-table-container">
          <table class="rd-api-table">
            <thead>
              <tr>
                <th class="col-name">Event Name</th>
                <th class="col-desc">Description & Payload</th>
              </tr>
            </thead>
            <tbody>
              {rapidocApiData.Events.items.map(ev => (
                <tr class="rd-api-row" id={ev.name} data-section="events" data-name={ev.name.toLowerCase()}>
                  <td class="col-name">
                    <div class="rd-name-cell">
                      <a href={`#${ev.name}`} class="rd-item-name-link">
                        <span class="rd-item-name rd-event-name">{ev.name}</span>
                        <span class="rd-item-hash">#</span>
                      </a>
                    </div>
                  </td>

                  <td class="col-desc">
                    <div class="rd-item-desc">
                      <Fragment set:html={ev.description} />
                    </div>

                    {ev.code && (
                      <div class="rd-card-code">
                        <pre><code class="language-html">{ev.code}</code></pre>
                      </div>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- ================= SLOTS SECTION ================= -->
      <section id="slots" class="rd-api-section" data-section-type="slots">
        <div class="rd-section-header">
          <div class="rd-section-badge">Component Slots</div>
          <h2 class="rd-section-title">
            <a href="#slots" class="rd-anchor-link">
              HTML Template Slots
              <span class="rd-hash">#</span>
            </a>
          </h2>
          <p class="rd-section-desc">
            Standard Web Component slots that enable embedding your custom HTML, logos, corporate banners, and notices directly at specific locations within the RapiDoc UI canvas.
          </p>
        </div>

        <div class="rd-feature-code-block">
          <CodeBlock code={slotCodeExample} lang="html" filename="Slot Injection Example" />
        </div>

        <div class="rd-table-container">
          <table class="rd-api-table">
            <thead>
              <tr>
                <th class="col-name">Slot Name</th>
                <th class="col-desc">Placement & Description</th>
              </tr>
            </thead>
            <tbody>
              {rapidocApiData.Slots.items.map(slot => (
                <tr class="rd-api-row" id={`slot-${slot.name.replace(/[^a-zA-Z0-9_-]/g, '-')}`} data-section="slots" data-name={slot.name.toLowerCase()}>
                  <td class="col-name">
                    <div class="rd-name-cell">
                      <a href={`#slot-${slot.name.replace(/[^a-zA-Z0-9_-]/g, '-')}`} class="rd-item-name-link">
                        <span class="rd-item-name rd-slot-name">{slot.name}</span>
                        <span class="rd-item-hash">#</span>
                      </a>

                      {slot.example && (
                        <a href={slot.example} class="rd-example-badge" target="_blank" rel="noopener">
                          <span>Example</span>
                          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path d="M7 17l9.2-9.2M17 17V8H8"/>
                          </svg>
                        </a>
                      )}
                    </div>
                  </td>

                  <td class="col-desc">
                    <div class="rd-item-desc">
                      <Fragment set:html={slot.description} />
                    </div>

                    {slot.code && (
                      <div class="rd-card-code">
                        <pre><code class="language-html">{slot.code}</code></pre>
                      </div>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- ================= VENDOR EXTENSIONS SECTION ================= -->
      <section id="extensions" class="rd-api-section" data-section-type="extensions">
        <div class="rd-section-header">
          <div class="rd-section-badge">OpenAPI Spec Extensions</div>
          <h2 class="rd-section-title">
            <a href="#extensions" class="rd-anchor-link">
              Supported Vendor Extensions (<code>x-*</code>)
              <span class="rd-hash">#</span>
            </a>
          </h2>
          <p class="rd-section-desc">
            OpenAPI vendor extension properties (<code>x-code-sample</code>, <code>x-badges</code>, <code>x-client-id</code>, etc.) that you can place in your OpenAPI YAML/JSON to enrich documentation views.
          </p>
        </div>

        <div class="rd-table-container">
          <table class="rd-api-table">
            <thead>
              <tr>
                <th class="col-name">Extension Name</th>
                <th class="col-desc">Description & Allowed Values</th>
              </tr>
            </thead>
            <tbody>
              {rapidocApiData.Extensions.items.map(ext => (
                <tr class="rd-api-row" id={ext.name} data-section="extensions" data-name={ext.name.toLowerCase()}>
                  <td class="col-name">
                    <div class="rd-name-cell">
                      <a href={`#${ext.name}`} class="rd-item-name-link">
                        <span class="rd-item-name rd-ext-name">{ext.name}</span>
                        <span class="rd-item-hash">#</span>
                      </a>
                    </div>
                  </td>

                  <td class="col-desc">
                    {ext.allowed && (
                      <div class="rd-allowed-row">
                        <span class="rd-allowed-label">Allowed:</span>
                        <div class="rd-tags-list">
                          {ext.allowed.map(val => (
                            <code class="rd-val-tag">{val}</code>
                          ))}
                        </div>
                      </div>
                    )}

                    {ext.description && (
                      <div class="rd-item-desc">
                        <Fragment set:html={ext.description} />
                      </div>
                    )}

                    {ext.code && (
                      <div class="rd-card-code">
                        <pre><code class="language-html">{ext.code}</code></pre>
                      </div>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

    </div>
  </main>

  <!-- Reusable Modern Footer -->
  <SiteFooter />

  <!-- Client-side Interactive Search & Category Filter Script -->
  <script>
    function setupApiSearch() {
      const searchInput = document.getElementById('api-search') as HTMLInputElement | null;
      const clearBtn = document.getElementById('clear-api-search') as HTMLButtonElement | null;
      const emptyState = document.getElementById('api-empty-state') as HTMLElement | null;
      const emptyQueryText = document.getElementById('empty-query-text') as HTMLElement | null;
      const resetBtn = document.getElementById('reset-api-search-btn') as HTMLButtonElement | null;
      const filterPills = document.querySelectorAll('.rd-nav-pills .rd-pill') as NodeListOf<HTMLAnchorElement>;
      const apiRows = document.querySelectorAll('.rd-api-row') as NodeListOf<HTMLElement>;
      const apiSections = document.querySelectorAll('.rd-api-section') as NodeListOf<HTMLElement>;
      const groupContainers = document.querySelectorAll('.rd-group-container') as NodeListOf<HTMLElement>;

      if (!searchInput || apiRows.length === 0) return;

      let activeSectionFilter = 'all';

      function filterApi() {
        const rawQuery = (searchInput ? searchInput.value : '') || '';
        const trimmedQuery = rawQuery.trim().toLowerCase();
        const searchTerms = trimmedQuery ? trimmedQuery.split(/\s+/).filter(Boolean) : [];
        let visibleCount = 0;

        // Toggle clear button
        if (clearBtn) {
          clearBtn.style.display = trimmedQuery.length > 0 ? 'flex' : 'none';
        }

        // Filter individual rows
        apiRows.forEach(row => {
          const rowSection = row.dataset.section || '';
          const matchesSection = activeSectionFilter === 'all' || rowSection === activeSectionFilter;

          // Search across entire visible row content (name, description, allowed values, default)
          const rowText = (row.textContent || '').toLowerCase();
          const matchesQuery = searchTerms.length === 0 || searchTerms.every(term => rowText.includes(term));

          if (matchesSection && matchesQuery) {
            row.style.display = '';
            visibleCount++;
          } else {
            row.style.display = 'none';
          }
        });

        // Hide empty group containers (e.g. Attribute categories)
        groupContainers.forEach(group => {
          const rows = group.querySelectorAll<HTMLElement>('.rd-api-row');
          const hasVisibleRow = Array.from(rows).some(r => r.style.display !== 'none');
          group.style.display = hasVisibleRow ? '' : 'none';
        });

        // Hide empty sections or sections filtered out by pill
        apiSections.forEach(section => {
          const sectionType = section.dataset.sectionType || '';
          const sectionMatches = activeSectionFilter === 'all' || activeSectionFilter === sectionType;
          const rows = section.querySelectorAll<HTMLElement>('.rd-api-row');
          const hasVisibleRow = Array.from(rows).some(r => r.style.display !== 'none');

          section.style.display = (sectionMatches && hasVisibleRow) ? '' : 'none';
        });

        // Toggle empty state
        if (emptyState) {
          emptyState.style.display = visibleCount === 0 ? 'flex' : 'none';
          if (emptyQueryText) {
            emptyQueryText.textContent = trimmedQuery ? `for "${trimmedQuery}"` : '';
          }
        }
      }

      // Live search input events
      searchInput.addEventListener('input', filterApi);
      searchInput.addEventListener('search', filterApi);
      searchInput.addEventListener('keyup', (e) => {
        if (e.key === 'Escape') {
          searchInput.value = '';
          filterApi();
          searchInput.blur();
        }
      });

      // Keyboard shortcut "/" to focus search
      window.addEventListener('keydown', (e) => {
        if (
          e.key === '/' &&
          document.activeElement !== searchInput &&
          !(document.activeElement instanceof HTMLInputElement) &&
          !(document.activeElement instanceof HTMLTextAreaElement)
        ) {
          e.preventDefault();
          searchInput.focus();
          searchInput.select();
        }
      });

      // Clear button
      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          searchInput.value = '';
          filterApi();
          searchInput.focus();
        });
      }

      // Reset button in empty state
      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          searchInput.value = '';
          activeSectionFilter = 'all';
          filterPills.forEach(p => p.classList.remove('active'));
          const allPill = document.querySelector('.rd-pill[data-section="all"]');
          if (allPill) allPill.classList.add('active');
          filterApi();
          searchInput.focus();
        });
      }

      // Category filter pills
      filterPills.forEach(pill => {
        pill.addEventListener('click', (e) => {
          const section = pill.dataset.section;
          if (!section) return; // Allow normal link to classic view
          e.preventDefault();

          filterPills.forEach(p => p.classList.remove('active'));
          pill.classList.add('active');
          activeSectionFilter = section;
          filterApi();

          if (section !== 'all') {
            const targetSec = document.getElementById(section);
            if (targetSec && targetSec.style.display !== 'none') {
              targetSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }
        });
      });

      // Smooth scroll and copy link on anchor click
      document.querySelectorAll('.rd-anchor-link, .rd-item-name-link').forEach(link => {
        link.addEventListener('click', (e) => {
          const href = (link as HTMLAnchorElement).getAttribute('href');
          if (href && href.startsWith('#')) {
            const target = document.querySelector(href);
            if (target) {
              target.scrollIntoView({ behavior: 'smooth' });
              try {
                navigator.clipboard.writeText(window.location.origin + window.location.pathname + href);
              } catch (err) {}
            }
          }
        });
      });

