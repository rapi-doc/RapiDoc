---
import ExampleLayout from '../../layouts/ExampleLayout.astro';

// Shares the spec of /tests/override-descriptions-in-refs; there is no /specs/ copy.
const specUrl = '/specs-test/override-descriptions-in-refs.yaml';
---

<ExampleLayout>
  <rapi-doc 
    id = "thedoc"
    spec-url = {specUrl}
    show-info = "false"
    show-header = "false"
    allow-server-selection = "false"
    allow-authentication = "false" 
    allow-try = "false" 
    render-style = "read"
  > </rapi-doc>
</ExampleLayout>
