---
import ExampleLayout from '../../layouts/ExampleLayout.astro';
---

<ExampleLayout
  autoRenderRapiDoc={true}
  controller="pretty"
  specUrl="/specs/bookstore.yaml"
  controls={['use-path-in-nav-bar', 'show-method-in-nav-bar', 'nav-active-item-marker', 'nav-item-spacing']}
  rapidocProps={{
    'show-info': 'false',
    'show-header': 'false',
    'allow-authentication': 'false',
    'allow-server-selection': 'false',
    'render-style': 'focused',
    'allow-try': 'false',
    'show-method-in-nav-bar': 'as-colored-block',
  }}
/>
