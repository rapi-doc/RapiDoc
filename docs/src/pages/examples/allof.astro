---
import ExampleLayout from '../../layouts/ExampleLayout.astro';
import { getSpecUrl } from '../../utils/getSpecUrl';

const specUrl = getSpecUrl(Astro.url);
---

<ExampleLayout
  title="Example | Schema Composition - all-of"
  description="Demonstrates Schema Composition using All-Of in RapiDoc"
  autoRenderRapiDoc={true}
  controller="pretty"
  preset={['schema']}
  rapidocProps={{
    'spec-url': specUrl,
    'show-header': 'false',
    'show-info': 'false',
    'allow-server-selection': 'false',
    'allow-authentication': 'false',
    'default-schema-tab': 'schema',
    'render-style': 'read',
  }}
/>
