---
import ExampleLayout from '../../layouts/ExampleLayout.astro';
import { getSpecUrl } from '../../utils/getSpecUrl';

const specUrl = getSpecUrl(Astro.url);
---

<ExampleLayout
  title="Example | End-Point Badges"
  description="Demonstrates endpoint badges and filtering using x-badges in RapiDoc"
  autoRenderRapiDoc={true}
  showController={false}
  rapidocProps={{
    'spec-url': specUrl,
    'show-header': 'false',
    'show-info': 'true',
    'allow-server-selection': 'false',
    'allow-authentication': 'false',
    theme: 'dark',
    'render-style': 'read',
  }}
/>
