---
import ExampleLayout from '../../layouts/ExampleLayout.astro';
---

<ExampleLayout
  specUrl="/specs/petstore.yaml"
  autoRenderRapiDoc={true}
  preset={['all']}
  rapidocProps={{
    'render-style': 'read',
    'schema-style': 'table',
    'color-scheme': 'dark',
    'show-info': 'true',
    'show-header': 'false',
    'allow-try': 'true',
    theme: 'jade',
  }}
/>
