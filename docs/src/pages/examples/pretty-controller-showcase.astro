---
import ExampleLayout from '../../layouts/ExampleLayout.astro';
---

<ExampleLayout
  title="Pretty Controller Showcase | RapiDoc"
  description="Demonstrates using the drawer-style PrettyRapiDocController"
  specUrl="/specs/petstore.yaml"
  autoRenderRapiDoc={true}
  controller="pretty"
  preset="schema"
  rapidocProps={{
    'render-style': 'read',
    'schema-style': 'table',
    theme: 'dark',
    'show-info': 'true',
    'show-header': 'false',
    'allow-try': 'true',
    'primary-color': '#10b981',
  }}
/>
