---
import GlobalLayout from '../../layouts/GlobalLayout.astro';
---

<GlobalLayout
  title="High-Contrast Light Theme Showcase | RapiDoc"
  description="High-contrast light theme preset showcase for RapiDoc OpenAPI documentation."
>
  <script slot="script" is:inline type="module" src="/rapidoc/rapidoc-min.js"></script>
  <div class="glow-container">
    <div class="radial-glow glow-orange"></div>
    <div class="radial-glow glow-amber"></div>
  </div>

  <div class="theme-toolbar">
    <div class="toolbar-left">
      <span class="theme-badge light">HIGH-CONTRAST LIGHT THEME</span>
    </div>
    <div class="toolbar-right">
      <a
        href="/examples/theme-dark-contrast"
        class="theme-icon-btn"
        title="Switch to Dark Theme"
        aria-label="Switch to Dark Theme"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </a>
      <a href="/" class="theme-home-btn">Back to Home</a>
    </div>
  </div>

  <div class="doc-frame">
    <rapi-doc
      id="thedoc"
      spec-url="/specs/petstore.yaml"
      theme="light"
      render-style="read"
      schema-style="tree"
      show-header="false"
      show-info="true"
      show-components="false"
      allow-server-selection="true"
      allow-authentication="true"
      use-path-in-nav-bar="true"
      show-method-in-nav-bar="as-colored-text"
      primary-color="#ea580c"
      bg-color="#ffffff"
      text-color="#0f172a"
      nav-bg-color="#f8fafc"
      nav-text-color="#475569"
      nav-hover-bg-color="#f1f5f9"
      nav-hover-text-color="#0f172a"
      nav-accent-color="#ff7043"
    >
    </rapi-doc>
  </div>
</GlobalLayout>

<script is:inline>
  // Wait for RapiDoc web component to load and expand the pet endpoint
  window.addEventListener('DOMContentLoaded', () => {
    function expandEndpoint() {
      const doc = document.getElementById('thedoc');
      if (doc && doc.shadowRoot) {
        // Expand the first endpoint automatically so request and response are visible
        const ep = doc.shadowRoot.querySelector('.m-endpoint');
        if (ep && !ep.classList.contains('expanded')) {
          ep.click();
        }
      }
    }
    setTimeout(expandEndpoint, 1000);
    setTimeout(expandEndpoint, 2500);
  });
</script>

<style>
  :root {
    --page-bg: #f8fafc;
  }
  body {
    background: var(--page-bg) !important;
    color: #0f172a !important;
    margin: 0;
    padding: 0;
    overflow-x: hidden;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  /* Subtle background radial glows in warm RapiDoc orange tones */
  .glow-container {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }
  .radial-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(140px);
    opacity: 0.12;
  }
  .glow-orange {
    top: -100px;
    right: 15%;
    width: 550px;
    height: 550px;
    background: radial-gradient(circle, #ff7043 0%, transparent 70%);
  }
  .glow-amber {
    bottom: 50px;
    left: 10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, #f59e0b 0%, transparent 70%);
  }

  /* Top toolbar */
  .theme-toolbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid #e2e8f0;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }
  .toolbar-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .theme-badge {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 4px 10px;
    border-radius: 6px;
  }
  .theme-badge.light {
    background: rgba(255, 112, 67, 0.12);
    color: #ea580c;
    border: 1px solid rgba(255, 112, 67, 0.35);
  }
  .theme-hint {
    font-size: 12.5px;
    color: #64748b;
  }
  .toolbar-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .theme-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    border: 1px solid #cbd5e1;
    background: transparent;
    color: #64748b;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .theme-icon-btn:hover {
    color: #ea580c;
    border-color: rgba(255, 112, 67, 0.5);
    background: rgba(255, 112, 67, 0.1);
    box-shadow: 0 0 10px rgba(255, 112, 67, 0.18);
  }
  .theme-home-btn {
    color: #64748b;
    font-size: 12.5px;
    text-decoration: none;
  }
  .theme-home-btn:hover {
    color: #0f172a;
  }

  /* RapiDoc Document Frame */
  .doc-frame {
    position: relative;
    z-index: 1;
    width: 100%;
    height: calc(100vh - 58px);
  }
  rapi-doc {
    width: 100%;
    height: 100%;

    /* High contrast light custom CSS properties */
    --bg: #ffffff;
    --bg2: #f8fafc;
    --bg3: #f1f5f9;
    --fg: #0f172a;
    --fg2: #1e293b;
    --fg3: #334155;
    --light-fg: #64748b;
    --border-color: #cbd5e1;
    --light-border-color: #e2e8f0;
    --code-bg: #f8fafc;
    --code-fg: #0f172a;
    --input-bg: #ffffff;
    --primary-color: #ea580c;
    --primary-color-invert: #ffffff;
    --blue: #0284c7;
    --green: #059669;
    --orange: #ff7043;
    --red: #dc2626;
  }

  /* ==========================================================================
     CSS Shadow Parts (::part) Styling - Vertical Border Glow & Ambient Aura
     ========================================================================== */

  /*
   * Left-nav (Sidebar) with vertical neon border line.
   * Fades to transparent at top and bottom ends and glows in the middle.
   */
  rapi-doc::part(section-navbar) {
    background-color: #f8fafc;
    border-right: 1px solid transparent;
    border-image: linear-gradient(
        to bottom,
        transparent 0%,
        rgba(255, 112, 67, 0.05) 15%,
        rgba(255, 112, 67, 0.55) 35%,
        #ff7043 50%,
        rgba(255, 112, 67, 0.55) 65%,
        rgba(255, 112, 67, 0.05) 85%,
        transparent 100%
      )
      1;
    position: relative;
    z-index: 10;
  }

  /*
   * Main Content Canvas with subtle vertical edge aura and top-right gradient.
   * Tight spread along the border, never overwhelming the text.
   */
  rapi-doc::part(section-main-content) {
    background-color: #ffffff;
    background-image:
      /* Faint warm gradient aura at top-right corner */
      radial-gradient(ellipse 200px 220px at 100% 0%, rgba(255, 112, 67, 0.12) 0%, rgba(245, 158, 11, 0.05) 45%, transparent 75%),
      /* Delicate edge aura hugging the boundary (x=0) without washing over the content */
      radial-gradient(ellipse 50px 35% at 0% 50%, rgba(255, 112, 67, 0.05) 0%, rgba(255, 112, 67, 0.02) 55%, transparent 100%),
      radial-gradient(ellipse 30px 20% at 0% 50%, rgba(255, 138, 101, 0.08) 0%, transparent 100%),
      /* Faint ambient glow in bottom area */ radial-gradient(ellipse 50% 40% at 75% 85%, rgba(245, 158, 11, 0.02) 0%, transparent 60%);
    background-attachment: scroll, scroll, scroll, scroll;
  }

  rapi-doc::part(section-navbar-search) {
    background: rgba(248, 250, 252, 0.85) !important;
    backdrop-filter: blur(12px) saturate(180%) !important;
    -webkit-backdrop-filter: blur(12px) saturate(180%) !important;
    border-bottom: 1px solid rgba(226, 232, 240, 0.8);
    box-shadow: 0 4px 16px -2px rgba(15, 23, 42, 0.06);
  }

  rapi-doc::part(textbox-nav-filter) {
    background: #ffffff !important;
    border: 1px solid #cbd5e1 !important;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #0f172a !important;
    transition: all 0.2s ease;
  }

  rapi-doc::part(textbox-nav-filter):focus {
    border-color: #ff7043 !important;
    box-shadow: 0 0 10px rgba(255, 112, 67, 0.25);
    background: #ffffff !important;
  }

  rapi-doc::part(btn-search) {
    border: 1px solid rgba(255, 112, 67, 0.3);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: all 0.2s ease;
  }

  rapi-doc::part(btn-search):hover {
    background: rgba(255, 112, 67, 0.2);
    border-color: #ea580c;
    color: #c2410c;
    box-shadow: 0 0 10px rgba(255, 112, 67, 0.2);
  }

  /*
   * Tag section header in Read Mode:
   * Top border that fades to transparent at left and right edges and peaks brightly at the center.
   */
  rapi-doc::part(section-tag) {
    border-top: 1px solid transparent !important;
    border-image: linear-gradient(
        to right,
        transparent 0%,
        rgba(255, 112, 67, 0.08) 15%,
        rgba(255, 112, 67, 0.65) 35%,
        #ff7043 50%,
        rgba(255, 112, 67, 0.65) 65%,
        rgba(255, 112, 67, 0.08) 85%,
        transparent 100%
      )
      1 !important;
  }
</style>
