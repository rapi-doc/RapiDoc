---
import GlobalLayout from '../../layouts/GlobalLayout.astro';
---

<GlobalLayout 
  title="High-Contrast Light Theme Showcase | RapiDoc"
  description="High-contrast light theme preset showcase for RapiDoc OpenAPI documentation."
>
  <div class="glow-container">
    <div class="radial-glow glow-emerald"></div>
    <div class="radial-glow glow-blue"></div>
  </div>

  <div class="theme-toolbar">
    <div class="toolbar-left">
      <span class="theme-badge light">HIGH-CONTRAST LIGHT THEME</span>
      <span class="theme-hint">Ready for high-res screenshot (1600x900 or 1440x900 recommended)</span>
    </div>
    <div class="toolbar-right">
      <a href="/examples/theme-dark-contrast" class="theme-switch-btn">← Switch to Dark Theme</a>
      <a href="/" class="theme-home-btn">Back to Home</a>
    </div>
  </div>

  <div class="doc-frame">
    <rapi-doc
      id="thedoc"
      spec-url="/specs/petstore.yaml"
      theme="light"
      render-style="view"
      schema-style="tree"
      show-header="false"
      show-info="false"
      show-components="false"
      allow-server-selection="false"
      allow-authentication="false"
      primary-color="#059669"
      bg-color="#ffffff"
      text-color="#0f172a"
      nav-bg-color="#f8fafc"
      nav-text-color="#475569"
      nav-hover-bg-color="#f1f5f9"
      nav-hover-text-color="#0f172a"
      nav-accent-color="#059669"
    >
    </rapi-doc>
  </div>
</GlobalLayout>

<script is:inline>
  // Wait for RapiDoc web component to load and expand the pet endpoint
  window.addEventListener('DOMContentLoaded', () => {
    function expandEndpoint() {
      const doc = document.getElementById('thedoc');
      if (doc && doc.shadowRoot) {
        // Expand the first endpoint automatically so request and response are visible
        const ep = doc.shadowRoot.querySelector('.m-endpoint');
        if (ep && !ep.classList.contains('expanded')) {
          ep.click();
        }
      }
    }
    setTimeout(expandEndpoint, 1000);
    setTimeout(expandEndpoint, 2500);
  });
</script>

<style>
:root {
  --page-bg: #f8fafc;
}
body {
  background: var(--page-bg) !important;
  color: #0f172a !important;
  margin: 0;
  padding: 0;
  overflow-x: hidden;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

/* Subtle radial glows */
.glow-container {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}
.radial-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(140px);
  opacity: 0.12;
}
.glow-emerald {
  top: -100px;
  right: 15%;
  width: 550px;
  height: 550px;
  background: radial-gradient(circle, #34d399 0%, transparent 70%);
}
.glow-blue {
  bottom: 50px;
  left: 10%;
  width: 600px;
  height: 600px;
  background: radial-gradient(circle, #38bdf8 0%, transparent 70%);
}

/* Top toolbar */
.theme-toolbar {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid #e2e8f0;
  padding: 12px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
}
.toolbar-left {
  display: flex;
  align-items: center;
  gap: 12px;
}
.theme-badge {
  font-size: 11.5px;
  font-weight: 700;
  letter-spacing: 0.05em;
  padding: 4px 10px;
  border-radius: 6px;
}
.theme-badge.light {
  background: rgba(5, 150, 105, 0.1);
  color: #059669;
  border: 1px solid rgba(5, 150, 105, 0.25);
}
.theme-hint {
  font-size: 12.5px;
  color: #64748b;
}
.toolbar-right {
  display: flex;
  align-items: center;
  gap: 12px;
}
.theme-switch-btn {
  background: #0f172a;
  color: #ffffff;
  font-weight: 700;
  font-size: 12.5px;
  padding: 6px 14px;
  border-radius: 6px;
  text-decoration: none;
  transition: all 0.2s ease;
}
.theme-switch-btn:hover {
  background: #1e293b;
}
.theme-home-btn {
  color: #64748b;
  font-size: 12.5px;
  text-decoration: none;
}
.theme-home-btn:hover {
  color: #0f172a;
}

/* RapiDoc Document Frame */
.doc-frame {
  position: relative;
  z-index: 1;
  width: 100%;
  height: calc(100vh - 58px);
}
rapi-doc {
  width: 100%;
  height: 100%;

  /* High contrast light custom CSS properties */
  --bg: #ffffff;
  --bg2: #f8fafc;
  --bg3: #f1f5f9;
  --fg: #0f172a;
  --fg2: #1e293b;
  --fg3: #334155;
  --light-fg: #64748b;
  --border-color: #cbd5e1;
  --light-border-color: #e2e8f0;
  --code-bg: #f8fafc;
  --code-fg: #0f172a;
  --input-bg: #ffffff;
  --primary-color: #059669;
  --blue: #0284c7;
  --green: #059669;
  --orange: #d97706;
  --red: #dc2626;
}
</style>
