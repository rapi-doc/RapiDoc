---
import ExampleLayout from '../../layouts/ExampleLayout.astro';
---

<ExampleLayout
  title="Arazzo workflow across several APIs"
  description="One Arazzo workflow using three different OpenAPI specs: rapi-flow draws Rapid Parcels' ship-a-parcel workflow, pairs each spec with its own rapi-doc-mini, and runs it against the in-browser mock."
>
  <script>
    import 'rapidoc/flow';
  </script>

  <div class="flow-example">
    <div class="flow-pane">
      <!-- for: one element per API of the Arazzo file; each is paired by its arazzo-source -->
      <rapi-flow
        arazzo-url="/specs/rapid-parcels/workflows/ship-a-parcel.arazzo.yaml"
        for="rates-api shipments-api tracking-api"
        update-route="true"
        mcp="true"
      >
        <div slot="header">
          <div class="brand">
            <img src="/assets/images/rapid-parcels-logo-dark.svg" alt="" width="40" height="35" />
            Rapid Parcels
          </div>
          <p class="note">
            This example demonstrates one Arazzo workflow using three different OpenAPI specs: to
            ship a parcel, it gets a
            quote from <code>rates.yaml</code>, a shipment and its label from
            <code>shipments.yaml</code>, and a tracking subscription from <code>tracking.yaml</code>.
            Each step's outputs feed the next, from one spec to another.
          </p>
          <p class="note">
            On the right, each spec has its own <code>&lt;rapi-doc-mini&gt;</code>, showing only the
            operations the workflow calls in it. Click a step to open its operation there, or run the
            workflow: RapiDoc's in-browser mock answers every request from the specs' examples and
            schemas, so nothing leaves the page.
          </p>
        </div>
      </rapi-flow>
    </div>

    <!-- One <rapi-doc-mini> per API. <rapi-flow> sets each one's filter-operations to the
         workflow's calls to that API. mock-server-status-code="": each operation answers with its
         first 2xx response (Rapid Parcels returns 201 on create), not the default 200. -->
    <div class="mini-pane">
      <section>
        <h2>rates - <code>../specs/rates.yaml</code></h2>
        <rapi-doc-mini
          id="rates-api"
          arazzo-source="rates"
          spec-url="/specs/rapid-parcels/specs/rates.yaml"
          mock-server="true"
          mock-server-status-code=""
        ></rapi-doc-mini>
      </section>
      <section>
        <h2>shipments - <code>../specs/shipments.yaml</code></h2>
        <rapi-doc-mini
          id="shipments-api"
          arazzo-source="shipments"
          spec-url="/specs/rapid-parcels/specs/shipments.yaml"
          mock-server="true"
          mock-server-status-code=""
        ></rapi-doc-mini>
      </section>
      <section>
        <h2>tracking - <code>../specs/tracking.yaml</code></h2>
        <rapi-doc-mini
          id="tracking-api"
          arazzo-source="tracking"
          spec-url="/specs/rapid-parcels/specs/tracking.yaml"
          mock-server="true"
          mock-server-status-code=""
        ></rapi-doc-mini>
      </section>
    </div>
  </div>
</ExampleLayout>

<style>
  /* Two panes: <rapi-flow> on the left, the minis on the right */
  .flow-example {
    display: flex;
    gap: 16px;
    height: 100vh;
    background: rgb(31, 31, 35);
  }
  .flow-pane {
    width: clamp(30rem, 45%, 56rem);
    overflow: auto;
    border-right: 1px solid var(--rd-border-hover);
  }
  .mini-pane {
    flex: 1;
    min-width: 0;
    overflow: auto;
    padding: 12px 20px 24px 4px;
  }

  /* The header slot */
  .brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 1.125rem;
    font-weight: 600;
    color: #f4f4f5;
  }
  .note {
    margin: 12px 0 0;
    font-size: 0.8125rem;
    color: #a1a1aa;
  }
  .note:last-child {
    margin-bottom: 16px;
  }
  .note code {
    color: #e4e4e7;
  }

  /* Each mini in a box, under its API's name and spec path */
  section {
    margin-bottom: 20px;
    border: 1px solid var(--rd-border-hover);
    border-radius: var(--rd-radius-sm);
    overflow: hidden;
  }
  h2 {
    margin: 0;
    padding: 10px 16px;
    background: rgb(24, 24, 27);
    border-bottom: 1px solid var(--rd-border-hover);
    font-size: 0.8125rem;
    text-transform: uppercase;
    color: #a1a1aa;
  }
  h2 code {
    text-transform: none;
    color: #71717a;
  }

  @media (max-width: 900px) {
    .flow-example {
      flex-direction: column;
      height: auto;
    }
    .flow-pane {
      width: auto;
    }
    .mini-pane {
      height: 100vh;
    }
  }
</style>
