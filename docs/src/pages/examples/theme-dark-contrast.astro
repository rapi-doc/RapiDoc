---
import GlobalLayout from '../../layouts/GlobalLayout.astro';
---

<GlobalLayout
  title="High-Contrast Dark Theme Showcase | RapiDoc"
  description="High-contrast dark theme preset showcase for RapiDoc OpenAPI documentation."
>
  <script slot="script" is:inline type="module" src="/rapidoc/rapidoc-min.js"></script>
  <div class="glow-container">
    <div class="radial-glow glow-orange"></div>
    <div class="radial-glow glow-amber"></div>
  </div>

  <div class="theme-toolbar">
    <div class="toolbar-left">
      <span class="theme-badge dark">HIGH-CONTRAST DARK THEME</span>
    </div>
    <div class="toolbar-right">
      <a
        href="/examples/theme-light-contrast"
        class="theme-icon-btn"
        title="Switch to Light Theme"
        aria-label="Switch to Light Theme"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
      </a>
      <a href="/" class="theme-home-btn">← Back to Home</a>
    </div>
  </div>

  <div class="doc-frame">
    <rapi-doc
      id="thedoc"
      spec-url="/specs/petstore.yaml"
      theme="dark"
      render-style="read"
      schema-style="tree"
      show-header="false"
      show-info="true"
      show-components="false"
      allow-server-selection="true"
      allow-authentication="true"
      use-path-in-nav-bar="true"
      show-method-in-nav-bar="as-colored-text"
      primary-color="#ff7043"
      bg-color="#0b0f19"
      text-color="#f8fafc"
    >
    </rapi-doc>
  </div>
</GlobalLayout>

<script is:inline>
  // Wait for RapiDoc web component to load and expand the pet endpoint
  window.addEventListener('DOMContentLoaded', () => {
    function expandEndpoint() {
      const doc = document.getElementById('thedoc');
      if (doc && doc.shadowRoot) {
        // Expand the first endpoint automatically so request and response are visible
        const ep = doc.shadowRoot.querySelector('.m-endpoint');
        if (ep && !ep.classList.contains('expanded')) {
          ep.click();
        }
      }
    }
    setTimeout(expandEndpoint, 1000);
    setTimeout(expandEndpoint, 2500);
  });
</script>

<style>
  :root {
    --page-bg: #060913;
  }
  body {
    background: var(--page-bg) !important;
    color: #f8fafc !important;
    margin: 0;
    padding: 0;
    overflow-x: hidden;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  /* Subtle background radial glows in warm RapiDoc orange tones */
  .glow-container {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }
  .radial-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(140px);
    opacity: 0.16;
  }
  .glow-orange {
    top: -100px;
    right: 15%;
    width: 550px;
    height: 550px;
    background: radial-gradient(circle, #ff7043 0%, transparent 70%);
  }
  .glow-amber {
    bottom: 50px;
    left: 10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, #f59e0b 0%, transparent 70%);
  }

  /* Top toolbar */
  .theme-toolbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(6, 9, 19, 0.88);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 12px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }
  .toolbar-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .theme-badge {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 4px 10px;
    border-radius: 6px;
  }
  .theme-badge.dark {
    background: rgba(255, 112, 67, 0.14);
    color: #ff8a65;
    border: 1px solid rgba(255, 112, 67, 0.35);
  }
  .theme-hint {
    font-size: 12.5px;
    color: #94a3b8;
  }
  .toolbar-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .theme-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: transparent;
    color: #94a3b8;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .theme-icon-btn:hover {
    color: #ff8a65;
    border-color: rgba(255, 112, 67, 0.5);
    background: rgba(255, 112, 67, 0.12);
    box-shadow: 0 0 10px rgba(255, 112, 67, 0.25);
  }
  .theme-home-btn {
    color: #94a3b8;
    font-size: 12.5px;
    text-decoration: none;
  }
  .theme-home-btn:hover {
    color: #fff;
  }

  /* RapiDoc Document Frame */
  .doc-frame {
    position: relative;
    z-index: 1;
    width: 100%;
    height: calc(100vh - 58px);
  }
  rapi-doc {
    width: 100%;
    height: 100%;

    /* High contrast dark custom CSS properties */
    --bg: #0b0f19;
    --bg2: #111827;
    --bg3: #1f2937;
    --fg: #f8fafc;
    --fg2: #f1f5f9;
    --fg3: #e2e8f0;
    --light-fg: #94a3b8;
    --border-color: #334155;
    --light-border-color: #1e293b;
    --code-bg: #030712;
    --code-fg: #f8fafc;
    --input-bg: #111827;
    --primary-color: #ff7043;
    --primary-color-invert: #ffffff;
    --blue: #38bdf8;
    --green: #34d399;
    --orange: #ff7043;
    --red: #f87171;
  }

  /* ==========================================================================
     CSS Shadow Parts (::part) Styling - Nuxt-Style Vertical Border Glow
     ========================================================================== */

  /*
   * Left-nav (Sidebar) with Nuxt-style vertical neon border line.
   * Fades to transparent at top and bottom ends and glows in the middle.
   */
  rapi-doc::part(section-navbar) {
    background-color: #060913;
    /* 1px crisp border that fades at the top and bottom and peaks gracefully at y=50% */
    border-right: 1px solid transparent;
    border-image: linear-gradient(
        to bottom,
        transparent 0%,
        rgba(255, 112, 67, 0.05) 15%,
        rgba(255, 112, 67, 0.55) 35%,
        #ff8a65 50%,
        rgba(255, 112, 67, 0.55) 65%,
        rgba(255, 112, 67, 0.05) 85%,
        transparent 100%
      )
      1;
    position: relative;
    z-index: 10;
  }

  /*
   * Main Content Canvas with subtle Nuxt-style vertical edge aura.
   * Tight 45px spread along the border (y=50%), never overwhelming the text.
   */
  rapi-doc::part(section-main-content) {
    background-color: #0b0f19;
    background-image:
      /* Faint warm gradient aura at top-right corner */
      radial-gradient(ellipse 200px 220px at 100% 0%, rgba(255, 112, 67, 0.15) 0%, rgba(245, 158, 11, 0.06) 45%, transparent 75%),
      /* Delicate edge aura hugging the boundary (x=0) without washing over the content */
      radial-gradient(ellipse 50px 35% at 0% 50%, rgba(218, 94, 56, 0.06) 0%, rgba(255, 112, 67, 0.04) 55%, transparent 100%),
      radial-gradient(ellipse 30px 20% at 0% 50%, rgba(255, 138, 101, 0.1) 0%, transparent 100%),
      /* Faint ambient glow in bottom area */ radial-gradient(ellipse 50% 40% at 75% 85%, rgba(245, 158, 11, 0.02) 0%, transparent 60%);
    background-attachment: scroll, scroll, scroll, scroll;
  }

  rapi-doc::part(section-navbar-search) {
    background: #0b0f19 !important;
    backdrop-filter: blur(12px) saturate(180%) !important;
    -webkit-backdrop-filter: blur(12px) saturate(180%) !important;
    box-shadow: 0 4px 16px -2px rgba(0, 0, 0, 0.4);
  }

  rapi-doc::part(textbox-nav-filter) {
    background: rgba(255, 255, 255, 0.06) !important;
    border: 1px solid rgba(255, 255, 255, 0.12) !important;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #f8fafc !important;
    transition: all 0.2s ease;
  }

  rapi-doc::part(textbox-nav-filter):focus {
    border-color: #ff7043 !important;
    box-shadow: 0 0 12px rgba(255, 112, 67, 0.35);
    background: rgba(255, 255, 255, 0.1) !important;
  }

  rapi-doc::part(btn-search) {
    background: rgba(255, 112, 67, 0.18);
    border: 1px solid rgba(255, 112, 67, 0.38);
    color: #ff8a65;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: all 0.2s ease;
  }

  rapi-doc::part(btn-search):hover {
    background: rgba(255, 112, 67, 0.3);
    border-color: #ff8a65;
    color: #ffffff;
    box-shadow: 0 0 12px rgba(255, 112, 67, 0.3);
  }

  /* Operation divider in Read Mode */

  /* Try / Action buttons */
  rapi-doc::part(btn-try) {
    background: rgba(255, 112, 67, 0.15);
    color: #ff8a65;
    border: 1px solid rgba(255, 112, 67, 0.35);
    transition: all 0.2s ease;
  }

  rapi-doc::part(btn-try):hover {
    background: rgba(255, 112, 67, 0.25);
    border-color: #ff8a65;
    box-shadow: 0 0 16px rgba(255, 112, 67, 0.35);
  }
  /*
   * Tag section header in Read Mode:
   * Top border that fades to transparent at left and right edges and peaks brightly at the center.
   */
  rapi-doc::part(section-tag) {
    border-top: 1px solid transparent !important;
    border-image: linear-gradient(
        to right,
        transparent 0%,
        rgba(255, 112, 67, 0.08) 15%,
        rgba(255, 112, 67, 0.65) 35%,
        #ff8a65 50%,
        rgba(255, 112, 67, 0.65) 65%,
        rgba(255, 112, 67, 0.08) 85%,
        transparent 100%
      )
      1 !important;
  }
</style>
