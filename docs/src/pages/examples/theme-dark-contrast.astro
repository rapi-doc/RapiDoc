---
import GlobalLayout from '../../layouts/GlobalLayout.astro';
---

<GlobalLayout 
  title="High-Contrast Dark Theme Showcase | RapiDoc"
  description="High-contrast dark theme preset showcase for RapiDoc OpenAPI documentation."
>
  <div class="glow-container">
    <div class="radial-glow glow-emerald"></div>
    <div class="radial-glow glow-cyan"></div>
  </div>

  <div class="theme-toolbar">
    <div class="toolbar-left">
      <span class="theme-badge dark">HIGH-CONTRAST DARK THEME</span>
      <span class="theme-hint">Ready for high-res screenshot (1600x900 or 1440x900 recommended)</span>
    </div>
    <div class="toolbar-right">
      <a href="/examples/theme-light-contrast" class="theme-switch-btn">Switch to Light Theme →</a>
      <a href="/" class="theme-home-btn">← Back to Home</a>
    </div>
  </div>

  <div class="doc-frame">
    <rapi-doc
      id="thedoc"
      spec-url="/specs/petstore.yaml"
      theme="dark"
      render-style="view"
      schema-style="tree"
      show-header="false"
      show-info="false"
      show-components="false"
      allow-server-selection="false"
      allow-authentication="false"
      primary-color="#10b981"
      bg-color="#0b0f19"
      text-color="#f8fafc"
      nav-bg-color="#060913"
      nav-text-color="#94a3b8"
      nav-hover-bg-color="#111827"
      nav-hover-text-color="#ffffff"
      nav-accent-color="#10b981"
    >
    </rapi-doc>
  </div>
</GlobalLayout>

<script is:inline>
  // Wait for RapiDoc web component to load and expand the pet endpoint
  window.addEventListener('DOMContentLoaded', () => {
    function expandEndpoint() {
      const doc = document.getElementById('thedoc');
      if (doc && doc.shadowRoot) {
        // Expand the first endpoint automatically so request and response are visible
        const ep = doc.shadowRoot.querySelector('.m-endpoint');
        if (ep && !ep.classList.contains('expanded')) {
          ep.click();
        }
      }
    }
    setTimeout(expandEndpoint, 1000);
    setTimeout(expandEndpoint, 2500);
  });
</script>

<style>
:root {
  --page-bg: #060913;
}
body {
  background: var(--page-bg) !important;
  color: #f8fafc !important;
  margin: 0;
  padding: 0;
  overflow-x: hidden;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

/* Subtle radial glows */
.glow-container {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}
.radial-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(140px);
  opacity: 0.15;
}
.glow-emerald {
  top: -100px;
  right: 15%;
  width: 550px;
  height: 550px;
  background: radial-gradient(circle, #10b981 0%, transparent 70%);
}
.glow-cyan {
  bottom: 50px;
  left: 10%;
  width: 600px;
  height: 600px;
  background: radial-gradient(circle, #06b6d4 0%, transparent 70%);
}

/* Top toolbar */
.theme-toolbar {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(6, 9, 19, 0.85);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  padding: 12px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
}
.toolbar-left {
  display: flex;
  align-items: center;
  gap: 12px;
}
.theme-badge {
  font-size: 11.5px;
  font-weight: 700;
  letter-spacing: 0.05em;
  padding: 4px 10px;
  border-radius: 6px;
}
.theme-badge.dark {
  background: rgba(16, 185, 129, 0.15);
  color: #34d399;
  border: 1px solid rgba(16, 185, 129, 0.3);
}
.theme-hint {
  font-size: 12.5px;
  color: #94a3b8;
}
.toolbar-right {
  display: flex;
  align-items: center;
  gap: 12px;
}
.theme-switch-btn {
  background: #10b981;
  color: #042f2e;
  font-weight: 700;
  font-size: 12.5px;
  padding: 6px 14px;
  border-radius: 6px;
  text-decoration: none;
  transition: all 0.2s ease;
}
.theme-switch-btn:hover {
  background: #34d399;
}
.theme-home-btn {
  color: #94a3b8;
  font-size: 12.5px;
  text-decoration: none;
}
.theme-home-btn:hover {
  color: #fff;
}

/* RapiDoc Document Frame */
.doc-frame {
  position: relative;
  z-index: 1;
  width: 100%;
  height: calc(100vh - 58px);
}
rapi-doc {
  width: 100%;
  height: 100%;

  /* High contrast dark custom CSS properties */
  --bg: #0b0f19;
  --bg2: #111827;
  --bg3: #1f2937;
  --fg: #f8fafc;
  --fg2: #f1f5f9;
  --fg3: #e2e8f0;
  --light-fg: #94a3b8;
  --border-color: #334155;
  --light-border-color: #1e293b;
  --code-bg: #030712;
  --code-fg: #f8fafc;
  --input-bg: #111827;
  --primary-color: #10b981;
  --blue: #38bdf8;
  --green: #34d399;
  --orange: #fbbf24;
  --red: #f87171;
}
</style>
