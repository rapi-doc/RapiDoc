---
import ExampleLayout from '../../layouts/ExampleLayout.astro';
---

<ExampleLayout
  title="Rapidoc Themes"
  description="Demonstrates Various themes and presets by RapiDoc"
  specUrl="/specs/petstore.yaml"
  autoRenderRapiDoc={true}
  controller="pretty"
  preset="colors"
  rapidocProps={{
    'render-style': 'read',
    'show-info': 'true',
    'show-header': 'false',
  }}
/>
