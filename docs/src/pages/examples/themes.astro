---
import ExampleLayout from '../../layouts/ExampleLayout.astro';
---

<ExampleLayout
  specUrl="/specs/bookstore.yaml"
  autoRenderRapiDoc={true}
  controller="pretty"
  controls={['theme', 'color-scheme', 'render-style', 'show-method-in-nav-bar', 'use-path-in-nav-bar', 'nav-item-spacing', 'regular-font']}
  rapidocProps={{
    'render-style': 'read',
    'show-info': 'true',
    'show-header': 'false',
  }}
/>
