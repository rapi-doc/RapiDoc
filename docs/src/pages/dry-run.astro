---
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import '../styles/dry-run.css';

const defaultSpec = '/specs/dryrun.yaml';
  const pageTitle = 'Interactive OpenAPI Spec Sandbox & Live Dry-Run Editor | RapiDoc';
  const pageDescription = 'Test, edit, and preview OpenAPI 3.x and Swagger 2.0 specs live in your browser using RapiDoc. Upload local files, toggle render styles, and live edit YAML/JSON.';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=yes">
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription}>
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site || 'https://rapidocweb.com').toString()}>
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={pageDescription}>
  <meta property="og:type" content="website">
  <GoogleAnalytics title={pageTitle} />
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@400;600&display=swap" rel="stylesheet">

  <script is:inline type="module" src="/rapidoc/rapidoc-min.js"></script>
</head>
<body>
  <!-- Minimal Floating Bar -->
  <nav class="dr-floating-bar" id="dr-floating-bar" aria-label="Dry-run controls">
    <!-- 1. Editor -->
    <button type="button" class="dr-btn dr-btn-accent" id="dr-btn-editor" title="Open Spec Editor (Shortcut: E)">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
      </svg>
      <span>Editor</span>
    </button>

    <!-- 2. Upload -->
    <label class="dr-btn" title="Upload local .yaml or .json spec file">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/>
      </svg>
      <span>Upload</span>
      <input type="file" id="dr-file-input" accept=".yaml,.yml,.json" style="display: none;" />
    </label>

    <!-- 3. Render Style (3-Icon Segmented Group: Read, View, Focused) -->
    <div class="dr-segmented-group" id="dr-style-group" role="group" aria-label="Render Style">
      <button type="button" class="dr-seg-btn active" data-style="read" title="Render Style: Read (Default single-column doc)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
          <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
        </svg>
      </button>
      <button type="button" class="dr-seg-btn" data-style="view" title="Render Style: View (Column layout with sidebar)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="9" y1="3" x2="9" y2="21"></line>
        </svg>
      </button>
      <button type="button" class="dr-seg-btn" data-style="focused" title="Render Style: Focused (One endpoint focused)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <circle cx="12" cy="12" r="3"></circle>
          <line x1="12" y1="2" x2="12" y2="5"></line>
          <line x1="12" y1="19" x2="12" y2="22"></line>
          <line x1="2" y1="12" x2="5" y2="12"></line>
          <line x1="19" y1="12" x2="22" y2="12"></line>
        </svg>
      </button>
    </div>

    <!-- 4. Schema Style Toggle (Table vs Tree) -->
    <button type="button" class="dr-btn dr-btn-icon" id="dr-btn-schema" title="Schema Style: Table (Click to switch to Tree)">
      <span id="dr-schema-icon">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="18" height="18" rx="2"/>
          <line x1="3" y1="9" x2="21" y2="9"/>
          <line x1="3" y1="15" x2="21" y2="15"/>
          <line x1="9" y1="3" x2="9" y2="21"/>
        </svg>
      </span>
    </button>

    <!-- 5. Theme Switcher -->
    <button type="button" class="dr-btn dr-btn-icon" id="dr-btn-theme" title="Switch to Light Theme">
      <span id="dr-theme-icon">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </span>
    </button>

    <!-- 5. Home -->
    <a href="/" class="dr-btn dr-btn-icon" title="Return to Home page">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        <polyline points="9 22 9 12 15 12 15 22"/>
      </svg>
    </a>
  </nav>

  <!-- RapiDoc Element -->
  <rapi-doc
    id="thedoc"
    spec-url={defaultSpec}
    theme="dark"
    render-style="read"
    schema-style="table"
    default-schema-tab="example"
    show-header="false"
    show-info="true"
    allow-authentication="true"
    allow-server-selection="true"
    allow-try="true"
    sort-endpoints-by="path"
  >
  </rapi-doc>

  <!-- Slide-Over Live Spec Editor Drawer -->
  <aside class="dr-drawer" id="dr-drawer" aria-hidden="true">
    <div class="dr-drawer-header">
      <div class="dr-drawer-title">
        <span style="font-size: 18px;">📝</span>
        <h4>Live Spec Editor</h4>
        <span class="dr-format-tag" id="dr-format-tag">YAML / JSON</span>
      </div>
      <button type="button" class="dr-drawer-close" id="dr-btn-close-drawer" aria-label="Close Drawer">&times;</button>
    </div>

    <div class="dr-drawer-body">
      <textarea
        id="dr-textarea"
        class="dr-textarea"
        placeholder="Paste or write OpenAPI spec in YAML or JSON..."
        spellcheck="false"
        autocomplete="off"
      ></textarea>
      <div class="dr-error-banner" id="dr-error-banner" style="display: none;"></div>
    </div>

    <div class="dr-drawer-footer">
      <span class="dr-hint"><kbd>Cmd</kbd> + <kbd>Enter</kbd> to apply</span>
      <div class="dr-drawer-actions">
        <button type="button" class="dr-btn" id="dr-btn-format-json" style="display: none;">Format JSON</button>
        <button type="button" class="dr-btn" id="dr-btn-cancel-drawer">Cancel</button>
        <button type="button" class="dr-btn dr-btn-primary" id="dr-btn-apply-drawer">Apply</button>
      </div>
    </div>
  </aside>

  <!-- Drag & Drop Fullscreen Overlay -->
  <div class="dr-drop-overlay" id="dr-drop-overlay">
    <div class="dr-drop-card">
      <div style="font-size: 48px;">📥</div>
      <h3>Drop OpenAPI Spec</h3>
      <p>Drop any <code>.yaml</code> or <code>.json</code> file to render immediately</p>
    </div>
  </div>

  <!-- Toast Container -->
  <div class="dr-toast-container" id="dr-toast-container" aria-live="polite"></div>

  <!-- Client Script -->
  <script is:inline>
    (function () {
      let rapidocEl;
      let activeSpecUrl = '/specs/dryrun.yaml';
      let isDrawerOpen = false;
      let activeBlobUrl = null;

      const floatingBar = document.getElementById('dr-floating-bar');
      const btnEditor = document.getElementById('dr-btn-editor');
      const btnCloseDrawer = document.getElementById('dr-btn-close-drawer');
      const btnCancelDrawer = document.getElementById('dr-btn-cancel-drawer');
      const btnApplyDrawer = document.getElementById('dr-btn-apply-drawer');
      const btnFormatJson = document.getElementById('dr-btn-format-json');
      const drawer = document.getElementById('dr-drawer');
      const textarea = document.getElementById('dr-textarea');
      const errorBanner = document.getElementById('dr-error-banner');
      const formatTag = document.getElementById('dr-format-tag');
      const fileInput = document.getElementById('dr-file-input');
      const styleBtns = document.querySelectorAll('.dr-seg-btn');
      const btnSchema = document.getElementById('dr-btn-schema');
      const schemaIcon = document.getElementById('dr-schema-icon');
      const btnTheme = document.getElementById('dr-btn-theme');
      const themeIcon = document.getElementById('dr-theme-icon');
      const dropOverlay = document.getElementById('dr-drop-overlay');
      const toastContainer = document.getElementById('dr-toast-container');

      function init() {
        rapidocEl = document.getElementById('thedoc');
        if (!rapidocEl) return;

        loadDefaultSpec();
        bindEvents();
      }

      async function loadDefaultSpec() {
        try {
          const res = await fetch(`/specs/dryrun.yaml?_t=${Date.now()}`);
          if (res.ok) {
            activeSpecUrl = '/specs/dryrun.yaml';
          } else {
            activeSpecUrl = '/specs/dryrun.json';
          }
        } catch {
          activeSpecUrl = '/specs/dryrun.yaml';
        }
        rapidocEl.loadSpec(`${activeSpecUrl}?_t=${Date.now()}`);
      }

      function bindEvents() {
        const moonSvg = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>`;

        const sunSvg = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>`;

        // Theme toggle
        btnTheme.addEventListener('click', () => {
          const current = rapidocEl.getAttribute('theme') || 'dark';
          const next = current === 'dark' ? 'light' : 'dark';
          rapidocEl.setAttribute('theme', next);
          themeIcon.innerHTML = next === 'dark' ? moonSvg : sunSvg;
          btnTheme.title = next === 'dark' ? 'Switch to Light Theme' : 'Switch to Dark Theme';
          showToast(`Theme: ${next}`);
        });

        // Render Style 3-Icon Group
        styleBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const style = btn.getAttribute('data-style');
            rapidocEl.setAttribute('render-style', style);
            styleBtns.forEach((b) => b.classList.toggle('active', b === btn));
            showToast(`Render style: ${style}`);
          });
        });

        // Schema Style Toggle (Table vs Tree)
        const tableSvg = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="18" height="18" rx="2"/>
          <line x1="3" y1="9" x2="21" y2="9"/>
          <line x1="3" y1="15" x2="21" y2="15"/>
          <line x1="9" y1="3" x2="9" y2="21"/>
        </svg>`;

        const treeSvg = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="6" cy="6" r="3"/>
          <circle cx="18" cy="18" r="3"/>
          <circle cx="18" cy="6" r="3"/>
          <path d="M6 9v9a3 3 0 0 0 3 3h6"/>
          <line x1="6" y1="12" x2="18" y2="12"/>
        </svg>`;

        function updateSchemaIcon(style) {
          if (style === 'tree') {
            schemaIcon.innerHTML = treeSvg;
            btnSchema.title = 'Schema Style: Tree (Click to switch to Table)';
          } else {
            schemaIcon.innerHTML = tableSvg;
            btnSchema.title = 'Schema Style: Table (Click to switch to Tree)';
          }
        }

        btnSchema.addEventListener('click', () => {
          const current = rapidocEl.getAttribute('schema-style') || 'table';
          const next = current === 'table' ? 'tree' : 'table';
          rapidocEl.setAttribute('schema-style', next);
          updateSchemaIcon(next);
          showToast(`Schema style: ${next}`);
        });

        // Drawer
        btnEditor.addEventListener('click', () => toggleDrawer(true));
        btnCloseDrawer.addEventListener('click', () => toggleDrawer(false));
        btnCancelDrawer.addEventListener('click', () => toggleDrawer(false));
        btnApplyDrawer.addEventListener('click', () => applyDrawer());
        btnFormatJson.addEventListener('click', () => formatJson());

        textarea.addEventListener('input', updateFormatTag);

        // Upload
        fileInput.addEventListener('change', (e) => {
          const file = e.target.files && e.target.files[0];
          if (file) handleFile(file);
          fileInput.value = '';
        });

        // Window focus -> auto reload from disk if active spec is a file
        window.addEventListener('focus', () => {
          if (!isDrawerOpen && !activeSpecUrl.startsWith('blob:')) {
            rapidocEl.loadSpec(`${activeSpecUrl}?_t=${Date.now()}`);
            showToast('Auto-reloaded spec from disk', 'info');
          }
        });

        // Keyboard Shortcuts
        window.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            if (isDrawerOpen) {
              toggleDrawer(false);
              return;
            }
          }

          if (document.activeElement === textarea) {
            if (e.key === 'Tab') {
              e.preventDefault();
              const s = textarea.selectionStart;
              const end = textarea.selectionEnd;
              textarea.value = textarea.value.substring(0, s) + '  ' + textarea.value.substring(end);
              textarea.selectionStart = textarea.selectionEnd = s + 2;
            } else if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
              e.preventDefault();
              applyDrawer();
            }
            return;
          }

          if (['INPUT', 'SELECT', 'TEXTAREA'].includes(document.activeElement.tagName)) return;

          if (e.key.toLowerCase() === 'e' && !e.metaKey && !e.ctrlKey) {
            e.preventDefault();
            toggleDrawer();
          }
        });

        setupDragAndDrop();
      }

      async function toggleDrawer(force) {
        isDrawerOpen = typeof force === 'boolean' ? force : !isDrawerOpen;
        drawer.classList.toggle('open', isDrawerOpen);
        drawer.setAttribute('aria-hidden', String(!isDrawerOpen));

        if (isDrawerOpen) {
          if (!textarea.value.trim() && !activeSpecUrl.startsWith('blob:')) {
            try {
              const res = await fetch(`${activeSpecUrl}?_t=${Date.now()}`);
              if (res.ok) textarea.value = await res.text();
            } catch (err) {
              console.error(err);
            }
          }
          updateFormatTag();
          textarea.focus();
        }
      }

      function updateFormatTag() {
        const text = textarea.value.trim();
        const isJson = text.startsWith('{') || text.startsWith('[');
        formatTag.textContent = isJson ? 'JSON' : 'YAML';
        btnFormatJson.style.display = isJson ? 'inline-flex' : 'none';
      }

      function formatJson() {
        try {
          const parsed = JSON.parse(textarea.value);
          textarea.value = JSON.stringify(parsed, null, 2);
          errorBanner.style.display = 'none';
          showToast('JSON formatted', 'success');
        } catch (err) {
          errorBanner.textContent = `Invalid JSON: ${err.message}`;
          errorBanner.style.display = 'block';
        }
      }

      async function applyDrawer() {
        const content = textarea.value.trim();
        if (!content) {
          errorBanner.textContent = 'Spec content cannot be empty';
          errorBanner.style.display = 'block';
          return;
        }

        try {
          const isJson = content.startsWith('{') || content.startsWith('[');
          const mimeType = isJson ? 'application/json' : 'text/yaml';

          if (activeBlobUrl) URL.revokeObjectURL(activeBlobUrl);
          const blob = new Blob([content], { type: mimeType });
          activeBlobUrl = URL.createObjectURL(blob);
          activeSpecUrl = activeBlobUrl;

          await rapidocEl.loadSpec(activeBlobUrl);
          errorBanner.style.display = 'none';
          toggleDrawer(false);
          showToast('Spec updated in RapiDoc', 'success');
        } catch (err) {
          console.error(err);
          errorBanner.textContent = `Render error: ${err.message}`;
          errorBanner.style.display = 'block';
        }
      }

      function handleFile(file) {
        if (!file) return;
        const reader = new FileReader();
        reader.onload = async (e) => {
          const content = e.target.result;
          textarea.value = content;
          updateFormatTag();

          const isJson = file.name.endsWith('.json') || content.trim().startsWith('{');
          const mimeType = isJson ? 'application/json' : 'text/yaml';

          if (activeBlobUrl) URL.revokeObjectURL(activeBlobUrl);
          const blob = new Blob([content], { type: mimeType });
          activeBlobUrl = URL.createObjectURL(blob);
          activeSpecUrl = activeBlobUrl;

          await rapidocEl.loadSpec(activeBlobUrl);
          showToast(`Loaded ${file.name}`, 'success');
        };
        reader.readAsText(file);
      }

      function setupDragAndDrop() {
        let dragCounter = 0;
        window.addEventListener('dragenter', (e) => {
          e.preventDefault();
          dragCounter++;
          dropOverlay.classList.add('visible');
        });
        window.addEventListener('dragleave', (e) => {
          e.preventDefault();
          dragCounter--;
          if (dragCounter <= 0) {
            dropOverlay.classList.remove('visible');
            dragCounter = 0;
          }
        });
        window.addEventListener('dragover', (e) => e.preventDefault());
        window.addEventListener('drop', (e) => {
          e.preventDefault();
          dragCounter = 0;
          dropOverlay.classList.remove('visible');
          const files = e.dataTransfer && e.dataTransfer.files;
          if (files && files.length > 0) handleFile(files[0]);
        });
      }

      function showToast(message, type = 'info') {
        const toast = document.createElement('div');
        toast.className = `dr-toast dr-toast-${type}`;
        toast.textContent = message;
        toastContainer.appendChild(toast);
        setTimeout(() => {
          toast.classList.add('fade-out');
          setTimeout(() => toast.remove(), 300);
        }, 2500);
      }

      document.addEventListener('DOMContentLoaded', init);
      if (document.readyState === 'interactive' || document.readyState === 'complete') init();
    })();
  </script>
</body>
</html>
