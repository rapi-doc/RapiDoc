<script>
  // Integration examples: tabs and the copy button
  const codeTabs = document.querySelectorAll<HTMLButtonElement>('.rd-code-tab');
  const codePanels = document.querySelectorAll<HTMLElement>('.rd-code-panel');
  codeTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      codeTabs.forEach((t) => {
        t.classList.toggle('active', t === tab);
        t.setAttribute('aria-selected', String(t === tab));
      });
      codePanels.forEach((p) => p.classList.toggle('active', p.id === `panel-${tab.dataset.tab}`));
    });
  });
  const codeCopy = document.querySelector<HTMLButtonElement>('.rd-code-copy');
  codeCopy?.addEventListener('click', async () => {
    const code = document.querySelector<HTMLElement>('.rd-code-panel.active')?.dataset.code;
    if (!code) return;
    await navigator.clipboard.writeText(code);
    const label = codeCopy.querySelector('.rd-code-copy-label');
    if (label) {
      label.textContent = 'Copied';
      setTimeout(() => (label.textContent = 'Copy'), 1600);
    }
  });

  // Hero Copy Button
  const heroCopyBtn = document.getElementById('hero-copy-btn');
  if (heroCopyBtn) {
    heroCopyBtn.addEventListener('click', async () => {
      const code = heroCopyBtn.getAttribute('data-code');
      if (code) {
        await navigator.clipboard.writeText(code);
        const label = heroCopyBtn.querySelector('.rd-copy-label');
        if (label) {
          label.textContent = 'Copied!';
          setTimeout(() => {
            label.textContent = 'Copy';
          }, 2000);
        }
      }
    });
  }
</script>

