<script>
  // Persona Switcher
  const devTab = document.getElementById('tab-dev');
  const pmTab = document.getElementById('tab-pm');
  const devContent = document.getElementById('content-dev');
  const pmContent = document.getElementById('content-pm');

  if (devTab && pmTab && devContent && pmContent) {
    devTab.addEventListener('click', () => {
      devTab.classList.add('active');
      pmTab.classList.remove('active');
      devContent.classList.add('active');
      pmContent.classList.remove('active');
    });

    pmTab.addEventListener('click', () => {
      pmTab.classList.add('active');
      devTab.classList.remove('active');
      pmContent.classList.add('active');
      devContent.classList.remove('active');
    });
  }

  // Quickstart Code Tabs
  const codeTabs = document.querySelectorAll('.rd-code-tab');
  const codePanels = document.querySelectorAll('.rd-tab-panel');

  codeTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const targetId = tab.getAttribute('data-tab');
      codeTabs.forEach((t) => t.classList.remove('active'));
      codePanels.forEach((p) => p.classList.remove('active'));
      tab.classList.add('active');
      if (targetId) {
        document.getElementById(targetId)?.classList.add('active');
      }
    });
  });

  // Hero Copy Button
  const heroCopyBtn = document.getElementById('hero-copy-btn');
  if (heroCopyBtn) {
    heroCopyBtn.addEventListener('click', async () => {
      const code = heroCopyBtn.getAttribute('data-code');
      if (code) {
        await navigator.clipboard.writeText(code);
        const label = heroCopyBtn.querySelector('.rd-copy-label');
        if (label) {
          label.textContent = 'Copied!';
          setTimeout(() => {
            label.textContent = 'Copy';
          }, 2000);
        }
      }
    });
  }

  // Live RapiDoc Mini Theme Switcher
  const btnDark = document.getElementById('btn-theme-dark');
  const btnLight = document.getElementById('btn-theme-light');
  const previewWindow = document.getElementById('preview-window');
  const miniEl = document.getElementById('homepage-rapi-mini');

  const getAccentColor = () => getComputedStyle(document.documentElement).getPropertyValue('--rd-accent').trim() || '#10b981';

  // Initialize miniEl primary color on load
  if (miniEl) {
    miniEl.setAttribute('primary-color', getAccentColor());
  }

  btnDark?.addEventListener('click', () => {
    btnDark.classList.add('active');
    btnLight?.classList.remove('active');
    previewWindow?.classList.remove('theme-light');

    if (miniEl) {
      miniEl.setAttribute('theme', 'dark');
      miniEl.setAttribute('bg-color', '#090d16');
      miniEl.setAttribute('text-color', '#f8fafc');
      miniEl.setAttribute('primary-color', getAccentColor());
    }
  });

  btnLight?.addEventListener('click', () => {
    btnLight.classList.add('active');
    btnDark?.classList.remove('active');
    previewWindow?.classList.add('theme-light');

    if (miniEl) {
      miniEl.setAttribute('theme', 'light');
      miniEl.setAttribute('bg-color', '#ffffff');
      miniEl.setAttribute('text-color', '#0f172a');
      miniEl.setAttribute('primary-color', getAccentColor());
    }
  });
</script>

