---
import GlobalLayout from '../layouts/GlobalLayout.astro';
import CodeBlock from '../components/CodeBlock.astro';
import SiteNavbar from '../components/SiteNavbar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { rapidocBuildInfo } from '../page-data/rapidoc-build-info';

const vanillaCode = `<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <script type="module" src="https://unpkg.com/rapidoc/dist/rapidoc-min.js"></script>
</head>
<body>
  <rapi-doc
    spec-url="https://petstore.swagger.io/v2/swagger.json"
    render-style="read"
    theme="dark"
    show-header="false"
  > </rapi-doc>
</body>
</html>`;

const reactCode = `import React from 'react';
import 'rapidoc';

export function ApiReference() {
  return (
    <rapi-doc
      spec-url="https://petstore.swagger.io/v2/swagger.json"
      render-style="view"
      theme="dark"
      style={{ height: '100vh', width: '100%' }}
    />
  );
}`;

const vueCode = `<template>
  <rapi-doc
    spec-url="https://petstore.swagger.io/v2/swagger.json"
    render-style="focused"
    theme="dark"
    style="height: 100vh; width: 100%"
  />
</template>

<script setup>
import 'rapidoc';
</script>`;

const dockerCode = `FROM nginx:alpine
# Copy rapidoc bundle and your OpenAPI spec into a zero-dependency container
COPY dist/rapidoc-min.js /usr/share/nginx/html/
COPY openapi.yaml /usr/share/nginx/html/
COPY index.html /usr/share/nginx/html/
EXPOSE 80
# Blazing fast, self-contained, <25MB total image size`;
---

<GlobalLayout
  title="RapiDoc - Fast, Beautiful & Customizable OpenAPI Spec Viewer & Console"
  description="Generate beautiful, interactive, and customizable API documentation from OpenAPI 3.0 & 3.1 and Swagger specs with zero build steps using native Web Components."
  keywords="OpenAPI, Swagger, API documentation, Web Component, OpenAPI 3.1, REST API, API Console, RapiDoc, API Explorer"
>
  <!-- RapiDoc Component Registration -->
  <script slot="script" is:inline type="module" src="/rapidoc/rapidoc-min.js"></script>

  <!-- Ambient background glow elements inspired by Nuxt.com -->
  <div class="ambient-glow glow-emerald"></div>
  <div class="ambient-glow glow-indigo"></div>
  <div class="ambient-glow glow-cyan"></div>

  <!-- Reusable Frosted Glass Navigation -->
  <SiteNavbar activePage="home" />

  <!-- Hero Section: Split DX Studio Layout -->
  <section class="rd-hero-section">
    <div class="rd-hero-container">
      <!-- Left Column: Copy & Personas -->
      <div class="rd-hero-left">
        <div class="rd-badge-pill">
          <span class="rd-badge-pulse"></span>
          <span class="rd-badge-text">OpenAPI 3.1 & 3.0 Web Component</span>
        </div>

        <h1 class="rd-hero-title">
          API Documentation <br />
          <span class="rd-gradient-text">Developers & Product Teams</span>
          <br />
          Agree On.
        </h1>

        <p class="rd-hero-subtitle">
          Build breathtaking, high-performance interactive API references without framework lock-in. Powered by native Web Components,
          featuring an integrated API console, and self-hosted corporate security.
        </p>

        <!-- Persona Switcher Segment -->
        <div class="rd-persona-box" id="persona-section">
          <div class="rd-persona-tabs">
            <button class="rd-persona-tab active" id="tab-dev" data-target="content-dev">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="16 18 22 12 16 6"></polyline>
                <polyline points="8 6 2 12 8 18"></polyline>
              </svg>
              <span>For Developers</span>
            </button>
            <button class="rd-persona-tab" id="tab-pm" data-target="content-pm">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 20h9"></path>
                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
              </svg>
              <span>For Product Managers</span>
            </button>
          </div>

          <!-- Developer Content -->
          <div class="rd-persona-content active" id="content-dev">
            <div class="rd-persona-grid">
              <div class="rd-persona-item">
                <span class="rd-persona-bullet">✓</span>
                <div>
                  <strong>True Web Component:</strong> Zero framework lock-in. Works effortlessly in React, Vue, Angular, Svelte, or plain HTML.
                </div>
              </div>
              <div class="rd-persona-item">
                <span class="rd-persona-bullet">✓</span>
                <div>
                  <strong>Integrated API Console:</strong> Test real endpoints directly with negative testing enabled — send custom headers &
                  malformed payloads to test edge cases.
                </div>
              </div>
              <div class="rd-persona-item">
                <span class="rd-persona-bullet">✓</span>
                <div>
                  <strong>Container Ready:</strong> Tiny ~{rapidocBuildInfo.bundle.minified.formatted} bundle ({
                    rapidocBuildInfo.bundle.gzip.formatted
                  } gzipped) with zero SSR/Node overhead. Bundles directly into Browser and micro-containers with Go/Rust/Java/Python servers.
                </div>
              </div>
              <div class="rd-persona-item">
                <span class="rd-persona-bullet">✓</span>
                <div>
                  <strong>Built In Mock Server:</strong>Prototype client frontends, simulate multi-status responses, and test network
                  latency before backend APIs exist
                </div>
              </div>
            </div>
          </div>

          <!-- Product Manager Content -->
          <div class="rd-persona-content" id="content-pm">
            <div class="rd-persona-grid">
              <div class="rd-persona-item">
                <span class="rd-persona-bullet">✓</span>
                <div>
                  <strong>Self-Hosted Corporate Data Security:</strong> Operates 100% in-browser with zero telemetry or outbound cloud leaks.
                  Ideal for strict compliance and air-gapped VPCs.
                </div>
              </div>
              <div class="rd-persona-item">
                <span class="rd-persona-bullet">✓</span>
                <div>
                  <strong>100% Brand Consistency:</strong> White-label fonts, header colors, logos, and light/dark modes with simple HTML attributes.
                  No code forks required.
                </div>
              </div>
              <div class="rd-persona-item">
                <span class="rd-persona-bullet">✓</span>
                <div>
                  <strong>3 Layout Modes for Every Reader:</strong> Deliver wiki-style references (Read Mode), fast technical exploration (View
                  Mode), or focused endpoint catalogs.
                </div>
              </div>
              <div class="rd-persona-item">
                <span class="rd-persona-bullet">✓</span>
                <div>
                  <strong>Zero SaaS Tax (100% MIT):</strong> No per-seat pricing, no paywalled interactive consoles, and no vendor lock-in.
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="rd-hero-cta-group">
          <a href="/examples/petstore" class="rd-btn rd-btn-primary rd-btn-lg">
            <span>Explore Live Demos</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14m-7-7 7 7-7 7"></path>
            </svg>
          </a>
          <a href="#quickstart" class="rd-btn rd-btn-glass rd-btn-lg">
            <span>Quick Start in 60s</span>
          </a>
        </div>

        <!-- Quick Terminal Snippet -->
        <div class="rd-terminal-box">
          <span class="rd-terminal-prompt">$</span>
          <code class="rd-terminal-code">npm install rapidoc</code>
          <button class="rd-terminal-copy" id="hero-copy-btn" data-code="npm install rapidoc" title="Copy command">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span class="rd-copy-label">Copy</span>
          </button>
        </div>
      </div>

      <!-- Right Column: Interactive RapiDoc Mini Live Preview -->
      <div class="rd-hero-right">
        <div class="rd-preview-window" id="preview-window">
          <!-- Window Header Bar -->
          <div class="rd-preview-header">
            <div class="rd-preview-left">
              <div class="rd-window-dots">
                <span class="rd-dot red"></span>
                <span class="rd-dot yellow"></span>
                <span class="rd-dot green"></span>
              </div>
              <span class="rd-preview-title">Live Interactive Component</span>
            </div>
            <!-- Theme Toggle: Light and Dark -->
            <div class="rd-theme-toggle-group">
              <span class="rd-toolbar-label">Theme:</span>
              <button class="rd-chip active" id="btn-theme-dark" type="button">Dark</button>
              <button class="rd-chip" id="btn-theme-light" type="button">Light</button>
            </div>
          </div>

          <!-- RapiDoc Mini Component blended into window surface -->
          <div class="rd-mini-surface" id="mini-surface">
            <rapi-doc-mini
              id="homepage-rapi-mini"
              spec-url="/specs/homepage-demo.yaml"
              match-paths="get /pet/{petId}"
              paths-expanded="true"
              schema-style="table"
              allow-try="true"
              color-scheme="dark"
              theme="amber"></rapi-doc-mini>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Metrics Proof Bar -->
  <section class="rd-metrics-section">
    <div class="rd-metrics-container">
      <div class="rd-metric-card">
        <div class="rd-metric-number">0</div>
        <div class="rd-metric-label">Framework Lock-in</div>
        <div class="rd-metric-desc">W3C Web Component: React, Vue, Svelte, or pure HTML</div>
      </div>
      <div class="rd-metric-card">
        <div class="rd-metric-number">~{rapidocBuildInfo.bundle.gzip.formatted}</div>
        <div class="rd-metric-label">Ultra-Light Bundle</div>
        <div class="rd-metric-desc">
          Gzipped single bundle ({rapidocBuildInfo.bundle.minified.formatted} minified). Zero VDOM diffing overhead
        </div>
      </div>
      <div class="rd-metric-card">
        <div class="rd-metric-number">100<span class="rd-unit">%</span></div>
        <div class="rd-metric-label">Private & Self-Hosted</div>
        <div class="rd-metric-desc">Zero telemetry. Air-gapped and container ready</div>
      </div>
      <div class="rd-metric-card">
        <div class="rd-metric-number">3</div>
        <div class="rd-metric-label">Layout Paradigms</div>
        <div class="rd-metric-desc">View, Read, and Focused modes for all audiences</div>
      </div>
    </div>
  </section>

  <!-- Dark & Light Modes Showcase Section -->
  <section class="rd-theme-card-section">
    <div class="rd-theme-card">
      <div class="rd-badge-pill" style="margin-bottom: 16px;">
        <span class="rd-badge-pulse"></span>
        <span class="rd-badge-text">Visual Polish</span>
      </div>
      <h2 class="rd-section-title">Dark & Light Modes Done Right</h2>
      <p class="rd-section-desc" style="max-width: 640px; margin: 0 auto 28px auto;">
        RapiDoc provides pixel-perfect high-contrast dark and light themes out of the box, engineered for crystal-clear readability, WCAG AA
        compliance, and effortless enterprise brand pairing.
      </p>
      <div class="rd-theme-card-actions">
        <a href="/examples/theme-dark-contrast" target="_blank" class="rd-btn rd-btn-primary">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <span>High-Contrast Dark Demo</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14m-7-7 7 7-7 7"></path>
          </svg>
        </a>
        <a href="/examples/theme-light-contrast" target="_blank" class="rd-btn rd-btn-primary">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <span>High-Contrast Light Demo</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14m-7-7 7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Bento Grid of Key Advantages (Nuxt-Style) -->
  <section class="rd-bento-section" id="features">
    <div class="rd-section-header">
      <span class="rd-sub-tag">Uncompromising Engineering</span>
      <h2 class="rd-section-title">Why Teams Choose RapiDoc Over Alternatives</h2>
      <p class="rd-section-desc">
        Designed from the ground up for developer productivity, enterprise privacy, and product design flexibility.
      </p>
    </div>

    <div class="rd-bento-grid">
      <!-- Card 1: Large feature -->
      <div class="rd-bento-card rd-col-span-2">
        <div class="rd-bento-badge">Framework Agnostic</div>
        <div class="rd-bento-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
        </div>
        <h3 class="rd-bento-title">Native W3C Web Component Standard</h3>
        <p class="rd-bento-text">
          Free of proprietary wrapper lock-in, complicated build steps, or framework runtime baggage. Drop a single <code
            >&lt;rapi-doc&gt;</code
          > custom element into React, Vue, Angular, Next.js, Nuxt, Astro, or plain vanilla HTML. Change attributes with JavaScript and it responds
          instantly.
        </p>
        <div class="rd-bento-tags">
          <span class="rd-tag">No React Hydration Overhead</span>
          <span class="rd-tag">Zero Build Step</span>
          <span class="rd-tag">Universal Interoperability</span>
        </div>
      </div>

      <!-- Card 2: Interactive Console -->
      <div class="rd-bento-card">
        <div class="rd-bento-badge">Real DX</div>
        <div class="rd-bento-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="4 17 10 11 4 5"></polyline>
            <line x1="12" y1="19" x2="20" y2="19"></line>
          </svg>
        </div>
        <h3 class="rd-bento-title">Built-in Console with Negative Testing</h3>
        <p class="rd-bento-text">
          Execute API calls directly in the docs. Unlike rigid renderers that block invalid inputs, RapiDoc lets you test negative edge
          cases, corrupt payloads, and custom headers.
        </p>
      </div>

      <!-- Card: In-Browser Mock Server -->
      <div class="rd-bento-card">
        <div class="rd-bento-badge">Zero Setup</div>
        <div class="rd-bento-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"
            ></path>
          </svg>
        </div>
        <h3 class="rd-bento-title">In-Browser Mock Server</h3>
        <p class="rd-bento-text">
          Frontend teams can prototype before the backend is built. Seamlessly intercepts in-page <code>fetch()</code> calls and generates realistic
          mock responses from OpenAPI examples or schemas with multi-status and latency simulation.
        </p>
        <a
          href="/guides/mock"
          style="color: var(--rd-accent); font-size: 13.5px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; margin-top: 14px; text-decoration: none;"
        >
          Explore Mock Server
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
            ><path d="M5 12h14M12 5l7 7-7 7"></path></svg
          >
        </a>
      </div>

      <!-- Card 3: Embedded Containers -->
      <div class="rd-bento-card">
        <div class="rd-bento-badge">Microservices & Edge</div>
        <div class="rd-bento-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
            <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
            <line x1="6" y1="6" x2="6.01" y2="6"></line>
            <line x1="6" y1="18" x2="6.01" y2="18"></line>
          </svg>
        </div>
        <h3 class="rd-bento-title">Embedded in Micro-Servers & Containers</h3>
        <p class="rd-bento-text">
          With its tiny bundle size and zero server-side rendering dependencies, RapiDoc is ideal for embedding into lightweight Docker
          containers, Go / Rust / Java backends, and IoT edge devices.
        </p>
      </div>

      <!-- Card 4: Schema Visualization -->
      <div class="rd-bento-card">
        <div class="rd-bento-badge">Ergonomics</div>
        <div class="rd-bento-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="6" y1="3" x2="6" y2="15"></line>
            <circle cx="18" cy="6" r="3"></circle>
            <circle cx="6" cy="18" r="3"></circle>
            <path d="M18 9a9 9 0 0 1-9 9"></path>
          </svg>
        </div>
        <h3 class="rd-bento-title">Tree & Tabular Schema Folding</h3>
        <p class="rd-bento-text">
          Choose between Tree and Table representation for deep schemas. All models and examples are auto-expanded by default, completely
          eliminating tedious 20-click accordions.
        </p>
      </div>

      <!-- Card 5: Corporate Security -->
      <div class="rd-bento-card rd-col-span-2">
        <div class="rd-bento-badge">Enterprise Ready</div>
        <div class="rd-bento-icon-box">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <h3 class="rd-bento-title">100% Self-Hosted & Air-Gapped Security</h3>
        <p class="rd-bento-text">
          Trusted by Fortune 500 corporations, defense, and fintech organizations. RapiDoc executes entirely client-side in the browser. No
          telemetry phoning home, no cloud vendor lock-in, and zero risk of proprietary internal API schemas leaking to third parties.
        </p>
        <div class="rd-bento-tags">
          <span class="rd-tag">100% Offline Capable</span>
          <span class="rd-tag">Air-Gapped VPC Compliant</span>
          <span class="rd-tag">Zero Cloud Telemetry</span>
          <span class="rd-tag">100% MIT Open Source</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Comprehensive Comparison Table: RapiDoc vs Others -->
  <section class="rd-comparison-section" id="comparison">
    <div class="rd-section-header">
      <span class="rd-sub-tag">Competitive Matrix</span>
      <h2 class="rd-section-title">How RapiDoc Compares to Other API Renderers</h2>
      <p class="rd-section-desc">See why teams switch from Redocly, Scalar, and Swagger UI to RapiDoc.</p>
    </div>

    <div class="rd-table-card">
      <div class="rd-table-responsive">
        <table class="rd-compare-table">
          <thead>
            <tr>
              <th class="rd-th-feature">Capability</th>
              <th class="rd-th-highlight">RapiDoc</th>
              <th>Redocly (Redoc)</th>
              <th>Scalar</th>
              <th>Swagger UI</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="rd-td-feature">
                <strong>Component Architecture</strong>
                <span>Portability across any framework</span>
              </td>
              <td class="rd-td-highlight">
                <span class="rd-check">✓</span>
                <strong>Standard Web Component</strong><br />
                <span class="rd-dim">React, Vue, Svelte, or plain HTML</span>
              </td>
              <td>React Component / Standalone bundle</td>
              <td>Vue 3 Component / Wrapper</td>
              <td>React Component / Legacy Webpack</td>
            </tr>

            <tr>
              <td class="rd-td-feature">
                <strong>Interactive Test Console</strong>
                <span>Call live endpoints directly</span>
              </td>
              <td class="rd-td-highlight">
                <span class="rd-check">✓</span>
                <strong>Built-In (Free)</strong><br />
                <span class="rd-dim">Supports negative/edge case testing</span>
              </td>
              <td><span class="rd-cross">✕</span> Paid / Separate Add-on</td>
              <td><span class="rd-check">✓</span> Built-in client</td>
              <td><span class="rd-partial">~</span> Basic (rigid validation)</td>
            </tr>

            <tr>
              <td class="rd-td-feature">
                <strong>In-Browser Mock Server</strong>
                <span>Zero-setup frontend prototyping & testing</span>
              </td>
              <td class="rd-td-highlight">
                <span class="rd-check">✓</span>
                <strong>Built-In Mock Server</strong><br />
                <span class="rd-dim">Zero config, schema-driven, multi-status & latency simulation</span>
              </td>
              <td><span class="rd-cross">✕</span> Requires Prism / External CLI</td>
              <td><span class="rd-cross">✕</span> No mock server</td>
              <td><span class="rd-cross">✕</span> No mock server</td>
            </tr>

            <tr>
              <td class="rd-td-feature">
                <strong>Model & Schema Folding</strong>
                <span>Inspect complex nested payloads</span>
              </td>
              <td class="rd-td-highlight">
                <span class="rd-check">✓</span>
                <strong>Dual Tree & Tabular</strong><br />
                <span class="rd-dim">Models expanded by default</span>
              </td>
              <td>Nested list only</td>
              <td>Single column list</td>
              <td>Accordion list (multi-click drilldown)</td>
            </tr>

            <tr>
              <td class="rd-td-feature">
                <strong>Distinct Layout Styles</strong>
                <span>Adapt to audience needs</span>
              </td>
              <td class="rd-td-highlight">
                <span class="rd-check">✓</span>
                <strong>3 Modes</strong><br />
                <span class="rd-dim">Read (wiki), View, & Focused</span>
              </td>
              <td>1 fixed 3-column layout</td>
              <td>1 fixed layout</td>
              <td>1 vertical accordion layout</td>
            </tr>

            <tr>
              <td class="rd-td-feature">
                <strong>Embedded & Micro-Containers</strong>
                <span>Lightweight binary / container integration</span>
              </td>
