---
import GlobalLayout from '../layouts/GlobalLayout.astro';
import SiteNavbar from '../components/SiteNavbar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CodeBlock from '../components/CodeBlock.astro';
import { stylingData } from '../page-data/styling-data';

const totalParts = stylingData.parts.reduce((acc, cat) => acc + cat.items.length, 0);
const totalVariables = stylingData.variables.reduce((acc, cat) => acc + cat.items.length, 0);
const totalCategories = stylingData.parts.length;

const navRecipeCode = `<style>
  /* Target the navigation sidebar using ::part() */
  rapi-doc::part(section-navbar) {
    background: linear-gradient(90deg, #3d4e70, #2e3746);
  }
</style>

<rapi-doc
  spec-url="https://petstore.swagger.io/v2/swagger.json"
  theme="dark"
  primary-color="#f54c47"
  bg-color="#2e3746"
  text-color="#bacdee"
  show-header="false"
></rapi-doc>`;

const serverRecipeCode = `<style>
  /* Style the Overview Title and Servers panel */
  rapi-doc::part(section-overview-title) {
    color: #9b2f80;
  }
  rapi-doc::part(section-servers) {
    background: #6b5b95;
    color: #d1c2e4;
    margin: 0 24px;
    border-radius: 8px;
  }
  rapi-doc::part(label-selected-server) {
    color: #ffffff;
    font-weight: 600;
  }
</style>

<rapi-doc
  spec-url="https://petstore.swagger.io/v2/swagger.json"
  show-header="false"
  nav-bg-color="#423368"
  primary-color="#df75c4"
  bg-color="#fae4f5"
></rapi-doc>`;

const buttonRecipeCode = `<style>
  /* Customize buttons and the primary TRY trigger */
  rapi-doc::part(btn) {
    border-radius: 14px;
    transition: all 0.2s ease;
  }
  rapi-doc::part(btn-try) {
    background-color: #eab308;
    color: #0f172a;
    border-color: #eab308;
    font-weight: 700;
  }
  rapi-doc::part(btn-selected-response-status) {
    background-color: #eab308;
    color: #0f172a;
    border-color: #eab308;
  }
</style>

<rapi-doc
  spec-url="https://petstore.swagger.io/v2/swagger.json"
  show-header="false"
  nav-bg-color="#423368"
  primary-color="#df75c4"
  bg-color="#fae4f5"
></rapi-doc>`;

const attributeRecipeCode = `<rapi-doc
  spec-url="https://petstore.swagger.io/v2/swagger.json"
  theme="dark"
  bg-color="#0b1121"
  text-color="#94a3b8"
  primary-color="#10b981"
  header-color="#060913"
  nav-bg-color="#0f172a"
  nav-text-color="#cbd5e1"
  nav-hover-bg-color="#1e293b"
  nav-hover-text-color="#ffffff"
  nav-accent-color="#10b981"
  regular-font="Inter, -apple-system, sans-serif"
  mono-font="Roboto Mono, monospace"
  font-size="default"
  render-style="focused"
  schema-style="table"
  schema-expand-level="1"
  show-header="true"
  allow-try="true"
></rapi-doc>`;

const slotsRecipeCode = `<rapi-doc spec-url="https://petstore.swagger.io/v2/swagger.json">
  <!-- 1. Default (unnamed) Slot: Announcement banner at top of document -->
  <div style="background: linear-gradient(135deg, rgba(16,185,129,0.12), rgba(6,182,212,0.12)); border: 1px solid rgba(16,185,129,0.3); border-radius: 8px; padding: 14px 20px; margin: 16px 24px; display: flex; align-items: center; justify-content: space-between;">
    <div>
      <strong style="color: #34d399; font-size: 14.5px;">🚀 API v2.4 Live in Production</strong>
      <p style="margin: 4px 0 0 0; color: #94a3b8; font-size: 13px;">Review our changelog for non-breaking deprecation updates.</p>
    </div>
    <a href="https://status.example.com" target="_blank" style="background: #10b981; color: #fff; padding: 6px 14px; border-radius: 6px; text-decoration: none; font-size: 12.5px; font-weight: 600;">Status Page ↗</a>
  </div>

  <!-- 2. Logo Slot: Custom brand logo in top utility header -->
  <div slot="logo" style="display: flex; align-items: center; gap: 8px; margin-left: 12px;">
    <img src="/assets/images/logo.png" width="30" height="30" alt="Logo" />
    <span style="font-size: 18px; font-weight: 700; color: #fff;">Acme API</span>
  </div>

  <!-- 3. Header Slot: Custom action buttons in top utility header -->
  <div slot="header" style="display: flex; gap: 10px; margin-right: 16px;">
    <a href="https://github.com/org/repo" target="_blank" style="color: #94a3b8; text-decoration: none; font-size: 13px; padding: 6px 12px; border: 1px solid rgba(255,255,255,0.1); border-radius: 6px;">GitHub SDK</a>
    <a href="/console" style="color: #10b981; text-decoration: none; font-size: 13px; font-weight: 600; padding: 6px 12px; background: rgba(16,185,129,0.15); border-radius: 6px;">Developer Portal</a>
  </div>

  <!-- 4. Auth Slot: Guidance notice in authentication modal -->
  <div slot="auth" style="background: rgba(56, 189, 248, 0.08); border-left: 3px solid #38bdf8; padding: 12px 16px; border-radius: 4px; margin-bottom: 16px;">
    <p style="margin: 0; font-size: 13px; color: #e2e8f0;">
      🔑 <strong>Need an API Key?</strong> Sign up at <a href="https://dashboard.example.com" target="_blank" style="color: #38bdf8;">dashboard.example.com</a> to retrieve your Bearer token.
    </p>
  </div>

  <!-- 5. Footer Slot: Legal notices and support contacts -->
  <div slot="footer" style="text-align: center; padding: 32px 0; color: #64748b; font-size: 13px; border-top: 1px solid rgba(255,255,255,0.08); margin-top: 48px;">
    Acme Cloud Platform © 2026 • <a href="/terms" style="color: #94a3b8;">Terms</a> • <a href="/privacy" style="color: #94a3b8;">Privacy</a> • Contact <a href="mailto:api@example.com" style="color: #10b981;">api@example.com</a>
  </div>
</rapi-doc>`;

const markdownRecipeYaml = `openapi: 3.0.3
info:
  title: Payments & Billing Gateway API
  version: 2.1.0
  description: |
    ### Welcome to the Payments Gateway
    
    <!-- 1. Custom Action Badges & External Link Buttons -->
    <div style="display: flex; gap: 10px; flex-wrap: wrap; margin: 16px 0;">
      <a href="https://status.example.com" style="background: #10b981; color: #fff; padding: 6px 14px; border-radius: 20px; text-decoration: none; font-size: 12px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
        <span>🟢 Systems Operational (99.99%)</span>
      </a>
      <a href="https://github.com/my-org/sdks" style="background: rgba(255,255,255,0.08); color: #38bdf8; padding: 6px 14px; border-radius: 20px; text-decoration: none; font-size: 12px; font-weight: 600;">
        <span>📦 Download Official SDKs</span>
      </a>
    </div>

    <!-- 2. Rich Alert / Notice Callout Box -->
    <div style="background: rgba(234, 179, 8, 0.1); border-left: 4px solid #eab308; padding: 14px 18px; border-radius: 6px; margin: 16px 0;">
      <strong style="color: #fde047;">⚠️ Deprecation Notice:</strong>
      <span style="color: #e2e8f0; font-size: 13.5px; margin-left: 6px;">
        The <code>/v1/charge</code> endpoint will be sunset on December 31, 2026. Please migrate to <code>/v2/payments</code>.
      </span>
    </div>

    <!-- 3. Native HTML Collapsible Accordion -->
    <details style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 12px 16px; margin: 16px 0;">
      <summary style="cursor: pointer; font-weight: 600; color: #38bdf8;">
        Click to view Rate Limits & Webhook Retry Architecture
      </summary>
      <div style="margin-top: 12px; font-size: 13px; color: #94a3b8; line-height: 1.6;">
        Standard tier tokens permit up to <strong>500 requests per second</strong>. When rate limits are exceeded, RapiDoc console and API responses will return HTTP status <code>429 Too Many Requests</code> with a <code>Retry-After</code> response header.
      </div>
    </details>`;

const stylingAttributes = [
  { name: 'theme', type: 'string', default: 'dark', allowed: 'light | dark', desc: 'Base color scheme and background theme of the documentation portal.' },
  { name: 'bg-color', type: 'hex/rgb', default: 'dark: #090d16', allowed: 'CSS color', desc: 'Background color of the entire main documentation canvas.' },
  { name: 'text-color', type: 'hex/rgb', default: '#94a3b8', allowed: 'CSS color', desc: 'Default typography color for body text, summaries, and schema descriptions.' },
  { name: 'primary-color', type: 'hex/rgb', default: '#ff791a', allowed: 'CSS color', desc: 'Primary brand accent color used for active tabs, links, schema outlines, and interactive highlights.' },
  { name: 'header-color', type: 'hex/rgb', default: '#060913', allowed: 'CSS color', desc: 'Background color of the top utility header bar.' },
  { name: 'nav-bg-color', type: 'hex/rgb', default: 'inherit', allowed: 'CSS color', desc: 'Background color of the sticky sidebar navigation panel.' },
  { name: 'nav-text-color', type: 'hex/rgb', default: '#cbd5e1', allowed: 'CSS color', desc: 'Color of text and icons in the sidebar navigation.' },
  { name: 'nav-hover-bg-color', type: 'hex/rgb', default: 'rgba(...)', allowed: 'CSS color', desc: 'Background color when hovering over sidebar navigation items.' },
  { name: 'nav-hover-text-color', type: 'hex/rgb', default: '#ffffff', allowed: 'CSS color', desc: 'Text color when hovering over sidebar navigation items.' },
  { name: 'nav-accent-color', type: 'hex/rgb', default: '#10b981', allowed: 'CSS color', desc: 'Accent highlight color applied to the actively viewed/selected navigation link.' },
  { name: 'regular-font', type: 'string', default: 'Open Sans', allowed: 'Font family', desc: 'Custom font family applied to all body text, headings, and UI controls.' },
  { name: 'mono-font', type: 'string', default: 'Monaco', allowed: 'Font family', desc: 'Monospace font family applied to code snippets, parameters, and schema structures.' },
  { name: 'font-size', type: 'string', default: 'default', allowed: 'default | large | largest', desc: 'Global typography scale modifier.' },
  { name: 'render-style', type: 'string', default: 'view', allowed: 'view | read | focused', desc: 'Primary document layout mode (multi-column view, continuous document read, or single-operation focused).' },
  { name: 'schema-style', type: 'string', default: 'tree', allowed: 'tree | table', desc: 'Visualization presentation style for request and response models.' },
  { name: 'show-header', type: 'boolean', default: 'true', allowed: 'true | false', desc: 'Toggles visibility of the top header bar.' },
];

const slotsData = stylingData.slots;
---

<GlobalLayout 
  title="Theming, CSS Parts (::part) & Deep Styling Guide | RapiDoc"
  description="Customize every aspect of your OpenAPI documentation using CSS shadow DOM parts (::part), custom color palettes, Google Fonts, dark mode, and layout styling."
  keywords="RapiDoc styling, CSS parts, shadow DOM theming, OpenAPI custom styles, Swagger custom themes"
>
  <!-- Ambient background glow elements -->
  <div class="ambient-glow glow-emerald"></div>
  <div class="ambient-glow glow-indigo"></div>
  <div class="ambient-glow glow-cyan"></div>

  <!-- Site Navbar -->
  <SiteNavbar activePage="other" />

  <main class="rd-styling-main">
    <!-- Hero Header -->
    <header class="rd-styling-hero">
      <div class="rd-badge-pill">
        <span class="rd-badge-pulse"></span>
        <span class="rd-badge-text">Design System & Shadow DOM Customization</span>
      </div>

      <h1 class="rd-page-title">
        Advanced Styling <span class="text-gradient">in RapiDoc</span>
      </h1>

      <p class="rd-page-subtitle">
        Designing enterprise-grade API documentation requires strict alignment with corporate brand standards, design tokens, and audience expectations. Discover how RapiDoc balances bulletproof Shadow DOM encapsulation with complete styling freedom through CSS Shadow Parts (<code class="mono-code">::part()</code>) and CSS Custom Properties.
      </p>

      <!-- Stats Metric Counter Cards -->
      <div class="rd-stats-bar">
        <div class="rd-stat-card">
          <span class="rd-stat-value">5</span>
          <span class="rd-stat-label">Theming Approaches</span>
        </div>
        <div class="rd-stat-card">
          <span class="rd-stat-value">{totalParts}</span>
          <span class="rd-stat-label">CSS Shadow Parts</span>
        </div>
        <div class="rd-stat-card">
          <span class="rd-stat-value">{totalVariables}</span>
          <span class="rd-stat-label">CSS Custom Properties</span>
        </div>
        <div class="rd-stat-card">
          <span class="rd-stat-value">{totalCategories}</span>
          <span class="rd-stat-label">Functional UI Zones</span>
        </div>
      </div>
    </header>

    <!-- The 5 Theming Mechanisms Overview Grid -->
    <section class="rd-mechanisms-section">
      <div class="rd-section-header">
        <div class="rd-section-badge">Architecture & Isolation</div>
        <h2 class="rd-section-title">The 5 Ways to Theme RapiDoc</h2>
        <p class="rd-section-desc">
          Because <code class="mono-code">&lt;rapi-doc&gt;</code> is built as a standard W3C Web Component, its markup and styles reside inside an isolated <strong>Shadow DOM</strong>. External stylesheet rules and third-party CSS resets cannot bleed in, and RapiDoc styles will never bleed out. You have five complementary mechanisms to achieve your desired aesthetic:
        </p>
      </div>

      <div class="rd-cards-grid">
        <a href="#attributes" class="rd-feature-card">
          <div class="rd-card-icon">🎨</div>
          <h3 class="rd-card-title">1. HTML Attributes</h3>
          <p class="rd-card-desc">
            Quick, declarative configuration directly on the element. Customize base themes (<code class="mono-code">theme="dark"</code>), brand colors, header palettes, font families, and sidebar layout modes with zero CSS.
          </p>
          <div class="rd-card-action">
            <span>Explore Attributes</span>
            <span class="action-arrow">↓</span>
          </div>
        </a>

        <a href="#css-parts" class="rd-feature-card rd-feature-highlight">
          <div class="rd-card-icon">⚡</div>
          <h3 class="rd-card-title">2. CSS Shadow Parts</h3>
          <p class="rd-card-desc">
            Target internal elements across the Shadow boundary using <code class="mono-code">rapi-doc::part(...)</code>. Unlock bespoke visual flourishes such as multi-stop gradients, backdrop filters, and custom borders.
          </p>
          <div class="rd-card-action">
            <span>Explore CSS Parts</span>
            <span class="action-arrow">↓</span>
          </div>
        </a>

        <a href="#reference-catalog" class="rd-feature-card" id="card-css-vars">
          <div class="rd-card-icon">🎛️</div>
          <h3 class="rd-card-title">3. CSS Custom Properties</h3>
          <p class="rd-card-desc">
            Override design tokens such as <code class="mono-code">--border-radius</code>, <code class="mono-code">--scroll-bar-width</code>, typography scale presets, and syntax highlighting colors directly in CSS.
          </p>
          <div class="rd-card-action">
            <span>Explore CSS Variables</span>
            <span class="action-arrow">↓</span>
          </div>
        </a>

        <a href="#slots" class="rd-feature-card">
          <div class="rd-card-icon">🧩</div>
          <h3 class="rd-card-title">4. Named HTML Slots</h3>
          <p class="rd-card-desc">
            Inject arbitrary HTML markup, custom brand logos, banners, search widgets, navigation elements, or authorization scripts into predefined slots inside RapiDoc.
          </p>
          <div class="rd-card-action">
            <span>Explore HTML Slots</span>
            <span class="action-arrow">↓</span>
          </div>
        </a>

        <a href="#markdown" class="rd-feature-card">
          <div class="rd-card-icon">📝</div>
          <h3 class="rd-card-title">5. Markdown HTML Injection</h3>
          <p class="rd-card-desc">
            Embed HTML tags directly within OpenAPI markdown descriptions (summaries, parameters, schemas) to render formatted tables, diagrams, callouts, or video embeds.
          </p>
          <div class="rd-card-action">
            <span>Explore Markdown HTML</span>
            <span class="action-arrow">↓</span>
          </div>
        </a>
      </div>
    </section>

    <!-- ================= 1. HTML ATTRIBUTES SECTION ================= -->
    <section class="rd-section-block" id="attributes">
      <div class="rd-section-header">
        <div class="rd-section-badge">Theming Mechanism 1</div>
        <h2 class="rd-section-title">Styling with Declarative HTML Attributes</h2>
        <p class="rd-section-desc">
          HTML attributes provide the foundational styling layer for RapiDoc. Because they are declared directly on the <code class="mono-code">&lt;rapi-doc&gt;</code> element with zero build tools or stylesheets required, attributes are the fastest way to customize color schemes, header themes, fonts, and layout modes.
        </p>
      </div>

      <div class="rd-recipe-card rd-mb-40">
        <div class="rd-recipe-top">
          <div class="rd-recipe-header-text">
            <div class="rd-recipe-tag">Quickstart Snippet</div>
            <h3 class="rd-recipe-heading">Declarative Brand Customization</h3>
            <p class="rd-recipe-text">
              Configure baseline brand styling including high-contrast dark themes, custom primary accents, navigation sidebar colors, and font families in a single declarative tag.
            </p>
          </div>
          <div class="rd-recipe-action">
            <a href="/api#attributes" class="rd-btn rd-btn-secondary">
              <span>View All 62 HTML Attributes in API Reference ↗</span>
            </a>
          </div>
        </div>
        <div class="rd-recipe-split">
          <div class="rd-screenshot-frame">
            <div class="rd-frame-header">
              <span class="frame-dot red"></span>
              <span class="frame-dot yellow"></span>
              <span class="frame-dot green"></span>
              <span class="frame-title">Live Theme Preview</span>
            </div>
            <div class="rd-screenshot-body">
              <img src="/assets/images/rapi-brand.png" alt="RapiDoc Brand Customization Preview" />
            </div>
          </div>
          <div class="rd-recipe-code">
            <CodeBlock code={attributeRecipeCode} lang="html" filename="declarative-styling.html" />
          </div>
        </div>
      </div>

      <!-- Core Styling Attributes Reference Table -->
      <div class="rd-table-wrapper">
        <table class="rd-catalog-table">
          <thead>
            <tr>
              <th class="col-attr-name">Attribute</th>
              <th class="col-attr-type">Type / Allowed</th>
              <th class="col-attr-default">Default</th>
              <th class="col-attr-desc">Description & Styling Effect</th>
            </tr>
          </thead>
          <tbody>
            {stylingAttributes.map(attr => (
              <tr class="rd-catalog-row">
                <td class="col-attr-name">
                  <div class="rd-item-pill">
                    <span class="rd-pill-name">{attr.name}</span>
                  </div>
                </td>
                <td class="col-attr-type">
                  <span class="rd-type-tag">{attr.type}</span>
                  <div class="rd-allowed-text">{attr.allowed}</div>
                </td>
                <td class="col-attr-default">
                  <code class="rd-default-badge">{attr.default}</code>
                </td>
                <td class="col-attr-desc">{attr.desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Practical Showcase & Recipes -->
    <section class="rd-recipes-section" id="css-parts">
      <div class="rd-section-header">
        <div class="rd-section-badge">Theming Mechanism 2</div>
        <h2 class="rd-section-title">Deep Styling Recipes with CSS Parts</h2>
        <p class="rd-section-desc">
          Explore real-world examples demonstrating how to combine declarative attributes with targeted <code class="mono-code">::part()</code> selectors to produce state-of-the-art documentation portals.
        </p>
      </div>

      <!-- Recipe 1: Navigation Bar Gradient -->
      <div class="rd-recipe-card">
        <div class="rd-recipe-top">
          <div class="rd-recipe-header-text">
            <div class="rd-recipe-tag">Recipe 1</div>
            <h3 class="rd-recipe-heading">Multi-Stop Gradient Sidebar Navigation</h3>
            <p class="rd-recipe-text">
              While the <code class="mono-code">nav-bg-color</code> attribute accepts solid colors, applying multi-stop CSS gradients or glassmorphic blur requires piercing the Shadow DOM. By selecting <code class="mono-code">rapi-doc::part(section-navbar)</code>, you can apply rich background gradients while keeping text and icons perfectly legible.
            </p>
          </div>
          <div class="rd-recipe-action">
            <a href="/examples/cssparts-nav" target="_blank" class="rd-btn rd-btn-primary">
              <span>View Interactive Demo</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M5 12h14m-7-7 7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
        <div class="rd-recipe-split">
          <div class="rd-screenshot-frame">
            <div class="rd-frame-header">
              <span class="frame-dot red"></span>
              <span class="frame-dot yellow"></span>
              <span class="frame-dot green"></span>
              <span class="frame-title">Sidebar Gradient Preview</span>
            </div>
            <div class="rd-screenshot-body">
              <img src="/assets/images/theme/rapidoc-csspart-nav.png" alt="RapiDoc CSS Part Navigation Example" />
            </div>
          </div>
          <div class="rd-recipe-code">
            <CodeBlock code={navRecipeCode} lang="html" filename="gradient-navbar.html" />
          </div>
        </div>
      </div>

      <!-- Recipe 2: Servers & Overview Title -->
      <div class="rd-recipe-card">
        <div class="rd-recipe-top">
          <div class="rd-recipe-header-text">
            <div class="rd-recipe-tag">Recipe 2</div>
            <h3 class="rd-recipe-heading">Branded API Servers & Environment Card</h3>
            <p class="rd-recipe-text">
              Emphasize active deployment environments by applying unique background tones, padding, and rounded borders to the server selection container using <code class="mono-code">rapi-doc::part(section-servers)</code> and <code class="mono-code">rapi-doc::part(label-selected-server)</code>.
            </p>
          </div>
          <div class="rd-recipe-action">
            <a href="/examples/cssparts-servers" target="_blank" class="rd-btn rd-btn-primary">
              <span>View Interactive Demo</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M5 12h14m-7-7 7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
        <div class="rd-recipe-split">
          <div class="rd-screenshot-frame">
            <div class="rd-frame-header">
              <span class="frame-dot red"></span>
              <span class="frame-dot yellow"></span>
              <span class="frame-dot green"></span>
              <span class="frame-title">Custom Server Card Preview</span>
            </div>
            <div class="rd-screenshot-body">
              <img src="/assets/images/theme/rapidoc-csspart-server.png" alt="RapiDoc CSS Part Server Example" />
            </div>
          </div>
          <div class="rd-recipe-code">
            <CodeBlock code={serverRecipeCode} lang="html" filename="branded-servers.html" />
          </div>
        </div>
      </div>

      <!-- Recipe 3: Custom Action & Try Buttons -->
      <div class="rd-recipe-card">
        <div class="rd-recipe-top">
          <div class="rd-recipe-header-text">
            <div class="rd-recipe-tag">Recipe 3</div>
            <h3 class="rd-recipe-heading">Customized Buttons & Console Triggers</h3>
            <p class="rd-recipe-text">
              Match your application's button styles by styling base buttons (<code class="mono-code">btn</code>), solid primary actions (<code class="mono-code">btn-try</code>), and active response status code selectors (<code class="mono-code">btn-selected-response-status</code>) with custom corner radiuses, hover animations, and high-contrast palettes.
            </p>
          </div>
          <div class="rd-recipe-action">
            <a href="/examples/cssparts-btn" target="_blank" class="rd-btn rd-btn-primary">
              <span>View Interactive Demo</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M5 12h14m-7-7 7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
