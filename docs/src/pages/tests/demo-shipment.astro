---
import TestCaseLayout from '../../layouts/TestCaseLayout.astro';
import PrettyRapidocTuner from '../../components/PrettyRapidocTuner.astro';
---

<TestCaseLayout
  specUrl="/specs-test/demo-shipment.yaml"
  preset={['all']}
  tuckedRight={false}
  controller={PrettyRapidocTuner}
  controllerSize="large"
  rapidocProps={{
    'render-style': 'read',
    'show-info': 'true',
    'show-header': 'false',
  }}
/>
