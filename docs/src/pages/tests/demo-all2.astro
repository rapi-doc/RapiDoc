---
import TestCaseLayout from '../../layouts/TestCaseLayout.astro';
---

<TestCaseLayout
  title="Test | Demo All Config Using RapidocTuner | RapiDoc"
  description="RapidocTuner to configure RapiDoc with all options"
  specUrl="/specs-test/petstore.yaml"
  preset={['all']}
  rapidocProps={{
    'render-style': 'read',
    'show-info': 'true',
    'show-header': 'false',
  }}
>
  <!-- Custom test action button injected into the RapidocTuner HUD via slot="controller" -->
  <button
    slot="controller"
    type="button"
    class="rd-toggle-btn"
    style="border-color: rgba(56, 189, 248, 0.4); color: #38bdf8;"
    onclick="const doc = document.getElementById('thedoc'); if (doc) { doc.scrollTo('get-/pet/findByStatus'); }"
    title="Programmatically scroll to the findByStatus endpoint using doc.scrollTo()"
  >
    <span>📍 Scroll to findByStatus</span>
  </button>
</TestCaseLayout>
