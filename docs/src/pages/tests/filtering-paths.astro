---
import ExampleLayout from '../../layouts/ExampleLayout.astro';
---

<ExampleLayout>
  <rapi-doc
    id="thedoc"
    spec-url="/specs-test/filtering-paths.yaml"
    show-header="false"
    show-info="true"
    allow-server-selection="false"
    allow-authentication="false"
    render-style="read"
    use-path-in-nav-bar="true"
    show-method-in-nav-bar="as-colored-text"
    filter-operations=""
  >
    <div slot="operations-top" style="display: flex; flex-direction: column; align-items: center; gap: 8px; margin: 16px">
      <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap; justify-content: center">
        <label for="filter-operations">filter-operations</label>
        <input
          id="filter-operations"
          class="txt"
          value="/public-* !badge:Preffered"
          type="text"
          placeholder="!badge:Internal !badge:admin-use-only"
          spellcheck="false"
          style="width: 320px"
        />
        <button class="btn" onclick="applyFilter()">Apply</button>
      </div>
      <div style="display: flex; gap: 6px; flex-wrap: wrap; justify-content: center">
        <button class="btn" onclick="applyFilter('/public-*')">/public-*</button>
        <button class="btn" onclick="applyFilter('GET /internal-path-1')">GET /internal-path-1</button>
        <button class="btn" onclick="applyFilter('badge:Core')">badge:Core</button>
        <button class="btn" onclick="applyFilter('!badge:Internal !badge:admin-use-only')">!badge:Internal !badge:admin-use-only</button>
        <button class="btn" onclick="applyFilter('')">(all)</button>
      </div>
    </div>
  </rapi-doc>

  <script is:inline>
    function applyFilter(value) {
      const input = document.getElementById('filter-operations');
      if (typeof value === 'string') input.value = value;
      document.getElementById('thedoc').setAttribute('filter-operations', input.value || '');
    }
  </script>
</ExampleLayout>
