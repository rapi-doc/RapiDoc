---
import GlobalLayout from '../../layouts/GlobalLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
---

<GlobalLayout>
  <PageBanner slot="topbar" page="theme-illustration" />
  <main class="page-container">
    <header class="page-header">
      <h1>RapiDoc Structure & Theme Illustration</h1>
      <p class="page-subtitle">
        Interactive preview showcasing RapiDoc layout sections, render styles, color schemes, theme presets, and accent colors via CSS.
      </p>
    </header>

    <!-- Controls Panel -->
    <section class="controls-card">
      <div class="controls-grid">
        <!-- Render Style (Focused vs View) -->
        <div class="control-group">
          <label class="group-title">Render Style</label>
          <div class="segmented-control" id="render-style-control">
            <button type="button" class="segment-btn active" data-render="focused" title="Standard focused/read mode with navigation bar">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="6" height="18" rx="1"></rect><rect x="12" y="3" width="9" height="18" rx="1"></rect></svg>
              Focused / Read
            </button>
            <button type="button" class="segment-btn" data-render="view" title="View mode: No navigation, Request and Response side-by-side">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="8" height="18" rx="1"></rect><rect x="13" y="3" width="8" height="18" rx="1"></rect></svg>
              View (Side-by-Side)
            </button>
          </div>
        </div>

        <!-- Visibility Toggles -->
        <div class="control-group">
          <label class="group-title">Layout Visibility</label>
          <div class="toggles-list">
            <label class="toggle-item">
              <input type="checkbox" id="toggle-header" checked />
              <span class="toggle-slider"></span>
              <span class="toggle-label">Header</span>
            </label>
            <label class="toggle-item" id="nav-logo-toggle-item">
              <input type="checkbox" id="toggle-nav-logo" checked />
              <span class="toggle-slider"></span>
              <span class="toggle-label">Nav Logo</span>
            </label>
            <label class="toggle-item" id="nav-methods-toggle-item">
              <input type="checkbox" id="toggle-nav-methods" checked />
              <span class="toggle-slider"></span>
              <span class="toggle-label">Nav Methods</span>
            </label>
          </div>
        </div>

        <!-- Color Scheme -->
        <div class="control-group">
          <label class="group-title">Color Scheme</label>
          <div class="segmented-control" id="scheme-control">
            <button type="button" class="segment-btn active" data-scheme="dark">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
              Dark
            </button>
            <button type="button" class="segment-btn" data-scheme="light">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
              Light
            </button>
          </div>
        </div>

        <!-- Preset -->
        <div class="control-group">
          <label class="group-title">Theme Preset</label>
          <div class="segmented-control" id="preset-control">
            <button type="button" class="segment-btn active" data-preset="amber">
              <span class="preset-dot" style="background: #f59e0b;"></span>
              Amber
            </button>
            <button type="button" class="segment-btn" data-preset="emerald">
              <span class="preset-dot" style="background: #10b981;"></span>
              Emerald
            </button>
          </div>
        </div>

        <!-- Accent Colors -->
        <div class="control-group accent-group">
          <label class="group-title">Accent Color</label>
          <div class="color-swatches" id="swatches-control">
            <button type="button" class="color-btn active" data-color="#f59e0b" style="--c: #f59e0b;" title="Amber"></button>
            <button type="button" class="color-btn" data-color="#10b981" style="--c: #10b981;" title="Emerald"></button>
            <button type="button" class="color-btn" data-color="#0284c7" style="--c: #0284c7;" title="Sky Blue"></button>
            <button type="button" class="color-btn" data-color="#f43f5e" style="--c: #f43f5e;" title="Rose"></button>
            <button type="button" class="color-btn" data-color="#8b5cf6" style="--c: #8b5cf6;" title="Violet"></button>
            <button type="button" class="color-btn" data-color="#ea580c" style="--c: #ea580c;" title="Orange"></button>
            <button type="button" class="color-btn" data-color="#14b8a6" style="--c: #14b8a6;" title="Teal"></button>
            
            <label class="custom-color-wrapper" id="custom-accent-wrapper" title="Pick custom accent color">
              <input type="color" id="accent-picker" value="#f59e0b" />
              <span class="custom-color-indicator" id="custom-color-preview"></span>
            </label>
          </div>
        </div>

        <!-- Background Color -->
        <div class="control-group bg-group">
          <label class="group-title">Background Color</label>
          <div class="color-swatches" id="bg-swatches-control">
            <button type="button" class="color-btn active" data-bg="auto" style="--c: conic-gradient(from 180deg at 50% 50%, #f59e0b 0deg, #10b981 120deg, #0284c7 240deg, #f59e0b 360deg);" title="Auto: Harmonize with Accent Color"></button>
            <button type="button" class="color-btn" data-bg="#18181b" style="--c: #18181b;" title="Zinc Charcoal (#18181b)"></button>
            <button type="button" class="color-btn" data-bg="#0f172a" style="--c: #0f172a;" title="Slate Navy (#0f172a)"></button>
            <button type="button" class="color-btn" data-bg="#09090b" style="--c: #09090b;" title="Pure Dark (#09090b)"></button>
            <button type="button" class="color-btn" data-bg="#ffffff" style="--c: #ffffff;" title="Crisp White (#ffffff)"></button>
            <button type="button" class="color-btn" data-bg="#f8fafc" style="--c: #f8fafc;" title="Off-White Slate (#f8fafc)"></button>
            
            <label class="custom-color-wrapper" id="custom-bg-wrapper" title="Pick custom background color">
              <input type="color" id="bg-picker" value="#362a1a" />
              <span class="custom-color-indicator" id="custom-bg-preview" style="background: #362a1a;"></span>
            </label>
          </div>
        </div>
      </div>

      <!-- Live CSS State Readout -->
      <div class="state-readout">
        <div class="readout-item">
          <span class="readout-label">Classes:</span>
          <code id="state-classes">.rapidoc-illustration</code>
        </div>
        <div class="readout-item">
          <span class="readout-label">--bg:</span>
          <code id="state-bg">#22242b</code>
        </div>
        <div class="readout-item">
          <span class="readout-label">--primary:</span>
          <code id="state-accent">#f59e0b</code>
        </div>
      </div>
    </section>

    <!-- Illustration Canvas Frame (strictly 0 margin/padding around SVG) -->
    <div class="illustration-frame">
      <div class="svg-container" id="svg-host">
        <svg viewBox="28 3.16 460.16 309.84" xmlns="http://www.w3.org/2000/svg" xmlns:svg="http://www.w3.org/2000/svg" id="rapidoc-svg" class="rapidoc-illustration">
          <style>
            :root, .rapidoc-illustration {
              /* Amber Dark Preset (Default) - RapiDoc Dark Charcoal Slate */
              --bg: #22242b;
              --nav-bg: #1a1c23;
              --header-bg: #14161c;
              --card-bg: #2a2d36;
              --border: #363636;
              --primary: #f59e0b;
              --primary-border: #d97706;

              /* Typography: Heading is prominent, Secondary/Body text is one shade darker */
              --text-heading: #ffffff;
              --text-body: #94a3b8;
              --text-muted: #6b7280;
              --tag-fill: #94a3b8;
              --search-fill: #1a1c23;
              --search-stroke: #363636;
            }

            /* Emerald Dark Preset - RapiDoc Deep Navy Slate */
            .rapidoc-illustration.preset-emerald {
              --bg: #060913;
              --nav-bg: #03060c;
              --header-bg: #020408;
              --card-bg: #0f172a;
              --border: #1e293b;
              --primary: #10b981;
              --primary-border: #059669;

              /* Typography: Heading is prominent, Secondary/Body text is one shade darker */
              --text-heading: #f8fafc;
              --text-body: #94a3b8;
              --text-muted: #6ee7b7;
              --tag-fill: #94a3b8;
              --search-fill: #0f172a;
              --search-stroke: #1e293b;
            }

            /* Light Color Scheme (Amber) - Crisp White Surface */
            .rapidoc-illustration.theme-light {
              --bg: #ffffff;
              --nav-bg: #f4f4f5;
              --header-bg: #f4f4f5;
              --card-bg: #ffffff;
              --border: #e4e4e7;
              --primary: #d97706;
              --primary-border: #b45309;

              /* Typography: Heading is dark, Secondary/Body text is one shade lighter */
              --text-heading: #09090b;
              --text-body: #71717a;
              --text-muted: #a1a1aa;
              --tag-fill: #71717a;
              --search-fill: #ffffff;
              --search-stroke: #e4e4e7;
            }

            /* Light Color Scheme (Emerald) - Crisp White Surface */
            .rapidoc-illustration.theme-light.preset-emerald {
              --bg: #ffffff;
              --nav-bg: #f4f4f5;
              --header-bg: #f4f4f5;
              --card-bg: #ffffff;
              --border: #e4e4e7;
              --primary: #059669;
              --primary-border: #047857;

              /* Typography: Heading is dark, Secondary/Body text is one shade lighter */
              --text-heading: #09090b;
              --text-body: #71717a;
              --text-muted: #a1a1aa;
              --tag-fill: #71717a;
              --search-fill: #ffffff;
              --search-stroke: #e4e4e7;
            }

            .rapidoc-illustration {
              transition: background-color 0.35s ease;
            }
            .rapidoc-illustration * {
              transition: fill 0.35s ease, stroke 0.35s ease, opacity 0.35s ease, transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.35s ease;
            }

            .rapidoc-illustration .header-group {
              transform-origin: top center;
              transition: opacity 0.35s ease, transform 0.35s ease, visibility 0.35s ease;
            }
            .rapidoc-illustration.hide-header .header-group {
              opacity: 0;
              visibility: hidden;
              pointer-events: none;
              transform: translateY(-10px);
            }

            .rapidoc-illustration .nav-logo {
              transform-origin: 51px 47px;
              transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s ease;
            }
            .rapidoc-illustration.hide-nav-logo .nav-logo {
              opacity: 0;
              visibility: hidden;
              pointer-events: none;
              transform: scale(0.4);
            }

            .rapidoc-illustration .nav-methods {
              transform-origin: center right;
              transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s ease;
            }
            .rapidoc-illustration.hide-nav-methods .nav-methods {
              opacity: 0;
              visibility: hidden;
              pointer-events: none;
              transform: translateX(12px);
            }

            .rapidoc-illustration .nav-group {
              transform-origin: left center;
              transition: opacity 0.35s ease, transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.35s ease;
            }
            .rapidoc-illustration.render-view .nav-group {
              opacity: 0;
              visibility: hidden;
              pointer-events: none;
              transform: translateX(-150px);
            }

            .rapidoc-illustration .main-headings,
            .rapidoc-illustration .post-endpoint {
              transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            }
            .rapidoc-illustration.render-view .main-headings,
            .rapidoc-illustration.render-view .post-endpoint {
              transform: translateX(-142px);
            }

            .rapidoc-illustration .request-section {
              transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            }
            .rapidoc-illustration.render-view .request-section {
              transform: translateX(-143px);
            }

            .rapidoc-illustration .response-section {
              transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            }
            .rapidoc-illustration.render-view .response-section {
              transform: translate(73px, -64.22px);
            }

            .main-bg { fill: var(--bg); }
            .nav-bg { fill: var(--nav-bg); }
            .nav-border { stroke: var(--border); }
            .header-bg { fill: var(--header-bg); }
            .header-border { stroke: var(--border); }
            .header-search { fill: var(--card-bg); stroke: var(--border); }
            .card-bg, .card-bg rect, #aa, #svg_15 { fill: var(--card-bg); stroke: var(--border); }
            .primary-accent { fill: var(--primary) !important; }
            .primary-btn { fill: var(--primary) !important; }
            .text-heading { fill: var(--text-heading); }
            .text-body { fill: var(--text-body); }
            .text-main { fill: var(--text-heading); }
            .text-dim { fill: var(--text-body); }
            .text-muted { fill: var(--text-muted); }
            .tag-fill { fill: var(--tag-fill); }
            .search-fill { fill: var(--search-fill); stroke: var(--search-stroke); }
          </style>

          <g class="layer">
            <rect fill="var(--bg)" stroke="none" stroke-width="0" x="28" y="3.16" width="460.16" height="309.84" id="main" class="main-bg"/>

            <g id="nav-group" class="nav-group">
              <rect fill="var(--nav-bg)" stroke="none" stroke-width="0" x="28" y="3.16" width="142" height="309.84" id="nav" class="nav-bg"/>
              <line x1="170" y1="3.16" x2="170" y2="313" stroke="var(--border)" stroke-width="1" id="nav-border" class="nav-border"/>
              <rect stroke="var(--search-stroke)" fill="var(--search-fill)" stroke-width="0.5" x="45.5" y="70.45" width="76" height="8" id="nav-search" rx="4" class="search-fill"/>
              <path stroke="none" id="svg_77" d="m134.18,77.83l-2.68,-2.68c0.36,-0.6 0.57,-1.3 0.57,-2.04c0,-2.18 -1.76,-3.95 -3.94,-3.95c-2.18,0 -3.95,1.77 -3.95,3.95c0,2.17 1.77,3.94 3.94,3.94c0.74,0 1.44,-0.21 2.04,-0.57l2.68,2.68l1.33,-1.33zm-8.49,-4.72c0,-1.35 1.09,-2.44 2.44,-2.45c1.34,0.01 2.43,1.1 2.44,2.45c-0.01,1.34 -1.1,2.43 -2.44,2.44c-1.35,-0.01 -2.44,-1.1 -2.44,-2.44z" stroke-width="0" fill="var(--text-body)" class="text-body"/>
              <rect fill="var(--tag-fill)" stroke="#000" stroke-width="0" x="52.4" y="92.95" width="74" height="7" id="nav-tag" rx="3" class="nav-tag tag-fill"/>
              <path id="nav-logo" class="nav-logo" d="m56.34,41.43c-0.43,1.19 -1.47,2.03 -2.68,2.03c-1.22,0 -2.25,-0.84 -2.68,-2.03l-6.57,3.13l1.85,4.88l2.03,-0.96l0,9.95l10.81,0l0,-9.92l1.96,0.93l1.85,-4.88l-6.57,-3.13l0,0z" stroke-width="0" stroke="#000" fill="#f87171"/>
              <rect fill="var(--primary)" stroke-width="0" x="52.4" y="140.6" width="66" height="6" id="selected-nav-item" rx="3" stroke="#000" class="selected-nav-item primary-accent"/>

              <g id="nav-items" class="nav-items">
                <rect fill="var(--text-muted)" stroke-width="0" x="52.4" y="104.25" width="45" height="6" id="svg_13" rx="3" stroke="#000" class="text-muted"/>
                <rect fill="var(--text-muted)" stroke-width="0" x="52.4" y="115.57" width="66" height="6" id="svg_14" rx="3" stroke="#000" class="text-muted"/>
                <rect fill="var(--text-muted)" stroke-width="0" x="52.4" y="127" width="45" height="6" id="svg_17" rx="3" stroke="#000" class="text-muted"/>
                <rect fill="var(--text-muted)" stroke-width="0" x="52.4" y="156.53" width="45" height="6" id="svg_29" rx="3" stroke="#000" class="text-muted"/>
                <rect fill="var(--text-muted)" stroke-width="0" x="52.4" y="167.85" width="66" height="6" id="svg_30" rx="3" stroke="#000" class="text-muted"/>
                <rect fill="var(--text-muted)" stroke-width="0" x="52.4" y="179.28" width="45" height="6" id="svg_33" rx="3" stroke="#000" class="text-muted"/>
                <rect fill="var(--text-muted)" stroke-width="0" x="52.4" y="194.13" width="45" height="6" id="svg_36" rx="3" stroke="#000" class="text-muted"/>
                <rect fill="var(--text-muted)" stroke-width="0" x="52.4" y="205.45" width="66" height="6" id="svg_37" rx="3" stroke="#000" class="text-muted"/>
                <rect fill="var(--text-muted)" stroke-width="0" x="52.4" y="216.88" width="45" height="6" id="svg_40" rx="3" stroke="#000" class="text-muted"/>
                <rect fill="var(--text-muted)" stroke-width="0" x="52.4" y="231.33" width="45" height="6" id="svg_43" rx="3" stroke="#000" class="text-muted"/>
                <rect fill="var(--text-muted)" stroke-width="0" x="52.4" y="242.65" width="66" height="6" id="svg_44" rx="3" stroke="#000" class="text-muted"/>
                <rect fill="var(--text-muted)" stroke-width="0" x="52.4" y="254.08" width="45" height="6" id="svg_59" rx="3" stroke="#000" class="text-muted"/>
              </g>

              <g id="nav-methods" class="nav-methods">
                <rect fill="#10b981" stroke-width="0" x="140.9" y="139.2" width="14.2" height="6.41" id="svg_20" rx="2"/>
                <rect fill="#10b981" stroke-width="0" x="140.6" y="103.24" width="14.2" height="6.41" id="svg_11" rx="2"/>
                <rect fill="#f43f5e" stroke-width="0" x="141" y="113.77" width="13.8" height="6.41" id="svg_7" rx="2"/>
                <rect fill="#0ea5e9" stroke-width="0" x="140.6" y="124.8" width="14.2" height="6.41" id="svg_18" rx="2"/>
                <rect fill="#10b981" stroke-width="0" x="140.6" y="155.52" width="14.2" height="6.41" id="svg_28" rx="2"/>
                <rect fill="#f43f5e" stroke-width="0" x="141" y="166.05" width="13.8" height="6.41" id="svg_31" rx="2"/>
                <rect fill="#0ea5e9" stroke-width="0" x="140.6" y="177.08" width="14.2" height="6.41" id="svg_32" rx="2"/>
                <rect fill="#10b981" stroke-width="0" x="140.6" y="193.12" width="14.2" height="6.41" id="svg_35" rx="2"/>
                <rect fill="#f43f5e" stroke-width="0" x="141" y="203.65" width="13.8" height="6.41" id="svg_38" rx="2"/>
                <rect fill="#0ea5e9" stroke-width="0" x="140.6" y="214.68" width="14.2" height="6.41" id="svg_39" rx="2"/>
                <rect fill="#10b981" stroke-width="0" x="140.6" y="230.32" width="14.2" height="6.41" id="svg_42" rx="2"/>
                <rect fill="#f43f5e" stroke-width="0" x="141" y="240.85" width="13.8" height="6.41" id="svg_45" rx="2"/>
                <rect fill="#0ea5e9" stroke-width="0" x="140.6" y="251.88" width="14.2" height="6.41" id="svg_46" rx="2"/>
              </g>
            </g>

            <g id="main-headings" class="main-headings">
              <!-- Section 1 Heading (Prominent) -->
              <rect fill="var(--text-heading)" stroke="#000" stroke-width="0" x="192" y="52.45" width="80" height="6" id="svg_3" rx="3" class="text-heading"/>
              <!-- Section 1 Body Lines (One shade darker than heading in dark, one shade lighter in light) -->
              <rect fill="var(--text-body)" stroke-width="0" x="192" y="68.95" width="25" height="6" id="svg_5" rx="3" stroke="#000" class="text-body"/>
              <rect fill="var(--text-body)" stroke-width="0" x="225" y="69.95" width="100" height="6" id="svg_8" rx="3" stroke="#000" class="text-body"/>
              <rect fill="var(--text-body)" stroke-width="0" x="192" y="83.95" width="200" height="6" id="svg_12" rx="3" stroke="#000" class="text-body"/>

              <!-- Section 2 Heading (Prominent) -->
              <rect fill="var(--text-heading)" stroke="#000" stroke-width="0" x="193" y="104.95" width="80" height="6" id="svg_48" rx="3" class="text-heading"/>
              <!-- Section 2 Body Lines (One shade darker than heading in dark, one shade lighter in light) -->
              <rect fill="var(--text-body)" stroke-width="0" x="193" y="114.63" width="25" height="6" id="svg_49" rx="3" stroke="#000" class="text-body"/>
              <rect fill="var(--text-body)" stroke-width="0" x="222.82" y="115.63" width="100" height="6" id="svg_50" rx="3" stroke="#000" class="text-body"/>
              <rect fill="var(--text-body)" stroke-width="0" x="193" y="125.54" width="200" height="6" id="svg_51" rx="3" stroke="#000" class="text-body"/>
            </g>

            <g id="post-endpoint" class="post-endpoint">
              <rect fill="var(--text-heading)" stroke="#000" stroke-width="0" x="223.3" y="149.99" width="80" height="6" id="svg_54" rx="3" class="text-heading"/>
              <rect fill="var(--text-body)" stroke-width="0" x="193.19" y="161.4" width="25" height="6" id="svg_55" rx="3" stroke="#000" class="text-body"/>
              <rect fill="var(--text-body)" stroke-width="0" x="229.53" y="161.4" width="100" height="6" id="svg_56" rx="3" stroke="#000" class="text-body"/>
              <rect fill="var(--text-body)" stroke-width="0" x="193.19" y="171.9" width="200" height="6" id="svg_57" rx="3" stroke="#000" class="text-body"/>
              <text fill="#10b981" stroke="none" stroke-width="0" x="197.05" y="151.36" id="post" font-size="10" font-family="Monospace" text-anchor="middle" xml:space="preserve" transform="matrix(1 0 0 0.717761 8.18182 46.956)" font-weight="bold" class="post">POST</text>
            </g>

            <!-- REQUEST SECTION (Left column in render-view mode) -->
            <g id="request-section" class="request-section">
