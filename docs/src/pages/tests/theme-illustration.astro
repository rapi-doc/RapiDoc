    const schemeButtons = document.querySelectorAll('#scheme-control .segment-btn');
    const presetButtons = document.querySelectorAll('#preset-control .segment-btn');
    const colorButtons = document.querySelectorAll('#swatches-control .color-btn');
    const accentPicker = document.getElementById('accent-picker') as HTMLInputElement | null;
    const customAccentWrapper = document.getElementById('custom-accent-wrapper');
    const customAccentPreview = document.getElementById('custom-color-preview');
    const bgButtons = document.querySelectorAll('#bg-swatches-control .color-btn');
