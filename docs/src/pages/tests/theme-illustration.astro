          primaryBorder: '#0f766e',
          textHeading: '#134e4a',
          textBody: '#0f766e'
        }
      }
    };

    function derivePalette(hex: string, scheme: 'dark' | 'light') {
      const hsl = hexToHsl(hex);
      if (scheme === 'dark') {
        return {
          bg: hslToHex(hsl.h, Math.min(hsl.s, 40), 14),
          navBg: hslToHex(hsl.h, Math.min(hsl.s, 45), 9),
          headerBg: hslToHex(hsl.h, Math.min(hsl.s, 50), 7),
          cardBg: hslToHex(hsl.h, Math.min(hsl.s, 35), 18),
          border: hslToHex(hsl.h, Math.min(hsl.s, 40), 27),
          primary: hex,
          primaryBorder: hslToHex(hsl.h, hsl.s, Math.max(hsl.l - 10, 20)),
          textHeading: '#ffffff',
          textBody: '#94a3b8'
        };
      } else {
        return {
          bg: hslToHex(hsl.h, Math.min(hsl.s, 65), 95),
          navBg: hslToHex(hsl.h, Math.min(hsl.s, 60), 90),
          headerBg: hslToHex(hsl.h, Math.min(hsl.s, 55), 85),
          cardBg: '#ffffff',
          border: hslToHex(hsl.h, Math.min(hsl.s, 50), 75),
          primary: hex,
          primaryBorder: hslToHex(hsl.h, hsl.s, Math.max(hsl.l - 12, 15)),
          textHeading: hslToHex(hsl.h, Math.min(hsl.s, 60), 16),
          textBody: hslToHex(hsl.h, Math.min(hsl.s, 40), 40)
        };
      }
    }

    let activeAccent = '#f59e0b';
    let isAutoBg = true;
    let manualBgColor = '#362a1a';

    function getActiveScheme(): 'dark' | 'light' {
      return svg.classList.contains('theme-light') ? 'light' : 'dark';
    }

    function applyTheme() {
      if (!svg) return;
      const scheme = getActiveScheme();
      const palette = colorPalettes[activeAccent]?.[scheme] || derivePalette(activeAccent, scheme);

      // 1. Apply accent color
      svg.style.setProperty('--primary', palette.primary);
      svg.style.setProperty('--primary-border', palette.primaryBorder);

      // 2. Apply background & derived layout colors
      if (isAutoBg) {
        svg.style.setProperty('--bg', palette.bg);
        svg.style.setProperty('--nav-bg', palette.navBg);
        svg.style.setProperty('--header-bg', palette.headerBg);
        svg.style.setProperty('--card-bg', palette.cardBg);
        svg.style.setProperty('--border', palette.border);
        svg.style.setProperty('--text-heading', palette.textHeading);
        svg.style.setProperty('--text-body', palette.textBody);

        if (bgPicker) bgPicker.value = palette.bg;
        if (customBgPreview) customBgPreview.style.background = palette.bg;

        bgButtons.forEach((btn) => {
          btn.classList.toggle('active', btn.getAttribute('data-bg') === 'auto');
        });
        customBgWrapper?.classList.remove('active');
      } else {
        const hsl = hexToHsl(manualBgColor);
        svg.style.setProperty('--bg', manualBgColor);
        if (scheme === 'dark') {
          svg.style.setProperty('--nav-bg', hslToHex(hsl.h, Math.min(hsl.s, 45), Math.max(hsl.l - 5, 5)));
          svg.style.setProperty('--header-bg', hslToHex(hsl.h, Math.min(hsl.s, 50), Math.max(hsl.l - 7, 4)));
          svg.style.setProperty('--card-bg', hslToHex(hsl.h, Math.min(hsl.s, 30), Math.min(hsl.l + 5, 25)));
          svg.style.setProperty('--border', hslToHex(hsl.h, Math.min(hsl.s, 35), Math.min(hsl.l + 12, 35)));
          svg.style.setProperty('--text-heading', '#ffffff');
          svg.style.setProperty('--text-body', '#94a3b8');
        } else {
          svg.style.setProperty('--nav-bg', hslToHex(hsl.h, Math.min(hsl.s, 45), Math.max(hsl.l - 5, 80)));
          svg.style.setProperty('--header-bg', hslToHex(hsl.h, Math.min(hsl.s, 50), Math.max(hsl.l - 8, 75)));
          svg.style.setProperty('--card-bg', '#ffffff');
          svg.style.setProperty('--border', hslToHex(hsl.h, Math.min(hsl.s, 35), Math.max(hsl.l - 15, 65)));
          svg.style.setProperty('--text-heading', '#1e1b16');
          svg.style.setProperty('--text-body', '#78716c');
        }

        if (bgPicker) bgPicker.value = manualBgColor;
        if (customBgPreview) customBgPreview.style.background = manualBgColor;

        bgButtons.forEach((btn) => {
          btn.classList.toggle('active', btn.getAttribute('data-bg') === manualBgColor);
        });
      }

      // 3. Highlight matching accent swatch or custom picker
      let matchedAccentBtn = false;
      colorButtons.forEach((cb) => {
        const isMatch = cb.getAttribute('data-color') === activeAccent;
        cb.classList.toggle('active', isMatch);
        if (isMatch) matchedAccentBtn = true;
      });

      if (customAccentWrapper) {
        customAccentWrapper.classList.toggle('active', !matchedAccentBtn);
      }
      if (accentPicker) accentPicker.value = activeAccent;
      if (customAccentPreview) customAccentPreview.style.background = activeAccent;

      // 4. Sync preset segmented control and SVG classes
      presetButtons.forEach((pb) => {
        const p = pb.getAttribute('data-preset');
        if (p === 'amber' && activeAccent === '#f59e0b') pb.classList.add('active');
        else if (p === 'emerald' && activeAccent === '#10b981') pb.classList.add('active');
        else pb.classList.remove('active');
      });

      if (activeAccent === '#10b981') {
        svg.classList.add('preset-emerald');
      } else {
        svg.classList.remove('preset-emerald');
      }

      updateStateReadout();
    }

    function updateStateReadout() {
      if (!svg) return;
      if (stateClasses) {
        stateClasses.textContent = svg.getAttribute('class') || '';
      }
      if (stateBg) {
        stateBg.textContent = svg.style.getPropertyValue('--bg') || '#22242b';
      }
      if (stateAccent) {
        stateAccent.textContent = svg.style.getPropertyValue('--primary') || '#f59e0b';
      }
    }

    // 0. Render Style (Focused vs View)
    renderButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const render = btn.getAttribute('data-render');
        renderButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        if (render === 'view') {
          svg.classList.add('render-view');
        } else {
          svg.classList.remove('render-view');
        }
        updateStateReadout();
      });
    });

    // 1. Show/Hide Header
    if (toggleHeader) {
      toggleHeader.addEventListener('change', () => {
        if (toggleHeader.checked) {
          svg.classList.remove('hide-header');
        } else {
          svg.classList.add('hide-header');
        }
        updateStateReadout();
      });
    }

    // 2. Show/Hide Nav Logo
    if (toggleNavLogo) {
      toggleNavLogo.addEventListener('change', () => {
        if (toggleNavLogo.checked) {
          svg.classList.remove('hide-nav-logo');
        } else {
          svg.classList.add('hide-nav-logo');
        }
        updateStateReadout();
      });
    }

    // 3. Show/Hide Nav Methods
    if (toggleNavMethods) {
      toggleNavMethods.addEventListener('change', () => {
        if (toggleNavMethods.checked) {
          svg.classList.remove('hide-nav-methods');
        } else {
          svg.classList.add('hide-nav-methods');
        }
        updateStateReadout();
      });
    }

    // 4. Dark / Light Scheme
    schemeButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const scheme = btn.getAttribute('data-scheme');
        schemeButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        if (scheme === 'light') {
          svg.classList.add('theme-light');
        } else {
          svg.classList.remove('theme-light');
        }

        applyTheme();
      });
    });

    // 5. Preset Switcher (Amber vs Emerald)
    presetButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const preset = btn.getAttribute('data-preset');
        if (!preset) return;
        presetButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        activeAccent = preset === 'emerald' ? '#10b981' : '#f59e0b';
        isAutoBg = true;
        applyTheme();
      });
    });

    // 6. Accent Color Swatches & Picker (Changing accent immediately updates background)
    colorButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const color = btn.getAttribute('data-color');
        if (!color) return;

        activeAccent = color;
        isAutoBg = true;
        applyTheme();
      });
    });

    if (accentPicker) {
      accentPicker.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        activeAccent = target.value;
        isAutoBg = true;
        applyTheme();
      });
    }

    // 7. Background Color Swatches & Picker (Direct background testing)
    bgButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const bgVal = btn.getAttribute('data-bg');
        if (!bgVal) return;

        if (bgVal === 'auto') {
          isAutoBg = true;
        } else {
          isAutoBg = false;
          manualBgColor = bgVal;
        }
        applyTheme();
      });
    });

    if (bgPicker) {
      bgPicker.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        isAutoBg = false;
        manualBgColor = target.value;
        customBgWrapper?.classList.add('active');
        applyTheme();
      });
    }

    // Initial setup
    applyTheme();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupThemeIllustration);
  } else {
    setupThemeIllustration();
  }
  document.addEventListener('astro:page-load', setupThemeIllustration);
</script>
