---
import TestCaseLayout from '../../layouts/TestCaseLayout.astro';
import PrettyRapidocTuner from '../../components/PrettyRapidocTuner.astro';
---

<TestCaseLayout
  title="Test | Demo All Config Using PrettyRapidocTuner | RapiDoc"
  description="PrettyRapidocTuner to configure RapiDoc with all options"
  specUrl="/specs-test/petstore.yaml"
  preset={['all']}
  tuckedRight={false}
  controller={PrettyRapidocTuner}
  controllerSize="large"
  rapidocProps={{
    'render-style': 'read',
    'show-info': 'true',
    'show-header': 'false',
  }}
>
  <!-- Custom test action button injected into the PrettyRapidocTuner via slot="controller" -->
  <button
    slot="controller"
    type="button"
    class="rd-pretty-action-btn"
    style="width: 100%; border-color: rgba(56, 189, 248, 0.4); color: #38bdf8; justify-content: flex-start; padding: 8px 12px; height: auto;"
    onclick="const doc = document.getElementById('thedoc'); if (doc) { doc.scrollTo('get-/pet/findByStatus'); }"
    title="Programmatically scroll to the findByStatus endpoint using doc.scrollTo()"
  >
    <span>📍 Scroll to findByStatus</span>
  </button>
</TestCaseLayout>
