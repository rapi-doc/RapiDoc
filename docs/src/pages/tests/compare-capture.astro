---
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';

// Dedicated capture page to generate pixel-perfect, high-contrast dark and light screenshots
const theme = Astro.url.searchParams.get('theme') || 'dark';
const isDark = theme === 'dark';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <GoogleAnalytics />
  <script type="module" src="/rapidoc/rapidoc-min.js"></script>
  <style>
    body {
      margin: 0;
      padding: 0;
      overflow: hidden;
      background: {isDark ? '#0b0f19' : '#ffffff'};
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    rapi-doc {
      width: 100vw;
      height: 100vh;
    }
  </style>
</head>
<body>
  <rapi-doc
    id="thedoc"
    spec-url="/specs/petstore.yaml"
    render-style="view"
    color-scheme={isDark ? "dark" : "light"}
    theme={isDark ? "#10b981" : "#059669"}
    show-header="false"
    show-info="false"
    show-components="false"
    allow-server-selection="false"
    allow-authentication="false"
    heading-text="Swagger Petstore OpenAPI 3.0"
  >
  </rapi-doc>

  <script is:inline>
    // Wait for rapi-doc to render, then auto-expand an endpoint for rich visuals
    document.addEventListener('DOMContentLoaded', () => {
      setTimeout(() => {
        const doc = document.getElementById('thedoc');
        if (doc && doc.shadowRoot) {
          // expand the first endpoint or section
          const ep = doc.shadowRoot.querySelector('.m-endpoint');
          if (ep) {
            ep.click();
          }
        }
      }, 1200);
    });
  </script>
</body>
</html>
