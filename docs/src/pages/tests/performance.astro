<script>
  // Interactive Benchmark Logic with Custom Dropdowns
  const specDropdown = document.getElementById('custom-spec-dropdown');
  const specTrigger = specDropdown?.querySelector('.rd-custom-select-trigger') as HTMLButtonElement | null;
  const specText = specDropdown?.querySelector('.rd-selected-text');
  const specOptions = specDropdown?.querySelectorAll<HTMLElement>('.rd-select-option');

  const modeDropdown = document.getElementById('custom-mode-dropdown');
  const modeTrigger = modeDropdown?.querySelector('.rd-custom-select-trigger') as HTMLButtonElement | null;
  const modeText = modeDropdown?.querySelector('.rd-selected-text');
  const modeOptions = modeDropdown?.querySelectorAll<HTMLElement>('.rd-select-option');

  const runBtn = document.getElementById('benchmark-run-btn');
  const statSize = document.getElementById('stat-size');
  const statOps = document.getElementById('stat-ops');
  const statSchemas = document.getElementById('stat-schemas');
  const statTimer = document.getElementById('stat-timer');
  const statusMsg = document.getElementById('sandbox-status');
  const placeholder = document.getElementById('benchmark-placeholder');
  const host = document.getElementById('benchmark-host');

  let currentSpec = {
    value: 'mega',
    url: '/specs/large-spec-v3.json',
    size: '4.8 MB',
    ops: '917',
    schemas: '2,511',
    label: 'Mega API Matrix (900+ Operations, 4.8 MB)',
  };

  let currentMode = 'focused';

  function updateScoreboard() {
    if (statSize) statSize.textContent = currentSpec.size;
    if (statOps) statOps.textContent = currentSpec.ops;
    if (statSchemas) statSchemas.textContent = currentSpec.schemas;
  }

  // Toggle Spec Dropdown
  specTrigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = specDropdown?.classList.toggle('is-open');
    specTrigger.setAttribute('aria-expanded', String(isOpen));
    modeDropdown?.classList.remove('is-open');
    modeTrigger?.setAttribute('aria-expanded', 'false');
  });

  // Toggle Mode Dropdown
  modeTrigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = modeDropdown?.classList.toggle('is-open');
    modeTrigger.setAttribute('aria-expanded', String(isOpen));
    specDropdown?.classList.remove('is-open');
    specTrigger?.setAttribute('aria-expanded', 'false');
  });

  // Spec Selection
  specOptions?.forEach((opt) => {
    opt.addEventListener('click', () => {
      const val = opt.getAttribute('data-value') || '';
      const url = opt.getAttribute('data-url') || '';
      const size = opt.getAttribute('data-size') || '';
      const ops = opt.getAttribute('data-ops') || '';
      const schemas = opt.getAttribute('data-schemas') || '';
      const label = opt.getAttribute('data-label') || opt.querySelector('.rd-option-label')?.textContent || '';

      currentSpec = { value: val, url, size, ops, schemas, label };

      if (specText) specText.textContent = label;

      specOptions.forEach((o) => {
        o.classList.remove('is-selected');
        o.removeAttribute('aria-selected');
      });
      opt.classList.add('is-selected');
      opt.setAttribute('aria-selected', 'true');

      specDropdown?.classList.remove('is-open');
      specTrigger?.setAttribute('aria-expanded', 'false');

      updateScoreboard();
    });
  });

  // Mode Selection
  modeOptions?.forEach((opt) => {
    opt.addEventListener('click', () => {
      const val = opt.getAttribute('data-value') || 'focused';
      const label = opt.getAttribute('data-label') || opt.querySelector('.rd-option-label')?.textContent || '';

      currentMode = val;
      if (modeText) modeText.textContent = label;

      modeOptions.forEach((o) => {
        o.classList.remove('is-selected');
        o.removeAttribute('aria-selected');
      });
      opt.classList.add('is-selected');
      opt.setAttribute('aria-selected', 'true');

      modeDropdown?.classList.remove('is-open');
      modeTrigger?.setAttribute('aria-expanded', 'false');
    });
  });

  // Close dropdowns on outside click
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest('#custom-spec-dropdown')) {
      specDropdown?.classList.remove('is-open');
      specTrigger?.setAttribute('aria-expanded', 'false');
    }
    if (!target.closest('#custom-mode-dropdown')) {
      modeDropdown?.classList.remove('is-open');
      modeTrigger?.setAttribute('aria-expanded', 'false');
    }
  });

  // Close dropdowns on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      specDropdown?.classList.remove('is-open');
      specTrigger?.setAttribute('aria-expanded', 'false');
      modeDropdown?.classList.remove('is-open');
      modeTrigger?.setAttribute('aria-expanded', 'false');
    }
  });

  // Initialize Scoreboard
  updateScoreboard();

  // Execute Live Benchmark
  runBtn?.addEventListener('click', () => {
    if (!host) return;

    if (placeholder) placeholder.style.display = 'none';
    host.style.display = 'block';

    if (statusMsg) {
      statusMsg.textContent = 'Parsing specification & rendering DOM...';
      statusMsg.className = 'rd-sandbox-status status-loading';
    }

    if (statTimer) {
      statTimer.textContent = 'Measuring...';
      statTimer.className = 'rd-score-val text-amber';
    }

    // High precision timing start
    const startTime = performance.now();

    // Create fresh rapi-doc element to avoid caching artifacts
    host.innerHTML = '';
    const rapidocEl = document.createElement('rapi-doc');
    rapidocEl.setAttribute('spec-url', currentSpec.url);
    rapidocEl.setAttribute('render-style', currentMode);
    rapidocEl.setAttribute('schema-style', 'table');
    rapidocEl.setAttribute('theme', 'dark');
    rapidocEl.setAttribute('bg-color', '#090d16');
    rapidocEl.setAttribute('primary-color', '#10b981');
    rapidocEl.setAttribute('show-header', 'false');
    rapidocEl.setAttribute('allow-try', 'true');
    rapidocEl.setAttribute('schema-expand-level', '1');
    rapidocEl.style.width = '100%';
    rapidocEl.style.height = '100%';

    rapidocEl.addEventListener(
      'spec-loaded',
      () => {
        const elapsed = Math.round(performance.now() - startTime);
        if (statTimer) {
          statTimer.textContent = `${elapsed} ms`;
          statTimer.className = 'rd-score-val text-emerald pulse';
        }
        if (statusMsg) {
          statusMsg.textContent = `Completed in ${elapsed} ms (${currentMode} mode)`;
          statusMsg.className = 'rd-sandbox-status status-success';
        }
      },
      { once: true }
    );

    host.appendChild(rapidocEl);
  });
</script>

