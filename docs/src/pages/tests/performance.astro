---
import GlobalLayout from '../../layouts/GlobalLayout.astro';
import SiteNavbar from '../../components/SiteNavbar.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { benchmarkData } from '../../page-data/performance-benchmarks';
import { rapidocBuildInfo } from '../../page-data/rapidoc-build-info';

const swaggerConvertCode = `# Optional: Only required if using legacy Swagger 2.0 specs
# 1. Install swagger2openapi globally
npm install -g swagger2openapi

# 2. Convert Swagger 2.0 to OpenAPI 3.0 during CI/CD build
swagger2openapi swagger.json --outfile openapi3.json --yaml false

# 3. Supply pre-converted spec directly to RapiDoc (zero browser conversion overhead)
<rapi-doc spec-url="/specs/openapi3.json"></rapi-doc>`;

const renderModeCode = `<!-- Switch from "read" to "focused" or "view" mode for 100+ endpoints -->
<rapi-doc
  spec-url="/specs/enterprise-large-spec.json"
  render-style="focused"
  schema-style="table"
></rapi-doc>`;

const tuningConfigCode = `<!-- Optimal configuration for 5MB+ mega specifications -->
<rapi-doc
  spec-url="/specs/enterprise-huge-spec.json"
  render-style="focused"
  schema-style="table"
  schema-expand-level="1"
  default-schema-tab="schema"
  show-header="false"
  theme="dark"
  bg-color="#0a0f1d"
  primary-color="#10b981"
  allow-try="true"
></rapi-doc>`;

const miniSnippetCode = `<!-- Pluck and render only a specific endpoint from a multi-megabyte spec -->
<script type="module" src="https://unpkg.com/rapidoc/dist/rapidoc-min.js"></script>

<rapi-doc-mini
  spec-url="/specs/enterprise-huge-spec.json"
  match-paths="get /users/{id}"
  theme="dark"
></rapi-doc-mini>`;

const esmImportCode = `// Native ES Module import in modern frameworks
import 'rapidoc';

// Or in vanilla HTML with zero bundlers:
<script type="module" src="https://unpkg.com/rapidoc/dist/rapidoc-min.js"></script>`;
---

<GlobalLayout
  title="Performance Benchmarks & Large Spec Optimization | RapiDoc"
  description="Compare RapiDoc rendering speed, memory consumption, and bundle size against Swagger UI and Redoc. Learn tuning techniques for multi-megabyte OpenAPI specs."
  keywords="RapiDoc performance, OpenAPI benchmark, Swagger UI speed comparison, Redoc alternative performance, large OpenAPI specs"
>
  <!-- Ambient background glow elements -->
  <div class="ambient-glow glow-emerald"></div>
  <div class="ambient-glow glow-cyan"></div>
  <div class="ambient-glow glow-purple"></div>

  <!-- RapiDoc Component Registration for Interactive Benchmark -->
  <script slot="script" is:inline type="module" src="/rapidoc/rapidoc-min.js"></script>

  <!-- Site Navbar -->
  <SiteNavbar activePage="tests" />

  <main class="rd-perf-page">
    <!-- Hero Section -->
    <header class="rd-perf-hero">
      <div class="rd-badge-pill">
        <span class="rd-badge-pulse"></span>
        <span class="rd-badge-text">Architecture & High-Scale Benchmarks</span>
      </div>

      <h1 class="rd-hero-title">
        Engineered for Speed. <br />
        <span class="rd-gradient-text">Zero DOM Bloat at Any Scale.</span>
      </h1>

      <p class="rd-hero-subtitle">
        Discover how RapiDoc parses and renders multi-megabyte OpenAPI specifications in under 500 milliseconds using native W3C Web
        Components, a pure ESM distribution, the CSS Custom Highlight API, and a non-blocking streaming engine.
      </p>

      <!-- Key Performance Indicators (KPIs) -->
      <div class="rd-kpi-grid">
        <div class="rd-kpi-card">
          <div class="rd-kpi-val">~{rapidocBuildInfo.bundle.gzip.formatted}</div>
          <div class="rd-kpi-label">Self-Contained Bundle</div>
          <div class="rd-kpi-desc">
            Gzipped single script ({rapidocBuildInfo.bundle.minified.formatted} minified). Zero external stylesheets, no font downloads, no framework
            overhead.
          </div>
        </div>

        <div class="rd-kpi-card">
          <div class="rd-kpi-val">0 <span class="rd-kpi-unit">ms</span></div>
          <div class="rd-kpi-label">Virtual DOM Diffing</div>
          <div class="rd-kpi-desc">Native W3C Web Component. Reactive direct DOM updates with zero tree diffing lag or memory leaks.</div>
        </div>

        <div class="rd-kpi-card">
          <div class="rd-kpi-val">0 <span class="rd-kpi-unit">Elements</span></div>
          <div class="rd-kpi-label">Nested Code Token Spans</div>
          <div class="rd-kpi-desc">W3C CSS Custom Highlight API paints syntax directly on raw text. No 50,000-span DOM explosion.</div>
        </div>

        <div class="rd-kpi-card">
          <div class="rd-kpi-val">&lt; 450 <span class="rd-kpi-unit">ms</span></div>
          <div class="rd-kpi-label">900+ Endpoints Rendered</div>
          <div class="rd-kpi-desc">Sub-half-second initial paint on massive 4.8MB enterprise specifications with 2,500+ schemas.</div>
        </div>
      </div>
    </header>

    <!-- Interactive Live Benchmark Studio -->
    <section class="rd-section" id="live-benchmark">
      <div class="rd-section-header">
        <div class="rd-section-badge">Live Interactive Lab</div>
        <h2 class="rd-section-title">Benchmark Real Large Specs</h2>
        <p class="rd-section-desc">
          Test real OpenAPI specifications live in your browser. Measure exact parsing and rendering times with high-precision browser
          timers.
        </p>
      </div>

      <div class="rd-benchmark-studio">
        <!-- Control Bar -->
        <div class="rd-studio-controls">
          <div class="rd-control-group">
            <span class="rd-control-label" id="label-spec-select">Select Specification:</span>
            <div class="rd-custom-select" id="custom-spec-dropdown">
              <button
                type="button"
                class="rd-custom-select-trigger"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-labelledby="label-spec-select"
              >
                <span class="rd-selected-text">Mega API Matrix (900+ Operations, 4.8 MB)</span>
                <svg
                  class="rd-select-arrow"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <div class="rd-custom-select-menu" role="listbox">
                <div
                  class="rd-select-option"
                  data-value="petstore"
                  data-label="Swagger Petstore (Baseline, 24 KB)"
                  data-size="24 KB"
                  data-ops="20"
                  data-schemas="6"
                  data-url="/specs/petstore-3-0-3.yaml"
                  role="option"
                  tabindex="0"
                >
                  <div class="rd-option-main">
                    <span class="rd-option-label">Swagger Petstore</span>
                    <span class="rd-option-badge">Baseline, 24 KB</span>
                  </div>
                  <svg
                    class="rd-option-check"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>

                <div
                  class="rd-select-option"
                  data-value="enterprise"
                  data-label="Enterprise Cluster (Deep Schemas, 3.2 MB)"
                  data-size="3.2 MB"
                  data-ops="38"
                  data-schemas="3,010"
                  data-url="/specs/large-spec2-v3.json"
                  role="option"
                  tabindex="0"
                >
                  <div class="rd-option-main">
                    <span class="rd-option-label">Enterprise Cluster</span>
                    <span class="rd-option-badge">Deep Schemas, 3.2 MB</span>
                  </div>
                  <svg
                    class="rd-option-check"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>

                <div
                  class="rd-select-option is-selected"
                  data-value="mega"
                  data-label="Mega API Matrix (900+ Operations, 4.8 MB)"
                  data-size="4.8 MB"
                  data-ops="917"
                  data-schemas="2,511"
                  data-url="/specs/large-spec-v3.json"
                  role="option"
                  aria-selected="true"
                  tabindex="0"
                >
                  <div class="rd-option-main">
                    <span class="rd-option-label">Mega API Matrix</span>
                    <span class="rd-option-badge">900+ Operations, 4.8 MB</span>
                  </div>
                  <svg
                    class="rd-option-check"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
              </div>
            </div>
          </div>

          <div class="rd-control-group">
            <span class="rd-control-label" id="label-mode-select">Render Mode:</span>
            <div class="rd-custom-select" id="custom-mode-dropdown">
              <button
                type="button"
                class="rd-custom-select-trigger"
                aria-haspopup="listbox"
                aria-expanded="false"
                aria-labelledby="label-mode-select"
              >
                <span class="rd-selected-text">Focused (Fastest - 1 active endpoint)</span>
                <svg
                  class="rd-select-arrow"
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <div class="rd-custom-select-menu" role="listbox">
                <div
                  class="rd-select-option is-selected"
                  data-value="focused"
                  data-label="Focused (Fastest - 1 active endpoint)"
                  role="option"
                  aria-selected="true"
                  tabindex="0"
                >
                  <div class="rd-option-main">
                    <span class="rd-option-label">Focused</span>
                    <span class="rd-option-badge">Fastest - 1 active endpoint</span>
                  </div>
                  <svg
                    class="rd-option-check"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>

                <div class="rd-select-option" data-value="view" data-label="View (Collapsible sections)" role="option" tabindex="0">
                  <div class="rd-option-main">
                    <span class="rd-option-label">View</span>
                    <span class="rd-option-badge">Collapsible sections</span>
                  </div>
                  <svg
                    class="rd-option-check"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>

                <div class="rd-select-option" data-value="read" data-label="Read (Full linear document)" role="option" tabindex="0">
                  <div class="rd-option-main">
                    <span class="rd-option-label">Read</span>
                    <span class="rd-option-badge">Full linear document</span>
                  </div>
                  <svg
                    class="rd-option-check"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
              </div>
            </div>
          </div>

          <button id="benchmark-run-btn" class="rd-btn rd-btn-primary">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
            <span>Run Benchmark</span>
          </button>
        </div>

        <!-- Live Scoreboard -->
        <div class="rd-scoreboard">
          <div class="rd-score-item">
            <span class="rd-score-label">Spec File Size</span>
            <span class="rd-score-val" id="stat-size">4.8 MB</span>
          </div>
          <div class="rd-score-item">
            <span class="rd-score-label">Total Operations</span>
            <span class="rd-score-val" id="stat-ops">917</span>
          </div>
          <div class="rd-score-item">
            <span class="rd-score-label">Schema Models</span>
            <span class="rd-score-val" id="stat-schemas">2,511</span>
          </div>
          <div class="rd-score-item highlight-score">
            <span class="rd-score-label">Render & Parse Time</span>
            <span class="rd-score-val text-emerald" id="stat-timer">Ready to test</span>
          </div>
        </div>

        <!-- Benchmark Output Sandbox -->
        <div class="rd-sandbox-frame">
          <div class="rd-sandbox-header">
            <div class="rd-window-dots">
              <span class="rd-dot red"></span>
              <span class="rd-dot yellow"></span>
              <span class="rd-dot green"></span>
            </div>
            <span class="rd-sandbox-status" id="sandbox-status">Click "Run Benchmark" to render live</span>
          </div>
          <div class="rd-sandbox-viewport" id="benchmark-viewport">
            <div class="rd-placeholder-state" id="benchmark-placeholder">
              <div class="rd-placeholder-icon">
                <svg
                  width="26"
                  height="26"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                </svg>
              </div>
              <h3>Interactive Performance Sandbox</h3>
              <p>Choose an enterprise specification above and click <strong>Run Benchmark</strong> to load and time RapiDoc live.</p>
            </div>
            <div id="benchmark-host" style="display: none; width: 100%; height: 600px;"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Large Spec Benchmark Comparison Table -->
    <section class="rd-section">
      <div class="rd-section-header">
        <div class="rd-section-badge">Empirical Results</div>
        <h2 class="rd-section-title">Tested Specifications & Benchmark Metrics</h2>
        <p class="rd-section-desc">Measured in Chromium on Apple Silicon (M-series) running single-threaded JavaScript execution:</p>
      </div>

      <div class="rd-table-container">
        <table class="rd-perf-table">
          <thead>
            <tr>
              <th>Specification</th>
              <th>Format</th>
              <th>File Size</th>
              <th>Operations</th>
              <th>Schemas</th>
              <th>Focused Mode</th>
              <th>View Mode</th>
              <th>Read Mode</th>
              <th>DOM Nodes (Focused)</th>
              <th>Scroll Stability</th>
            </tr>
          </thead>
          <tbody>
            {
              benchmarkData.benchmarks.map((item) => (
                <tr>
                  <td class="font-semibold text-white">
                    <div>{item.name}</div>
                    <span class="rd-table-sub">{item.subtitle}</span>
                  </td>
                  <td>
                    <code>{item.format}</code>
                  </td>
                  <td>{item.fileSize}</td>
                  <td>{item.operations}</td>
                  <td>{item.schemas}</td>
                  <td>
                    <span class="rd-pill-fast rd-pill-focused">{item.focusedModeTime}</span>
                  </td>
                  <td>
                    <span class="rd-pill-fast rd-pill-view">{item.viewModeTime}</span>
                  </td>
                  <td>
                    <span class="rd-pill-fast rd-pill-read">{item.readModeTime}</span>
                  </td>
                  <td>{item.domNodesFocused}</td>
                  <td>
                    <span class="text-emerald">{item.scrollStability}</span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <!-- Architectural Deep-Dive Grid -->
    <section class="rd-section" id="architecture">
      <div class="rd-section-header">
        <div class="rd-section-badge">Engineering Deep Dive</div>
        <h2 class="rd-section-title">Why RapiDoc Outperforms Traditional Documentation</h2>
        <p class="rd-section-desc">Four foundational engineering breakthroughs that enable instantaneous loads and flat memory profiles:</p>
      </div>

      <div class="rd-arch-grid">
        <!-- Card 1: Bundle Size & Zero CSS downloads -->
        <div class="rd-arch-card">
          <div class="rd-card-header">
            <span class="rd-card-badge badge-emerald">Design & Tooling</span>
            <span class="rd-card-time">~{rapidocBuildInfo.bundle.gzip.formatted} gzipped</span>
          </div>
          <div class="rd-card-icon-wrap">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"
              ></path>
              <path d="m3.3 7 8.7 5 8.7-5"></path>
              <path d="M12 22V12"></path>
            </svg>
          </div>
          <h3 class="rd-card-title">Ultra-Lean Bundle by Design</h3>
          <p class="rd-card-desc">
            The ~{rapidocBuildInfo.bundle.gzip.formatted} gzipped size is not from post-build compression tricks, but deliberate design and tooling
            choices. By relying on native browser standards, lightweight Lit primitives, and zero third-party UI framework runtimes or external
            CSS stylesheets, RapiDoc stays lean and bloat-free.
          </p>
          <div class="rd-card-tags">
            <span class="rd-card-tag">Deliberate Architecture</span>
            <span class="rd-card-tag">Zero External CSS</span>
            <span class="rd-card-tag">No Framework Bloat</span>
          </div>
        </div>

        <!-- Card 2: Modern ESM Distribution -->
        <div class="rd-arch-card">
          <div class="rd-card-header">
            <span class="rd-card-badge badge-blue">Modern Runtime</span>
            <span class="rd-card-time">Native ES Modules</span>
          </div>
          <div class="rd-card-icon-wrap">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
          </div>
          <h3 class="rd-card-title">Native ESM Build (Modern JS)</h3>
          <p class="rd-card-desc">
            RapiDoc is compiled and distributed as standard ECMAScript Modules (ESM), fully aligned with modern browser engines and modern
            bundlers (Vite, Rollup, Webpack 5).
          </p>
          <div class="rd-card-tags">
            <span class="rd-card-tag">Native Browser Loading</span>
            <span class="rd-card-tag">HTTP/2 Streaming</span>
            <span class="rd-card-tag">Universal Frameworks</span>
          </div>
        </div>

        <!-- Card 3: Native Web Component & Zero VDOM Diffing -->
        <div class="rd-arch-card">
          <div class="rd-card-header">
            <span class="rd-card-badge badge-purple">DOM Engine</span>
            <span class="rd-card-time">0 ms VDOM Diffing</span>
          </div>
          <div class="rd-card-icon-wrap">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5.5 8.5 9 12l-3.5 3.5L2 12l3.5-3.5Z"></path>
              <path d="m12 2 3.5 3.5L12 9 8.5 5.5 12 2Z"></path>
              <path d="M18.5 8.5 22 12l-3.5 3.5L15 12l3.5-3.5Z"></path>
              <path d="m12 15 3.5 3.5L12 22l-3.5-3.5L12 15Z"></path>
            </svg>
          </div>
          <h3 class="rd-card-title">Native Web Component</h3>
          <p class="rd-card-desc">
            Built on W3C Web Component standards powered by Lit. Traditional React or Vue documentation tools must create and reconcile an
            internal Virtual DOM tree for every endpoint and schema expansion.
          </p>
          <div class="rd-card-tags">
            <span class="rd-card-tag">Direct DOM Updates</span>
            <span class="rd-card-tag">Zero GC Stalls</span>
            <span class="rd-card-tag">True Shadow DOM</span>
          </div>
        </div>

        <!-- Card 4: CSS Custom Highlight API -->
        <div class="rd-arch-card">
          <div class="rd-card-header">
            <span class="rd-card-badge badge-cyan">Syntax Rendering</span>
            <span class="rd-card-time">W3C Highlight API</span>
          </div>
          <div class="rd-card-icon-wrap">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle>
              <circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle>
              <circle cx="8.5" cy="7.5" r=".5" fill="currentColor"></circle>
              <circle cx="6.5" cy="12.5" r=".5" fill="currentColor"></circle>
              <path
                d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"
              ></path>
            </svg>
          </div>
          <h3 class="rd-card-title">CSS Custom Highlight API</h3>
          <p class="rd-card-desc">
            Syntax highlighters like Prism.js and Highlight.js shred code snippets into thousands of nested <code>&lt;span&gt;</code> elements.
            On large 2MB payloads, this generates 50,000+ DOM nodes, freezing the browser.
          </p>
          <div class="rd-card-tags">
            <span class="rd-card-tag">Zero Extra Nodes</span>
            <span class="rd-card-tag">Flat Memory Footprint</span>
            <span class="rd-card-tag">GPU Accelerated</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Code Highlighting Comparison Visual -->
    <section class="rd-section">
      <div class="rd-section-header">
        <div class="rd-section-badge">DOM Architecture Comparison</div>
        <h2 class="rd-section-title">Traditional Highlighting vs. RapiDoc Highlighting</h2>
        <p class="rd-section-desc">How RapiDoc prevents the "DOM Explosion" problem on multi-megabyte API payloads:</p>
      </div>

      <div class="rd-compare-columns">
        <div class="rd-compare-col bad">
          <div class="rd-compare-head">
            <span class="rd-cross-icon">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="15" y1="9" x2="9" y2="15"></line>
                <line x1="9" y1="9" x2="15" y2="15"></line>
              </svg>
            </span>
            <div>
              <h3>Traditional Highlighters (Prism / Highlight.js)</h3>
              <span class="rd-dom-stat">~45,000 DOM Nodes on 2MB JSON</span>
            </div>
          </div>
          <div class="rd-compare-code">
            <pre><code>{`<!-- Explodes into thousands of DOM nodes -->
