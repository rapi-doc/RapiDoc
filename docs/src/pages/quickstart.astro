---
import GlobalLayout from '../layouts/GlobalLayout.astro';
import SiteNavbar from '../components/SiteNavbar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CodeBlock from '../components/CodeBlock.astro';
import { IconSearch, IconSearchOff, IconX, IconArrowUpRight, IconArrowRight } from '@tabler/icons-astro';

interface Recipe {
  id: string;
  title: string;
  category: 'Getting Started' | 'Layout & Modes' | 'Theming & Branding' | 'Slots & Custom HTML' | 'JavaScript & DOM Interaction';
  summary: string;
  demoUrl?: string;
  code: string;
  lang: string;
  filename: string;
  tags: string[];
}

const recipes: Recipe[] = [
  // ================= GETTING STARTED =================
  {
    id: 'minimal-html',
    title: 'Zero-Config HTML Embed',
    category: 'Getting Started',
    summary:
      'The simplest way to embed RapiDoc. Import the ES module directly from a CDN (unpkg or jsdelivr) and add the <rapi-doc> custom element with your OpenAPI spec URL. No build tools or backend server required.',
    demoUrl: '/examples/petstore',
    code: `<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8"> <!-- Required: RapiDoc uses UTF-8 characters -->
    <script type="module" src="https://unpkg.com/rapidoc/dist/rapidoc-min.js"></script>
  </head>
  <body>
    <rapi-doc 
      spec-url="https://petstore.swagger.io/v2/swagger.json"
    > </rapi-doc>
  </body>
</html>`,
    lang: 'html',
    filename: 'index.html',
    tags: ['CDN', 'HTML5', 'Zero-Config', 'Quickstart'],
  },
  {
    id: 'npm-frameworks',
    title: 'Modern Bundlers & Frameworks (React, Vue, Vite)',
    category: 'Getting Started',
    summary:
      'Install RapiDoc as an npm dependency. Because it is a standardized W3C Web Component, it runs natively inside React, Vue, Svelte, Angular, Astro, Next.js, and Vite without framework-specific wrappers.',
    demoUrl: '/docs/get-started/frameworks/',
    code: `// 1. Install via npm or yarn:
// npm install rapidoc

// 2. Import into your application entrypoint:
import 'rapidoc';

// Example in React:
export function ApiDocsPortal() {
  return (
    <rapi-doc
      spec-url="https://petstore.swagger.io/v2/swagger.json"
      render-style="focused"
      style={{ height: '100vh', width: '100%' }}
    />
  );
}`,
    lang: 'javascript',
    filename: 'App.jsx',
    tags: ['npm', 'React', 'Vue', 'Vite', 'Bundler'],
  },

  // ================= LAYOUT & MODES =================
  {
    id: 'focused-layout',
    title: 'Focused Layout (Sidebar + Active Operation)',
    category: 'Layout & Modes',
    summary:
      'Displays a high-performance sidebar navigation on the left and renders only the currently selected endpoint on the right. Employs lazy DOM instantiation for lightning-fast speeds even with 10MB+ specs.',
    demoUrl: '/examples/render-focused',
    code: `<rapi-doc
  spec-url="https://petstore.swagger.io/v2/swagger.json"
  render-style="focused"
  show-header="false"
>
</rapi-doc>`,
    lang: 'html',
    filename: 'focused-mode.html',
    tags: ['render-style', 'focused', 'performance', 'sidebar'],
  },
  {
    id: 'read-layout',
    title: 'Read Layout (Continuous Document Reader)',
    category: 'Layout & Modes',
    summary:
      'Renders all endpoints sequentially into a continuous, printable technical document. Ideal for comprehensive API reference manuals, product guides, and technical whitepapers.',
    demoUrl: '/examples/render-read',
    code: `<rapi-doc
  spec-url="https://petstore.swagger.io/v2/swagger.json"
  render-style="read"
>
</rapi-doc>`,
    lang: 'html',
    filename: 'read-mode.html',
    tags: ['render-style', 'read', 'documentation', 'scroll'],
  },
  {
    id: 'view-layout',
    title: 'View Layout (Collapsible Accordion Operations)',
    category: 'Layout & Modes',
    summary:
      'Presents API tags and operations as an expandable/collapsible accordion hierarchy. Balances overview density with focused exploration.',
    demoUrl: '/examples/render-view',
    code: `<rapi-doc
  spec-url="https://petstore.swagger.io/v2/swagger.json"
  render-style="view"
>
</rapi-doc>`,
    lang: 'html',
    filename: 'view-mode.html',
    tags: ['render-style', 'view', 'accordion', 'collapsible'],
  },
  {
    id: 'schema-tabular',
    title: 'Tabular Schema View (Data Contract Rows)',
    category: 'Layout & Modes',
    summary:
      'Switches complex JSON schema models in request bodies and response payloads from interactive collapsible tree views to clean, structured data tables.',
    demoUrl: '/examples/schema-styles',
    code: `<rapi-doc
  spec-url="https://petstore.swagger.io/v2/swagger.json"
  schema-style="table"
  default-schema-tab="schema"
>
</rapi-doc>`,
    lang: 'html',
    filename: 'tabular-schemas.html',
    tags: ['schema-style', 'table', 'models', 'types'],
  },

  // ================= THEMING & BRANDING =================
  {
    id: 'theming-palette',
    title: 'Light Theme & Custom Brand Palette',
    category: 'Theming & Branding',
    summary:
      'Tailor RapiDoc to match your brand identity. Configure background surfaces, header colors, primary action buttons, and sidebar navigation accents.',
    demoUrl: '/examples/header-color',
    code: `<rapi-doc
  spec-url="https://petstore.swagger.io/v2/swagger.json"
  color-scheme="light"
  theme="#2563eb"
  radius="md"
>
</rapi-doc>`,
    lang: 'html',
    filename: 'branded-theme.html',
    tags: ['theme', 'colors', 'light', 'branding', 'palette'],
  },
  {
    id: 'custom-fonts',
    title: 'Custom Typography & Google Web Fonts',
    category: 'Theming & Branding',
    summary:
      'Apply modern typography using Google Fonts or custom font faces. RapiDoc reads its fonts from the CSS custom properties --font-sans (interface text) and --font-mono (code payloads and parameter definitions), so set them on the element.',
    demoUrl: '/examples/font',
    code: `<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=JetBrains+Mono&display=swap" rel="stylesheet">
  <script type="module" src="https://unpkg.com/rapidoc/dist/rapidoc-min.js"></script>
  <style>
    rapi-doc {
      --font-sans: 'Outfit', sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
    }
  </style>
</head>
<body>
  <rapi-doc spec-url="https://petstore.swagger.io/v2/swagger.json" scale="default">
  </rapi-doc>
</body>
</html>`,
    lang: 'html',
    filename: 'custom-fonts.html',
    tags: ['fonts', 'typography', 'Google Fonts', 'styling'],
  },
  {
    id: 'embed-no-iframe',
    title: 'Seamless In-Page Embedding (No <iframe>)',
    category: 'Theming & Branding',
    summary:
      'Because RapiDoc is a native custom element, you can seamlessly integrate it directly into existing dashboards or web applications. Disable header bars, server selectors, and intro banners to merge cleanly into your layout.',
    demoUrl: '/examples/alongside-html-content',
    code: `<!-- Direct embedding inside your dashboard grid without any <iframe> -->
<div class="api-portal-container" style="display: flex; height: 100vh;">
  <aside class="dashboard-sidebar" style="width: 240px;">
    <!-- Your internal app navigation -->
  </aside>

  <main style="flex: 1; overflow: hidden;">
    <rapi-doc
      spec-url="https://petstore.swagger.io/v2/swagger.json"
      render-style="read"
      show-header="false"
      show-info="false"
      allow-authentication="false"
      allow-server-selection="false"
      style="height: 100%; width: 100%;"
    >
    </rapi-doc>
  </main>
</div>`,
    lang: 'html',
    filename: 'embedded-dashboard.html',
    tags: ['embedding', 'no-iframe', 'dashboard', 'integration'],
  },

  // ================= SLOTS & CUSTOM HTML =================
  {
    id: 'logo-slot',
    title: 'Custom Brand Logo (nav-logo Slot)',
    category: 'Slots & Custom HTML',
    summary: 'Replace default branding with your organization or product logo inside the sidebar navigation header using slot="nav-logo".',
    demoUrl: '/examples/logo',
    code: `<rapi-doc
  spec-url="https://petstore.swagger.io/v2/swagger.json"
  render-style="read"
>
  <!-- Injects custom logo into sidebar navigation -->
  <img
    slot="nav-logo"
    src="logo.png"
    alt="Brand Logo"
    style="width: 32px; height: 32px; margin-right: 8px;"
  />
</rapi-doc>`,
    lang: 'html',
    filename: 'custom-logo.html',
    tags: ['slot', 'nav-logo', 'branding', 'logo'],
  },
  {
    id: 'header-slot',
    title: 'Custom Header Actions & Controls (header Slot)',
    category: 'Slots & Custom HTML',
    summary:
      'Inject custom UI components directly into the top navigation bar. Perfect for environment switchers, quick links to external developer portals, or custom login modals.',
    demoUrl: '/examples/header',
    code: `<rapi-doc spec-url="https://petstore.swagger.io/v2/swagger.json">
  <!-- Custom controls injected into the top header bar -->
  <div slot="header" style="display: flex; align-items: center; gap: 10px; margin-right: 16px;">
    <span style="background: rgba(16, 185, 129, 0.2); color: #10b981; padding: 3px 8px; border-radius: 4px; font-size: 12px; font-weight: 600;">
      v2.4 Production
    </span>
    <button onclick="window.open('https://help.example.com', '_blank')" style="background: #2563eb; color: #fff; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer; font-size: 13px;">
      Developer Support ↗
    </button>
  </div>
</rapi-doc>`,
    lang: 'html',
    filename: 'custom-header.html',
    tags: ['slot', 'header', 'actions', 'custom-ui'],
  },
  {
    id: 'top-footer-slots',
    title: 'Overview Banners & Custom Footers (Slots)',
    category: 'Slots & Custom HTML',
    summary:
      'Inject rich HTML content above the API specification overview and at the very bottom of the document using default and footer slots.',
    demoUrl: '/examples/slots',
    code: `<rapi-doc spec-url="https://petstore.swagger.io/v2/swagger.json">
  <!-- Default slot: Renders at the top, right before the API spec -->
  <div style="background: rgba(37, 99, 235, 0.08); border-left: 4px solid #3b82f6; padding: 16px; border-radius: 6px; margin: 16px 0;">
    <h3 style="margin-top: 0; color: #60a5fa;">Welcome to the Developer Gateway</h3>
    <p style="margin-bottom: 0;">Please review rate-limiting tiers and obtain production tokens before invoking live endpoints.</p>
  </div>

  <!-- Footer slot: Renders at the bottom of the entire documentation -->
  <div slot="footer" style="text-align: center; padding: 32px 0; color: #64748b; font-size: 13.5px; border-top: 1px solid rgba(255,255,255,0.08);">
    Enterprise API Platform © 2026 • Need help? Contact <a href="mailto:api@example.com" style="color: #38bdf8;">api@example.com</a>
  </div>
</rapi-doc>`,
    lang: 'html',
    filename: 'slots-content.html',
    tags: ['slot', 'footer', 'banner', 'overview', 'html'],
  },

  // ================= JAVASCRIPT & DOM INTERACTION =================
  {
    id: 'reactive-attributes',
    title: 'Reactive Attribute Updates via JavaScript',
    category: 'JavaScript & DOM Interaction',
    summary:
      'RapiDoc reacts immediately to runtime attribute changes. Use standard document.querySelector("rapi-doc").setAttribute(...) to dynamically switch specifications, toggle dark mode, or supply API credentials.',
    demoUrl: '/examples/example100',
    code: `const rapidocEl = document.querySelector('rapi-doc');

// Dynamically swap OpenAPI specification (e.g. from a version dropdown)
rapidocEl.setAttribute('spec-url', 'https://api.example.com/v3/openapi.yaml');

// Toggle between light and dark theme at runtime
rapidocEl.setAttribute('theme', isDarkMode ? 'dark' : 'light');

// Dynamically supply API credentials for interactive 'TRY' requests
rapidocEl.setAttribute('api-key-name', 'Authorization');
rapidocEl.setAttribute('api-key-location', 'header');
rapidocEl.setAttribute('api-key-value', 'Bearer YOUR_JWT_TOKEN');`,
    lang: 'javascript',
    filename: 'reactive-attributes.js',
    tags: ['javascript', 'setAttribute', 'reactive', 'api-key', 'dynamic'],
  },
  {
    id: 'dom-methods',
    title: 'Programmatic Viewport & State Methods',
    category: 'JavaScript & DOM Interaction',
    summary: 'Control navigation and state programmatically through standard DOM methods exposed on the <rapi-doc> element instance.',
    demoUrl: '/tests/collapsable',
    code: `const doc = document.getElementById('the-doc');

// 1. Programmatically scroll to and open a specific endpoint
// Format required: '{http_method}-{path}'
doc.scrollToPath('get-/pets/{petId}');

// 2. Programmatically switch active target API server
doc.setApiServer('https://staging-api.example.com/v1');

// 3. Programmatically supply Basic Auth credentials
doc.setHttpUserNameAndPassword('basic_auth', 'admin_user', 'super_secret_pw');`,
    lang: 'javascript',
    filename: 'dom-methods.js',
    tags: ['methods', 'scrollToPath', 'setApiServer', 'DOM', 'controller'],
  },
  {
    id: 'lifecycle-events',
    title: 'Intercept Requests & Lifecycle Event Listeners',
    category: 'JavaScript & DOM Interaction',
    summary:
      'Listen to custom lifecycle events on <rapi-doc> to intercept outgoing "TRY" requests, inject authorization headers or HMAC signatures, and log server changes.',
    demoUrl: '/examples/events',
    code: `const doc = document.querySelector('rapi-doc');

// Fires before an interactive 'TRY' HTTP request is dispatched
doc.addEventListener('before-try', (e) => {
  const { request } = e.detail;
  // Inject custom correlation ID or dynamic OAuth token
  request.headers.append('X-Request-Trace-ID', crypto.randomUUID());
  request.headers.append('X-Tenant-Slug', 'acme-corp');
});

// Fires when the OpenAPI specification finishes loading and parsing
doc.addEventListener('spec-loaded', (e) => {
  console.log('Spec loaded:', e.detail.title, e.detail.version);
});

// Fires when user selects a different target server
doc.addEventListener('api-server-change', (e) => {
  console.log('Active server changed to:', e.detail.selectedServer);
});`,
    lang: 'javascript',
    filename: 'lifecycle-events.js',
    tags: ['events', 'before-try', 'intercept', 'headers', 'telemetry'],
  },
  {
    id: 'interactive-auth-widget',
    title: 'Interactive Authorization Widget (Slots + JS)',
    category: 'JavaScript & DOM Interaction',
    summary:
      'A complete working example combining custom HTML header injection with JavaScript to create a 1-click token authorization bar.',
    demoUrl: '/examples/example8',
    code: `<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <script type="module" src="https://unpkg.com/rapidoc/dist/rapidoc-min.js"></script>
  <script>
    function updateApiKey() {
      const docEl = document.getElementById('api-doc');
      const tokenInput = document.getElementById('token-input');
      docEl.setAttribute('api-key-name', 'api_key');
      docEl.setAttribute('api-key-location', 'header');
      docEl.setAttribute('api-key-value', tokenInput.value);
      alert('API key configured for all interactive TRY requests!');
    }
  </script>
</head>
<body>
  <rapi-doc
    id="api-doc"
    spec-url="https://petstore.swagger.io/v2/swagger.json"
    allow-authentication="false"
  >
    <!-- Custom interactive login bar injected into header slot -->
    <div slot="header" style="display: flex; align-items: center; gap: 8px; margin: 0 16px;">
      <input
        id="token-input"
        type="text"
        placeholder="Enter API token..."
        style="padding: 5px 10px; border-radius: 4px; border: 1px solid #38bdf8; background: transparent; color: #fff; font-size: 13px;"
      />
      <button
        onclick="updateApiKey()"
        style="padding: 6px 14px; background: #0284c7; color: #fff; border: none; border-radius: 4px; cursor: pointer; font-size: 13px;"
      >
        Authorize
      </button>
    </div>
  </rapi-doc>
</body>
</html>`,
    lang: 'html',
    filename: 'interactive-auth.html',
    tags: ['interactive', 'auth', 'slot', 'header', 'JavaScript'],
  },
];

const categories = [
  'All',
  'Getting Started',
  'Layout & Modes',
  'Theming & Branding',
  'Slots & Custom HTML',
  'JavaScript & DOM Interaction',
];
---

<GlobalLayout
  title="Quick Start & Framework Integration (React, Vue, Angular, Svelte) | RapiDoc"
  description="Get started with RapiDoc in seconds. Learn how to install and integrate RapiDoc in plain HTML, React, Vue, Angular, Svelte, or Next.js applications."
  keywords="RapiDoc quickstart, React OpenAPI, Vue Swagger, Angular API docs, Svelte OpenAPI, install rapidoc"
>
  <!-- Ambient background glow elements inspired by modern developer portals -->
  <div class="ambient-glow glow-emerald"></div>
  <div class="ambient-glow glow-indigo"></div>
  <div class="ambient-glow glow-cyan"></div>

  <!-- Reusable Frosted Glass Navigation -->
  <SiteNavbar activePage="quickstart" />

  <main class="rd-ref-main">
    <!-- Hero Header -->
    <header class="rd-ref-header">
      <div class="rd-badge-pill">
        <span class="rd-badge-pulse"></span>
        <span class="rd-badge-text">Developer Cheatsheet & Integration Recipes</span>
      </div>

      <h1 class="rd-page-title">
        RapiDoc <span class="text-gradient">Quick Start</span>
      </h1>

      <p class="rd-page-subtitle">
        Curated integration recipes showing how to embed <code>&lt;rapi-doc&gt;</code> into your HTML, configure themes and layout modes, inject
        custom slots, and programmatically interact with DOM methods and lifecycle events.
      </p>

      <!-- Key Metrics Counter Bar -->
      <div class="rd-stats-bar">
        <a href="#getting-started" class="rd-stat-card">
          <span class="rd-stat-value">{recipes.length}</span>
          <span class="rd-stat-label">Code Recipes</span>
        </a>
        <a href="#layout-modes" class="rd-stat-card">
          <span class="rd-stat-value">3</span>
          <span class="rd-stat-label">Layout Modes</span>
        </a>
        <a href="#theming-branding" class="rd-stat-card">
          <span class="rd-stat-value">100%</span>
          <span class="rd-stat-label">No &lt;iframe&gt; Needed</span>
        </a>
        <a href="#slots-custom-html" class="rd-stat-card">
          <span class="rd-stat-value">11</span>
          <span class="rd-stat-label">HTML Slots</span>
        </a>
        <a href="#javascript-dom-interaction" class="rd-stat-card">
          <span class="rd-stat-value">6+</span>
          <span class="rd-stat-label">DOM Methods & Events</span>
        </a>
      </div>

      <!-- Live Search & Interactive Filter Controls -->
      <div class="rd-search-section">
        <div class="rd-search-wrapper">
          <IconSearch size={20} class="rd-search-icon" stroke={2} />
          <input
            id="ref-search"
            type="text"
            placeholder="Search recipes by keyword (e.g. auth, focused, slot, method, event, font, theme, cdn)..."
            autocomplete="off"
            class="rd-search-input"
          />
          <button id="clear-ref-search" class="rd-clear-btn" aria-label="Clear search" style="display: none;">
            <IconX size={16} stroke={2} />
          </button>
        </div>

        <!-- Category Navigation Pills -->
        <div class="rd-nav-pills" id="category-pills">
          {
            categories.map((cat, idx) => (
              <button class={`rd-pill ${idx === 0 ? 'active' : ''}`} data-category={cat}>
                {cat}
              </button>
            ))
          }
          <a href="/examples/example100" class="rd-pill rd-pill-playground" target="_blank" rel="noopener"> JS Playground ↗ </a>
        </div>
      </div>
    </header>

    <!-- Empty Search State -->
    <div id="ref-empty-state" class="rd-empty-state" style="display: none;">
      <div class="rd-empty-icon">
        <IconSearchOff size={36} stroke={1.75} />
      </div>
      <h3 class="rd-empty-title">
        No matching recipes found <span id="empty-query-text" class="text-gradient"></span>
      </h3>
      <p class="rd-empty-desc">
        Try searching for a different keyword like <code>focused</code>, <code>auth</code>, <code>slot</code>, or <code>setAttribute</code>.
      </p>
      <button id="reset-ref-search-btn" class="rd-btn rd-btn-primary">Reset Search</button>
    </div>

    <!-- Recipes Grid -->
    <div class="rd-recipes-container" id="recipes-list">
      {
        categories
          .filter((c) => c !== 'All')
          .map((cat) => {
            const catRecipes = recipes.filter((r) => r.category === cat);
            const sectionId = cat.toLowerCase().replace(/[^a-z0-9]+/g, '-');

            return (
              <section class="rd-category-section" id={sectionId} data-category-group={cat}>
                <div class="rd-section-header">
                  <h2 class="rd-section-title">
                    <a href={`#${sectionId}`} class="rd-anchor-link">
                      {cat}
                      <span class="rd-hash">#</span>
                    </a>
                  </h2>
                </div>

                <div class="rd-recipes-grid">
                  {catRecipes.map((recipe) => (
                    <article
                      class="rd-recipe-card"
                      id={recipe.id}
                      data-category={recipe.category}
                      data-recipe-name={recipe.title.toLowerCase()}
                      data-tags={recipe.tags.join(' ').toLowerCase()}
                    >
                      <div class="rd-card-topbar">
                        <div class="rd-card-heading">
                          <a href={`#${recipe.id}`} class="rd-recipe-link" title="Copy direct link to this recipe">
                            <h3 class="rd-recipe-title">{recipe.title}</h3>
                            <span class="rd-recipe-hash">#</span>
                          </a>
                        </div>

                        {recipe.demoUrl && (
                          <a href={recipe.demoUrl} class="rd-demo-btn" target="_blank" rel="noopener">
                            <span>Launch Demo</span>
                            <IconArrowUpRight size={13} stroke={2.5} />
                          </a>
                        )}
                      </div>

                      <p class="rd-recipe-summary">{recipe.summary}</p>

                      <div class="rd-tags-list">
                        {recipe.tags.map((tag) => (
                          <span class="rd-tag-badge">{tag}</span>
                        ))}
                      </div>

                      <div class="rd-code-container">
                        <CodeBlock code={recipe.code} lang={recipe.lang} filename={recipe.filename} />
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            );
          })
      }
    </div>

    <!-- Quick Jump Callout to Showcase & Sandbox -->
    <section class="rd-sandbox-callout">
      <div class="rd-callout-glow"></div>
      <div class="rd-callout-content">
        <div class="rd-callout-badge">Interactive Sandboxes & Exploration</div>
        <h2 class="rd-callout-title">Looking for Complete Working Examples?</h2>
        <p class="rd-callout-desc">
          Explore over 50+ live demonstrations covering OpenAPI 3.1 features, OAuth2 workflows, custom schemas, and performance benchmarks
          in our gallery.
        </p>
        <div class="rd-callout-actions">
          <a href="/examples" class="rd-btn rd-btn-primary rd-btn-lg">
            <span>Browse Full Examples Gallery</span>
            <IconArrowRight size={16} stroke={2.5} />
          </a>
          <a href="/sandbox" class="rd-btn rd-btn-secondary rd-btn-lg" target="_blank" rel="noopener">
            <span>Open JavaScript Playground ↗</span>
          </a>
          <a href="/api" class="rd-btn rd-btn-ghost rd-btn-lg">
            <span>Complete API Specification ↗</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Reusable Modern Footer -->
  <SiteFooter />

  <!-- Client-side Interactive Search & Category Filter Script -->
  <script>
    function setupQuickRefSearch() {
      const searchInput = document.getElementById('ref-search') as HTMLInputElement | null;
      const clearBtn = document.getElementById('clear-ref-search') as HTMLButtonElement | null;
      const emptyState = document.getElementById('ref-empty-state') as HTMLElement | null;
      const emptyQueryText = document.getElementById('empty-query-text') as HTMLElement | null;
      const resetBtn = document.getElementById('reset-ref-search-btn') as HTMLButtonElement | null;
      const filterPills = document.querySelectorAll('#category-pills .rd-pill') as NodeListOf<HTMLButtonElement>;
      const recipeCards = document.querySelectorAll('.rd-recipe-card') as NodeListOf<HTMLElement>;
      const categorySections = document.querySelectorAll('.rd-category-section') as NodeListOf<HTMLElement>;

      if (!searchInput || recipeCards.length === 0) return;

      let activeCategory = 'All';

      function filterRecipes() {
        const rawQuery = (searchInput ? searchInput.value : '') || '';
        const trimmedQuery = rawQuery.trim().toLowerCase();
        const searchTerms = trimmedQuery ? trimmedQuery.split(/\s+/).filter(Boolean) : [];
        let visibleCount = 0;

        // Toggle clear button
        if (clearBtn) {
          clearBtn.style.display = trimmedQuery.length > 0 ? 'flex' : 'none';
        }

        // Filter individual recipe cards
        recipeCards.forEach((card) => {
          const cardCat = card.dataset.category || '';
          const matchesCategory = activeCategory === 'All' || cardCat === activeCategory;

          // Search across card title, summary, tags, and code
          const cardText = (card.textContent || '').toLowerCase();
          const matchesQuery = searchTerms.every((term) => cardText.includes(term));

          if (matchesCategory && matchesQuery) {
            card.style.display = '';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        // Hide empty category sections
        categorySections.forEach((section) => {
          const sectionCat = section.dataset.categoryGroup || '';
          const matchesCategory = activeCategory === 'All' || sectionCat === activeCategory;
          const cards = section.querySelectorAll<HTMLElement>('.rd-recipe-card');
          const hasVisibleCards = Array.from(cards).some((c) => c.style.display !== 'none');

          section.style.display = matchesCategory && hasVisibleCards ? '' : 'none';
        });

        // Toggle empty state
        if (emptyState) {
          emptyState.style.display = visibleCount === 0 ? 'flex' : 'none';
          if (emptyQueryText) {
            emptyQueryText.textContent = trimmedQuery ? `for "${trimmedQuery}"` : '';
          }
        }
      }

      // Input event listeners
      searchInput.addEventListener('input', filterRecipes);
      searchInput.addEventListener('search', filterRecipes);
      searchInput.addEventListener('keyup', (e) => {
        if (e.key === 'Escape') {
          searchInput.value = '';
          filterRecipes();
        }
      });

      // Clear button
      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          searchInput.value = '';
          searchInput.focus();
          filterRecipes();
        });
      }

      // Reset button
      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          searchInput.value = '';
          activeCategory = 'All';
          filterPills.forEach((p, idx) => {
            p.classList.toggle('active', idx === 0);
          });
          filterRecipes();
        });
      }

      // Category filter pills
      filterPills.forEach((pill) => {
        pill.addEventListener('click', () => {
          const cat = pill.dataset.category;
          if (!cat) return;

          filterPills.forEach((p) => p.classList.remove('active'));
          pill.classList.add('active');
          activeCategory = cat;
          filterRecipes();

          if (cat !== 'All') {
            const sectionId = cat.toLowerCase().replace(/[^a-z0-9]+/g, '-');
            const targetSection = document.getElementById(sectionId);
            if (targetSection && targetSection.style.display !== 'none') {
              targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }
        });
      });

      // Smooth scroll and copy link on anchor click
      document.querySelectorAll('.rd-anchor-link, .rd-recipe-link').forEach((link) => {
        link.addEventListener('click', (e) => {
          const href = (link as HTMLAnchorElement).getAttribute('href');
          if (href && href.startsWith('#')) {
            const target = document.querySelector(href);
            if (target) {
              target.scrollIntoView({ behavior: 'smooth' });
              try {
                navigator.clipboard.writeText(window.location.origin + window.location.pathname + href);
              } catch (err) {}
            }
          }
        });
      });

      // Initial filter execution
      filterRecipes();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupQuickRefSearch);
    } else {
      setupQuickRefSearch();
    }
  </script>
</GlobalLayout>

