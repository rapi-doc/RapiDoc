  <!-- Client-side Interactive Search & Category Filter Script -->
  <script>
    function setupQuickRefSearch() {
      const searchInput = document.getElementById('ref-search') as HTMLInputElement | null;
      const clearBtn = document.getElementById('clear-ref-search') as HTMLButtonElement | null;
      const emptyState = document.getElementById('ref-empty-state') as HTMLElement | null;
      const emptyQueryText = document.getElementById('empty-query-text') as HTMLElement | null;
      const resetBtn = document.getElementById('reset-ref-search-btn') as HTMLButtonElement | null;
      const filterPills = document.querySelectorAll('#category-pills .rd-pill') as NodeListOf<HTMLButtonElement>;
      const recipeCards = document.querySelectorAll('.rd-recipe-card') as NodeListOf<HTMLElement>;
      const categorySections = document.querySelectorAll('.rd-category-section') as NodeListOf<HTMLElement>;

      if (!searchInput || recipeCards.length === 0) return;

      let activeCategory = 'All';

      function filterRecipes() {
        const rawQuery = (searchInput ? searchInput.value : '') || '';
        const trimmedQuery = rawQuery.trim().toLowerCase();
        const searchTerms = trimmedQuery ? trimmedQuery.split(/\s+/).filter(Boolean) : [];
        let visibleCount = 0;

        // Toggle clear button
        if (clearBtn) {
          clearBtn.style.display = trimmedQuery.length > 0 ? 'flex' : 'none';
        }

        // Filter individual recipe cards
        recipeCards.forEach(card => {
          const cardCat = card.dataset.category || '';
          const matchesCategory = activeCategory === 'All' || cardCat === activeCategory;

          // Search across card title, summary, tags, and code
          const cardText = (card.textContent || '').toLowerCase();
          const matchesQuery = searchTerms.length === 0 || searchTerms.every(term => cardText.includes(term));

          if (matchesCategory && matchesQuery) {
            card.style.display = '';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        // Hide empty category sections
        categorySections.forEach(section => {
          const sectionCat = section.dataset.categoryGroup || '';
          const matchesCategory = activeCategory === 'All' || sectionCat === activeCategory;
          const cards = section.querySelectorAll<HTMLElement>('.rd-recipe-card');
          const hasVisibleCards = Array.from(cards).some(c => c.style.display !== 'none');

          section.style.display = (matchesCategory && hasVisibleCards) ? '' : 'none';
        });

        // Toggle empty state
        if (emptyState) {
          emptyState.style.display = visibleCount === 0 ? 'flex' : 'none';
          if (emptyQueryText) {
            emptyQueryText.textContent = trimmedQuery ? `for "${trimmedQuery}"` : '';
          }
        }
      }

      // Input event listeners
      searchInput.addEventListener('input', filterRecipes);
      searchInput.addEventListener('search', filterRecipes);
      searchInput.addEventListener('keyup', (e) => {
        if (e.key === 'Escape') {
          searchInput.value = '';
          filterRecipes();
        }
      });

      // Clear button
      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          searchInput.value = '';
          searchInput.focus();
          filterRecipes();
        });
      }

      // Reset button
      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          searchInput.value = '';
          activeCategory = 'All';
          filterPills.forEach((p, idx) => {
            p.classList.toggle('active', idx === 0);
          });
          filterRecipes();
        });
      }

      // Category filter pills
      filterPills.forEach(pill => {
        pill.addEventListener('click', () => {
          const cat = pill.dataset.category;
          if (!cat) return;

          filterPills.forEach(p => p.classList.remove('active'));
          pill.classList.add('active');
          activeCategory = cat;
          filterRecipes();

          if (cat !== 'All') {
            const sectionId = cat.toLowerCase().replace(/[^a-z0-9]+/g, '-');
            const targetSection = document.getElementById(sectionId);
            if (targetSection && targetSection.style.display !== 'none') {
              targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }
        });
      });

      // Smooth scroll and copy link on anchor click
      document.querySelectorAll('.rd-anchor-link, .rd-recipe-link').forEach(link => {
        link.addEventListener('click', (e) => {
          const href = (link as HTMLAnchorElement).getAttribute('href');
          if (href && href.startsWith('#')) {
            const target = document.querySelector(href);
            if (target) {
              target.scrollIntoView({ behavior: 'smooth' });
              try {
                navigator.clipboard.writeText(window.location.origin + window.location.pathname + href);
              } catch (err) {}
            }
          }
        });
      });

      // Initial filter execution
      filterRecipes();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupQuickRefSearch);
    } else {
      setupQuickRefSearch();
    }
  </script>
</GlobalLayout>

