{
  "name": "rapidoc-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspace=docs",
    "stop": "npm run stop --workspace=docs",
    "build": "npm run build --workspace=rapidoc && npm run build:mcp && npm run build:prerender && npm run build --workspace=docs",
    "build:rapidoc": "npm run build --workspace=rapidoc",
    "build:mcp": "npm run build --workspace=@rapidoc/mcp",
    "build:prerender": "npm run build --workspace=@rapidoc/prerender",
    "build:rapidoc:dev": "npm run build:dev --workspace=rapidoc",
    "build:size": "npm run build:size --workspace=rapidoc",
    "build:docs": "npm run build --workspace=docs",
    "build:demo": "npm run build --workspace=rapidoc && npm run build:mcp && npm run build:prerender && node packages/rapidoc-cli/src/index.js build ../rapi-portal-demo/rapid-parcels",
    "preview": "npm run preview --workspace=docs",
    "lint": "oxlint --deny-warnings packages docs/src tests scripts docs/astro.config.mjs",
    "format": "oxfmt --check packages docs/src tests scripts '!**/fixtures/**' '!**/*.mdx' '!packages/rapidoc-portal/schema.json' '!packages/rapidoc-portal/tests/layout/measurements.json'",
    "format-fix": "oxfmt packages docs/src tests scripts '!**/fixtures/**' '!**/*.mdx' '!packages/rapidoc-portal/schema.json' '!packages/rapidoc-portal/tests/layout/measurements.json'",
    "publish:rapidoc": "npm publish --workspace=rapidoc",
    "publish:mcp": "npm publish --workspace=@rapidoc/mcp",
    "publish:prerender": "npm publish --workspace=@rapidoc/prerender",
    "prerender:demo": "npm run build:prerender && node scripts/prerender-demo.mjs",
    "test:parser": "node tests/perf/benchmark.js",
    "test:perf": "node tests/perf/render-benchmark.js",
    "test:component": "node --import ./scripts/test-loader.mjs --test tests/component/*.test.js",
    "test:unit": "node --import ./scripts/test-loader.mjs --test tests/unit/*.test.js",
    "pretest:portal": "npm run build:rapidoc && npm run build:mcp && npm run build:prerender",
    "test:portal": "node --test --test-concurrency=1 packages/rapidoc-portal/tests/**/*.test.js packages/rapidoc-cli/tests/**/*.test.js packages/rapidoc-server/tests/**/*.test.js packages/rapidoc-mock/tests/**/*.test.js packages/create-rapidoc/tests/**/*.test.js",
    "test:e2e": "node --import ./scripts/test-loader.mjs --test tests/e2e/*.test.js",
    "test:all": "npm run test:unit && npm run test:component && npm run test:e2e",
    "build-info": "node scripts/capture-build-info.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "playwright-core": "^1.64.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
