{
  "name": "rapidoc-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspace=docs",
    "stop": "npm run stop --workspace=docs",
    "build": "npm run build --workspace=rapidoc && npm run build --workspace=docs",
    "build:rapidoc": "npm run build --workspace=rapidoc",
    "build:rapidoc:dev": "npm run build:dev --workspace=rapidoc",
    "build:size": "npm run build:size --workspace=rapidoc",
    "build:docs": "npm run build --workspace=docs",
    "build:demo": "npm run build --workspace=rapidoc && node packages/rapidoc-cli/src/index.js build ../demo-api-portal",
    "preview": "npm run preview --workspace=docs",
    "lint": "npm run lint --workspace=rapidoc",
    "format": "prettier --config .prettierrc --check './packages/**/*.{js,ts,html,css}' './docs/src/**/*.{js,ts,html,css}'",
    "format-fix": "prettier --config .prettierrc --write './packages/**/*.{js,ts,html,css}' './docs/src/**/*.{js,ts,html,css}'",
    "analyze": "npm run analyze --workspace=rapidoc",
    "publish:rapidoc": "npm publish --workspace=rapidoc",
    "prerender:demo": "node scripts/prerender-demo.mjs",
    "test:parser": "node tests/perf/benchmark.js",
    "test:perf": "node tests/perf/render-benchmark.js",
    "test:component": "node --import ./scripts/test-loader.mjs --test tests/component/*.test.js",
    "test:unit": "node --import ./scripts/test-loader.mjs --test tests/unit/*.test.js",
    "pretest:portal": "npm run build:rapidoc",
    "test:portal": "node --test --test-concurrency=1 packages/rapidoc-portal/tests/**/*.test.js packages/rapidoc-cli/tests/**/*.test.js packages/rapidoc-server/tests/**/*.test.js packages/create-rapidoc/tests/**/*.test.js",
    "test:e2e": "node --import ./scripts/test-loader.mjs --test tests/e2e/*.test.js",
    "test:visual": "node --import ./scripts/test-loader.mjs --test tests/visual/*.test.js",
    "test:all": "npm run test:unit && npm run test:component && npm run test:e2e && npm run test:visual"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "lit-analyzer": "^2.0.3",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
