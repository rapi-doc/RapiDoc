{
  "name": "rapidoc-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspace=docs",
    "stop": "npm run stop --workspace=docs",
    "build": "npm run build --workspace=rapidoc && npm run build --workspace=docs",
    "build:rapidoc": "npm run build --workspace=rapidoc",
    "build:rapidoc:dev": "npm run build:dev --workspace=rapidoc",
    "build:size": "npm run build:size --workspace=rapidoc",
    "build:docs": "npm run build --workspace=docs",
    "preview": "npm run preview --workspace=docs",
    "lint": "npm run lint --workspace=rapidoc",
    "format": "prettier --config .prettierrc --check './packages/**/*.{js,html,css}' './docs/src/**/*.{js,astro,html,css}'",
    "format-fix": "prettier --config .prettierrc --write './packages/**/*.{js,html,css}' './docs/src/**/*.{js,astro,html,css}'",
    "analyze": "npm run analyze --workspace=rapidoc",
    "publish:rapidoc": "npm publish --workspace=rapidoc",
    "test:perf": "node tests/perf/benchmark.js",
    "test:render": "node tests/perf/render-benchmark.js",
    "test:unit": "node --test tests/unit/*.test.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-lit": "^1.15.0",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^15.14.0",
    "lit-analyzer": "^2.0.3",
    "prettier": "^3.5.2",
    "puppeteer-core": "^25.12.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}