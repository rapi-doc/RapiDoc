---
import GlobalLayout from '../layouts/GlobalLayout.astro';
import { productPageData } from '../utils/structuredData';
import PortalHeader from '@rapidoc/portal/components/PortalPageHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Icon from '../components/Icon.astro';
import { RAPIFLOW_SNIPPET } from '../page-data/snippets';

const pageSnippet = RAPIFLOW_SNIPPET;

const arazzoSnippet = `arazzo: 1.0.1
info: { title: Petstore workflows, version: 1.0.0 }
sourceDescriptions:
  - name: petstore
    url: ./petstore.yaml
    type: openapi
workflows:
  - workflowId: adoptPet
    summary: Adopt an available pet
    inputs:
      type: object
      properties:
        quantity: { type: integer, default: 1 }
    steps:
      - stepId: findAvailable
        operationId: findPetsByStatus          # a box linked to this operation
        parameters:
          - { name: status, in: query, value: available }
        successCriteria:
          - condition: $statusCode == 200
        onFailure:
          - { name: noPets, type: end }        # the failure branch
        outputs:
          petId: $response.body#/0/id          # passed on: a dashed line
      - stepId: placeOrder
        operationId: placeOrder
        requestBody:
          contentType: application/json
          payload:
            petId: $steps.findAvailable.outputs.petId
            quantity: $inputs.quantity
        onFailure:
          - name: storeBusy
            type: retry                        # drawn as a loop back
            retryAfter: 2
            retryLimit: 3
            criteria:
              - condition: $statusCode == 503
        outputs:
          orderId: $response.body#/id
    outputs:
      orderId: $steps.placeOrder.outputs.orderId`;

const mockServerSnippet = `# A mock that validates requests, generates data and checks OAuth scopes
npx rapidoc mock            # serves every OpenAPI spec under http://localhost:4010/<api id>`;

const mockServerHtmlSnippet = `<rapi-flow
  arazzo-url="/specs/petstore.arazzo.yaml"
  spec-url="/specs/petstore.yaml"
  server-url="http://localhost:4010/petstore"
></rapi-flow>`;
---

<GlobalLayout
  structuredData={productPageData('rapi-flow')}
  title="RapiFlow: Draw and Run Arazzo Workflows | RapiDoc"
  description="Draw the multi-step journeys through your API from an Arazzo spec, run them in the browser against a mock or the real API, and reuse them as MCP tools."
  keywords="Arazzo, API workflows, rapi-flow, OpenAPI workflows, workflow diagram, API mock, MCP tools, RapiDoc"
>
  <div class="ambient-glow glow-emerald"></div>
  <div class="ambient-glow glow-indigo"></div>
  <div class="ambient-glow glow-cyan"></div>

  <PortalHeader />

  <main class="wf-guide-main">
    <header class="rd-hero-header rd-hero-split">
      <div class="rd-hero-grid">
      <div class="rd-hero-copy">
      <div class="rd-badge-pill">
        <span class="rd-badge-pulse"></span>
        <span class="rd-badge-text">&lt;rapi-flow&gt; • Arazzo</span>
      </div>

      <h1 class="rd-page-title">
        Rapi<span class="text-gradient">Flow</span>
      </h1>

      <p class="rd-page-subtitle">
        Show the sequence, not just the endpoints. <code>&lt;rapi-flow&gt;</code> draws the journeys an Arazzo spec describes (find a pet, order it, read the order
        back) right next to your API reference, and lets readers run them against a mock or the real API, one lit-up step
        at a time.
      </p>

      <div class="rd-hero-actions">
        <a href="/examples/arazzo" class="rd-btn rd-btn-primary">
          <Icon name="play" size={18} />
          <span>Run the Live Example</span>
        </a>
        <a href="https://flow.rapidocui.com/docs/quickstart/" class="rd-btn rd-btn-secondary">
          <Icon name="rocket-launch" size={18} />
          <span>Quickstart</span>
        </a>
        <a href="https://flow.rapidocui.com/docs/reference/" class="rd-btn rd-btn-secondary">
          <span>API Reference</span>
          <Icon name="arrow-up-right" size={16} />
        </a>
      </div>
      </div>

      <figure class="rd-hero-visual">
        <img
          src="/assets/images/rapi-flow/workflow-run.svg"
          alt="A RapiFlow workflow run: each step lights up in turn, a failed order is retried, values pass from step to step and the outputs fill in"
          width="760"
          height="600"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
      </div>

      <div class="rd-stats-bar">
        <div class="rd-stat-card">
          <span class="rd-stat-value">Arazzo 1.x</span>
          <span class="rd-stat-label">The OpenAPI Initiative's Standard</span>
        </div>
        <div class="rd-stat-card">
          <span class="rd-stat-value">0 KB</span>
          <span class="rd-stat-label">Added to rapidoc-min.js</span>
        </div>
        <div class="rd-stat-card">
          <span class="rd-stat-value">One Runtime</span>
          <span class="rd-stat-label">Browser, MCP & Portal</span>
        </div>
        <div class="rd-stat-card">
          <span class="rd-stat-value">Zero Backend</span>
          <span class="rd-stat-label">Runs Against the Mock</span>
        </div>
      </div>
    </header>

    <div class="wf-guide-content">
      <section class="rd-section">
        <div class="rd-section-badge">Why</div>
        <h2 class="rd-section-title">Integrators Need the Order, Not Just the Operations</h2>
        <p class="rd-section-desc">
          An API reference answers "what does this endpoint take?". The first question a new integrator asks is different:
          "which calls do I make, in which order, and what do I pass from one to the next?". That knowledge usually lives in
          a tutorial that drifts from the API. Arazzo puts it in an Arazzo spec next to the OpenAPI spec, and <code>&lt;rapi-flow&gt;</code>
          draws it from that file, so the diagram changes when the workflow does.
        </p>

        <div class="comparison-grid">
          <div class="comparison-card before">
            <div class="card-status-badge badge-muted">Reference Alone</div>
            <h3 class="card-title">Forty operations, no path through them</h3>
            <ul class="comparison-list">
              <li>The order of calls is buried in prose, or in a sample app.</li>
              <li>Which response field feeds which request is left to the reader.</li>
              <li>Error handling ("retry when the store is busy") is a footnote, if it's there at all.</li>
              <li>Trying a journey means copying IDs between Try panels by hand.</li>
            </ul>
          </div>

          <div class="comparison-card after">
            <div class="card-status-badge badge-success">With a Workflow</div>
            <h3 class="card-title">The journey, drawn from the Arazzo spec</h3>
            <ul class="comparison-list">
              <li>One box per step, in order, each linked to its operation in the reference.</li>
              <li>Dashed lines show each value a step passes on, labelled with its name.</li>
              <li><code>goto</code>, <code>retry</code> and <code>end</code> branches are part of the diagram.</li>
              <li><strong>Run workflow</strong> makes every call, passes the values along and shows the outputs.</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="rd-section" id="example">
        <div class="rd-section-badge">Example</div>
        <h2 class="rd-section-title">A Workflow, Drawn from Its Arazzo Spec</h2>
        <p class="rd-section-desc">
          <code>orderOrReserve</code> from the Petstore example: check the inventory, then order the pet when it is in
          stock, or reserve a pending one when it is sold out. This is the diagram exactly as <code>&lt;rapi-flow&gt;</code>
          draws it; the example page puts it next to the Petstore reference, where you can run it.
        </p>

        <div class="rd-showcase">
          <a class="rd-showcase-image" href="/examples/arazzo?workflow=orderOrReserve#overview" aria-label="Open the live example">
            <img
              src="/assets/images/rapi-flow/workflow-diagram.svg"
              alt="The orderOrReserve workflow as rapi-flow draws it: checkInventory branches to readPet and placeOrder when in stock, or to findPending and markWanted when sold out"
              width="546"
              height="1108"
              loading="lazy"
            />
          </a>
          <div class="rd-showcase-notes">
            <h3>What to look for</h3>
            <ul>
              <li><strong>Two paths from one step.</strong> <code>checkInventory</code>'s <code>onSuccess</code> goes to <code>readPet</code> when <code>available &gt; 0</code>, otherwise to <code>findPending</code>.</li>
              <li><strong>A retry on the order.</strong> <code>placeOrder</code> tries again after 1 s, at most twice, before the run fails.</li>
              <li><strong>Values handed on.</strong> <code>findPending</code>'s <code>pendingPetId</code> is the path parameter of <code>markWanted</code>.</li>
              <li><strong>Outputs from either path.</strong> <code>orderId</code> or <code>reservedPetId</code>, whichever branch ran.</li>
            </ul>
            <div class="rd-showcase-actions">
              <a href="/examples/arazzo?workflow=orderOrReserve#overview" class="rd-btn rd-btn-primary">
                <Icon name="play" size={18} />
                <span>Run It Live</span>
              </a>
              <a href="/specs/petstore.arazzo.yaml" class="rd-btn rd-btn-secondary">
                <Icon name="file-code" size={18} />
                <span>Arazzo Spec</span>
              </a>
            </div>
            <p class="rd-showcase-caveat">
              On the example page, the run goes to the real Petstore API or to RapiDoc's in-browser mock: no backend needed.
            </p>
          </div>
        </div>
      </section>

      <section class="rd-section">
        <div class="rd-section-badge">The Diagram</div>
        <h2 class="rd-section-title">What It Draws</h2>
        <p class="rd-section-desc">
          The layout is RapiDoc's own SVG code with no graph library, so the same diagram renders in the browser and, in a
          portal, as static SVG at build time.
        </p>
        <figure class="rd-illustration">
          <img
            src="/assets/images/rapi-flow/workflow-branches.svg"
            alt="placeOrder answers 503 and its retry action runs it again; the second attempt answers 200 and goto moves on to getOrder; in another run a 404 takes the end action"
            width="760"
            height="440"
            loading="lazy"
          />
        </figure>
        <div class="feature-grid">
          <div class="feature-card">
            <div class="feature-icon"><Icon name="path" size={24} weight="duotone" /></div>
            <div>
              <h4>Steps linked to operations</h4>
              <p>Each box names its step, method and path. Clicking it scrolls a tied <code>&lt;rapi-doc&gt;</code> to the operation.</p>
            </div>
          </div>
          <div class="feature-card">
            <div class="feature-icon"><Icon name="arrows-split" size={24} weight="duotone" /></div>
            <div>
              <h4>Values passed between steps</h4>
              <p>A dashed line from <code>findAvailable</code> to <code>placeOrder</code>, labelled <code>petId</code>. Hover a value to see where it goes.</p>
            </div>
          </div>
          <div class="feature-card">
            <div class="feature-icon"><Icon name="repeat" size={24} weight="duotone" /></div>
            <div>
              <h4>Success and failure branches</h4>
              <p><code>goto</code> and <code>retry</code> draw as arrows back or forward; <code>end</code> closes the run. Each action shows its criteria.</p>
            </div>
          </div>
          <div class="feature-card">
            <div class="feature-icon"><Icon name="list-dashes" size={24} weight="duotone" /></div>
            <div>
              <h4>Compact and expanded</h4>
              <p>Expanded shows each step's inputs and actions in its box; compact keeps only the operation, for long workflows.</p>
            </div>
          </div>
          <div class="feature-card">
            <div class="feature-icon"><Icon name="table" size={24} weight="duotone" /></div>
            <div>
              <h4>Outputs at a glance</h4>
              <p>The workflow's outputs sit in a table under the steps, each with the step it comes from.</p>
            </div>
          </div>
        </div>

        <div class="sub-topic">
          <h3>The Arazzo behind it</h3>
          <p>
            Steps name their operation by <code>operationId</code> (or <code>operationPath</code>); runtime expressions such as
            <code>$response.body#/0/id</code> and <code>$steps.findAvailable.outputs.petId</code> carry values from one step to the next.
          </p>
          <CodeBlock code={arazzoSnippet} lang="yaml" filename="petstore.arazzo.yaml" />
        </div>
      </section>

      <section class="rd-section">
        <div class="rd-section-badge">One Runtime</div>
        <h2 class="rd-section-title">One Workflow, Three Places It Runs</h2>
        <p class="rd-section-desc">
          The run button, AI agents and the developer portal all use the same workflow runtime, built on RapiDoc's MCP
          manifest. A workflow that runs on this page runs the same way for an agent.
        </p>
        <figure class="rd-illustration">
          <img
            src="/assets/images/rapi-flow/workflow-one-runtime.svg"
            alt="One Arazzo spec feeds the workflow runtime, which runs it in the browser, serves it to AI agents as an MCP tool and draws it in the developer portal"
            width="760"
            height="420"
            loading="lazy"
          />
        </figure>
        <div class="standards-grid">
          <div class="standard-card">
            <div class="standard-badge"><Icon name="browser" size={14} /> Browser</div>
            <h4>The run panel</h4>
            <p>
              Inputs with their defaults, credentials from the tied <code>&lt;rapi-doc&gt;</code> (or a small form of its own),
              a log with each step's request and response, and the outputs. Requests go from the reader's browser, like
              <strong>Try</strong>.
            </p>
          </div>
          <div class="standard-card">
            <div class="standard-badge"><Icon name="robot" size={14} /> AI agents</div>
            <h4>One MCP tool per workflow</h4>
            <p>
              With a <code>&lt;rapi-flow for="…"&gt;</code> on the page, <strong>Export MCP Server</strong> adds a tool per
              workflow: its inputs become the arguments, its outputs the result. See <a href="/docs/mcp/server/#workflows-as-tools">MCP Server</a>.
            </p>
          </div>
          <div class="standard-card">
            <div class="standard-badge"><Icon name="book-open" size={14} /> Developer portal</div>
            <h4>Drawn at build time</h4>
            <p>
              <code>@rapidoc/portal</code>'s <code>&#123;% workflow %&#125;</code> tag renders the diagram as static SVG, so
              it shows without JavaScript; the element loads only when a reader clicks <strong>Run workflow</strong>. The
              portal's hosted <code>/mcp</code> serves the same workflows to agents.
            </p>
          </div>
        </div>
      </section>

      <section class="rd-section">
        <div class="rd-section-badge">Integration</div>
        <h2 class="rd-section-title">Add It to Your Docs</h2>
        <p class="rd-section-desc">
          Load the flow bundle next to RapiDoc, point the element at your Arazzo spec and tie it to the reference. Its
          attributes and events are in the <a href="https://flow.rapidocui.com/docs/reference/">API reference</a>, and its slots and CSS parts in
          <a href="https://flow.rapidocui.com/docs/styling/">Slots &amp; Styling</a>.
        </p>
        <div class="sub-topic">
          <CodeBlock code={pageSnippet} lang="html" filename="index.html" />
        </div>

        <div class="sub-topic">
          <h3>Against a mock server, or the real API</h3>
          <p>
            For a mock that validates requests, generates data and checks OAuth scopes, run <code>rapidoc mock</code> and send
            the run there with <code>server-url</code> (or list it as a server in the OpenAPI spec and pick it in
            <code>&lt;rapi-doc&gt;</code>). Against the real API, the browser makes the calls, so the API must allow
            cross-origin requests from your docs site.
          </p>
          <CodeBlock code={mockServerSnippet} lang="bash" filename="terminal" />
          <CodeBlock code={mockServerHtmlSnippet} lang="html" filename="index.html" />
        </div>
      </section>

      <section class="wf-cta-box">
        <div class="wf-cta-content">
          <h3>See it next to a full API reference</h3>
          <p>The example page ties two Arazzo specs to the Petstore reference, with branches, retries and the MCP export.</p>
          <div class="cta-actions">
            <a href="/examples/arazzo" class="rd-btn rd-btn-primary">
              <span>Open the rapi-flow Example</span>
              <Icon name="arrow-right" size={18} />
            </a>
            <a href="https://flow.rapidocui.com/" class="rd-btn rd-btn-secondary">
              <span>RapiFlow Docs</span>
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>

  <SiteFooter />
</GlobalLayout>

<style>
  .wf-guide-main {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--rd-page-top) 24px 96px;
  }

  /* Sections */
  .rd-section {
    scroll-margin-top: 80px;
  }
  /* The lead paragraph sits directly above the section's content, without a header wrapper */
  .rd-section > .rd-section-desc {
    margin-bottom: 28px;
  }
  .sub-topic {
    margin-top: 36px;
    display: grid;
    gap: 14px;
  }
  .sub-topic h3 {
    font-size: 19px;
    font-weight: 600;
    color: var(--rd-text-primary);
    margin: 0;
  }
  .sub-topic p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--rd-text-muted);
    margin: 0;
  }
  code {
    font-size: 0.9em;
  }

  /* Before / after */
  .comparison-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }
  .comparison-card {
    padding: 24px;
    border-radius: var(--rd-radius-md);
    background: var(--rd-surface);
    border: 1px solid var(--rd-border);
    backdrop-filter: blur(8px);
  }
  .comparison-card.after {
    border-color: var(--rd-accent-border);
    background: color-mix(in srgb, var(--rd-accent) 3%, transparent);
  }
  .card-status-badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: var(--rd-radius-pill);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .badge-muted {
    background: color-mix(in srgb, var(--rd-text-muted) 15%, transparent);
    color: var(--rd-text-muted);
  }
  .badge-success {
    background: color-mix(in srgb, var(--rd-accent) 15%, transparent);
    color: var(--rd-accent-light);
  }
  .card-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--rd-text-bright);
    margin: 0 0 16px;
  }
  .comparison-list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 13px;
    line-height: 1.7;
    color: var(--rd-text-soft);
  }
  .comparison-list li {
    margin-bottom: 10px;
    padding-left: 20px;
    position: relative;
  }
  .comparison-card.before .comparison-list li::before {
    content: "–";
    position: absolute;
    left: 0;
    color: var(--rd-text-dim);
    font-weight: 700;
  }
  .comparison-card.after .comparison-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--rd-accent-light);
    font-weight: 700;
  }

  /* What it draws */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 18px;
  }
  .feature-card {
    display: flex;
    gap: 14px;
    padding: 18px;
    background: var(--rd-surface);
    border: 1px solid var(--rd-border);
    border-radius: var(--rd-radius-md);
  }
  /* The card's icon on its own, no box (the site's card standard: 24px regular) */
  .feature-icon {
    color: var(--rd-accent);
    display: flex;
    flex-shrink: 0;
  }
  .feature-card h4 {
    font-size: 14px;
    font-weight: 600;
    color: var(--rd-text-bright);
    margin: 0 0 6px;
  }
  .feature-card p {
    font-size: 13px;
    line-height: 1.55;
    color: var(--rd-text-muted);
    margin: 0;
  }

  /* Three places */
  .standards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }
  .standard-card {
    padding: 24px;
    background: var(--rd-surface);
    border: 1px solid var(--rd-border);
    border-radius: var(--rd-radius-lg);
    backdrop-filter: blur(8px);
  }
  .standard-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 8px;
    border-radius: var(--rd-radius-xs);
    background: color-mix(in srgb, var(--rd-sky) 12%, transparent);
    color: var(--rd-sky);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 12px;
  }
  .standard-card h4 {
    font-size: 16px;
    font-weight: 700;
    color: var(--rd-text-bright);
    margin: 0 0 10px;
  }
  .standard-card p {
    font-size: 13px;
    line-height: 1.6;
    color: var(--rd-text-muted);
    margin: 0;
  }

  /* Closing call to action */
  .wf-cta-box {
    padding: 40px;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--rd-accent) 8%, transparent) 0%,
      color-mix(in srgb, var(--rd-indigo) 5%, transparent) 100%
    );
    border: 1px solid var(--rd-accent-border);
    border-radius: var(--rd-radius-lg);
    text-align: center;
  }
  .wf-cta-content h3 {
    font-size: 24px;
    font-weight: 700;
    color: var(--rd-text-bright);
    margin: 0 0 10px;
  }
  .wf-cta-content p {
    font-size: 15px;
    color: var(--rd-text-muted);
    margin: 0 auto 24px;
    max-width: 600px;
  }
  .cta-actions {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }
</style>
