---
// The in-browser mock, live: a testbed that sets the mock attributes and calls fetch(), which the mock
// answers. The how-to is in content/docs/mocking/; this page was the Mock Server guide.
import GlobalLayout from '../../layouts/GlobalLayout.astro';
import PortalHeader from '@rapidoc/portal/components/PortalHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Icon from '../../components/Icon.astro';

const mockAttributes = [
  {
    name: 'mock-server',
    type: 'true | false',
    default: 'false',
    desc: 'Activates the in-browser mock server interceptor. Transparently intercepts outgoing network requests (both in-doc TRY console and host application fetch/XHR calls) and synthesizes realistic mock responses directly from your OpenAPI specification.',
  },
  {
    name: 'mock-server-status-code',
    type: 'String',
    default: '(auto)',
    desc: 'Target HTTP status code, or a comma-separated list used in turn per operation ("503, 503, 200"); "random:200, 500" picks one at random for each call. Or a JSON map by operation, each entry with its own codes and prefix ({ "POST /orders": "503, 200", "*": "200" }, keys are the method and path template, "*" the default). If omitted, the mock server automatically picks the first available 2xx response in the spec.',
  },
  {
    name: 'mock-server-status-strategy',
    type: 'first | cycle | random',
    default: 'cycle',
    desc: "Deprecated: write the strategy in front of the codes in mock-server-status-code instead (random:200, 500). How codes without a prefix are picked: 'cycle' in turn per operation, 'random' one per call, 'first' always the first code.",
  },
  {
    name: 'mock-server-delay',
    type: 'Number (ms)',
    default: '0',
    desc: 'Simulated network latency in milliseconds before resolving mock responses. Perfect for testing loading skeletons, button disabled states, and race conditions.',
  },
  {
    name: 'mock-server-log',
    type: 'true | false',
    default: 'true',
    desc: 'Logs intercepted requests, matched OpenAPI routes, and synthesized status codes directly to the browser DevTools console.',
  },
];
---

<GlobalLayout
  title="In-Browser Mock Server - Interactive OpenAPI Example | RapiDoc"
  description="Instantly simulate REST API endpoints directly in your browser with zero backend setup. Return realistic mock data synthesized from OpenAPI schema examples."
  keywords="OpenAPI mock server, in-browser mock server, mock REST API, Swagger mock server, client-side API simulation"
>
  <!-- RapiDoc Component Registration -->
  <script slot="script" is:inline type="module" src="/assets/rapidoc-min.js"></script>

  <!-- Ambient background glow elements -->
  <div class="ambient-glow glow-emerald"></div>
  <div class="ambient-glow glow-cyan"></div>
  <div class="ambient-glow glow-indigo"></div>

  <!-- Reusable Navigation -->
  <PortalHeader />

  <main class="rd-mock-main">
    <!-- Hero Header -->
    <header class="rd-hero-header">
      <div class="rd-badge-pill">
        <span class="rd-badge-pulse"></span>
        <span class="rd-badge-text">Example • mock-server</span>
      </div>

      <h1 class="rd-page-title">
        In-Browser <span class="text-gradient">Mock Server</span>
      </h1>

      <p class="rd-page-subtitle">
        With <code>mock-server="true"</code>, <code>&lt;rapi-doc&gt;</code> answers requests from the spec inside the page, for
        Try and for the page's own <code>fetch()</code> calls. Pick a status code and a delay below and call the API.
      </p>

    </header>

    <!-- ================= INTERACTIVE TESTBED & LIVE PLAYGROUND ================= -->
    <section class="rd-section" id="interactive-demo">
      <div class="rd-section-header">
        <div class="rd-section-badge">Live Interactive Playground</div>
        <h2 class="rd-section-title">Test In-Page Fetch Interception Live</h2>
        <p class="rd-section-desc">
          The <code>&lt;rapi-doc&gt;</code> element below is mounted with <code>mock-server="true"</code>. Use the live test controls to
          trigger actual <code>window.fetch()</code> requests from this page, and see them intercepted and resolved with mock data in real time!
        </p>
      </div>

      <div class="rd-playground-grid">
        <!-- Interactive Fetch Client Card -->
        <div class="rd-client-card">
          <div class="rd-card-header">
            <span class="rd-card-dot green"></span>
            <span class="rd-card-title">Frontend <code>fetch()</code> Tester</span>
            <span class="rd-badge-mock-active">INTERCEPTOR READY</span>
          </div>

          <div class="rd-card-body">
            <div class="rd-form-group">
              <label>Target OpenAPI Endpoint:</label>
              <div class="rd-custom-select" id="endpoint-custom-select">
                <button type="button" class="rd-select-trigger" aria-haspopup="listbox" aria-expanded="false">
                  <span class="rd-select-value">GET https://reqres.in/api/users (List Paginated)</span>
                  <Icon name="caret-down" size={14} class="rd-select-chevron" />
                </button>
                <div class="rd-select-menu" role="listbox">
                  <div
                    class="rd-select-option selected"
                    role="option"
                    aria-selected="true"
                    data-value="https://reqres.in/api/users"
                    data-method="GET"
                  >
                    <span>GET https://reqres.in/api/users (List Paginated)</span>
                    <Icon name="check" size={14} class="rd-option-check" />
                  </div>
                  <div
                    class="rd-select-option"
                    role="option"
                    aria-selected="false"
                    data-value="https://reqres.in/api/users/2"
                    data-method="GET"
                  >
                    <span>GET https://reqres.in/api/users/2 (Single User)</span>
                    <Icon name="check" size={14} class="rd-option-check" />
                  </div>
                  <div
                    class="rd-select-option"
                    role="option"
                    aria-selected="false"
                    data-value="https://reqres.in/api/users"
                    data-method="POST"
                  >
                    <span>POST https://reqres.in/api/users (Create User)</span>
                    <Icon name="check" size={14} class="rd-option-check" />
                  </div>
                </div>
                <!-- Native hidden select for DOM & script access -->
                <select id="endpoint-select" class="rd-sr-select" tabindex="-1" aria-hidden="true">
                  <option value="https://reqres.in/api/users" selected>GET https://reqres.in/api/users (List Paginated)</option>
                  <option value="https://reqres.in/api/users/2">GET https://reqres.in/api/users/2 (Single User)</option>
                  <option value="https://reqres.in/api/users" data-method="POST">POST https://reqres.in/api/users (Create User)</option>
                </select>
              </div>
            </div>

            <div class="rd-form-row">
              <div class="rd-form-group">
                <label>Status Code Simulation:</label>
                <div class="rd-custom-select" id="status-custom-select">
                  <button type="button" class="rd-select-trigger" aria-haspopup="listbox" aria-expanded="false">
                    <span class="rd-select-value">Auto (First 2xx)</span>
                    <Icon name="caret-down" size={14} class="rd-select-chevron" />
                  </button>
                  <div class="rd-select-menu" role="listbox">
                    <div class="rd-select-option selected" role="option" aria-selected="true" data-value="">
                      <span>Auto (First 2xx)</span>
                      <Icon name="check" size={14} class="rd-option-check" />
                    </div>
                    <div class="rd-select-option" role="option" aria-selected="false" data-value="200">
                      <span>200 OK</span>
                      <Icon name="check" size={14} class="rd-option-check" />
                    </div>
                    <div class="rd-select-option" role="option" aria-selected="false" data-value="400">
                      <span>400 Bad Request</span>
                      <Icon name="check" size={14} class="rd-option-check" />
                    </div>
                    <div class="rd-select-option" role="option" aria-selected="false" data-value="404">
                      <span>404 Not Found</span>
                      <Icon name="check" size={14} class="rd-option-check" />
                    </div>
                    <div class="rd-select-option" role="option" aria-selected="false" data-value="500">
                      <span>500 Server Error</span>
                      <Icon name="check" size={14} class="rd-option-check" />
                    </div>
                    <div class="rd-select-option" role="option" aria-selected="false" data-value="200, 400, 500">
                      <span>Cycle (200 &rarr; 400 &rarr; 500)</span>
                      <Icon name="check" size={14} class="rd-option-check" />
                    </div>
                    <div class="rd-select-option" role="option" aria-selected="false" data-value="random:200, 500">
                      <span>Random Chaos (200 / 500)</span>
                      <Icon name="check" size={14} class="rd-option-check" />
                    </div>
                  </div>
                  <select id="status-select" class="rd-sr-select" tabindex="-1" aria-hidden="true">
                    <option value="" selected>Auto (First 2xx)</option>
                    <option value="200">200 OK</option>
                    <option value="400">400 Bad Request</option>
                    <option value="404">404 Not Found</option>
                    <option value="500">500 Server Error</option>
                    <option value="200, 400, 500">Cycle (200 &rarr; 400 &rarr; 500)</option>
                    <option value="random:200, 500">Random Chaos (200 / 500)</option>
                  </select>
                </div>
              </div>

              <div class="rd-form-group">
                <label>Simulated Latency:</label>
                <div class="rd-custom-select" id="delay-custom-select">
                  <button type="button" class="rd-select-trigger" aria-haspopup="listbox" aria-expanded="false">
                    <span class="rd-select-value">300ms (Fast 4G)</span>
                    <Icon name="caret-down" size={14} class="rd-select-chevron" />
                  </button>
                  <div class="rd-select-menu" role="listbox">
                    <div class="rd-select-option" role="option" aria-selected="false" data-value="0">
                      <span>0ms (Instant)</span>
                      <Icon name="check" size={14} class="rd-option-check" />
                    </div>
                    <div class="rd-select-option selected" role="option" aria-selected="true" data-value="300">
                      <span>300ms (Fast 4G)</span>
                      <Icon name="check" size={14} class="rd-option-check" />
                    </div>
                    <div class="rd-select-option" role="option" aria-selected="false" data-value="800">
                      <span>800ms (Slow Network)</span>
                      <Icon name="check" size={14} class="rd-option-check" />
                    </div>
                    <div class="rd-select-option" role="option" aria-selected="false" data-value="1500">
                      <span>1500ms (High Latency)</span>
                      <Icon name="check" size={14} class="rd-option-check" />
                    </div>
                  </div>
                  <select id="delay-select" class="rd-sr-select" tabindex="-1" aria-hidden="true">
                    <option value="0">0ms (Instant)</option>
                    <option value="300" selected>300ms (Fast 4G)</option>
                    <option value="800">800ms (Slow Network)</option>
                    <option value="1500">1500ms (High Latency)</option>
                  </select>
                </div>
              </div>
            </div>

            <button id="send-fetch-btn" class="rd-fetch-btn">
              <Icon name="play" size={15} />
              <span>Execute In-Page <code>fetch()</code></span>
            </button>

            <!-- Response Viewer -->
            <div class="rd-response-box">
              <div class="rd-response-header">
                <div class="rd-response-meta">
                  <span class="rd-meta-label">Status:</span>
                  <span id="res-status" class="rd-status-badge badge-pending">Ready</span>
                  <span class="rd-meta-label" style="margin-left: 10px;">Time:</span>
                  <span id="res-time" class="rd-time-badge">0ms</span>
                </div>
                <span class="rd-response-origin">Intercepted in-memory</span>
              </div>
              <pre
                id="res-body"
                class="rd-response-body"><code>// Click "Execute In-Page fetch()" above to test interception...</code></pre>
            </div>
          </div>
        </div>

        <!-- Embedded Live RapiDoc Instance -->
        <div class="rd-rapidoc-embed-card">
          <div class="rd-card-header">
            <span class="rd-card-dot blue"></span>
            <span class="rd-card-title">Live <code>&lt;rapi-doc mock-server="true"&gt;</code></span>
            <span class="rd-badge-doc-active">MOCKING BADGE IN UI</span>
          </div>
          <div class="rd-embed-container">
            <rapi-doc
              id="live-mock-rapidoc"
              spec-url="/specs/reqres.yaml"
              mock-server="true"
              mock-server-delay="300"
              mock-server-log="true"
              color-scheme="dark"
              theme="amber"
              render-style="view"
              show-header="false"
              allow-try="true"
              show-info="false"
              style="width: 100%;"></rapi-doc>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= WHY BUILT-IN MOCKING MATTERS ================= -->
    <section class="rd-next-steps">
      <h2 class="rd-section-title">In Your Own Pages</h2>
      <p class="rd-section-desc">
        The attributes, the per-operation status map, what the mock answers and how to use it while you build your app are in
        the docs. For a mock that runs as an HTTP server, see <code>rapidoc mock</code>.
      </p>
      <div class="rd-hero-actions">
        <a href="/docs/mocking/in-browser/" class="rd-btn rd-btn-primary rd-btn-lg">In-Browser Mock Docs</a>
        <a href="/docs/mocking/mock-server/" class="rd-btn rd-btn-secondary rd-btn-lg">Mock Server Docs</a>
      </div>
    </section>
  </main>

  <SiteFooter />
</GlobalLayout>

<script>
  // Interactive testbed script for fetch testing
  window.addEventListener('DOMContentLoaded', () => {
    const endpointSelect = document.getElementById('endpoint-select') as HTMLSelectElement | null;
    const statusSelect = document.getElementById('status-select') as HTMLSelectElement | null;
    const delaySelect = document.getElementById('delay-select') as HTMLSelectElement | null;
    const sendBtn = document.getElementById('send-fetch-btn');
    const resStatus = document.getElementById('res-status');
    const resTime = document.getElementById('res-time');
    const resBody = document.getElementById('res-body');
    const rapidocEl = document.getElementById('live-mock-rapidoc');

    // Setup custom styled dropdown logic
    function setupCustomSelect(containerId: string, selectEl: HTMLSelectElement | null) {
      const container = document.getElementById(containerId);
      if (!container || !selectEl) return;

      const trigger = container.querySelector('.rd-select-trigger') as HTMLButtonElement | null;
      const valDisplay = container.querySelector('.rd-select-value');
      const options = container.querySelectorAll('.rd-select-option');

      trigger?.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = container.classList.contains('is-open');
        document.querySelectorAll('.rd-custom-select.is-open').forEach((el) => {
          if (el !== container) el.classList.remove('is-open');
        });
        container.classList.toggle('is-open', !isOpen);
        trigger.setAttribute('aria-expanded', (!isOpen).toString());
      });

      options.forEach((opt, idx) => {
        opt.addEventListener('click', (e) => {
          e.stopPropagation();
          const text = opt.querySelector('span')?.textContent ?? '';
          if (valDisplay) valDisplay.textContent = text;

          options.forEach((o) => {
            o.classList.remove('selected');
            o.setAttribute('aria-selected', 'false');
          });
          opt.classList.add('selected');
          opt.setAttribute('aria-selected', 'true');
          container.classList.remove('is-open');
          trigger?.setAttribute('aria-expanded', 'false');

          // Sync underlying native select option by exact index
          if (selectEl.options[idx]) {
            selectEl.selectedIndex = idx;
            selectEl.dispatchEvent(new Event('change', { bubbles: true }));
          }
        });
      });
    }

    setupCustomSelect('endpoint-custom-select', endpointSelect);
    setupCustomSelect('status-custom-select', statusSelect);
    setupCustomSelect('delay-custom-select', delaySelect);

    // Global click-away and Escape dismiss for custom dropdowns
    document.addEventListener('click', () => {
      document.querySelectorAll('.rd-custom-select.is-open').forEach((el) => {
        el.classList.remove('is-open');
        el.querySelector('.rd-select-trigger')?.setAttribute('aria-expanded', 'false');
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelectorAll('.rd-custom-select.is-open').forEach((el) => {
          el.classList.remove('is-open');
          el.querySelector('.rd-select-trigger')?.setAttribute('aria-expanded', 'false');
        });
      }
    });

    function syncRapidocAttributes() {
      if (!rapidocEl) return;
      const statusVal = statusSelect.value;
      const delayVal = delaySelect.value;

      if (statusVal) {
        rapidocEl.setAttribute('mock-server-status-code', statusVal);
      } else {
        rapidocEl.removeAttribute('mock-server-status-code');
      }
      rapidocEl.setAttribute('mock-server-delay', delayVal);
    }

    statusSelect?.addEventListener('change', syncRapidocAttributes);
    delaySelect?.addEventListener('change', syncRapidocAttributes);

    sendBtn?.addEventListener('click', async () => {
      syncRapidocAttributes();

      const url = endpointSelect.value;
      const selectedOpt = endpointSelect.options[endpointSelect.selectedIndex];
      const method = selectedOpt.getAttribute('data-method') || 'GET';

      resStatus.className = 'rd-status-badge badge-pending';
      resStatus.textContent = 'Fetching...';
      resTime.textContent = '...';
      resBody.textContent = `Sending ${method} request to ${url} ...`;

      const startTime = performance.now();
      try {
        const fetchOptions = { method };
        if (method === 'POST') {
          fetchOptions.headers = { 'Content-Type': 'application/json' };
          fetchOptions.body = JSON.stringify({ name: 'morpheus', job: 'leader' });
        }

        const response = await fetch(url, fetchOptions);
        const elapsed = Math.round(performance.now() - startTime);

        const statusClass = response.ok ? 'badge-2xx' : response.status >= 500 ? 'badge-5xx' : 'badge-4xx';
        resStatus.className = `rd-status-badge ${statusClass}`;
        resStatus.textContent = `${response.status} ${response.statusText || 'OK'}`;
        resTime.textContent = `${elapsed}ms`;

        const contentType = response.headers.get('content-type') || '';
        if (contentType.includes('json')) {
          const data = await response.json();
          resBody.textContent = JSON.stringify(data, null, 2);
        } else {
          const text = await response.text();
          resBody.textContent = text;
        }
      } catch (err) {
        const elapsed = Math.round(performance.now() - startTime);
        resStatus.className = 'rd-status-badge badge-5xx';
        resStatus.textContent = 'Failed';
        resTime.textContent = `${elapsed}ms`;
        resBody.textContent = `Error executing fetch: ${err.message}`;
      }
    });
  });
</script>

<style>
  .rd-mock-main {
    position: relative;
    z-index: 1;
    max-width: 1180px;
    margin: 0 auto;
    padding: var(--rd-page-top) 24px 96px 24px;
  }

  /* Playground Grid */
  .rd-playground-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 24px;
    align-items: stretch;
  }

  @media (max-width: 960px) {
    .rd-playground-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Both playground cards have square bottom corners, matching the element that sits flush in the right one */
  .rd-client-card,
  .rd-rapidoc-embed-card {
    background: var(--rd-surface-card);
    border: 1px solid var(--rd-border);
    border-radius: var(--rd-radius-md) var(--rd-radius-md) 0 0;
    overflow: hidden;
    box-shadow: var(--rd-shadow-panel);
    display: flex;
    flex-direction: column;
  }

  .rd-card-header {
    display: flex;
    align-items: center;
    padding: 12px 16px;
    background: var(--rd-wash);
    border-bottom: 1px solid var(--rd-border);
  }

  .rd-card-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-right: 8px;
  }
  .rd-card-dot.green {
    background: var(--rd-green);
    box-shadow: 0 0 8px color-mix(in srgb, var(--rd-green) 50%, transparent);
  }
  .rd-card-dot.blue {
    background: var(--rd-cyan);
    box-shadow: 0 0 8px color-mix(in srgb, var(--rd-cyan) 50%, transparent);
  }

  .rd-card-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--rd-text);
    flex: 1;
  }

  .rd-badge-mock-active {
    font-size: 10px;
    padding: 3px 8px;
    border-radius: var(--rd-radius-xs);
    background: color-mix(in srgb, var(--rd-green) 20%, transparent);
    color: var(--rd-green-light);
    border: 1px solid color-mix(in srgb, var(--rd-green) 40%, transparent);
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .rd-badge-doc-active {
    font-size: 10px;
    padding: 3px 8px;
    border-radius: var(--rd-radius-xs);
    background: color-mix(in srgb, var(--rd-cyan) 20%, transparent);
    color: #67e8f9;
    border: 1px solid color-mix(in srgb, var(--rd-cyan) 40%, transparent);
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .rd-card-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex: 1;
  }

  .rd-form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .rd-form-group label {
    font-size: 12px;
    font-weight: 600;
    color: var(--rd-text-muted);
  }

  .rd-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  /* Visually hidden native select, kept for forms and assistive tech */
  .rd-sr-select {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }

  .rd-custom-select {
    position: relative;
    width: 100%;
  }

  .rd-select-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 9px 13px;
    background: var(--rd-bg-input);
    border: 1px solid var(--rd-border-hover);
    border-radius: var(--rd-radius-md);
    color: var(--rd-text-primary);
    font-size: 13px;
    font-family: inherit;
    cursor: pointer;
    outline: none;
    transition: all 0.2s ease;
    text-align: left;
  }

  .rd-select-trigger:hover {
    background: var(--rd-surface-hover);
    border-color: var(--rd-border-hover);
  }

  .rd-custom-select.is-open .rd-select-trigger {
    border-color: var(--rd-accent);
    box-shadow: 0 0 0 2px var(--rd-accent-dim);
    background: rgba(15, 23, 42, 0.98);
  }

  .rd-select-value {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .rd-select-chevron {
    color: var(--rd-text-muted);
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .rd-custom-select.is-open .rd-select-chevron {
    transform: rotate(180deg);
    color: var(--rd-accent-light);
  }

  .rd-select-menu {
    position: absolute;
    top: calc(100% + 5px);
    left: 0;
    right: 0;
    z-index: 100;
    background: #090e1a;
    border: 1px solid var(--rd-border-hover);
    border-radius: var(--rd-radius-md);
    padding: 4px;
    box-shadow:
      0 16px 36px -4px rgba(0, 0, 0, 0.75),
      0 0 0 1px color-mix(in srgb, var(--rd-accent) 15%, transparent);
    display: none;
    flex-direction: column;
    gap: 2px;
    max-height: 220px;
    overflow-y: auto;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .rd-custom-select.is-open .rd-select-menu {
    display: flex;
  }

  .rd-select-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 8px 12px;
    border-radius: var(--rd-radius-sm);
    font-size: 13px;
    color: var(--rd-text-soft);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .rd-select-option:hover {
    background: var(--rd-wash-strong);
