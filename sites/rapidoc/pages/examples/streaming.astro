---
import ExampleLayout from '../../layouts/ExampleLayout.astro';
import { getSpecUrl } from '../../utils/getSpecUrl';

// OpenAPI 3.2 streams (itemSchema). No server answers these paths: the in-browser mock streams the
// events and JSON lines, one item every 300 ms, so Try shows them arriving.
const specUrl = getSpecUrl(Astro.url);
---

<ExampleLayout>
  <rapi-doc
    id="thedoc"
    spec-url={specUrl}
    show-method-in-nav-bar="as-colored-block"
    show-header="false"
    allow-server-selection="true"
    allow-authentication="true"
    render-style="read"
    mock-server="false"
    theme="ember"
  >
  </rapi-doc>
</ExampleLayout>
