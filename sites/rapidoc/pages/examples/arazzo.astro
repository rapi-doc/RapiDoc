---
import ExampleLayout from '../../layouts/ExampleLayout.astro';
---

<ExampleLayout
  title="Arazzo workflows with rapi-flow"
  description="Draw the workflows of an Arazzo spec next to the API reference with the rapi-flow element, and run them against the real Petstore API or the in-browser mock."
>
  <script>
    import 'rapidoc/flow';

    // The Real server / Mock switch: turns <rapi-doc>'s in-browser mock on or off.
    // <rapi-flow> follows it (its run button reads "RUN WORKFLOW (Mock)").
    const doc = document.querySelector('rapi-doc');
    for (const button of document.querySelectorAll<HTMLButtonElement>('.server-switch button')) {
      button.addEventListener('click', () => {
        const server = button.dataset.server;
        doc.setAttribute('mock-server', server === 'mock' ? 'true' : 'false');
        for (const b of document.querySelectorAll('.server-switch button')) {
          b.setAttribute('aria-pressed', String(b === button));
        }
        for (const note of document.querySelectorAll<HTMLElement>('.server-note')) {
          note.hidden = note.dataset.server !== server;
        }
      });
    }

    // The Dark / Light switch: sets both elements' color-scheme and the page's own colors.
    const flow = document.querySelector('rapi-flow');
    const example = document.querySelector<HTMLElement>('.flow-example');
    const logo = document.querySelector<HTMLImageElement>('.flow-logo');
    for (const button of document.querySelectorAll<HTMLButtonElement>('.scheme-switch button')) {
      button.addEventListener('click', () => {
        const scheme = button.dataset.scheme;
        flow.setAttribute('color-scheme', scheme);
        doc.setAttribute('color-scheme', scheme);
        example.dataset.scheme = scheme;
        logo.src = `/assets/images/rapi-flow-lockup-${scheme}.svg`;
        for (const b of document.querySelectorAll('.scheme-switch button')) {
          b.setAttribute('aria-pressed', String(b === button));
        }
      });
    }
  </script>

  <div class="flow-example" data-scheme="dark">
    <div class="flow-pane">
      <rapi-flow
        arazzo-url="/specs/petstore.arazzo.yaml"
        for="thedoc"
        allow-arazzo-url-load="true"
        update-route="true"
        mcp="true"
        theme = "amber"
        color-scheme="dark"
      >
        <div slot="header">
          <div class="header-bar">
            <img class="flow-logo" src="/assets/images/rapi-flow-lockup-dark.svg" alt="rapi-flow" height="26" />
            <div class="switches">
              <div class="switch scheme-switch" role="group" aria-label="Color scheme">
                <button type="button" data-scheme="dark" aria-pressed="true">Dark</button>
                <button type="button" data-scheme="light" aria-pressed="false">Light</button>
              </div>
              <div class="switch server-switch" role="group" aria-label="Server">
                <button type="button" data-server="real" aria-pressed="true">Real server</button>
                <button type="button" data-server="mock" aria-pressed="false">Mock</button>
              </div>
            </div>
          </div>
          <p class="server-note" data-server="real">
            Requests go to <code>petstore3.swagger.io</code>, a public demo anyone can change: runs place
            real orders, and results vary. Switch to Mock to try the failure paths.
          </p>
          <p class="server-note" data-server="mock" hidden>
            RapiDoc's in-browser mock answers every request in the page; nothing reaches the server.
            Responses come from the OpenAPI spec's examples and schemas.
          </p>
        </div>
      </rapi-flow>
    </div>

    <!-- No spec-url: <rapi-flow> (it has the URL box) loads the Arazzo spec's API into it -->
    <rapi-doc
      id="thedoc"
      class="doc-pane"
      show-header="false"
      render-style="focused"
      show-side-nav="floating"
      mock-server="false"
      color-scheme="dark"
    ></rapi-doc>
  </div>
</ExampleLayout>

<style>
  /* Two panes: <rapi-flow> on the left, <rapi-doc> on the right */
  /* The page's own colors, for each position of the Dark / Light switch */
  .flow-example {
    --example-bg: rgb(31, 31, 35);
    --example-muted: #a1a1aa;
    --example-border: var(--rd-border-hover);
    display: flex;
    gap: 16px;
    height: 100vh;
    background: var(--example-bg);
  }
  .flow-example[data-scheme='light'] {
    --example-bg: #fff;
    --example-muted: #52525b;
    --example-border: #d4d4d8;
  }
  .flow-example[data-scheme='light'] .switch button[aria-pressed='true'] {
    color: #9a4a00;
    border-color: #f0a35c;
    background: #fff4e8;
  }
  .flow-pane {
    width: clamp(30rem, 45%, 56rem);
    overflow: auto;
    border-right: 1px solid var(--example-border);
  }
  .doc-pane {
    flex: 1;
    min-width: 0;
  }

  /* The header slot: logo on the left, the server switch on the right, a note below */
  .header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .switches {
    display: flex;
    gap: 8px;
  }
  .switch button {
    padding: 0.25rem 0.75rem;
    font: inherit;
    font-size: 0.8125rem;
    color: var(--example-muted);
    background: transparent;
    border: 1px solid var(--example-border);
    cursor: pointer;
  }
  .switch button[aria-pressed='true'] {
    color: var(--rd-accent);
    border-color: var(--rd-accent-border);
    background: var(--rd-accent-dim);
  }
  .server-note {
    margin: 12px 0 16px;
    font-size: 0.8125rem;
    color: var(--example-muted);
  }

  @media (max-width: 900px) {
    .flow-example {
      flex-direction: column;
      height: auto;
    }
    .flow-pane {
      width: auto;
    }
    .doc-pane {
      height: 100vh;
    }
  }
</style>
