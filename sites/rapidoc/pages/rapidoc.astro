---
import GlobalLayout from '../layouts/GlobalLayout.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import { rapidocComparison } from '../page-data/rapidoc-comparison';
import { productPageData } from '../utils/structuredData';
import { Code } from 'astro:components';
import PortalHeader from '@rapidoc/portal/components/PortalPageHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Icon from '../components/Icon.astro';
import { rapidocBuildInfo } from '../page-data/rapidoc-build-info';
import { RAPIDOC_PAGE } from '../page-data/snippets';

// "Zero Config, Instant Integration": the quickstart's HTML file (page-data/snippets.ts). Frameworks and
// self-hosting are links: the framework guide and the quickstart's "Without a CDN".
const startSample = { file: 'index.html', lang: 'html', code: RAPIDOC_PAGE };
const startLinks = [
  { label: 'Quickstart', href: '/docs/rapidoc/get-started/quickstart/' },
  { label: 'React, Vue, Angular, Svelte', href: '/docs/integrations/front-end/' },
  { label: 'Without a CDN', href: '/docs/rapidoc/get-started/quickstart/#without-a-cdn' },
];


---

<GlobalLayout
  structuredData={productPageData('rapidoc')}
  title="RapiDoc: Interactive API Reference from OpenAPI | RapiDoc"
  description="Generate beautiful, interactive, and customizable API documentation from OpenAPI 3.0 & 3.1 and Swagger specs with zero build steps using native Web Components."
  keywords="OpenAPI, Swagger, API documentation, Web Component, OpenAPI 3.1, REST API, API Console, RapiDoc, API Explorer"
>
  <!-- RapiDoc Component Registration -->
  <script slot="script" is:inline type="module" src="/assets/rapidoc-min.js"></script>

  <!-- Ambient background glow elements inspired by Nuxt.com -->
  <div class="ambient-glow glow-emerald"></div>
  <div class="ambient-glow glow-indigo"></div>
  <div class="ambient-glow glow-cyan"></div>

  <!-- Reusable Frosted Glass Navigation -->
  <PortalHeader />

  <!-- Hero Section: Split DX Studio Layout -->
  <section class="rd-hero-section">
    <div class="rd-hero-container">
      <!-- Left Column: Copy & Personas -->
      <div class="rd-hero-left">
        <h1 class="rd-hero-title">
          API Documentation <br />
          <span class="rd-gradient-text">Developers & Product Teams</span>
          <br />
          Agree On.
        </h1>

        <p class="rd-hero-subtitle">
          Build breathtaking, high-performance interactive API references without framework lock-in. Powered by native Web Components,
          featuring an integrated API console, and self-hosted corporate security.
        </p>

        <!-- Action CTAs -->
        <div class="rd-hero-cta-group">
          <a href="/examples/petstore-3-2" class="rd-btn rd-btn-primary rd-btn-lg">
            <span>Explore Live Demos</span>
            <Icon name="arrow-right" size={16} />
          </a>
          <a href="#quickstart" class="rd-btn rd-btn-glass rd-btn-lg">
            <span>Quick Start in 60s</span>
          </a>
        </div>

        <!-- Quick Terminal Snippet -->
        <div class="rd-terminal-box">
          <span class="rd-terminal-prompt">$</span>
          <code class="rd-terminal-code">npm install rapidoc</code>
          <button class="rd-terminal-copy" id="hero-copy-btn" data-code="npm install rapidoc" title="Copy command">
            <Icon name="copy" size={14} />
            <span class="rd-copy-label">Copy</span>
          </button>
        </div>
      </div>

      <!-- Right Column: RapiDoc Dark Mode Interface Preview -->
      <div class="rd-hero-right">
        <div class="rd-screenshot-container">
          <div class="rd-screenshot-mask-y">
            <img
              src="/assets/images/RapidocDarkScreenShot.png"
              alt="RapiDoc Dark Theme - Interactive API Documentation and Console"
              class="rd-screenshot-img"
              loading="eager"
              fetchpriority="high"
              width="2872"
              height="1208"
            />
          </div>
        </div>
      </div>
    </div>

    <!-- Persona Columns: Side-by-Side (For Developers & For Product Managers) -->
    <div class="rd-persona-box" id="persona-section">
      <div class="rd-persona-columns">
        <!-- Developer Section -->
        <div class="rd-persona-col">
          <div class="rd-persona-col-header">
            <div class="rd-persona-icon-wrap">
              <Icon name="code" size={16} />
            </div>
            <h2 class="rd-persona-title">For Developers</h2>
          </div>
          <div class="rd-persona-list">
            <div class="rd-persona-item">
              <span class="rd-persona-bullet">✓</span>
              <div>
                <strong>True Web Component:</strong> Zero framework lock-in. Works effortlessly in React, Vue, Angular, Svelte, or plain HTML.
              </div>
            </div>
            <div class="rd-persona-item">
              <span class="rd-persona-bullet">✓</span>
              <div>
                <strong>Curated MCP Server Generator:</strong> Export a Model Context Protocol manifest with JSON Schema tools, MCP safety annotations and a runnable TypeScript project, with transport-header stripping and token budget diagnostics.
              </div>
            </div>
            <div class="rd-persona-item">
              <span class="rd-persona-bullet">✓</span>
              <div>
                <strong>Integrated API Console:</strong> Test real endpoints directly with negative testing enabled — send custom headers & malformed
                payloads to test edge cases.
              </div>
            </div>
            <div class="rd-persona-item">
              <span class="rd-persona-bullet">✓</span>
              <div>
                <strong>Container Ready:</strong> Tiny ~{rapidocBuildInfo.bundle.minified.formatted} bundle ({
                  rapidocBuildInfo.bundle.gzip.formatted
                } gzipped) with zero SSR/Node overhead. Bundles directly into Browser and micro-containers with Go/Rust/Java/Python servers.
              </div>
            </div>
            <div class="rd-persona-item">
              <span class="rd-persona-bullet">✓</span>
              <div>
                <strong>Built In Mock Server:</strong> Prototype client frontends, simulate multi-status responses, and test network latency before
                backend APIs exist.
              </div>
            </div>
          </div>
        </div>

        <!-- Product Manager Section -->
        <div class="rd-persona-col">
          <div class="rd-persona-col-header">
            <div class="rd-persona-icon-wrap">
              <Icon name="pencil-simple" size={16} />
            </div>
            <h2 class="rd-persona-title">For Product Managers</h2>
          </div>
          <div class="rd-persona-list">
            <div class="rd-persona-item">
              <span class="rd-persona-bullet">✓</span>
              <div>
                <strong>Agent-Ready with Token Budget Controls:</strong> Future-proof your APIs for AI assistants (Claude, Cursor). Real-time token diagnostics slash prompt overhead by ~80% while shielding internal enterprise routes.
              </div>
            </div>
            <div class="rd-persona-item">
              <span class="rd-persona-bullet">✓</span>
              <div>
                <strong>Self-Hosted Corporate Data Security:</strong> Operates 100% in-browser with zero telemetry or outbound cloud leaks. Ideal
                for strict compliance and air-gapped VPCs.
              </div>
            </div>
            <div class="rd-persona-item">
              <span class="rd-persona-bullet">✓</span>
              <div>
                <strong>100% Brand Consistency:</strong> White-label fonts, header colors, logos, and light/dark modes with simple HTML attributes.
                No code forks required.
              </div>
            </div>
            <div class="rd-persona-item">
              <span class="rd-persona-bullet">✓</span>
              <div>
                <strong>3 Layout Modes for Every Reader:</strong> Deliver wiki-style references (Read Mode), fast technical exploration (View
                Mode), or focused endpoint catalogs.
              </div>
            </div>
            <div class="rd-persona-item">
              <span class="rd-persona-bullet">✓</span>
              <div>
                <strong>Zero SaaS Tax (100% MIT):</strong> No per-seat pricing, no paywalled interactive consoles, and no vendor lock-in.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Metrics Proof Bar -->
  <section class="rd-metrics-section">
    <div class="rd-metrics-container">
      <div class="rd-metric-card">
        <div class="rd-metric-number">0</div>
        <div class="rd-metric-label">Framework Lock-in</div>
        <div class="rd-metric-desc">W3C Web Component: React, Vue, Svelte, or pure HTML</div>
      </div>
      <div class="rd-metric-card">
        <div class="rd-metric-number">~{rapidocBuildInfo.bundle.gzip.formatted}</div>
        <div class="rd-metric-label">Ultra-Light Bundle</div>
        <div class="rd-metric-desc">
          Gzipped single bundle ({rapidocBuildInfo.bundle.minified.formatted} minified). Zero VDOM diffing overhead
        </div>
      </div>
      <div class="rd-metric-card">
        <div class="rd-metric-number">100<span class="rd-unit">%</span></div>
        <div class="rd-metric-label">Private & Self-Hosted</div>
        <div class="rd-metric-desc">Zero telemetry. Air-gapped and container ready</div>
      </div>
      <div class="rd-metric-card">
        <div class="rd-metric-number">3</div>
        <div class="rd-metric-label">Layout Paradigms</div>
        <div class="rd-metric-desc">View, Read, and Focused modes for all audiences</div>
      </div>
    </div>
  </section>

  <!-- The other products and the integrations (page-data/products.ts) -->

  <!-- Dark & Light Modes Showcase Section -->
  <section class="rd-theme-card-section">
    <div class="rd-theme-card">
      <div class="rd-badge-pill" style="margin-bottom: 16px;">
        <span class="rd-badge-pulse"></span>
        <span class="rd-badge-text">Visual Polish</span>
      </div>
      <h2 class="rd-section-title">Dark & Light Modes Done Right</h2>
      <p class="rd-section-desc" style="max-width: 640px; margin: 0 auto 28px auto;">
        RapiDoc provides pixel-perfect high-contrast dark and light themes out of the box, engineered for crystal-clear readability, WCAG AA
        compliance, and effortless enterprise brand pairing.
      </p>
      <div class="rd-theme-card-actions">
        <a href="/examples/css-dark" target="_blank" class="rd-btn rd-btn-primary">
          <Icon name="moon" size={15} />
          <span>High-Contrast Dark Demo</span>
          <Icon name="arrow-right" size={14} />
        </a>
        <a href="/examples/css-light" target="_blank" class="rd-btn rd-btn-primary">
          <Icon name="sun" size={15} />
          <span>High-Contrast Light Demo</span>
          <Icon name="arrow-right" size={14} />
        </a>
      </div>
    </div>
  </section>

  <!-- Bento Grid of Key Advantages (Nuxt-Style) -->
  <section class="rd-bento-section" id="features">
    <div class="rd-section-header rd-section-header--center">
      <span class="rd-section-badge">Uncompromising Engineering</span>
      <h2 class="rd-section-title">Why Teams Choose RapiDoc Over Alternatives</h2>
      <p class="rd-section-desc">
        Designed from the ground up for developer productivity, enterprise privacy, and product design flexibility.
      </p>
    </div>

    <div class="rd-bento-grid">
      <!-- Card 1: Large feature -->
      <div class="rd-bento-card rd-col-span-2">
        <div class="rd-bento-badge">Framework Agnostic</div>
        <div class="rd-bento-icon-box">
          <Icon name="globe" size={24} weight="duotone" />
        </div>
        <h3 class="rd-bento-title">Native W3C Web Component Standard</h3>
        <p class="rd-bento-text">
          Free of proprietary wrapper lock-in, complicated build steps, or framework runtime baggage. Drop a single <code
            >&lt;rapi-doc&gt;</code
          > custom element into React, Vue, Angular, Next.js, Nuxt, Astro, or plain vanilla HTML. Change attributes with JavaScript and it responds
          instantly.
        </p>
        <div class="rd-bento-tags">
          <span class="rd-tag">No React Hydration Overhead</span>
          <span class="rd-tag">Zero Build Step</span>
          <span class="rd-tag">Universal Interoperability</span>
        </div>
      </div>

      <!-- Card 2: Interactive Console -->
      <div class="rd-bento-card">
        <div class="rd-bento-badge">Real DX</div>
        <div class="rd-bento-icon-box">
          <Icon name="terminal-window" size={24} weight="duotone" />
        </div>
        <h3 class="rd-bento-title">Built-in Console with Negative Testing</h3>
        <p class="rd-bento-text">
          Execute API calls directly in the docs. Unlike rigid renderers that block invalid inputs, RapiDoc lets you test negative edge
          cases, corrupt payloads, and custom headers.
        </p>
      </div>

      <!-- Card: In-Browser Mock Server -->
      <div class="rd-bento-card">
        <div class="rd-bento-badge">Zero Setup</div>
        <div class="rd-bento-icon-box">
          <Icon name="sparkle" size={24} weight="duotone" />
        </div>
        <h3 class="rd-bento-title">In-Browser Mock Server</h3>
        <p class="rd-bento-text">
          Frontend teams can prototype before the backend is built. Seamlessly intercepts in-page <code>fetch()</code> calls and generates realistic
          mock responses from OpenAPI examples or schemas with multi-status and latency simulation.
        </p>
        <a
          href="/examples/mock-server"
          style="color: var(--rd-accent); font-size: 13.5px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; margin-top: 14px; text-decoration: none;"
        >
          Explore Mock Server
          <Icon name="arrow-right" size={14} />
        </a>
      </div>

      <!-- Card: Curated MCP Server Generator -->
      <div class="rd-bento-card">
        <div class="rd-bento-badge">Agent Ready</div>
        <div class="rd-bento-icon-box">
          <Icon name="lightning" size={24} weight="duotone" />
        </div>
        <h3 class="rd-bento-title">Curated MCP Server Generator</h3>
        <p class="rd-bento-text">
          Convert OpenAPI specs into a Model Context Protocol manifest with JSON Schema tools, MCP safety annotations and a runnable TypeScript project. Skips internal and deprecated endpoints, strips transport headers and keeps a live budget of prompt context overhead.
        </p>
        <a
          href="/docs/mcp/"
          style="color: var(--rd-accent); font-size: 13.5px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; margin-top: 14px; text-decoration: none;"
        >
          Explore MCP Architecture
          <Icon name="arrow-right" size={14} />
        </a>
      </div>

      <!-- Card 3: Embedded Containers -->
      <div class="rd-bento-card">
        <div class="rd-bento-badge">Microservices & Edge</div>
        <div class="rd-bento-icon-box">
          <Icon name="cube" size={24} weight="duotone" />
        </div>
        <h3 class="rd-bento-title">Embedded in Micro-Servers & Containers</h3>
        <p class="rd-bento-text">
          With its tiny bundle size and zero server-side rendering dependencies, RapiDoc is ideal for embedding into lightweight Docker
          containers, Go / Rust / Java backends, and IoT edge devices.
        </p>
      </div>

      <!-- Card 4: Schema Visualization -->
      <div class="rd-bento-card">
        <div class="rd-bento-badge">Ergonomics</div>
        <div class="rd-bento-icon-box">
          <Icon name="tree-structure" size={24} weight="duotone" />
        </div>
        <h3 class="rd-bento-title">Tree & Tabular Schema Folding</h3>
        <p class="rd-bento-text">
          Choose between Tree and Table representation for deep schemas. All models and examples are auto-expanded by default, completely
          eliminating tedious 20-click accordions.
        </p>
      </div>

      <!-- Card 5: Corporate Security -->
      <div class="rd-bento-card rd-col-span-2">
        <div class="rd-bento-badge">Enterprise Ready</div>
        <div class="rd-bento-icon-box">
          <Icon name="shield-check" size={24} weight="duotone" />
        </div>
        <h3 class="rd-bento-title">100% Self-Hosted & Air-Gapped Security</h3>
        <p class="rd-bento-text">
          Trusted by Fortune 500 corporations, defense, and fintech organizations. RapiDoc executes entirely client-side in the browser. No
          telemetry phoning home, no cloud vendor lock-in, and zero risk of proprietary internal API schemas leaking to third parties.
        </p>
        <div class="rd-bento-tags">
          <span class="rd-tag">100% Offline Capable</span>
          <span class="rd-tag">Air-Gapped VPC Compliant</span>
          <span class="rd-tag">Zero Cloud Telemetry</span>
          <span class="rd-tag">100% MIT Open Source</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison with other API documentation tools (data: page-data/rapidoc-comparison.ts) -->
  <section class="rd-comparison-section" id="comparison">
    <div class="rd-section-header rd-section-header--center">
      <span class="rd-section-badge">Comparison</span>
      <h2 class="rd-section-title">How RapiDoc Compares</h2>
      <p class="rd-section-desc">
        From the reference to the whole portal: what each tool includes, and what needs a paid or hosted plan.
      </p>
    </div>

    <ComparisonTable data={rapidocComparison} />
  </section>

  <!-- Upgraded Shiki Quickstart Code Showcase -->
  <section class="rd-quickstart-section" id="quickstart">
    <div class="rd-section-header rd-section-header--center">
      <span class="rd-section-badge">Get Up & Running</span>
      <h2 class="rd-section-title">Zero Config, Instant Integration</h2>
      <p class="rd-section-desc">Save this as a file and open it in a browser. The same element works in any framework.</p>
    </div>

    <div class="rd-code-box">
      <div class="rd-code-bar">
        <div class="rd-code-tabs">
          <span class="rd-code-tab active">HTML</span>
        </div>
        <button class="rd-code-copy" type="button" aria-label="Copy the code">
          <Icon name="copy" size={14} />
          <span class="rd-code-copy-label">Copy</span>
        </button>
      </div>

      <div class="rd-code-panel active" data-code={startSample.code}>
        <div class="rd-code-file">{startSample.file}</div>
        <Code code={startSample.code} lang={startSample.lang} theme="github-dark" />
        <p class="rd-code-note">
          One script tag and one element. Nothing to install or build.{' '}
          {startLinks.map((link, n) => (
            <>
              {n > 0 && ' · '}
              <a href={link.href}>{link.label}</a>
            </>
          ))}
        </p>
      </div>
    </div>
  </section>

  <!-- Modern Call To Action Card -->
  <section class="rd-cta-section">
    <div class="rd-cta-card">
      <div class="rd-cta-glow"></div>
      <h2 class="rd-cta-title">Ready to Elevate Your API Documentation?</h2>
      <p class="rd-cta-desc">
        Join thousands of developers and enterprise organizations delivering lightning-fast, beautifully branded OpenAPI references.
      </p>
      <div class="rd-cta-actions">
        <a href="/examples/petstore-3-2" class="rd-btn rd-btn-primary rd-btn-lg">
          <span>View Live Petstore Demo</span>
          <Icon name="arrow-right" size={16} />
        </a>
        <a href="/tests" class="rd-btn rd-btn-glass rd-btn-lg">
          <span>Explore Test Matrix →</span>
        </a>
        <a href="https://github.com/rapi-doc/RapiDoc" target="_blank" rel="noopener" class="rd-btn rd-btn-glass rd-btn-lg">
          <span>Star on GitHub ★</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Reusable Modern Footer -->
  <SiteFooter />
</GlobalLayout>

<script>
  // "Zero Config": the copy button
  const codeCopy = document.querySelector<HTMLButtonElement>('.rd-code-copy');
  codeCopy?.addEventListener('click', async () => {
    const code = document.querySelector<HTMLElement>('.rd-code-panel.active')?.dataset.code;
    if (!code) return;
    await navigator.clipboard.writeText(code);
    const label = codeCopy.querySelector('.rd-code-copy-label');
    if (label) {
      label.textContent = 'Copied';
      setTimeout(() => (label.textContent = 'Copy'), 1600);
    }
  });

  // Hero Copy Button
  const heroCopyBtn = document.getElementById('hero-copy-btn');
  if (heroCopyBtn) {
    heroCopyBtn.addEventListener('click', async () => {
      const code = heroCopyBtn.getAttribute('data-code');
      if (code) {
        await navigator.clipboard.writeText(code);
        const label = heroCopyBtn.querySelector('.rd-copy-label');
        if (label) {
          label.textContent = 'Copied!';
          setTimeout(() => {
            label.textContent = 'Copy';
          }, 2000);
        }
      }
    });
  }
</script>

<style>
  /* Base resets & layout (the font is the site's, from global.css) */
  body {
    overflow-x: hidden;
  }

  /* Hero Section */
  .rd-hero-section {
    position: relative;
    z-index: 1;
    padding: var(--rd-page-top) 24px 72px 24px;
    max-width: var(--rd-max-width);
    margin: 0 auto;
  }
  .rd-hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: start;
  }
  .rd-hero-left {
    display: flex;
    flex-direction: column;
  }
  /* Hero Typography */
  .rd-hero-title {
    font-size: 2.5rem;
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--rd-text-bright);
    margin: 0 0 18px 0;
  }
  .rd-hero-subtitle {
    font-size: 1.08rem;
    line-height: 1.6;
    color: var(--rd-text-muted);
    margin: 0 0 28px 0;
    max-width: 580px;
  }

  /* Persona Box: Side-by-Side (Below Hero & Screenshot) */
  .rd-persona-box {
    background: var(--rd-surface);
    border: 1px solid var(--rd-border);
    border-radius: var(--rd-radius-lg);
    padding: 28px 32px;
    backdrop-filter: blur(12px);
    margin-top: 48px;
    margin-bottom: 28px;
    box-shadow: var(--rd-shadow-panel);
  }
  .rd-persona-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }
  @media (min-width: 768px) {
    .rd-persona-columns {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
  }
  .rd-persona-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .rd-persona-col-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--rd-border);
  }
  .rd-persona-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--rd-radius-sm);
    background: var(--rd-icon-bg);
    color: var(--rd-accent);
    flex-shrink: 0;
  }
  .rd-persona-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--rd-text-bright);
    letter-spacing: -0.01em;
    margin: 0;
  }
  .rd-persona-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .rd-persona-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--rd-text-soft);
  }
  .rd-persona-item strong {
    color: var(--rd-text-bright);
  }
  .rd-persona-bullet {
    color: var(--rd-accent);
    font-weight: 800;
    font-size: 14px;
    margin-top: 1px;
    flex-shrink: 0;
  }

  /* Hero CTAs & Terminal */
  .rd-hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 24px;
  }
  .rd-terminal-box {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid var(--rd-border);
    border-radius: var(--rd-radius-md);
    width: fit-content;
    font-family: var(--rd-font-mono);
    font-size: 13px;
  }
  .rd-terminal-prompt {
    color: var(--rd-accent);
    font-weight: 700;
  }
  .rd-terminal-code {
    color: var(--rd-text);
  }
  .rd-terminal-copy {
    display: flex;
    align-items: center;
    gap: 6px;
    background: var(--rd-wash);
