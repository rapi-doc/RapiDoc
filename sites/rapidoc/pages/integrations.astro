---
// Every RapiDoc integration on one page: server frameworks, documentation sites and front-end frameworks.
// The setup of each is in the Integrations section of the docs (content/docs/integrations/).
import GlobalLayout from '../layouts/GlobalLayout.astro';
import PortalHeader from '@rapidoc/portal/components/PortalPageHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Icon from '../components/Icon.astro';

const DOCS = '/docs/integrations/';

interface Integration {
  name: string;
  /** The package to install, or none */
  pkg?: string;
  install?: string;
  /** The line that adds the reference */
  usage?: string;
  text: string;
  icon: string;
  href: string;
}

const servers: Integration[] = [
  {
    name: 'Hono',
    pkg: '@rapidoc/hono',
    install: 'npm install @rapidoc/hono',
    usage: "app.use(rapidoc({ specUrl: '/openapi.json' }));",
    text: 'Middleware that serves the reference at <code>/docs</code>; on Cloudflare Workers, import <code>@rapidoc/hono/edge</code>.',
    icon: 'node',
    href: `${DOCS}node/#hono`,
  },
  {
    name: 'Express',
    pkg: '@rapidoc/express',
    install: 'npm install @rapidoc/express',
    usage: "app.use(rapidoc({ specUrl: '/openapi.json' }));",
    text: 'Middleware that serves the reference at <code>/docs</code>, with the bundle and the OAuth return page.',
    icon: 'node',
    href: `${DOCS}node/#express-and-fastify`,
  },
  {
    name: 'Fastify',
    pkg: '@rapidoc/fastify',
    install: 'npm install @rapidoc/fastify',
    usage: "await fastify.register(rapidoc, { specUrl: '/openapi.json' });",
    text: 'A plugin with the same options as the Express and Hono packages; honors Fastify\'s <code>prefix</code>.',
    icon: 'node',
    href: `${DOCS}node/#express-and-fastify`,
  },
  {
    name: 'FastAPI & Starlette',
    pkg: 'rapidoc (PyPI)',
    install: 'pip install rapidoc',
    usage: 'setup_rapidoc(app, options={"render_style": "focused"})',
    text: 'Reads the app\'s own <code>/openapi.json</code>. For plain Starlette, import from <code>rapidoc.starlette</code>.',
    icon: 'python',
    href: `${DOCS}python/`,
  },
  {
    name: 'ASP.NET Core',
    pkg: 'RapiDoc.AspNetCore',
    install: 'dotnet add package RapiDoc.AspNetCore',
    usage: 'app.MapRapiDoc();',
    text: 'An endpoint for .NET 8 or later, next to <code>MapOpenApi()</code>, Swashbuckle or NSwag.',
    icon: 'csharp',
    href: `${DOCS}dotnet/`,
  },
  {
    name: 'Go',
    pkg: 'rapidoc-go',
    install: 'go get github.com/rapi-doc/rapidoc-go',
    usage: 'mux.Handle("/docs/", rapidoc.Handler(opts))',
    text: 'A <code>net/http</code> handler with no dependencies, so it also mounts on chi, Gin, Echo and Fiber.',
    icon: 'go',
    href: `${DOCS}go/`,
  },
];

const docSites: Integration[] = [
  {
    name: 'Starlight',
    pkg: '@rapidoc/starlight',
    install: 'npm install @rapidoc/starlight',
    usage: "plugins: [starlightRapidoc({ uiPath: '/docs/rapidoc/reference/', spec: './openapi.yaml' })]",
    text: 'A page per API in Starlight\'s layout and themes, with its operations in Starlight\'s sidebar.',
    icon: 'astro',
    href: `${DOCS}docs-sites/#starlight`,
  },
  {
    name: 'VitePress',
    pkg: '@rapidoc/vitepress',
    install: 'npm install @rapidoc/vitepress',
    usage: '<RapidocReference api="pets" />',
    text: 'Wrap the config with <code>withRapidoc</code>, build the sidebar with <code>rapidocSidebar</code>, add the component to a page.',
    icon: 'books',
    href: `${DOCS}docs-sites/#vitepress`,
  },
  {
    name: 'Docusaurus',
    pkg: '@rapidoc/docusaurus',
    install: 'npm install @rapidoc/docusaurus',
    usage: '<RapidocReference api="pets" />',
    text: 'A plugin for the specs, a React component for the page and <code>rapidocSidebarSync</code> for the sidebar.',
    icon: 'books',
    href: `${DOCS}docs-sites/#docusaurus`,
  },
];

const frontEnds: Integration[] = [
  {
    name: 'React & Next.js',
    text: 'Import <code>rapidoc</code> in a client component and write the element; the package ships JSX types for its attributes.',
    icon: 'react',
    href: `${DOCS}front-end/#react-and-nextjs`,
  },
  {
    name: 'Vue & Nuxt',
    text: 'Tell the Vue compiler that <code>rapi-</code> tags are custom elements, then import <code>rapidoc</code> on mount.',
    icon: 'vue',
    href: `${DOCS}front-end/#vue-and-nuxt`,
  },
  {
    name: 'Angular',
    text: 'Add <code>CUSTOM_ELEMENTS_SCHEMA</code> to the component that uses the element.',
    icon: 'angular',
    href: `${DOCS}front-end/#angular`,
  },
  {
    name: 'Svelte, Astro & bundlers',
    text: 'No configuration: import <code>rapidoc</code> in a client-side script and write the element.',
    icon: 'svelte',
    href: `${DOCS}front-end/#svelte-astro-and-plain-bundlers`,
  },
];

const groups = [
  {
    id: 'server-frameworks',
    badge: 'Server Frameworks',
    title: 'Serve the Reference Next to Your API',
    desc: 'These packages add the page, the bundle and the OAuth return page to your app: no HTML to write. Each serves the reference at <code>/docs</code> and takes any attribute of <code>&lt;rapi-doc&gt;</code> as an option.',
    items: servers,
  },
  {
    id: 'documentation-sites',
    badge: 'Documentation Sites',
    title: 'An API Reference Inside Your Docs Site',
    desc: 'A page per API in the site\'s own layout, with the API\'s tags and operations in its sidebar.',
    items: docSites,
  },
  {
    id: 'front-end-frameworks',
    badge: 'Front-End Frameworks',
    title: 'A Web Component Works Everywhere',
    desc: '<code>&lt;rapi-doc&gt;</code> is a standard custom element, so no wrapper package is needed: a line of setup at most.',
    items: frontEnds,
  },
];
---

<GlobalLayout
  title="RapiDoc Integrations: Hono, Express, Fastify, FastAPI, ASP.NET Core, Go, Starlight, VitePress, Docusaurus | RapiDoc"
  description="Add a RapiDoc API reference to your server framework, documentation site or front-end app: packages for Hono, Express, Fastify, FastAPI, ASP.NET Core, Go, Starlight, VitePress and Docusaurus."
  keywords="RapiDoc integrations, OpenAPI docs Express, FastAPI docs, ASP.NET Core OpenAPI UI, Starlight OpenAPI, VitePress OpenAPI, Docusaurus OpenAPI"
>
  <div class="ambient-glow glow-emerald"></div>
  <div class="ambient-glow glow-indigo"></div>

  <PortalHeader />

  <main class="rd-product-main">
    <header class="rd-hero-header">
      <div class="rd-badge-pill">
        <span class="rd-badge-pulse"></span>
        <span class="rd-badge-text">Integrations</span>
      </div>

      <h1 class="rd-page-title">
        RapiDoc <span class="text-gradient">Everywhere</span>
      </h1>

      <p class="rd-page-subtitle">
        Add an API reference to the server that runs your API, the docs site you already have, or your app. Every
        integration follows one contract, so they take the same options and serve the same page.
      </p>

      <div class="rd-hero-actions">
        {
          groups.map((group, i) => (
            <a href={`#${group.id}`} class:list={['rd-btn', i === 0 ? 'rd-btn-primary' : 'rd-btn-secondary']}>
              <span>{group.badge}</span>
            </a>
          ))
        }
      </div>
    </header>

    {
      groups.map((group) => (
        <section class="rd-section" id={group.id}>
          <div class="rd-section-header rd-section-header--center">
            <div class="rd-section-badge">{group.badge}</div>
            <h2 class="rd-section-title">{group.title}</h2>
            <p class="rd-section-desc" set:html={group.desc} />
          </div>
          <div class="rd-feature-grid">
            {group.items.map((item) => (
              <a href={item.href} class="rd-feature-card">
                <span class="rd-feature-icon">
                  {item.icon === 'node' && <Icon name="file-js" size={24} weight="duotone" />}
                  {item.icon === 'python' && <Icon name="file-py" size={24} weight="duotone" />}
                  {item.icon === 'csharp' && <Icon name="file-c-sharp" size={24} weight="duotone" />}
                  {item.icon === 'go' && <Icon name="file-code" size={24} weight="duotone" />}
                  {item.icon === 'astro' && <Icon name="star-four" size={24} weight="duotone" />}
                  {item.icon === 'books' && <Icon name="books" size={24} weight="duotone" />}
                  {item.icon === 'react' && <Icon name="atom" size={24} weight="duotone" />}
                  {item.icon === 'vue' && <Icon name="file-vue" size={24} weight="duotone" />}
                  {item.icon === 'angular' && <Icon name="angular-logo" size={24} weight="duotone" />}
                  {item.icon === 'svelte' && <Icon name="file-code" size={24} weight="duotone" />}
                </span>
                <h3 class="rd-feature-title">
                  {item.name}
                  {item.pkg && <span class="rd-feature-tag">{item.pkg}</span>}
                </h3>
                <p class="rd-feature-text" set:html={item.text} />
                {item.install && <code class="rd-int-code">{item.install}</code>}
                {item.usage && <code class="rd-int-code rd-int-code--usage">{item.usage}</code>}
                <span class="rd-feature-more">
                  Setup <Icon name="arrow-right" size={14} />
                </span>
              </a>
            ))}
          </div>
        </section>
      ))
    }

    <section class="rd-next-steps">
      <h2 class="rd-section-title">Not on the List?</h2>
      <p class="rd-section-desc">
        Write one for your framework, site generator or tool, in any language. <code>@rapidoc/embed</code> has the contract
        (options, routes and the page's HTML) and conformance fixtures that ports in other languages run.
      </p>
      <div class="rd-hero-actions">
        <a href="/docs/integrations/build-your-own/" class="rd-btn rd-btn-primary rd-btn-lg">
          <span>Build an Integration</span>
          <Icon name="arrow-right" size={15} />
        </a>
        <a href={DOCS} class="rd-btn rd-btn-secondary rd-btn-lg">
          <Icon name="book-open" size={16} />
          <span>Integrations Docs</span>
        </a>
      </div>
    </section>
  </main>

  <SiteFooter />
</GlobalLayout>

<style>
  /* An install command or the line that adds the reference, inside a card */
  .rd-int-code {
    display: block;
    overflow-x: auto;
    white-space: nowrap;
    font-family: var(--rd-font-mono);
    font-size: 12px;
    line-height: 1.6;
    color: var(--rd-text-soft);
    background: var(--rd-icon-bg);
    border: 1px solid var(--rd-border);
    border-radius: var(--rd-radius-sm);
    padding: 6px 10px;
  }
  .rd-int-code--usage {
    color: var(--rd-accent-light);
  }
  .rd-section-desc :global(code) {
    font-family: var(--rd-font-mono);
    font-size: 0.92em;
    color: var(--rd-text-soft);
  }
</style>
