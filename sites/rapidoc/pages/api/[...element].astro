---
// The element references moved into each product's docs (sites/shared/components/ElementReference.astro).
// /api/ and /api/<element>/ stay as pages that send readers there, for the links that can't change: the
// READMEs of published npm packages link to rapidocui.com/api/. A #hash (an attribute's anchor) is kept.
import type { GetStaticPaths } from 'astro';
import { API_ELEMENTS, readElementApi } from '../../page-data/rapidoc-api';

export const getStaticPaths = (() =>
  [
    { slug: '', to: '/docs/rapidoc/reference/', name: '<rapi-doc>' },
    { slug: 'rapi-doc-mini', to: '/docs/rapidoc-mini/reference/', name: '<rapi-doc-mini>' },
    { slug: 'rapi-flow', to: 'https://flow.rapidocui.com/docs/reference/', name: '<rapi-flow>' },
    { slug: 'rapi-pdf', to: '/docs/rapipdf/reference/', name: '<rapi-pdf>' },
  ].map((page) => ({ params: { element: page.slug || undefined }, props: page }))) satisfies GetStaticPaths;

const { to, name } = Astro.props as { to: string; name: string };

// <rapi-doc>'s reference is split over pages: an anchor that isn't an attribute goes to its page
const anchors: Record<string, string> = {};
if (name === '<rapi-doc>') {
  const api = readElementApi(API_ELEMENTS.find((el) => el.tag === 'rapi-doc')!);
  const id = (n: string) => n.replace(/[^a-zA-Z0-9_-]/g, '-');
  const base = '/docs/rapidoc/reference/';
  for (const m of api.Methods.items) anchors[id(m.name)] = `${base}methods/`;
  for (const e of api.Events.items) anchors[e.name] = `${base}events/`;
  for (const sl of api.Slots.items) anchors[`slot-${id(sl.name)}`] = `${base}slots/`;
  for (const x of api.Extensions.items) anchors[x.name] = `${base}extensions/`;
  Object.assign(anchors, {
    methods: `${base}methods/`,
    events: `${base}events/`,
    slots: `${base}slots/`,
    extensions: `${base}extensions/`,
  });
}
const canonical = to.startsWith('http') ? to : new URL(to, 'https://rapidocui.com').href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>The {name} reference has moved</title>
    <meta name="robots" content="noindex" />
    <meta name="portal-search" content="off" />
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <script is:inline define:vars={{ to, anchors }}>
      const hash = decodeURIComponent(location.hash.slice(1));
      location.replace((anchors[hash] || to) + location.hash);
    </script>
  </head>
  <body>
    <p>The {name} reference has moved to <a href={to}>{canonical}</a>.</p>
  </body>
</html>
