---
import { rapidocBuildInfo } from '../page-data/rapidoc-build-info';
import { PRODUCTS, TOOLS, INTEGRATIONS, type ProductLink } from '../page-data/products';

// Products, then the CLI (the other tools are in Resources)
const productLinks: ProductLink[] = [
  ...PRODUCTS.items,
  ...TOOLS.items.filter((item) => item.label === 'RapiDoc CLI'),
];

const linkColumns: { heading: string; links: ProductLink[] }[] = [
  { heading: 'Products', links: productLinks },
  { heading: 'Integrations', links: INTEGRATIONS.items },
  {
    heading: 'Resources',
    links: [
      { label: 'Documentation', href: '/docs/' },
      { label: 'Quickstart', href: '/docs/rapidoc/get-started/quickstart/' },
      { label: 'Reference', href: '/docs/rapidoc/reference/' },
      { label: 'Common Tasks', href: '/docs/rapidoc/guides/' },
      { label: 'Examples', href: '/examples' },
      { label: 'In-Browser Mock', href: '/docs/rapidoc/mocking/in-browser/' },
      { label: 'MCP Server', href: '/docs/mcp/' },
      { label: 'Migration Guides', href: '/docs/rapidoc/migration/v13-to-v14/' },
    ],
  },
  {
    heading: 'Developers',
    links: [
      { label: 'Spec Sandbox', href: '/sandbox' },
      { label: 'Live Configurator', href: '/examples/controller-showcase' },
      { label: 'Test Matrix', href: '/tests' },
      { label: 'Performance', href: '/tests/performance' },
      { label: 'GitHub', href: 'https://github.com/rapi-doc/RapiDoc', external: true },
      { label: 'Releases', href: 'https://github.com/rapi-doc/RapiDoc/releases', external: true },
      { label: 'Issues', href: 'https://github.com/rapi-doc/RapiDoc/issues', external: true },
      { label: 'npm', href: 'https://www.npmjs.com/package/rapidoc', external: true },
    ],
  },
];

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
---

<footer class="rd-footer">
  <div class="rd-footer-container">
    <div class="rd-footer-col">
      <div class="rd-footer-brand">
        <img src="/assets/images/rapidoc-lockup-dark.svg" alt="RapiDoc" class="rd-footer-logo" width="143" height="24" />
      </div>
      <p class="rd-footer-tagline">The modern, framework-agnostic OpenAPI Web Component for developers and product leaders.</p>
      <div class="rd-footer-meta">
        {rapidocBuildInfo.versionTag} • MIT License © {new Date().getFullYear()} Mrinmoy Majumdar
      </div>
      <div class="rd-footer-meta">
        Hosting sponsored by <a href="https://www.simafri.com/en/managed-vps/" target="_blank" rel="sponsored noopener">Simafri</a> (managed VPS)
      </div>
    </div>

    <div class="rd-footer-links-group">
      {
        linkColumns.map((col) => (
          <nav class="rd-footer-link-col" aria-label={col.heading}>
            <span class="rd-footer-heading">{col.heading}</span>
            {col.links.map((link) => (
              <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener' : undefined}>
                {link.label}
              </a>
            ))}
          </nav>
        ))
      }
    </div>
  </div>
</footer>

<style>
  .rd-footer {
    border-top: 1px solid var(--rd-border);
    background: rgba(4, 7, 15, 0.85);
    padding: 56px 24px 40px 24px;
    font-size: 13.5px;
    position: relative;
    z-index: 1;
  }
  .rd-footer-container {
    max-width: var(--rd-max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .rd-footer-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .rd-footer-brand {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .rd-footer-logo {
    display: block;
    width: auto;
    height: 24px;
  }
  .rd-footer-tagline {
    color: var(--rd-text-muted);
    font-size: 13px;
    line-height: 1.5;
    max-width: 320px;
    margin: 0;
  }
  .rd-footer-meta {
    color: var(--rd-text-dim);
    font-size: 12px;
  }
  .rd-footer-meta a {
    color: var(--rd-text-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.15s ease;
  }
  .rd-footer-meta a:hover {
    color: var(--rd-accent);
  }
  .rd-footer-links-group {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 28px;
  }
  .rd-footer-link-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .rd-footer-heading {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--rd-text-bright);
    margin-bottom: 4px;
  }
  .rd-footer-link-col a {
    color: var(--rd-text-muted);
    text-decoration: none;
    font-size: 13px;
    transition: color 0.15s ease;
  }
  .rd-footer-link-col a:hover {
    color: var(--rd-accent);
  }

  @media (min-width: 768px) {
    .rd-footer-container {
      grid-template-columns: 1fr 2.6fr;
    }
  }
</style>
