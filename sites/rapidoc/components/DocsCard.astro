---
/**
 * A card of the /docs page: a product, tool or integration, with its icon, name, tag and one line,
 * linking to its docs; `links` adds shortcuts under it (Quickstart, API Reference). The whole card is the
 * main link (its title's link covers the card), and the shortcuts sit above it, so each stays its own
 * link. A link to another site, the title or a shortcut, gets ↗ and opens in a new tab, as in the
 * header's menus.
 * `wide` spans the whole row, for the Get started card.
 */
import Icon from './Icon.astro';

interface Link {
  label: string;
  href: string;
}

interface Props {
  title: string;
  href: string;
  icon: string;
  description: string;
  /** The element, package or command, in code font beside the title */
  tag?: string;
  links?: Link[];
  wide?: boolean;
}

const { title, href, icon, description, tag, links = [], wide = false } = Astro.props;
const isExternal = (url: string) => /^https?:/.test(url);
const external = (url: string) => (isExternal(url) ? { target: '_blank', rel: 'noopener noreferrer' } : {});
---

<div class:list={['docs-card not-content', { 'docs-card-wide': wide }]}>
  <span class="docs-card-icon" aria-hidden="true"><Icon name={icon} size={24} weight="duotone" /></span>
  <div class="docs-card-body">
    <a class="docs-card-title" href={href} {...external(href)}>
      <span>{title}</span>
      {isExternal(href) && <span class="docs-card-external" aria-label="(opens another site)">↗</span>}
    </a>
    {tag && <code class="docs-card-tag">{tag}</code>}
    <p class="docs-card-desc">{description}</p>
    {
      links.length > 0 && (
        <p class="docs-card-links">
          {links.map((link) => (
            <a href={link.href} {...external(link.href)}>
              {link.label}
              {isExternal(link.href) && <span class="docs-card-external" aria-label="(opens another site)">↗</span>}
            </a>
          ))}
        </p>
      )
    }
  </div>
</div>

<style is:global>
  .docs-card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 1rem;
    margin-block: 1rem 2.5rem;
  }
  /* Starlight spaces the content's elements apart with a top margin; in the grid the gap does that */
  .sl-markdown-content .docs-card-grid > .docs-card {
    margin-top: 0;
  }
  .docs-card {
    position: relative;
    display: flex;
    gap: 1rem;
    padding: 1.25rem;
    border: 1px solid var(--portal-border);
    border-radius: var(--portal-radius);
    background-color: var(--portal-card-bg, transparent);
    transition: border-color 0.15s ease;
  }
  .docs-card:hover,
  .docs-card:focus-within {
    border-color: var(--portal-primary);
  }
  .docs-card-wide {
    grid-column: 1 / -1;
    align-items: center;
  }
  .docs-card-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--portal-border);
    border-radius: var(--portal-radius);
    color: var(--portal-primary);
  }
  .docs-card-body {
    min-width: 0;
  }
  /* The title's link covers the whole card; the shortcuts sit above it */
  .docs-card-title {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--portal-fg);
    text-decoration: none;
  }
  .docs-card-title::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .docs-card-title:focus-visible {
    outline: none;
  }
  .docs-card:has(.docs-card-title:focus-visible) {
    outline: 2px solid var(--portal-primary);
    outline-offset: 2px;
  }
  .docs-card-external {
    font-size: 0.85em;
    color: var(--portal-muted);
  }
  .docs-card-tag {
    display: inline-block;
    margin-inline-start: 0.5rem;
    padding: 0.05rem 0.4rem;
    border-radius: 0.3rem;
    background-color: var(--portal-primary-tint);
    color: var(--portal-primary-text);
    font-size: 0.75rem;
    vertical-align: 0.15em;
  }
  .docs-card-desc {
    margin: 0.35rem 0 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--portal-muted);
  }
  .docs-card-links {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0.75rem 0 0;
    font-size: 0.85rem;
  }
  .docs-card-links a {
    color: var(--portal-primary-text);
    text-decoration: none;
    font-weight: 500;
  }
  .docs-card-links a:hover {
    text-decoration: underline;
  }
  .docs-card-links .docs-card-external {
    margin-inline-start: 0.2em;
  }
</style>
